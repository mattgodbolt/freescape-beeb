\ ***************************************************************************
\ FREESCAPE for the BBC Master - the panel below the view
\ (docs/research/panel.md)
\
\ Driller's instruments, the Atari ST's console redrawn for MODE 2's 128
\ pixels (tools/mkpanel.py, at build time: build/panel/panel.6502). Two
\ parts:
\
\ - The picture: everything outside the view, which never changes, packed
\   (section PanelPack, loaded once at PANEL_LOAD) and unpacked into both
\   buffers at the start (panel_init).
\ - Cells over it, each a few lines of two bytes (four pixels), showing a
\   glyph of a table in its kind's ink on its kind's paper (the picture
\   under it), a line at a time; or a tile, eight bytes down a byte column
\   of a character row (the vehicle's picture). Fields of cells show the
\   score, the energy and shield, the step and turn, the position, the
\   heading and pitch, the vehicle, the area and its message, two lights
\   and the frames a second (tools/model/panel.py, which is the panel's
\   specification: its FIELDS, its tables, cells() and render()).
\
\ The caller says what a cell is to show with panel_set (panel_values does
\ every field the logic's variables give; the frames a second come from
\ the figures). The flip comes mid-field (decision 21), so what's outside
\ the view must be the same in both buffers at every flip, and a change to
\ the buffer shown shows at once (docs/engine.md, section 1). So each cell
\ goes into both buffers, begun only while the beam is past the screen's
\ last line or in the view's lines (User VIA T1's high byte from
\ PANEL_T1_MIN up to HI(PANEL_T1_TOP)) with time to finish before
\ FLIP_LINE, and every cell is below the view (ASSERTed): so no flip that
\ waits for T1 comes while a cell is half drawn, and the beam reaches the
\ shown buffer's copy only once it's whole. panel_sync draws what the beam allows, anywhere once
\ the interrupt is on; panel_catch_up waits for the beam once the panel has
\ been behind for PANEL_PATIENCE calls; panel_wait until a range of cells
\ is drawn; panel_flush draws everything, beam or not, before the
\ interrupt is on. panel_gen moves on whenever anything wanted changes, so
\ a call with nothing new costs a compare.
\
\ The includer includes this file in main RAM below &3000 (panel_set goes
\ there, so code in any bank can call it); declares the sections PanelData
\ (the code and the tables: in a sideways bank, called with it paged) and
\ PanelPack (the packed picture, at PANEL_LOAD: main RAM that's free from
\ the start until panel_init); and names PANEL_BOUNCE (a page of RAM below
\ &3000 that's free until panel_init) and where the panel's values come
\ from (PANEL_POS: x, y and z, words; PANEL_YAW and PANEL_PITCH, bytes: the
\ logic's or the free camera's) and PANEL_FREE (TRUE: the message is the
\ includer's and the compass always turns; FALSE: the original's).
\ ***************************************************************************

INCLUDE "../build/panel/panel.6502"

\ The beam's window. A cell into both buffers takes at most PANEL_CELL_US
\ (tools/livecheck.mjs fails a write to the shown buffer made with the beam
\ at or past its character row, and a flip with the buffers different
\ outside the view), so one begun PANEL_T1_MIN pages of T1 before
\ FLIP_LINE is done by then, and before the beam reaches the panel's top
\ row where that comes sooner (PANEL_LEAD_US). The window opens once the
\ beam has passed the screen's last line (PANEL_T1_TOP: the count from
\ there to FLIP_LINE, a high byte under its own), so no cell's row is
\ scanned while it's drawn: the beam meets the panel again only past
\ FLIP_LINE (2026-11-06, the journal's entry for the eleventh round; the
\ window was the view's lines alone before). T1's interrupt comes at the
\ window's end; the vertical sync's comes inside it, but further from its
\ end than a cell takes, so it only delays a cell begun well before.
PANEL_TOP_LINE = ((PANEL_LOWEST - SCREEN) DIV SCREEN_ROW) * (CRTC_R9 + 1)
PANEL_CELL_US  = 600
IF PANEL_TOP_LINE < FLIP_LINE
    PANEL_LEAD_US = (FLIP_LINE - PANEL_TOP_LINE) * LINE_US
ELSE
    PANEL_LEAD_US = 0
ENDIF
PANEL_T1_MIN   = CEIL((PANEL_CELL_US + PANEL_LEAD_US) / 256)
PANEL_T1_TOP   = (FIELD_LINES - SCREEN_ROWS * (CRTC_R9 + 1) + FLIP_LINE) * LINE_US
PANEL_PATIENCE = 4                          ; panel_catch_up's calls behind before it waits
ASSERT NOT(FLIP_AT_VSYNC)                   ; (T1 times the window)
ASSERT PANEL_TOP_LINE >= VIEW_END_LINE      ; (every cell is below the view)
ASSERT PANEL_T1_MIN < HI(SAFE_T1) AND FLIP_LINE < FLAG_LINE
ASSERT HI(SAFE_T1) < HI(PANEL_T1_TOP) AND HI(PANEL_T1_TOP) < HI(T1_PERIOD)
\ (the vertical sync's flag, inside the window, is more than a cell's time
\ and the lead before its end)
ASSERT (FLIP_LINE + FIELD_LINES - FLAG_LINE) * LINE_US > PANEL_T1_MIN * 256 + PANEL_CELL_US
ASSERT PANEL_CELLS < 128 AND PANEL_GLYPHS <= PANEL_CELLS
ASSERT PANEL_MAX_H <= 8

SECTION Work
.panel_want     SKIP PANEL_CELLS    ; what each cell should show
.panel_shown    SKIP PANEL_CELLS    ; what both buffers show (&FF: nothing yet)
.panel_gen      SKIP 1              ; moves on when panel_want changes
.panel_seen     SKIP 1              ; panel_gen when everything was last drawn
.panel_left     SKIP 1              ; the first cell panel_sync last left undrawn (PANEL_CELLS: none)
.panel_free     SKIP 1              ; non-zero: draw whatever the beam (panel_flush)
.panel_behind   SKIP 1              ; panel_catch_up's calls since the panel was last all drawn
.panel_lines    SKIP 2 * PANEL_MAX_H    ; panel_draw's: a glyph cell's bytes, the left column's then the right's
.panel_num      SKIP 3              ; panel_number's
.panel_cache    SKIP PC_BYTES       ; ... each number as last shown (PC_SCORE ..), the vehicle's and the area's
ENDSECTION
PC_SCORE = 0 : PC_STEP = 3 : PC_TURN = 6 : PC_X = 9 : PC_Z = 12 : PC_Y = 15
PC_VEHICLE = 18 : PC_AREA = 19 : PC_BYTES = 20

\ panel_set: cell X to show A. Keeps A, X and Y. (In the section the
\ includer includes this file in, which must be main RAM's, below &3000:
\ code in any bank calls it.)
.panel_set
{
    CMP panel_want,X : BEQ same
    STA panel_want,X
    INC panel_gen
    CPX panel_left : BCS same
    STX panel_left                      ; (every cell before it is still shown as wanted)
.same
    RTS
}
ASSERT P% <= &3000

SECTION PanelData

\ panel_init: the picture unpacked into main RAM's buffer (screen_init has
\ cleared both) and copied into shadow RAM's, through PANEL_BOUNCE; every
\ cell shown as nothing, so every cell is drawn once it's wanted. With
\ interrupts off and ACCCON's X clear; leaves it clear.
.panel_init
{
    ZA_AUTO2 src, dst, from
    ZA_AUTO1 d
    LDA #ACCCON_X : TRB acccon
    LDA #LO(panel_packed) : STA src : LDA #HI(panel_packed) : STA src+1
    LDA #LO(SCREEN) : STA dst : LDA #HI(SCREEN) : STA dst+1
.token
    LDA dst+1 : BMI unpacked                    ; (at &8000)
    LDA (src) : TAY
    INCW src
    TYA : BMI match
    \ a run given: A + 1 bytes
    TAX : INX
.given
    LDA (src) : STA (dst)
    INCW src : INCW dst
    DEX : BNE given
    BRA token
.match
    \ a run copied: A - &80 + MATCH_MIN bytes from d back (0: 256)
    AND #&7F : CLC : ADC #PANEL_MATCH_MIN : TAX
    LDA (src) : STA d : INCW src
    LDA dst : SEC : SBC d : STA from
    LDA dst+1 : SBC #0 : STA from+1
    LDA d : BNE copy
    DEC from+1
.copy
    LDA (from) : STA (dst)
    INCW from : INCW dst
    DEX : BNE copy
    BRA token
.unpacked
    \ main RAM's buffer to shadow RAM's, a page at a time
    STZ dst : LDA #HI(SCREEN) : STA dst+1
.page
    LDA #ACCCON_X : TRB acccon
    LDY #0
.out
    LDA (dst),Y : STA PANEL_BOUNCE,Y
    INY : BNE out
    LDA #ACCCON_X : TSB acccon
.in
    LDA PANEL_BOUNCE,Y : STA (dst),Y
    INY : BNE in
    INC dst+1 : BPL page
    LDA #ACCCON_X : TRB acccon
    \ nothing shown, nothing wanted, no number
    LDX #PANEL_CELLS - 1
.cell
    LDA #&FF : STA panel_shown,X
    STZ panel_want,X
    DEX : BPL cell
    LDX #PC_BYTES - 1
.number
    STA panel_cache,X
    DEX : BPL number
    LDA #1 : STA panel_gen
    STZ panel_seen : STZ panel_left : STZ panel_free : STZ panel_behind
    RTS
}
ASSERT LO(SCREEN) = 0

\ panel_sync: each cell not shown as wanted drawn into both buffers, from
\ the first that may not be (panel_left: where the last stopped, or before
\ it the first panel_set has changed since), while the beam leaves time;
\ panel_left says where it stopped. Keeps ACCCON's X.
.panel_sync
{
    LDA panel_gen : CMP panel_seen : BNE changed
    RTS
.changed
    PHA
    LDX panel_left
    CPX #PANEL_CELLS : BEQ same_last    ; (nothing left: panel_left at its end)
.cell
    LDA panel_want,X : CMP panel_shown,X : BEQ same
    LDA panel_free : BNE draw
    LDA usrvia_t1ch                             ; (its high byte only: the low acknowledges)
    CMP #PANEL_T1_MIN : BCC stop
    CMP #HI(PANEL_T1_TOP) : BCS stop
.draw
    PHX
    JSR panel_draw
.drawn                                          ; (tools/livecheck.mjs times panel_draw to here)
    PLX
    LDA panel_want,X : STA panel_shown,X
.same
    INX : CPX #PANEL_CELLS : BNE cell
.same_last
    PLA : STA panel_seen
    STX panel_left
    RTS
.stop
    PLA
    STX panel_left
    RTS
}

\ panel_wait: panel_sync again and again, waiting for the beam, until
\ every cell below A is drawn.
.panel_wait
{
    ZA_AUTO1 limit
    STA limit
.again
    JSR panel_sync
    LDA panel_left : CMP limit : BCC again
    RTS
}

\ panel_catch_up: panel_sync, or panel_wait for every cell once the panel
\ has been behind for PANEL_PATIENCE calls.
.panel_catch_up
{
    JSR panel_sync
    LDA panel_left : CMP #PANEL_CELLS : BEQ caught
    INC panel_behind
    LDA panel_behind : CMP #PANEL_PATIENCE : BCC behind
.waiting                                        ; (tools/livecheck.mjs counts these)
    LDA #PANEL_CELLS : JSR panel_wait
.caught
    STZ panel_behind
.behind
    RTS
}

\ panel_flush: every cell drawn, whatever the beam: before the interrupt
\ is on, when nothing is shown that matters.
.panel_flush
    LDA #1 : STA panel_free
    JSR panel_sync
    STZ panel_free
    RTS

\ panel_draw: cell X's wanted value into both buffers; ACCCON's X as it
\ was. A glyph cell: each line's nibble (bit 3 the leftmost pixel) as two
\ bytes, each pixel the kind's ink for the line where it's lit, else its
\ paper: paper EOR ((paper EOR ink) AND mask), the kind keeping paper and
\ paper EOR ink a line; a tile: its eight bytes.
.panel_draw
{
    ZA_AUTO2 at, right, g, diff, paper
    ZA_AUTO1 h, was, v
    LDA pc_lo,X : STA at
    LDA pc_hi,X : STA at+1
    LDA panel_want,X : STA v
    LDA acccon : AND #ACCCON_X : STA was
    CPX #PANEL_GLYPHS : BCC glyph
    \ a tile: pv_data + 8 v
    STZ g+1
    LDA v : ASL A : ROL g+1 : ASL A : ROL g+1 : ASL A : ROL g+1
    CLC : ADC #LO(pv_data) : STA g
    LDA g+1 : ADC #HI(pv_data) : STA g+1
    LDA #ACCCON_X : TSB acccon
    JSR tile
    LDA #ACCCON_X : TRB acccon
    JSR tile
    LDA was : BEQ main
    TSB acccon
.main
    RTS
.glyph
    LDY pc_kind,X
    LDA pk_h,Y : STA h
    LDA pk_dlo,Y : STA diff : LDA pk_dhi,Y : STA diff+1
    LDA pk_plo,Y : STA paper : LDA pk_phi,Y : STA paper+1
    LDA pk_tlo,Y : STA g : LDA pk_thi,Y : STA g+1
    LDX pk_stride,Y                             ; g + v stride
.stride
    LDA g : CLC : ADC v : STA g
    BCC next_stride
    INC g+1
.next_stride
    DEX : BNE stride
    \ the right column's address
    LDA at : CLC : ADC #8 : STA right
    LDA at+1 : ADC #0 : STA right+1
    \ the cell's lines, the last first: each line's two bytes into the
    \ buffer X selects now, and kept for the other's
    LDY h : DEY
.line
    LDA (g),Y : TAX
    LDA (diff),Y : AND mask_left,X : EOR (paper),Y
    STA (at),Y : STA panel_lines,Y
    LDA (diff),Y : AND mask_right,X : EOR (paper),Y
    STA (right),Y : STA panel_lines + PANEL_MAX_H,Y
    DEY : BPL line
    \ then into the other buffer, and X back as it was
    LDA #ACCCON_X
    BIT was : BNE was_set
    TSB acccon
    JSR put
    LDA #ACCCON_X : TRB acccon
    RTS
.was_set
    TRB acccon
    JSR put
    LDA #ACCCON_X : TSB acccon
    RTS
\ put: the cell's lines at at and right, down their byte columns, into the
\ buffer X selects (every cell is inside a character row: tools/mkpanel.py
\ checks).
.put
    LDY h : DEY
.put_line
    LDA panel_lines,Y : STA (at),Y
    LDA panel_lines + PANEL_MAX_H,Y : STA (right),Y
    DEY : BPL put_line
    RTS
\ tile: the tile's eight bytes down its byte column, into the buffer X selects
.tile
    LDY #7
.tile_line
    LDA (g),Y : STA (at),Y
    DEY : BPL tile_line
    RTS
\ A line's four pixels (a nibble, bit 3 the leftmost) as the left byte's
\ mask and the right's.
.mask_left
    FOR n = 0..15
        EQUB WHERE((n AND 8) <> 0, PIX_LEFT, 0) OR WHERE((n AND 4) <> 0, PIX_RIGHT, 0)
    NEXT
.mask_right
    FOR n = 0..15
        EQUB WHERE((n AND 2) <> 0, PIX_LEFT, 0) OR WHERE((n AND 1) <> 0, PIX_RIGHT, 0)
    NEXT
}

\ ---------------------------------------------------------------------------
\ The values (tools/model/panel.py's values_of and cells(), from the
\ original's $B72B): panel_values sets every field but the frames a second
\ (and with PANEL_FREE the message) from the logic's variables, with the
\ area's name panel_area's (the area the view shows, its index in the
\ records' directory). Called with this bank paged.

SECTION Work
.panel_area     SKIP 1              ; the area whose name shows
.panel_over     SKIP 1              ; non-zero: the game's over (the message says so)
ENDSECTION

.panel_values
{
    ZA_AUTO1 t
    ZA_AUTO2 nm
    \ the score: 24 bits, seven digits
    LDA Score : STA panel_num : LDA Score+1 : STA panel_num+1 : LDA Score+2 : STA panel_num+2
    LDX #PF_SCORE : LDY #PC_SCORE : LDA #PN_SCORE : JSR panel_number
    \ the step: three digits; the turn, in degrees: two, and the sign
    LDA Step : JSR panel_byte
    LDX #PF_STEP : LDY #PC_STEP : LDA #PN_STEP : JSR panel_number
    LDA Turn : ASL A : ASL A : CLC : ADC Turn : JSR panel_byte    ; (5 Turn, a byte, as $B7C9)
    LDX #PF_TURN : LDY #PC_TURN : LDA #PN_TURN - 1 : JSR panel_number
    LDA #PC_DEGREE : JSR panel_set
    \ the position, over the area's scale: x, z, y
    LDA PANEL_POS : STA panel_num : LDA PANEL_POS+1 : STA panel_num+1
    LDX #PF_X : LDY #PC_X : JSR position
    LDA PANEL_POS+4 : STA panel_num : LDA PANEL_POS+5 : STA panel_num+1
    LDX #PF_Z : LDY #PC_Z : JSR position
    LDA PANEL_POS+2 : STA panel_num : LDA PANEL_POS+3 : STA panel_num+1
    LDX #PF_Y : LDY #PC_Y : JSR position
    \ the energy and shield
    LDA Energy : LDX #PF_ENERGY : JSR panel_bar
    LDA Shield : LDX #PF_SHIELD : JSR panel_bar
    \ the heading: the tape's window (yaw - span + 4 i) mod 72, but where
    \ the original's compass doesn't turn ($B83B)
IF NOT(PANEL_FREE)
    LDA AreaId
    FOR i = 0..<LEN(PANEL_NO_COMPASS)
        CMP #PANEL_NO_COMPASS[i] : BEQ no_compass
    NEXT
ENDIF
    LDA PANEL_YAW : JSR mod_turn
    SEC : SBC #PANEL_HEADING_SPAN : BCS heading
    ADC #STEPS_TURN
.heading
    LDX #PF_HEADING
    LDY #PN_HEADING
.heading_cell
    JSR panel_set
    CLC : ADC #4 : CMP #STEPS_TURN : BCC heading_next
    SBC #STEPS_TURN
.heading_next
    INX : DEY : BNE heading_cell
.no_compass
    \ the pitch: both columns' cells, (2 pitch - mid + h j) mod lines
    LDA PANEL_PITCH : JSR mod_turn
    ASL A : SEC : SBC #PANEL_PITCH_MID : BCS pitch
    ADC #PANEL_PITCH_LINES
.pitch
    LDX #PF_PITCH0
    LDY #PN_PITCH0
.pitch_cell
    JSR panel_set
    PHA : TXA : CLC : ADC #PF_PITCH1 - PF_PITCH0 : TAX : PLA
    JSR panel_set
    PHA : TXA : SEC : SBC #PF_PITCH1 - PF_PITCH0 - 1 : TAX : PLA
    CLC : ADC #PANEL_PITCH_H : CMP #PANEL_PITCH_LINES : BCC pitch_next
    SBC #PANEL_PITCH_LINES
.pitch_next
    DEY : BNE pitch_cell
    \ the vehicle: the jet's picture and name, or the probe's and its
    \ extension's (ExtLevel, 1 to 4)
    LDA InJet : BEQ probe
    LDA #PANEL_JET
    BRA vehicle
.probe
    LDA ExtLevel : BNE some
    LDA #1
.some
    CMP #5 : BCC vehicle
    LDA #4
.vehicle
    CMP panel_cache + PC_VEHICLE : BEQ lights   ; (as last shown)
    STA panel_cache + PC_VEHICLE
    STA t
    \ its name: pm_vehicle + 5 t
    ASL A : ASL A : CLC : ADC t : TAY
    LDX #PF_VEHICLE
.vname
    LDA pm_vehicle,Y : JSR panel_set
    INY : INX : CPX #PF_VEHICLE + PN_VEHICLE : BNE vname
    \ its picture
    LDX #PF_PICTURE
    LDY #0
    LDA t : CMP #PANEL_JET : BNE probe_tiles
.jet_tiles
    LDA pv_jet,Y : JSR panel_set
    INX : INY : CPY #PN_PICTURE : BNE jet_tiles
    BRA lights
.probe_tiles
    LDA pv_probe,Y : JSR panel_set
    INX : INY : CPY #PN_PICTURE : BNE probe_tiles
.lights
    \ the lights: the crosshair, and shooting mode
    LDX #PF_CROSS
    LDA CrossOn : JSR light
    LDX #PF_SHOOT
    LDA ShootMode : JSR light
    \ the area's name
    LDA panel_area : CMP #PANEL_AREAS : BCS no_name
    CMP panel_cache + PC_AREA : BEQ no_name     ; (as last shown)
    STA panel_cache + PC_AREA
    JSR names
IF NOT(PANEL_FREE)
    \ the end's area: the safe sectors (FclVar32) in its name, two digits,
    \ the first a space for 0, as the end writes them ($9B11)
    LDA panel_area : CMP #PANEL_END_AREA : BNE no_name
    LDA FclVar32
.hundreds
    CMP #100 : BCC tens
    SBC #100
    BRA hundreds
.tens
    LDY #PC_DIGIT0
.ten
    CMP #10 : BCC units
    SBC #10 : INY
    BRA ten
.units
    ADC #PC_DIGIT0                              ; (C clear)
    LDX #PF_NAME + PANEL_END_DIGITS + 1 : JSR panel_set
    TYA : CMP #PC_DIGIT0 : BNE tens_digit
    LDA #PC_SPACE
.tens_digit
    LDX #PF_NAME + PANEL_END_DIGITS : JSR panel_set
ENDIF
.no_name
IF NOT(PANEL_FREE)
    \ the message: one of a rig's while it shows (src/live.6502's
    \ lv_messages: ASCII, as the original's, into the font's places) ...
    LDA lv_msg_on : BEQ no_rig
    TAY : LDA panel_msg_at - 1,Y : TAY
    LDX #PF_MESSAGE
.rig_cell
    LDA lv_msgs,Y
    CMP #'A' : BCC rig_not_letter
    SBC #'A' - PC_LETTER_A
    BRA rig_glyph
.rig_not_letter
    CMP #'0' : BCC rig_not_digit
    SBC #'0' - PC_DIGIT0
    BRA rig_glyph
.rig_not_digit
    CMP #'%' : BNE rig_space
    LDA #PC_PERCENT
    BRA rig_glyph
.rig_space
    LDA #PC_SPACE
.rig_glyph
    JSR panel_set
    INY : INX : CPX #PF_MESSAGE + PN_MESSAGE : BNE rig_cell
    JMP valued
.no_rig
    \ ... else the game's end; or the area's gas, as $B76C
    LDY #LO(pm_over - pm_neutral)
    LDA panel_over : BNE message
    LDY #0                                      ; (pm_neutral)
    LDA AreaId : SEC : SBC #PANEL_NEUTRAL_FROM : BPL message
    LDA AreaId : TAX : DEX
    LDY #LO(pm_build - pm_neutral)
    LDA RigPlaced,X : CMP #PANEL_CLEARED : BNE message
    LDY #LO(pm_cleared - pm_neutral)
.message
    LDX #PF_MESSAGE
.message_cell
    LDA pm_neutral,Y : JSR panel_set
    INY : INX : CPX #PF_MESSAGE + PN_MESSAGE : BNE message_cell
ENDIF
.valued                                         ; (tools/livecheck.mjs: the panel's values are set)
    RTS
\ position: panel_num's word over AreaScale, four digits, into cells X
\ on (its place in panel_cache Y)
.position
    PHY
    LDA AreaScale : JSR panel_divide
    PLY
    STZ panel_num+2
    LDA #PN_X : JMP panel_number
\ light: cell X on if A isn't 0
.light
    BEQ off
    LDA #1
.off
    JMP panel_set
\ names: area A's name, into the name's cells: pa_names + PANEL_MESSAGE A
.names
    TAX
    LDA #LO(pa_names) : STA nm : LDA #HI(pa_names) : STA nm+1
    TXA : BEQ names_go
.names_add
    LDA nm : CLC : ADC #PANEL_MESSAGE : STA nm
    BCC names_more
    INC nm+1
.names_more
    DEX : BNE names_add
.names_go
    LDY #0
    LDX #PF_NAME
.names_cell
    LDA (nm),Y : JSR panel_set
    INY : INX : CPX #PF_NAME + PN_NAME : BNE names_cell
    RTS
}
ASSERT pm_over - pm_neutral < 256 AND pm_build - pm_neutral < 256 AND pm_cleared - pm_neutral < 256
ASSERT PN_MESSAGE = PANEL_MESSAGE AND PN_NAME = PANEL_MESSAGE AND PN_X = 4 AND PN_Y = 4 AND PN_Z = 4
ASSERT PN_PITCH0 = PN_PITCH1 AND PF_PITCH1 > PF_PITCH0 AND PN_VEHICLE = 5

\ mod_turn: A mod STEPS_TURN. Keeps X and Y.
.mod_turn
{
.again
    CMP #STEPS_TURN : BCC done
    SBC #STEPS_TURN
    BRA again
.done
    RTS
}

\ panel_byte: A into panel_num (24 bits).
.panel_byte
    STA panel_num : STZ panel_num+1 : STZ panel_num+2
    RTS

\ panel_divide: panel_num's word over A (from 1), in place. Keeps X.
.panel_divide
{
    ZA_AUTO1 dv
    CMP #2 : BCC done                           ; (most areas' scale is 1; 0 taken as 1)
    STA dv
    LDA #0
    LDY #16
.bit
    ASL panel_num : ROL panel_num+1
    ROL A
    BCS take                                    ; (over a byte: more than dv)
    CMP dv : BCC next
.take
    SBC dv                                      ; (C is set)
    INC panel_num                               ; (its low bit, 0 after the shift)
.next
    DEY : BNE bit
.done
    RTS
}

\ panel_number: panel_num (24 bits) as A digits, leading zeros, its low
\ ones if it's longer (as the original's $9390), into cells X on; X ends
\ past them. Y is the number's place in panel_cache, which keeps the
\ number last shown there: the same number again leaves its cells as they
\ are (panel_init fills the cache with &FF, which no number has: the score
\ stops at &7FFFFF, the rest are words).
.panel_number
{
    ZA_AUTO1 n, k
    STA n
    LDA panel_num : CMP panel_cache,Y : BNE changed
    LDA panel_num+1 : CMP panel_cache+1,Y : BNE changed
    LDA panel_num+2 : CMP panel_cache+2,Y : BNE changed
    TXA : CLC : ADC n : TAX
    RTS
.changed
    LDA panel_num : STA panel_cache,Y
    LDA panel_num+1 : STA panel_cache+1,Y
    LDA panel_num+2 : STA panel_cache+2,Y
    \ panel_num mod 10^n: POWERS[7 - n] is 10^n
    LDA #7 : SEC : SBC n : TAY
    JSR times
.digit
    INY
    JSR times
    CLC : ADC #PC_DIGIT0 : JSR panel_set
    INX
    DEC n : BNE digit
    RTS
\ times: how many of POWERS[Y] panel_num holds, taken away, in A
.times
    STZ k
.again
    LDA panel_num : CMP pw_lo,Y
    LDA panel_num+1 : SBC pw_mid,Y
    LDA panel_num+2 : SBC pw_hi,Y
    BCC enough
    LDA panel_num : SBC pw_lo,Y : STA panel_num        ; (C is set)
    LDA panel_num+1 : SBC pw_mid,Y : STA panel_num+1
    LDA panel_num+2 : SBC pw_hi,Y : STA panel_num+2
    INC k
    BRA again
.enough
    LDA k
    RTS
.pw_lo  EQUB LO(POWERS)
.pw_mid EQUB HI(POWERS)
.pw_hi  EQUB (POWERS >> 16) AND &FF
}
POWERS = {10000000, 1000000, 100000, 10000, 1000, 100, 10, 1}

\ panel_bar: a bar of energy or shield A, into cells X on: the pixels it
\ lights, (min(A, PANEL_BAR_MAX) 3 + 7) >> 3, four a cell from the left.
.panel_bar
{
    CMP #PANEL_BAR_MAX + 1 : BCC fits
    LDA #PANEL_BAR_MAX
.fits
    STA panel_num : ASL A : CLC : ADC panel_num : ADC #7
    LSR A : LSR A : LSR A
    LDY #PN_SHIELD
.cell
    CMP #4 : BCC part
    PHA : LDA #4 : JSR panel_set : PLA
    SEC : SBC #4
    BRA next
.part
    JSR panel_set
    LDA #0
.next
    INX : DEY : BNE cell
    RTS
}
ASSERT PN_SHIELD = PN_ENERGY AND PANEL_BAR_MAX * 3 + 7 < 256

\ panel_blank: the frames a second's cells blank, until there are figures.
.panel_blank
{
    LDX #PF_FPS
    LDA #PC_SPACE
.cell
    JSR panel_set
    INX : CPX #PF_FPS + PN_FPS : BNE cell
    RTS
}

ENDSECTION

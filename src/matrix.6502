\ ***************************************************************************
\ FREESCAPE for the BBC Master - the camera's matrix (docs/engine.md, stage
\ 1; tools/model/matrix.py)
\
\ M = Rroll (Rpitch Ryaw), nine signed bytes, 1.0 = 64, row-major (camera
\ x, y, z), from the original's sine table; each product's sums plus 32,
\ shifted right six (rounding half up) to a byte, as the model and the
\ original compose. Written out, with s and c the angles' sines and
\ cosines and r() that rounding:
\
\   Rpitch Ryaw = [[cy, 0, -sy], [r(sp sy), cp, r(sp cy)], [r(cp sy), -sp, r(cp cy)]]
\   M's row 0   = r(cr PY0 + sr PY1), row 1 = r(cr PY1 - sr PY0), row 2 = PY2
\
\ (a product with the 64 of an identity rotation rounds back to itself, so
\ the first row and the last are exact). That's 14 products of bytes each
\ within -64..64, by quarter squares: a b = f(|a + b|) - f(|a - b|), f(n) =
\ n * n DIV 4.
\
\ Entry points:
\   matrix_update   the matrix for cam_yaw, cam_pitch, cam_roll, built if
\                   an angle changed since the last build (and the
\                   transform's cache then emptied); C set if it was built
\   andy_matrix_build  the matrix built (matrix_build, which is in ANDY: a
\                   build is a turn's alone; src/transform.6502's ANDY_CALL)
\ ***************************************************************************

SECTION ObjWork
.cam_x      SKIP 2                  ; the camera: the eye, in world units, 16-bit
.cam_y      SKIP 2
.cam_z      SKIP 2
.cam_yaw    SKIP 1                  ; 0-71, 5 degrees a step
.cam_pitch  SKIP 1
.cam_roll   SKIP 1
.mat        SKIP 9                  ; M, row-major, signed bytes
.mat_angles SKIP 3                  ; the yaw, pitch and roll it was built for
.mat_valid  SKIP 1                  ; non-zero once built
.mat_big    SKIP 1                  ; non-zero if an entry is beyond -64..64
.mat_tilt   SKIP 1                  ; 0 for a level camera's: y row and column (0, 64, 0); else &FF
.im_fx0     SKIP 3                  ; FX M0k, by the column k, 24-bit signed (im_cols) ...
.im_fx1     SKIP 3
.im_fx2     SKIP 3
.im_fy0     SKIP 3                  ; ... and FY M1k
.im_fy1     SKIP 3
.im_fy2     SKIP 3
ENDSECTION

M00 = mat + 0 : M01 = mat + 1 : M02 = mat + 2
M10 = mat + 3 : M11 = mat + 4 : M12 = mat + 5
M20 = mat + 6 : M21 = mat + 7 : M22 = mat + 8

SECTION ObjCode

\ matrix_update: build the matrix if the angles aren't the last build's.
.matrix_update
{
    ZA_ENTRY
    LDA mat_valid : BEQ build
    LDA cam_yaw : CMP mat_angles : BNE build
    LDA cam_pitch : CMP mat_angles+1 : BNE build
    LDA cam_roll : CMP mat_angles+2 : BNE build
    CLC
    RTS
.build
    LDA cam_yaw : STA mat_angles
    LDA cam_pitch : STA mat_angles+1
    LDA cam_roll : STA mat_angles+2
    LDA #1 : STA mat_valid
    JSR andy_matrix_build
    JSR bound_patch
    JSR fill_patch
    JSR cache_empty
    SEC
    RTS
}

\ mmul: mp (16-bit signed) = A times Y, signed bytes each within -64..64.
\ Clobbers A, X, Y.
.mmul
{
    STY mm_b : STA mm_a
    CLC : ADC mm_b
    BPL sum_pos
    EOR #&FF : INC A                ; |a + b| (128 stays 128)
.sum_pos
    TAX
    LDA mm_a : SEC : SBC mm_b
    BPL diff_pos
    EOR #&FF : INC A
.diff_pos
    TAY
    LDA msq_lo,X : SEC : SBC msq_lo,Y : STA mp
    LDA msq_hi,X : SBC msq_hi,Y : STA mp+1
    RTS
}
ZA_AUTO1 mm_a, mm_b
ZA_AUTO2 mp

\ MMUL a, b: mp = a b (mmul), a and b in zero page
MACRO MMUL a, b
    LDY b : LDA a : JSR mmul
ENDMACRO

\ mround: mp's (v + 32) >> 6 in A, which must fit a signed byte.
.mround
    LDA mp : CLC : ADC #32 : STA mp
    LDA mp+1 : ADC #0 : STA mp+1
    LDA mp
    ASL A : ROL mp+1
    ASL A : ROL mp+1
    LDA mp+1
    RTS
MACRO MROUND
    JSR mround
ENDMACRO

\ MADD acc: mp added to acc (16-bit).
MACRO MADD acc
    LDA acc : CLC : ADC mp : STA acc
    LDA acc+1 : ADC mp+1 : STA acc+1
ENDMACRO

ENDSECTION
SECTION ObjMore
.andy_matrix_build
    ANDY_CALL matrix_build
ENDSECTION
SECTION ObjAndy

\ matrix_build: M from mat_angles (and the transform's M c no longer for
\ it: mc_valid). (mmul and mround are the bank's, past its first 4K.)
.matrix_build
{
    ZA_ENTRY
    ZA_AUTO1 sy, cy, sp, cp, sr, cr, py10, py12, nsy
    ZA_AUTO2 acc
    STZ mc_valid
    LDX mat_angles : LDA sin_table,X : STA sy : LDA cos_table,X : STA cy
    LDX mat_angles+1 : LDA sin_table,X : STA sp : LDA cos_table,X : STA cp
    LDX mat_angles+2 : LDA sin_table,X : STA sr : LDA cos_table,X : STA cr
    LDA #0 : SEC : SBC sy : STA nsy
    LDA mat_angles+1 : ORA mat_angles+2 : BNE composed
    \ pitch and roll 0, whose rotations are 64 times the identity (the
    \ table's sine and cosine of 0 are 0 and 64), which the rounding gives
    \ back: M is the yaw's own (the matrix check has every yaw so)
    LDA cy : STA M00 : STA M22
    LDA nsy : STA M02
    LDA sy : STA M20
    STZ M01 : STZ M10 : STZ M12 : STZ M21
    LDA #64 : STA M11
    \ and so a level camera's, every entry within -64..64
    STZ mat_big : STZ mat_tilt
    JMP im_cols.im_level
.composed
    \ Rpitch Ryaw's middle row (its first is cy, 0, -sy) and its last,
    \ which is M's
    MMUL sp, sy : MROUND : STA py10
    MMUL sp, cy : MROUND : STA py12
    MMUL cp, sy : MROUND : STA M20
    LDA #0 : SEC : SBC sp : STA M21
    MMUL cp, cy : MROUND : STA M22
    \ row 0: cr PY0 + sr PY1
    MMUL cr, cy : LDA mp : STA acc : LDA mp+1 : STA acc+1
    MMUL sr, py10 : MADD acc
    LDA acc : STA mp : LDA acc+1 : STA mp+1 : MROUND : STA M00
    MMUL sr, cp : MROUND : STA M01
    MMUL cr, nsy : LDA mp : STA acc : LDA mp+1 : STA acc+1
    MMUL sr, py12 : MADD acc
    LDA acc : STA mp : LDA acc+1 : STA mp+1 : MROUND : STA M02
    \ row 1: cr PY1 - sr PY0
    MMUL cr, py10 : LDA mp : STA acc : LDA mp+1 : STA acc+1
    MMUL sr, cy
    LDA acc : SEC : SBC mp : STA mp : LDA acc+1 : SBC mp+1 : STA mp+1
    MROUND : STA M10
    MMUL cr, cp : MROUND : STA M11
    MMUL cr, py12 : LDA mp : STA acc : LDA mp+1 : STA acc+1
    MMUL sr, nsy
    LDA acc : SEC : SBC mp : STA mp : LDA acc+1 : SBC mp+1 : STA mp+1
    MROUND : STA M12
    JSR im_cols
    \ mat_big: an entry beyond 64 either way (src/transform.6502's fills)
    STZ mat_big
    LDX #8
.big
    LDA mat,X : BPL positive
    EOR #&FF : INC A
.positive
    CMP #65 : BCC small
    STA mat_big
.small
    DEX : BPL big
    \ mat_tilt: 0 if M's y row and column are (0, 64, 0), every entry within
    \ -64..64 (a level camera: pitch and roll 0), else &FF
    LDA #&FF : STA mat_tilt
    LDA mat_big : ORA M01 : ORA M10 : ORA M12 : ORA M21 : BNE done
    LDA M11 : CMP #64 : BNE done
    STZ mat_tilt
.done
    RTS
}

\ im_cols: for each column k of M, FX M0k and FY M1k (im_fx*, im_fy*), which
\ the cone's lines from images take (src/clip.6502's image_edge): 317 m from
\ mmul's 61 m and 256 m, then times 4, or 8.
.im_cols
{
    ZA_AUTO1 k
    LDX #2
.column
    STX k
    LDA mat,X : JSR im_317
    ASL im_t : ROL im_t+1 : ROL im_t+2
    ASL im_t : ROL im_t+1 : ROL im_t+2
    LDX k
    LDA im_t : STA im_fx0,X
    LDA im_t+1 : STA im_fx1,X
    LDA im_t+2 : STA im_fx2,X
    LDA mat+3,X : JSR im_317
    ASL im_t : ROL im_t+1 : ROL im_t+2
    ASL im_t : ROL im_t+1 : ROL im_t+2
    ASL im_t : ROL im_t+1 : ROL im_t+2
    LDX k
    LDA im_t : STA im_fy0,X
    LDA im_t+1 : STA im_fy1,X
    LDA im_t+2 : STA im_fy2,X
    DEX : BPL column
    RTS
\ im_level: the same for a level camera's M, whose y row and column are
\ (0, 64, 0): FY 64 down the middle, FX M00 and FX M02 across the top
.im_level
    STZ im_fx0+1 : STZ im_fx1+1 : STZ im_fx2+1
    STZ im_fy0 : STZ im_fy1 : STZ im_fy2
    STZ im_fy0+2 : STZ im_fy1+2 : STZ im_fy2+2
    LDA #LO(VIEW_FY * 64) : STA im_fy0+1
    LDA #HI(VIEW_FY * 64) : STA im_fy1+1
    LDA #(VIEW_FY * 64) >> 16 : STA im_fy2+1
    LDX #0
.level_column
    STX k
    LDA mat,X : JSR im_317
    ASL im_t : ROL im_t+1 : ROL im_t+2
    ASL im_t : ROL im_t+1 : ROL im_t+2
    LDX k
    LDA im_t : STA im_fx0,X
    LDA im_t+1 : STA im_fx1,X
    LDA im_t+2 : STA im_fx2,X
    INX : INX : CPX #4 : BNE level_column
    RTS
\ im_317: im_t (24-bit) = 317 A, A an entry of M
.im_317
    PHA
    LDY #61 : JSR mmul                  ; (|A| + 61 within msq's 128)
    PLA : CLC : ADC mp+1 : STA im_t+1
    LDA mp : STA im_t
    LDA im_t+1 : ASL A
    LDA #0 : ADC #&FF : EOR #&FF        ; (its sign, extended)
    STA im_t+2
    RTS
}
ZA_AUTO 4, im_t                         ; (src/clip.6502's image lines' too)
ASSERT 317 * 65 < &8000 AND 4 * 317 = VIEW_FX AND 8 * 317 = VIEW_FY   ; (317 m fits 16 bits)
ASSERT im_fx1 = im_fx0 + 3 AND im_fx2 = im_fx1 + 3 AND im_fy1 = im_fy0 + 3 AND im_fy2 = im_fy1 + 3

\ (the bank's, past its first 4K, as matrix_build calls it from ANDY)
ENDSECTION
SECTION ObjCode

\ BP_SITE site, f, k: bound_box's term for bound f on axis k, at site,
\ patched for the coefficient bp_p: its products' bases (f(u + phi) from sq
\ at phi when phi >= 0, else from ng, f(j - 255), at 255 + phi; f(u - phi)
\ likewise at -phi, a base of ng's at 255 serving for 0), the cell it reads
\ (the box's high one on axis k when phi is positive, else its low), and for
\ a term past the bound's first, whether it's skipped (a phi of 0) or
\ counted in bb_bias.
MACRO BP_SITE site, f, k
    LDA bp_p+1 : BMI neg
    LDA bp_p
    STA site + BB_A0 : STA site + BB_A0 + BB_HI
    EOR #&FF                                        ; 255 - phi
    STA site + BB_B0 : STA site + BB_B0 + BB_HI
    LDA #HI(sq_lo) : STA site + BB_A0 + 1
    LDA #HI(sq_hi) : STA site + BB_A0 + BB_HI + 1
    LDA #HI(ng_lo) : STA site + BB_B0 + 1
    LDA #HI(ng_hi) : STA site + BB_B0 + BB_HI + 1
    LDA #LO(bb_lo + k)
    LDY bp_p : BEQ cell
    LDA #LO(bb_hi + k)
    BRA cell
.neg
    LDA bp_p : DEC A                                ; 255 + phi
    STA site + BB_A0 : STA site + BB_A0 + BB_HI
    EOR #&FF                                        ; -phi
    STA site + BB_B0 : STA site + BB_B0 + BB_HI
    LDA #HI(ng_lo) : STA site + BB_A0 + 1
    LDA #HI(ng_hi) : STA site + BB_A0 + BB_HI + 1
    LDA #HI(sq_lo) : STA site + BB_B0 + 1
    LDA #HI(sq_hi) : STA site + BB_B0 + BB_HI + 1
    LDA #LO(bb_lo + k)
.cell
    STA site + BB_UX
    IF k > 0
        LDA bp_p : ORA bp_p+1 : BEQ skip
        LDA bb_bias + f : CLC : ADC #&20 : STA bb_bias + f
        LDA #0
        BRA put
    .skip
        LDA #BB_SKIP
    .put
        STA site + BB_SK
    ENDIF
ENDMACRO

\ bound_patch: bound_box's terms (src/transform.6502's "The bounds") for M,
\ as it's built: term k of bound f takes f's coefficient on M's column k,
\ L 3 M0k + 2 M2k, R 2 M2k - 3 M0k, T M2k - 3 M1k, in 16 bits (each within
\ 255 either way: the model asserts, render.BOUND_PHI).
.bound_patch
{
    ZA_AUTO2 a3, b3, c1, c2
    \ each bound's bias: 64 times &8000 a term, the top byte's &20
    LDA #&20 : STA bb_bias : STA bb_bias+1 : STA bb_bias+2
    ASSERT BD_N = 3
    FOR k = 0..2
        IF k = 1
            \ a level camera's middle column, (0, 64, 0): L's and R's terms
            \ 0, skipped, and T's -192, as the last level camera's patch
            \ left them (bp_level)
            LDA mat_tilt : BNE column
            LDA bp_level : BEQ column
            LDA bb_bias + BD_T : CLC : ADC #&20 : STA bb_bias + BD_T
            JMP column_done
        .column
        ENDIF
        LDA mat + k : JSR times3 : STA a3 : STY a3+1
        LDA mat + 3 + k : JSR times3 : STA b3 : STY b3+1
        LDA mat + 6 + k : JSR widen : STA c1 : STY c1+1
        ASL A : STA c2
        TYA : ROL A : STA c2+1
        \ L: c2 + a3
        LDA c2 : CLC : ADC a3 : STA bp_p
        LDA c2+1 : ADC a3+1 : STA bp_p+1
        BP_SITE WHERE(k = 0, bb_t00, WHERE(k = 1, bb_t01, bb_t02)), BD_L, k
        \ R: c2 - a3
        LDA c2 : SEC : SBC a3 : STA bp_p
        LDA c2+1 : SBC a3+1 : STA bp_p+1
        BP_SITE WHERE(k = 0, bb_t10, WHERE(k = 1, bb_t11, bb_t12)), BD_R, k
        \ T: c1 - b3
        LDA c1 : SEC : SBC b3 : STA bp_p
        LDA c1+1 : SBC b3+1 : STA bp_p+1
        BP_SITE WHERE(k = 0, bb_t20, WHERE(k = 1, bb_t21, bb_t22)), BD_T, k
        IF k = 1
        .column_done
        ENDIF
    NEXT
    \ (whether the middle column's terms are a level camera's)
    LDA mat_tilt : EOR #&FF : STA bp_level
    RTS
\ widen: A, Y = the signed byte A as 16 bits (low, high)
.widen
    LDY #0
    CMP #&80 : BCC positive
    DEY
.positive
    RTS
\ times3: A, Y = 3 times the signed byte A, 16 bits (low, high)
.times3
    JSR widen
    STA b_t : STY b_t+1
    ASL A : STA b_u
    TYA : ROL A : STA b_u+1
    LDA b_t : CLC : ADC b_u : PHA
    LDA b_t+1 : ADC b_u+1 : TAY
    PLA
    RTS
}
ZA_AUTO2 b_t, b_u, bp_p
ASSERT BD_L = 0 AND BD_R = 1 AND BD_T = 2
ASSERT HI(bb_lo) = HI(bb_hi + 2)                ; (only a cell's low byte is patched)

ENDSECTION
ASSERT mmul >= obj_andy_reach AND mround >= obj_andy_reach   ; (matrix_build's, from ANDY)

SECTION ObjConst
\ Quarter squares for MMUL: n * n DIV 4, n = 0..128.
.msq_lo
    EQUB LO((0..128) * (0..128) DIV 4)
.msq_hi
    EQUB HI((0..128) * (0..128) DIV 4)
ENDSECTION

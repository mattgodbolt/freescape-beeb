\ ***************************************************************************
\ FREESCAPE for the BBC Master - a candidate's faces: the near clip, the
\ guard band, the projection and the 2D clip (docs/engine.md, stages 4-6;
\ tools/model/clip.py, and render.py's draw_faces, which this follows step
\ for step)
\
\ For each face the camera sees, in its object's face order:
\
\ - the near clip: if a vertex is nearer than ZNEAR, the face is clipped
\   against that plane in 3D (Sutherland-Hodgman; a line as a segment),
\   each new coordinate the model's round_div exactly (umul32, rdiv);
\   nothing left means it isn't drawn;
\ - the guard band (decision 17): a face with a vertex outside |X| <= 16 Z
\   or |Y| <= 8 Z is clipped against those planes in 3D, by crossings;
\ - each vertex projected (the maths' project), and its outcode against the
\   view's rectangle found from the projection (the model's outcode2d); a
\   face with every vertex beyond one edge isn't drawn;
\ - a line widened to the quad a one-pixel line covers, a point to its
\   pixel's square;
\ - the 2D clip against the view's rectangle if a vertex was beyond an edge
\   or the face was widened, by crossings; else repeated vertices dropped;
\ - drawn if three or more vertices are left, not all on one line.
\
\ A crossing (the model's crossing_t and lerp) is one fraction t =
\ floor(2^16 f_P / (f_P - f_Q)) from the edge's inside end P (frac16), and
\ each coordinate P + (Q - P) t / 2^16 rounded half up (lerp).
\
\ A vertex the object's faces share is tested against the guard band and
\ projected once (vflag's VF_* bits say which it has been). The clips' new
\ vertices are vertices VMAX onwards of the same arrays, made afresh for
\ each face. After the guard band every projection fits 16 bits, so the
\ 2D polygons are 16-bit.
\
\ A drawn face's polygon goes into the output's vertices (out_vx*, out_vy*:
\ view coordinates, 16-bit) and its record into tf_* in the order found;
\ emit_faces (src/order.6502) puts the records in out_f* nearest first.
\
\ Entry point:
\   draw_object   the candidate of_cand (slot of_slot), its vertices
\                 transformed: its drawn faces in tf_*, and the object on
\                 the draw list (dl_*) if any is. Needs the maths' tables
\                 readable.
\ ***************************************************************************

NPOLY       = 16                    ; a 3D polygon's vertices, at most
NP2         = 20                    ; a 2D polygon's, at most
OUT_FACES   = 128                   ; faces a frame draws, at most
OUT_VERTS   = 256                   ; their vertices
OC_LEFT = 2 : OC_RIGHT = 4 : OC_TOP = 8 : OC_BOTTOM = 16
VF_NEAR     = &80                   ; vflag: nearer than ZNEAR (transform_object's)
VF_GTEST    = &40                   ; ... tested against the guard band ...
VF_GOUT     = &20                   ; ... and outside it
VF_PROJ     = &10                   ; ... projected: vsx, vsy and voc hold it
VF_Z16      = &08                   ; ... g16_* hold its z << 4
CLIP_W      = SUB * VIEW_W          ; the view's rectangle, in view coordinates
CLIP_H      = SUB * VIEW_H
HALF        = SUB DIV 2
\ A face's near clip makes two vertices at most, and each of the guard
\ band's four planes two more.
ASSERT VMAX + 2 + 4 * 2 <= VALL
ASSERT ZNEAR >= PROJ_ZNEAR          ; the projection takes what the near clip leaves
\ Inside the guard band a projection is within 16 FX (8 FY) of the centre,
\ so the 2D clip's coordinates, their distances from the view's edges and
\ the differences of two (a crossing's denominator) all fit 16 bits.
ASSERT PROJ_XC + (VIEW_FX << GUARD_XS) + CLIP_W < &8000
ASSERT PROJ_YC + (VIEW_FY << GUARD_YS) + CLIP_H < &8000

SECTION ObjWork
.voc        SKIP VALL               ; a vertex's outcode against the view's rectangle
.vbc        SKIP VALL               ; ... and the planes beyond its sides (vertex_guard)
.g16_0      SKIP VALL               ; its z << 4 (vertex_z16)
.g16_1      SKIP VALL
.g16_2      SKIP VALL
.g16_3      SKIP VALL
.vsxl       SKIP VALL               ; its projection
.vsxh       SKIP VALL
.vsyl       SKIP VALL
.vsyh       SKIP VALL
.fp_idx     SKIP NPOLY              ; the face's loop, as vertex indices
.fq_idx     SKIP NPOLY              ; ... as the clips leave it
.fg_idx     SKIP NPOLY              ; ... a guard plane's, before it's copied back
.gf0        SKIP NPOLY              ; a guard plane's f for each vertex, 32-bit
.gf1        SKIP NPOLY
.gf2        SKIP NPOLY
.gf3        SKIP NPOLY
\ the 2D polygons, 16-bit coordinates: the clip's passes go from one
\ buffer to the other and back
.pa_xl      SKIP NP2
.pa_xh      SKIP NP2
.pa_yl      SKIP NP2
.pa_yh      SKIP NP2
.pb_xl      SKIP NP2
.pb_xh      SKIP NP2
.pb_yl      SKIP NP2
.pb_yh      SKIP NP2
.p_fl       SKIP NP2 + 1            ; a pass's f (bound - v, or v - bound) for each
.p_fh       SKIP NP2 + 1            ; vertex, the first again after the last
.p_n        SKIP 1                  ; the 2D polygon's vertices
\ the faces drawn, in the order found
.tf_n       SKIP 1
.tf_fn      SKIP OUT_FACES          ; vertices
.tf_fv      SKIP OUT_FACES          ; the first, in out_v*
.tf_fc      SKIP OUT_FACES          ; colour
\ the draw list
.dl_n       SKIP 1
.dl_obj     SKIP N_OBJ
.dl_f0      SKIP N_OBJ
.dl_nf      SKIP N_OBJ
.dl_ord     SKIP N_OBJ              ; the sort's order: dl indices, farthest first
.next_new   SKIP 1                  ; the clips' next new vertex
.of_cand    SKIP 1                  ; the candidate being drawn
.of_slot    SKIP 1                  ; its slot
.out_over   SKIP 1                  ; non-zero if a frame's faces didn't fit
ENDSECTION

SECTION ObjOut
.out_nf     SKIP 1                  ; faces, nearest first
.out_vn     SKIP 1                  ; vertices used
.out_fn     SKIP OUT_FACES          ; a face's vertex count ...
.out_fv     SKIP OUT_FACES          ; ... its first vertex ...
.out_fc     SKIP OUT_FACES          ; ... and its colour index (1-15)
.out_vxl    SKIP OUT_VERTS          ; vertices, view coordinates (sixteenths), 16-bit
.out_vxh    SKIP OUT_VERTS
.out_vyl    SKIP OUT_VERTS
.out_vyh    SKIP OUT_VERTS
ENDSECTION
ASSERT OUT_VERTS = 256              ; (indexed by a byte)

\ NEG4 v: the 4-byte value v negated
MACRO NEG4 v
    LDA #0 : SEC : SBC v+0 : STA v+0
    LDA #0 : SBC v+1 : STA v+1
    LDA #0 : SBC v+2 : STA v+2
    LDA #0 : SBC v+3 : STA v+3
ENDMACRO

\ SEXT: A = &FF if C was set, else 0 (C as a sign bit, extended)
MACRO SEXT
    LDA #0 : ADC #&FF : EOR #&FF
ENDMACRO

SECTION ObjCode

\ ===========================================================================
\ Big numbers, for round_div (tools/model/clip.py): a byte product on the
\ maths' quarter squares, a product of four bytes by four, a long division
\ and the rounding.

\ umul8: up = A * Y, unsigned: sq[a + b] - ng[a - b + 255] (src/maths.6502's
\ tables, page-aligned, with b patched into the operands). Clobbers A, X.
.umul8
{
    ZA_AUTO2 up
    TAX
    TYA
    STA ul+1 : STA uh+1
    EOR #&FF
    STA nl+1 : STA nh+1
    SEC
.ul LDA sq_lo,X
.nl SBC ng_lo,X
    STA up
.uh LDA sq_hi,X
.nh SBC ng_hi,X
    STA up+1
    RTS
}

\ umul32: udiv.uu (8 bytes) = ma (4 bytes) * mb (4 bytes), unsigned, a
\ column at a time: each of mb's bytes patched into cprod's quarter-square
\ reads once, for every byte of ma; a zero byte of either costs nothing.
.umul32
{
    ZA_AUTO 4, ma
    ZA_AUTO 4, mb
    ZA_AUTO1 lo
    FOR k = 0..7
        STZ udiv.uu + k
    NEXT
    FOR j = 0..3
        LDA mb + j : BNE column
        JMP next
    .column
        STA sl+1 : STA sh+1
        EOR #&FF
        STA nl+1 : STA nh+1
        FOR i = 0..3
            LDX ma + i : BEQ skip
            JSR cprod
            TAY
            LDA udiv.uu + i + j : CLC : ADC lo : STA udiv.uu + i + j
            TYA : ADC udiv.uu + i + j + 1 : STA udiv.uu + i + j + 1
            IF i + j + 2 <= 7
                BCC skip
                FOR k = i + j + 2..7
                    INC udiv.uu + k : BNE skip
                NEXT
            ENDIF
        .skip
        NEXT
    .next
    NEXT
    RTS
\ cprod: A (high) and lo = X times the patched byte
.cprod
    SEC
.sl LDA sq_lo,X
.nl SBC ng_lo,X
    STA lo
.sh LDA sq_hi,X
.nh SBC ng_hi,X
    RTS
}

\ udiv: uu's low four bytes = uu (8 bytes) DIV uv (4 bytes, non-zero),
\ which must be below 2^32; uu's high four bytes the remainder.
.udiv
{
    ZA_AUTO 8, uu
    ZA_AUTO 4, uv
    ZA_AUTO1 count
    LDA #32 : STA count
    \ While the quotient fits a byte fewer ((uu >> 24) < uv), the dividend
    \ moves up a byte and the division takes eight steps fewer.
.shrink
    LDA uu+7 : BNE divide
    LDA uu+3 : CMP uv
    LDA uu+4 : SBC uv+1
    LDA uu+5 : SBC uv+2
    LDA uu+6 : SBC uv+3
    BCS divide
    LDA uu+6 : STA uu+7
    LDA uu+5 : STA uu+6
    LDA uu+4 : STA uu+5
    LDA uu+3 : STA uu+4
    LDA uu+2 : STA uu+3
    LDA uu+1 : STA uu+2
    LDA uu+0 : STA uu+1
    STZ uu+0
    LDA count : SEC : SBC #8 : STA count
    BNE shrink
    RTS                             ; (the quotient is zero)
.divide
    \ The remainder stays below uv: when uv is two bytes or three, so is
    \ the remainder's register.
    LDA uv+3 : BNE step
    LDA uv+2 : BNE mid
.narrow
    ASL uu+0 : ROL uu+1 : ROL uu+2 : ROL uu+3 : ROL uu+4 : ROL uu+5
    BCS narrow_take                 ; (past 16 bits: at least uv)
    LDA uu+4 : CMP uv
    LDA uu+5 : SBC uv+1
    BCC narrow_next
.narrow_take
    LDA uu+4 : SBC uv : STA uu+4    ; (C set either way)
    LDA uu+5 : SBC uv+1 : STA uu+5
    INC uu+0
.narrow_next
    DEC count : BNE narrow
    RTS
.mid
    ASL uu+0 : ROL uu+1 : ROL uu+2 : ROL uu+3
    ROL uu+4 : ROL uu+5 : ROL uu+6
    BCS mid_take
    LDA uu+4 : CMP uv
    LDA uu+5 : SBC uv+1
    LDA uu+6 : SBC uv+2
    BCC mid_next
.mid_take
    LDA uu+4 : SBC uv : STA uu+4
    LDA uu+5 : SBC uv+1 : STA uu+5
    LDA uu+6 : SBC uv+2 : STA uu+6
    INC uu+0
.mid_next
    DEC count : BNE mid
    RTS
.step
    ASL uu+0 : ROL uu+1 : ROL uu+2 : ROL uu+3
    ROL uu+4 : ROL uu+5 : ROL uu+6 : ROL uu+7
    BCS take
    LDA uu+4 : CMP uv
    LDA uu+5 : SBC uv+1
    LDA uu+6 : SBC uv+2
    LDA uu+7 : SBC uv+3
    BCC next
.take
    LDA uu+4 : SEC : SBC uv : STA uu+4
    LDA uu+5 : SBC uv+1 : STA uu+5
    LDA uu+6 : SBC uv+2 : STA uu+6
    LDA uu+7 : SBC uv+3 : STA uu+7
    INC uu+0
.next
    DEC count : BNE step
    RTS
}

\ rdiv: udiv.uu's low four bytes (signed) = round_div(n, d), the model's
\ (2 n + d) DIV (2 d) once d is made positive: |n| in udiv.uu (its top
\ byte 0), |d| in udiv.uv, and neg's bit 7 set if n and d differ in sign.
\ With s that sign, it's s (2 |n| + |d| - s) DIV (2 |d|).
.rdiv
{
    ZA_AUTO1 neg
    ZA_AUTO 4, dm
    \ dm = |d| - s
    LDA neg : EOR #&80 : ASL A      ; C = 1 - s
    LDA udiv.uv+0 : SBC #0 : STA dm+0
    LDA udiv.uv+1 : SBC #0 : STA dm+1
    LDA udiv.uv+2 : SBC #0 : STA dm+2
    LDA udiv.uv+3 : SBC #0 : STA dm+3
    \ uu = 2 uu + dm
    ASL udiv.uu+0 : ROL udiv.uu+1 : ROL udiv.uu+2 : ROL udiv.uu+3
    ROL udiv.uu+4 : ROL udiv.uu+5 : ROL udiv.uu+6 : ROL udiv.uu+7
    LDA udiv.uu+0 : CLC : ADC dm+0 : STA udiv.uu+0
    LDA udiv.uu+1 : ADC dm+1 : STA udiv.uu+1
    LDA udiv.uu+2 : ADC dm+2 : STA udiv.uu+2
    LDA udiv.uu+3 : ADC dm+3 : STA udiv.uu+3
    BCC added
    FOR k = 4..7
        INC udiv.uu + k : BNE added
    NEXT
.added
    ASL udiv.uv+0 : ROL udiv.uv+1 : ROL udiv.uv+2 : ROL udiv.uv+3
    JSR udiv
    BIT neg : BPL done
    NEG4 udiv.uu
.done
    RTS
}
\ ===========================================================================
\ The near clip.

\ near_point: vertex next_new = where the edge from vertex X to vertex Y
\ crosses z = ZNEAR (the model's _near_point(a, b)): a + round_div((b - a)
\ (ZNEAR - a.z), b.z - a.z) on x and y. X and Y are kept.
.near_point
{
    ZA_AUTO1 ia, ib
    ZA_AUTO 4, dz
    ZA_AUTO 4, t
    ZA_AUTO 4, d
    ZA_AUTO1 sa, sb
    STX ia : STY ib
    \ dz = b.z - a.z and t = ZNEAR - a.z, 32-bit
    LDA vz2,X : ASL A : SEXT : STA sa
    LDA vz2,Y : ASL A : SEXT : STA sb
    LDA vz0,Y : SEC : SBC vz0,X : STA dz+0
    LDA vz1,Y : SBC vz1,X : STA dz+1
    LDA vz2,Y : SBC vz2,X : STA dz+2
    LDA sb : SBC sa : STA dz+3
    LDA #LO(ZNEAR) : SEC : SBC vz0,X : STA t+0
    LDA #HI(ZNEAR) : SBC vz1,X : STA t+1
    LDA #ZNEAR DIV 65536 : SBC vz2,X : STA t+2
    LDA #0 : SBC sa : STA t+3
    \ their signs EORed in sb, and their sizes kept
    LDA t+3 : EOR dz+3 : STA sb
    LDA t+3 : BPL t_pos
    NEG4 t
.t_pos
    LDA dz+3 : BPL dz_pos
    NEG4 dz
.dz_pos
    LDX ia : LDY ib
    LDA vx2,X : ASL A : SEXT : STA sa
    LDA vx2,Y : ASL A : SEXT : PHA
    LDA vx0,Y : SEC : SBC vx0,X : STA d+0
    LDA vx1,Y : SBC vx1,X : STA d+1
    LDA vx2,Y : SBC vx2,X : STA d+2
    PLA : SBC sa : STA d+3
    JSR cut
    LDY next_new
    LDX ia
    LDA udiv.uu+0 : CLC : ADC vx0,X : STA vx0,Y
    LDA udiv.uu+1 : ADC vx1,X : STA vx1,Y
    LDA udiv.uu+2 : ADC vx2,X : STA vx2,Y
    LDY ib
    LDA vy2,X : ASL A : SEXT : STA sa
    LDA vy2,Y : ASL A : SEXT : PHA
    LDA vy0,Y : SEC : SBC vy0,X : STA d+0
    LDA vy1,Y : SBC vy1,X : STA d+1
    LDA vy2,Y : SBC vy2,X : STA d+2
    PLA : SBC sa : STA d+3
    JSR cut
    LDY next_new
    LDX ia
    LDA udiv.uu+0 : CLC : ADC vy0,X : STA vy0,Y
    LDA udiv.uu+1 : ADC vy1,X : STA vy1,Y
    LDA udiv.uu+2 : ADC vy2,X : STA vy2,Y
    LDA #LO(ZNEAR) : STA vz0,Y
    LDA #HI(ZNEAR) : STA vz1,Y
    LDA #ZNEAR DIV 65536 : STA vz2,Y
    LDA #0 : STA vflag,Y
    LDX ia : LDY ib
    RTS
\ cut: udiv.uu = round_div(d t, dz), from d (32-bit signed), |t|, |dz|, and
\ the signs of t and dz EORed in sb
.cut
    LDA d+3 : EOR sb : STA rdiv.neg
    LDA d+3 : BPL d_pos
    NEG4 d
.d_pos
    FOR k = 0..3
        LDA d + k : STA umul32.ma + k
        LDA t + k : STA umul32.mb + k
    NEXT
    JSR umul32
    FOR k = 0..3
        LDA dz + k : STA udiv.uv + k
    NEXT
    JMP rdiv
}

\ near_clip: fp_idx's A vertices, a face with a vertex nearer than ZNEAR,
\ clipped to z >= ZNEAR into fq_idx (the model's near_clip): the count
\ left in A (Z set if none). New vertices from next_new on.
.near_clip
{
    ZA_AUTO1 n, i, m, ain
    STA n
    STZ m
    CMP #2 : BEQ segment
    BCC done                        ; (a point nearer than ZNEAR: nothing)
    STZ i
.edge
    LDY i
    LDX fp_idx,Y
    INY : CPY n : BNE wrapped
    LDY #0
.wrapped
    LDA fp_idx,Y : TAY              ; the edge from X to Y
    LDA vflag,X : EOR #VF_NEAR : AND #VF_NEAR : STA ain     ; non-zero if X is in
    BEQ a_out
    TXA : LDX m : STA fq_idx,X : INC m : TAX
.a_out
    LDA vflag,Y : EOR #VF_NEAR : AND #VF_NEAR
    EOR ain : BEQ next              ; both in or both out
    JSR near_point
    LDX m : LDA next_new : STA fq_idx,X
    INC m : INC next_new
.next
    INC i : LDA i : CMP n : BNE edge
.done
    LDA m
    RTS
.segment
    LDX fp_idx : LDY fp_idx+1
    LDA vflag,X : AND vflag,Y : BMI done       ; both nearer: nothing
    JSR near_point
    LDA vflag,X : BMI a_near
    STX fq_idx
    LDA next_new : STA fq_idx+1
    BRA two
.a_near
    LDA next_new : STA fq_idx
    STY fq_idx+1
.two
    INC next_new
    LDA #2
    RTS
}

\ ===========================================================================
\ Crossings (the model's crossing_t and lerp).

\ frac16: ft = the model's crossing_t, from fp (4 bytes, at least 0) and fd
\ (4 bytes, fp less): fp and fd shifted right together until fd fits 16
\ bits (whole bytes while it's past 24), then floor(2^16 fp / fd) by
\ sixteen steps of a long division, unrolled, the remainder's high byte in
\ A. (When the shifts leave fp = fd, every step takes and ft is &FFFF, the
\ model's clamp.)
.frac16
{
    ZA_AUTO 4, fp
    ZA_AUTO 4, fd
    ZA_AUTO2 ft
    LDA fd+3 : BEQ under24
    LDA fd+1 : STA fd
    LDA fd+2 : STA fd+1
    LDA fd+3 : STA fd+2
    LDA fp+1 : STA fp
    LDA fp+2 : STA fp+1
    LDA fp+3 : STA fp+2
.under24
    LDA fd+2 : BEQ divide
.normalise
    LSR fd+2 : ROR fd+1 : ROR fd
    LSR fp+2 : ROR fp+1 : ROR fp
    LDA fd+2 : BNE normalise
.divide
    LDA fp+1
    FOR k = 1..16
        ASL fp : ROL A
        BCS take                    ; (past 16 bits: at least fd)
        CMP fd+1 : BCC bit
        BNE take
        LDY fp : CPY fd : BCC bit
    .take
        TAY                         ; (C is set on every way here)
        LDA fp : SBC fd : STA fp
        TYA : SBC fd+1
        SEC
    .bit
        ROL ft : ROL ft+1
    NEXT
    RTS
}

\ lerp: lr (3 bytes) = round half up of ld (32-bit signed) frac16.ft /
\ 2^16, modulo 2^24 (the callers add it to a 24-bit coordinate, and the sum
\ fits).
.lerp
{
    ZA_AUTO 4, ld
    ZA_AUTO 3, lr
    ZA_AUTO1 neg
    LDA ld+3 : STA neg : BPL positive
    NEG4 ld
.positive
    FOR k = 0..3
        LDA ld + k : STA umul32.ma + k
    NEXT
    LDA frac16.ft : STA umul32.mb
    LDA frac16.ft+1 : STA umul32.mb+1
    STZ umul32.mb+2 : STZ umul32.mb+3
    JSR umul32
    \ (|product| + 2^15) >> 16 rounds a positive one half up; for a negative
    \ one it's -((|product| + 2^15 - 1) >> 16). So &7FFF plus C, with C set
    \ for a positive product, then >> 16.
    LDA neg : EOR #&80 : ASL A
    LDA udiv.uu+0 : ADC #&FF
    LDA udiv.uu+1 : ADC #&7F
    LDA udiv.uu+2 : ADC #0 : STA lr+0
    LDA udiv.uu+3 : ADC #0 : STA lr+1
    LDA udiv.uu+4 : ADC #0 : STA lr+2
    BIT neg : BPL done
    LDA #0 : SEC : SBC lr+0 : STA lr+0
    LDA #0 : SBC lr+1 : STA lr+1
    LDA #0 : SBC lr+2 : STA lr+2
.done
    RTS
}


\ ===========================================================================
\ The guard band (decision 17; the model's outside_guard and guard_clip).

\ vertex_z16: vertex Y's z << 4 in g16_*, once (vflag's VF_Z16): the guard
\ band's slope for x, and twice its slope for y, so both its tests and its
\ planes' distances take it (GUARD_XS = 4, GUARD_YS = 3, ASSERTed). By
\ nibbles: each byte's low four bits up and high four down (lo4, hi4). X
\ and Y are kept.
.vertex_z16
{
    ZA_AUTO1 t
    LDA vflag,Y : AND #VF_Z16 : BNE done
    PHX
    LDX vz0,Y
    LDA lo4,X : STA g16_0,Y
    LDA hi4,X : STA t
    LDX vz1,Y
    LDA lo4,X : ORA t : STA g16_1,Y
    LDA hi4,X : STA t
    LDX vz2,Y
    LDA lo4,X : ORA t : STA g16_2,Y
    LDA hi4,X : STA g16_3,Y
    LDA vflag,Y : ORA #VF_Z16 : STA vflag,Y
    PLX
.done
    RTS
}
ASSERT GUARD_XS = 4 AND GUARD_YS = 3

\ vertex_guard: vertex Y against the planes beyond the view's sides and
\ the guard band, once a vertex (vflag, vbc): A = which of x = -z, x = z,
\ 2y = z, 2y = -z it's beyond (the model's beyond: OC_LEFT, OC_RIGHT,
\ OC_TOP, OC_BOTTOM), and C set if it's outside the guard band (the
\ model's outside_guard: |x| > 16 z or |y| > 8 z, so 2 |y| > 16 z). Only a
\ vertex beyond one of the planes can be outside the band. Y is kept.
.vertex_guard
{
    ZA_AUTO 4, ga
    ZA_AUTO1 code
    LDA vflag,Y : BIT #VF_GTEST : BEQ test
    AND #VF_GOUT : CMP #1
    LDA vbc,Y
    RTS
.test
    ORA #VF_GTEST : STA vflag,Y
    STZ code
    \ |x| against z
    STZ ga+3
    LDA vx2,Y : BPL x_pos
    LDA #0 : SEC : SBC vx0,Y : STA ga
    LDA #0 : SBC vx1,Y : STA ga+1
    LDA #0 : SBC vx2,Y : STA ga+2
    LDA #OC_LEFT
    BRA x_got
.x_pos
    STA ga+2
    LDA vx1,Y : STA ga+1
    LDA vx0,Y : STA ga
    LDA #OC_RIGHT
.x_got
    JSR beyond
    \ 2 |y| against z
    LDA vy2,Y : BPL y_pos
    LDA #0 : SEC : SBC vy0,Y : STA ga
    LDA #0 : SBC vy1,Y : STA ga+1
    LDA #0 : SBC vy2,Y : STA ga+2
    LDA #OC_BOTTOM
    BRA y_got
.y_pos
    STA ga+2
    LDA vy1,Y : STA ga+1
    LDA vy0,Y : STA ga
    LDA #OC_TOP
.y_got
    STZ ga+3
    ASL ga : ROL ga+1 : ROL ga+2 : ROL ga+3
    JSR beyond
    LDA code : STA vbc,Y
    LDA vflag,Y : AND #VF_GOUT : CMP #1
    LDA code
    RTS
\ beyond: if ga > (vertex Y's) z, code gets A, and if ga > z << 4 too,
\ vflag's VF_GOUT is set
.beyond
    PHA
    LDA vz0,Y : CMP ga
    LDA vz1,Y : SBC ga+1
    LDA vz2,Y : SBC ga+2
    LDA #0 : SBC ga+3
    PLA
    BCS done                        ; (ga <= z)
    TSB code
    JSR vertex_z16
    \ z << 4 - ga borrows if ga > z << 4
    LDA g16_0,Y : CMP ga
    LDA g16_1,Y : SBC ga+1
    LDA g16_2,Y : SBC ga+2
    LDA g16_3,Y : SBC ga+3
    BCS done
    LDA vflag,Y : ORA #VF_GOUT : STA vflag,Y
.done
    RTS
}

\ guard_f: gf*,X = guard_clip.plane's f for vertex Y, 32-bit: the model's
\ GUARD_PLANES' 16 z - x and 16 z + x for planes 0 and 1, and twice its 8 z
\ - y and 8 z + y for 2 and 3 (twice, the same crossings: a crossing's
\ fraction is a ratio, and crossing_t's shifts keep it). X and Y are kept.
.guard_f
{
    ZA_AUTO 4, v
    JSR vertex_z16
    LDA guard_clip.plane : CMP #2 : BCS y_axis
    LDA vx0,Y : STA v+0
    LDA vx1,Y : STA v+1
    LDA vx2,Y : STA v+2
    ASL A : SEXT : STA v+3
    BRA got
.y_axis
    \ 2 y
    LDA vy0,Y : ASL A : STA v+0
    LDA vy1,Y : ROL A : STA v+1
    LDA vy2,Y : ROL A : STA v+2
    LDA vy2,Y : ASL A : SEXT : STA v+3
.got
    LDA guard_clip.plane : LSR A : BCS add      ; odd planes: + v
    LDA g16_0,Y : SEC : SBC v+0 : STA gf0,X
    LDA g16_1,Y : SBC v+1 : STA gf1,X
    LDA g16_2,Y : SBC v+2 : STA gf2,X
    LDA g16_3,Y : SBC v+3 : STA gf3,X
    RTS
.add
    LDA g16_0,Y : CLC : ADC v+0 : STA gf0,X
    LDA g16_1,Y : ADC v+1 : STA gf1,X
    LDA g16_2,Y : ADC v+2 : STA gf2,X
    LDA g16_3,Y : ADC v+3 : STA gf3,X
    RTS
}


\ GP_AXIS a0, a1, a2: guard_point's new vertex on one axis (its arrays):
\ P + lerp(Q - P)
MACRO GP_AXIS a0, a1, a2
    LDX guard_point.ip : LDY guard_point.iq
    LDA a2,X : ASL A : SEXT : STA guard_point.sp
    LDA a2,Y : ASL A : SEXT : STA guard_point.sq
    LDA a0,Y : SEC : SBC a0,X : STA lerp.ld+0
    LDA a1,Y : SBC a1,X : STA lerp.ld+1
    LDA a2,Y : SBC a2,X : STA lerp.ld+2
    LDA guard_point.sq : SBC guard_point.sp : STA lerp.ld+3
    JSR lerp
    LDY next_new : LDX guard_point.ip
    LDA lerp.lr+0 : CLC : ADC a0,X : STA a0,Y
    LDA lerp.lr+1 : ADC a1,X : STA a1,Y
    LDA lerp.lr+2 : ADC a2,X : STA a2,Y
ENDMACRO

\ guard_point: vertex next_new = the crossing (the model's crossing) of the
\ edge from fq_idx's entry X, inside the plane (gf >= 0), to entry Y,
\ outside it.
.guard_point
{
    ZA_AUTO1 ip, iq, sp, sq
    LDA fq_idx,X : STA ip
    LDA fq_idx,Y : STA iq
    LDA gf0,X : STA frac16.fp+0
    SEC : SBC gf0,Y : STA frac16.fd+0
    LDA gf1,X : STA frac16.fp+1
    SBC gf1,Y : STA frac16.fd+1
    LDA gf2,X : STA frac16.fp+2
    SBC gf2,Y : STA frac16.fd+2
    LDA gf3,X : STA frac16.fp+3
    SBC gf3,Y : STA frac16.fd+3
    JSR frac16
    GP_AXIS vx0, vx1, vx2
    GP_AXIS vy0, vy1, vy2
    GP_AXIS vz0, vz1, vz2
    LDY next_new
    LDA #0 : STA vflag,Y
    RTS
}

\ GUARD_CUT: a guard_point from entry X (inside) to entry Y into fg_idx
MACRO GUARD_CUT
    JSR guard_point
    LDY guard_clip.m : LDA next_new : STA fg_idx,Y
    INC guard_clip.m : INC next_new
ENDMACRO

\ guard_clip: fq_idx's A vertices, all at or beyond ZNEAR, clipped to the
\ guard band's four planes in turn (the model's guard_clip; a line as a
\ segment), back into fq_idx: the count left in A (Z set if none). A plane
\ with every vertex inside leaves the polygon as it is.
.guard_clip
{
    ZA_AUTO1 plane, n, i, m, ib, out
    STA n
    STZ plane
.plane_loop
    LDA n : BNE planed
    JMP done
.planed
    STZ out
    LDX #0
.f
    LDY fq_idx,X
    JSR guard_f
    LDA gf3,X : TSB out             ; (bit 7: one's outside)
    INX : CPX n : BNE f
    BIT out : BMI clip
    JMP next_plane
.clip
    LDA n : CMP #2 : BNE polygon
    JMP segment
.polygon
    STZ m
    STZ i
.edge
    LDX i
    INX : CPX n : BNE no_wrap
    LDX #0
.no_wrap
    STX ib
    LDX i
    LDA gf3,X : BMI a_out
    LDY m : LDA fq_idx,X : STA fg_idx,Y : INC m
    LDY ib
    LDA gf3,Y : BPL next            ; both in
    GUARD_CUT                       ; (X = i, Y = ib)
    BRA next
.a_out
    LDY ib
    LDA gf3,Y : BMI next            ; both out
    TXA : LDX ib : TAY
    GUARD_CUT                       ; (from ib to i)
.next
    INC i : LDA i : CMP n : BNE edge
    LDX m : STX n
    BEQ next_plane
.copy
    DEX
    LDA fg_idx,X : STA fq_idx,X
    TXA : BNE copy
    BRA next_plane
.segment
    LDA gf3 : AND gf3+1 : BMI empty         ; both outside: nothing
    STZ m
    LDA gf3 : BMI a_cut
    \ [a, crossing from a to b]
    LDX #0 : LDY #1
    GUARD_CUT
    LDA fg_idx : STA fq_idx+1
    BRA next_plane
.a_cut
    \ [crossing from b to a, b]
    LDX #1 : LDY #0
    GUARD_CUT
    LDA fg_idx : STA fq_idx
    BRA next_plane
.empty
    STZ n
.next_plane
    INC plane : LDA plane : CMP #4 : BEQ done
    JMP plane_loop
.done
    LDA n
    RTS
}

\ ===========================================================================
\ The projection, once a vertex, with its outcode against the view's
\ rectangle (the model's outcode2d).

\ vertex_project: vertex Y's projection (the maths' project) into vsx and
\ vsy, its outcode into voc. Y is kept.
.vertex_project
{
    LDA vflag,Y : AND #VF_PROJ : BEQ project_it
    RTS
.project_it
    LDA vx0,Y : STA proj_x+0
    LDA vx1,Y : STA proj_x+1
    LDA vx2,Y : STA proj_x+2
    LDA vy0,Y : STA proj_y+0
    LDA vy1,Y : STA proj_y+1
    LDA vy2,Y : STA proj_y+2
    LDA vz0,Y : STA proj_z+0
    LDA vz1,Y : STA proj_z+1
    LDA vz2,Y : STA proj_z+2
    PHY
    JSR project
    PLY
    LDA proj_sx : STA vsxl,Y
    LDA proj_sx+1 : STA vsxh,Y
    LDA proj_sy : STA vsyl,Y
    LDA proj_sy+1 : STA vsyh,Y
    \ the outcode: sx < 0 or > CLIP_W, sy < 0 or > CLIP_H (a non-negative
    \ coordinate compared unsigned)
    LDX #0
    LDA proj_sx+1 : BPL x_right
    LDX #OC_LEFT
    BRA x_done
.x_right
    LDA #LO(CLIP_W) : CMP proj_sx
    LDA #HI(CLIP_W) : SBC proj_sx+1
    BCS x_done                      ; (no borrow: sx <= CLIP_W)
    LDX #OC_RIGHT
.x_done
    TXA
    LDX proj_sy+1 : BPL y_down
    ORA #OC_TOP
    BRA y_done
.y_down
    TAX
    LDA #LO(CLIP_H) : CMP proj_sy
    LDA #HI(CLIP_H) : SBC proj_sy+1
    TXA
    BCS y_done                      ; (no borrow: sy <= CLIP_H)
    ORA #OC_BOTTOM
.y_done
    STA voc,Y
    LDA #VF_PROJ : ORA vflag,Y : STA vflag,Y
    RTS
}
ASSERT CLIP_W < &8000 AND CLIP_H < &8000

\ ===========================================================================
\ In two dimensions: the polygon in pa_* (p_n vertices, 16-bit signed view
\ coordinates).

\ ADDK al, ah, k: pa's 16-bit coordinate al/ah,X plus k (signed, small)
MACRO ADDK al, ah, k
    LDA al,X : CLC : ADC #LO(k) : STA al,X
    LDA ah,X : ADC #HI(k) : STA ah,X
ENDMACRO

\ COPY2D: pa's vertex X copied to vertex Y
MACRO COPY2D
    LDA pa_xl,X : STA pa_xl,Y
    LDA pa_xh,X : STA pa_xh,Y
    LDA pa_yl,X : STA pa_yl,Y
    LDA pa_yh,X : STA pa_yh,Y
ENDMACRO

\ line_quad: the line from vertex 0 to vertex 1 as the polygon a one-pixel
\ line covers (the model's line_quad): half a pixel each way across its
\ major axis.
.line_quad
{
    ZA_AUTO2 dx, dy
    \ |b - a| on each axis: the difference has 17 bits, its sign N EOR V
    LDA pa_xl+1 : SEC : SBC pa_xl : STA dx
    LDA pa_xh+1 : SBC pa_xh : STA dx+1
    BVC dx_signed
    EOR #&80
.dx_signed
    BPL dx_pos
    LDA #0 : SEC : SBC dx : STA dx
    LDA #0 : SBC dx+1 : STA dx+1
.dx_pos
    LDA pa_yl+1 : SEC : SBC pa_yl : STA dy
    LDA pa_yh+1 : SBC pa_yh : STA dy+1
    BVC dy_signed
    EOR #&80
.dy_signed
    BPL dy_pos
    LDA #0 : SEC : SBC dy : STA dy
    LDA #0 : SBC dy+1 : STA dy+1
.dy_pos
    \ vertices 2 and 3 are b and a again
    LDX #1 : LDY #2
    COPY2D
    LDX #0 : LDY #3
    COPY2D
    LDA #4 : STA p_n
    \ |dx| >= |dy|: across is y
    LDA dx : CMP dy
    LDA dx+1 : SBC dy+1
    BCC steep
    LDX #0 : ADDK pa_yl, pa_yh, -HALF
    LDX #1 : ADDK pa_yl, pa_yh, -HALF
    LDX #2 : ADDK pa_yl, pa_yh, HALF
    LDX #3 : ADDK pa_yl, pa_yh, HALF
    RTS
.steep
    LDX #0 : ADDK pa_xl, pa_xh, -HALF
    LDX #1 : ADDK pa_xl, pa_xh, -HALF
    LDX #2 : ADDK pa_xl, pa_xh, HALF
    LDX #3 : ADDK pa_xl, pa_xh, HALF
    RTS
}
ASSERT (PROJ_XC + (VIEW_FX << GUARD_XS)) * 2 < &10000   ; (|b - a| fits 16 bits)

\ point_square: vertex 0 as the square round the pixel it's in (the
\ model's point_square).
.point_square
{
    LDX #0
    LDY #1 : COPY2D
    LDY #2 : COPY2D
    LDY #3 : COPY2D
    LDA #4 : STA p_n
    LDX #0 : ADDK pa_xl, pa_xh, -HALF
    ADDK pa_yl, pa_yh, -HALF
    LDX #1 : ADDK pa_xl, pa_xh, HALF
    ADDK pa_yl, pa_yh, -HALF
    LDX #2 : ADDK pa_xl, pa_xh, HALF
    ADDK pa_yl, pa_yh, HALF
    LDX #3 : ADDK pa_xl, pa_xh, -HALF
    ADDK pa_yl, pa_yh, HALF
    RTS
}

\ clip_cut: r = the crossing's other coordinate, P's + lerp(Q's - P's) by
\ t from fp >= 0 at P and fq < 0 at Q (16-bit signed each, so fp - fq fits
\ 16 bits unsigned).
.clip_cut
{
    ZA_AUTO2 fp, fq, po, qo, r
    LDA fp : STA frac16.fp
    SEC : SBC fq : STA frac16.fd
    LDA fp+1 : STA frac16.fp+1
    SBC fq+1 : STA frac16.fd+1
    STZ frac16.fp+2 : STZ frac16.fp+3
    STZ frac16.fd+2 : STZ frac16.fd+3
    JSR frac16
    \ Q's - P's, 17 bits signed, as lerp's 32
    LDA qo : SEC : SBC po : STA lerp.ld
    LDA qo+1 : SBC po+1 : STA lerp.ld+1
    \ (the sign from the 17th bit: V gives it with N)
    LDA #0 : BVC no_overflow
    LDA #&FF
.no_overflow
    EOR lerp.ld+1 : ASL A           ; C = the true sign
    SEXT : STA lerp.ld+2 : STA lerp.ld+3
    JSR lerp
    LDA lerp.lr : CLC : ADC po : STA r
    LDA lerp.lr+1 : ADC po+1 : STA r+1
    RTS
}

\ CLIP_PASS sal, sah, sol, soh, dal, dah, dol, doh, bound, below: one side of
\ the view's rectangle (the model's _clip_edge), from the source buffer (its
\ arrays on the side's axis, then the other) to the destination: keep the
\ axis's coordinate <= bound if below, else >= bound (which is 0); a
\ crossing from the edge's inside end.
MACRO CLIP_PASS sal, sah, sol, soh, dal, dah, dol, doh, bound, below
    LDX #0
.f
    IF below
        LDA #LO(bound) : SEC : SBC sal,X : STA p_fl,X
        LDA #HI(bound) : SBC sah,X : STA p_fh,X
    ELSE
        ASSERT bound = 0
        LDA sal,X : STA p_fl,X
        LDA sah,X : STA p_fh,X
    ENDIF
    INX : CPX p_n : BNE f
    LDA p_fl : STA p_fl,X               ; the first again after the last
    LDA p_fh : STA p_fh,X
    STZ clip2d.m
    LDX #0
.vertex
    STX clip2d.i
    LDA p_fh,X : BMI a_out
    LDY clip2d.m
    LDA sal,X : STA dal,Y
    LDA sah,X : STA dah,Y
    LDA sol,X : STA dol,Y
    LDA soh,X : STA doh,Y
    INC clip2d.m
    LDA p_fh+1,X : BPL next             ; both in
    \ the crossing from a (X) to b
    STX clip2d.ip
    INX : CPX p_n : BNE b_set
    LDX #0
.b_set
    STX clip2d.iq
    BRA cut
.a_out
    LDA p_fh+1,X : BMI next             ; both out
    \ the crossing from b to a (X)
    STX clip2d.iq
    INX : CPX p_n : BNE p_set
    LDX #0
.p_set
    STX clip2d.ip
.cut
    LDX clip2d.ip : LDY clip2d.iq
    LDA p_fl,X : STA clip_cut.fp
    LDA p_fh,X : STA clip_cut.fp+1
    LDA p_fl,Y : STA clip_cut.fq
    LDA p_fh,Y : STA clip_cut.fq+1
    LDA sol,X : STA clip_cut.po
    LDA soh,X : STA clip_cut.po+1
    LDA sol,Y : STA clip_cut.qo
    LDA soh,Y : STA clip_cut.qo+1
    JSR clip_cut
    LDY clip2d.m
    LDA #LO(bound) : STA dal,Y
    LDA #HI(bound) : STA dah,Y
    LDA clip_cut.r : STA dol,Y
    LDA clip_cut.r+1 : STA doh,Y
    INC clip2d.m
.next
    LDX clip2d.i : INX : CPX p_n : BEQ finished
    JMP vertex
.finished
    LDA clip2d.m : STA p_n
ENDMACRO
ASSERT NP2 >= 4 + 4 * 2                 ; a widened line, cut by every edge

\ clip2d: the polygon clipped to the view's rectangle, [0, CLIP_W] x [0,
\ CLIP_H] (the model's clip2d), then its repeats dropped. A = the edges a
\ vertex is beyond (OC_*): the passes for the others are skipped, as they'd
\ change nothing (a crossing lies between its edge's ends, so it isn't
\ beyond an edge neither of them is). Each pass goes from pa to pb, and
\ back.
.clip2d
{
    ZA_AUTO1 m, i, ip, iq, edges
    STA edges
    LDA #OC_LEFT : BIT edges : BNE pass1
    JMP pass2
.pass1
    CLIP_PASS pa_xl, pa_xh, pa_yl, pa_yh, pb_xl, pb_xh, pb_yl, pb_yh, 0, FALSE
    JSR back
    BNE pass2
    RTS
.pass2
    LDA #OC_RIGHT : BIT edges : BNE pass2_do
    JMP pass3
.pass2_do
    CLIP_PASS pa_xl, pa_xh, pa_yl, pa_yh, pb_xl, pb_xh, pb_yl, pb_yh, CLIP_W, TRUE
    JSR back
    BNE pass3
    RTS
.pass3
    LDA #OC_TOP : BIT edges : BNE pass3_do
    JMP pass4
.pass3_do
    CLIP_PASS pa_yl, pa_yh, pa_xl, pa_xh, pb_yl, pb_yh, pb_xl, pb_xh, 0, FALSE
    JSR back
    BNE pass4
    RTS
.pass4
    LDA #OC_BOTTOM : BIT edges : BNE pass4_do
    JMP dedupe
.pass4_do
    CLIP_PASS pa_yl, pa_yh, pa_xl, pa_xh, pb_yl, pb_yh, pb_xl, pb_xh, CLIP_H, TRUE
    JSR back
    JMP dedupe
\ back: pb's polygon to pa; Z set if it's empty
.back
    LDX p_n : BEQ empty
.copy
    DEX
    LDA pb_xl,X : STA pa_xl,X
    LDA pb_xh,X : STA pa_xh,X
    LDA pb_yl,X : STA pa_yl,X
    LDA pb_yh,X : STA pa_yh,X
    TXA : BNE copy
    LDA p_n
.empty
    RTS
}

\ SAME2D: Z set if pa's vertices X and Y are the same point
MACRO SAME2D
    LDA pa_xl,X : CMP pa_xl,Y : BNE done
    LDA pa_xh,X : CMP pa_xh,Y : BNE done
    LDA pa_yl,X : CMP pa_yl,Y : BNE done
    LDA pa_yh,X : CMP pa_yh,Y
.done
ENDMACRO

\ dedupe: the polygon without repeated vertices next to each other, the
\ last and first included (the model's dedupe).
.dedupe
{
    ZA_AUTO1 m
    LDA p_n : BNE some
    RTS
.some
    LDA #1 : STA m                  ; vertex 0 stays
    LDX #1
    CPX p_n : BEQ wrap
.vertex
    LDY m : DEY
    SAME2D
    BEQ next
    LDY m
    COPY2D
    INC m
.next
    INX : CPX p_n : BNE vertex
.wrap
    \ while more than one and the last is the first, drop the last
    LDY m
.tail
    CPY #2 : BCC counted
    DEY : LDX #0
    SAME2D
    BEQ tail
    INY
.counted
    STY p_n
    RTS
}

\ umul16: mp (4 bytes) = ma * mb, each unsigned 16-bit; a zero high byte
\ costs nothing.
.umul16
{
    ZA_AUTO2 ma, mb
    ZA_AUTO 4, mp
    LDA ma : LDY mb : JSR umul8
    LDA umul8.up : STA mp
    LDA umul8.up+1 : STA mp+1
    STZ mp+2 : STZ mp+3
    LDY mb+1 : BEQ no_b1
    LDA ma : JSR umul8
    LDA mp+1 : CLC : ADC umul8.up : STA mp+1
    LDA mp+2 : ADC umul8.up+1 : STA mp+2
.no_b1
    LDA ma+1 : BEQ done
    LDY mb : JSR umul8
    LDA mp+1 : CLC : ADC umul8.up : STA mp+1
    LDA mp+2 : ADC umul8.up+1 : STA mp+2
    BCC no_carry
    INC mp+3
.no_carry
    LDY mb+1 : BEQ done
    LDA ma+1 : JSR umul8
    LDA mp+2 : CLC : ADC umul8.up : STA mp+2
    LDA mp+3 : ADC umul8.up+1 : STA mp+3
.done
    RTS
}

\ DIFF2D dst, arr_l, arr_h: dst = pa's coordinate at X less vertex 0's
\ (16-bit; inside the view, so small)
MACRO DIFF2D dst, arr_l, arr_h
    LDA arr_l,X : SEC : SBC arr_l : STA dst
    LDA arr_h,X : SBC arr_h : STA dst+1
ENDMACRO

\ ABS16 v: |v| (16-bit), and A = v's sign: &81 negative, 1 positive, 0 (Z
\ set) zero. Two such signs EORed, ORed with 1, are their product's.
MACRO ABS16 v
    LDA v+1 : BPL positive
    LDA #0 : SEC : SBC v : STA v
    LDA #0 : SBC v+1 : STA v+1
    LDA #&81
    BRA done
.positive
    LDA v : ORA v+1 : BEQ done
    LDA #1
.done
ENDMACRO

\ PSIGN s: A = the sign (ABS16's) of the product of A's and s's
MACRO PSIGN s
    BEQ done                        ; (A zero: the product's zero)
    LDX s : BEQ zero
    EOR s : ORA #1
    BRA done
.zero
    LDA #0
.done
ENDMACRO

\ drawable: C set if the polygon (p_n vertices, its repeats dropped, inside
\ the view) is drawn (the model's drawable): three or more vertices, one off
\ the line through the first two. dx ey = dy ex is decided by the products'
\ signs and zeros where it can be, else by the products.
.drawable
{
    ZA_AUTO2 dx, dy, ex, ey
    ZA_AUTO1 i, sa, sb, s
    LDA p_n : CMP #3 : BCS enough
    RTS                             ; (C clear)
.enough
    LDX #1
    DIFF2D dx, pa_xl, pa_xh
    DIFF2D dy, pa_yl, pa_yh
    ABS16 dx : STA sa               ; (dx, dy kept as sizes, their signs here)
    ABS16 dy : STA sb
    LDA #2 : STA i
.vertex
    LDX i
    DIFF2D ex, pa_xl, pa_xh
    DIFF2D ey, pa_yl, pa_yh
    ABS16 ey : PSIGN sa : STA s     ; dx ey's sign
    ABS16 ex : PSIGN sb             ; dy ex's
    CMP s : BNE off_line            ; (their signs or zeros differ)
    CMP #0 : BEQ next               ; (both zero: on the line)
    \ the same sign: the sizes decide
    LDA dx : STA umul16.ma
    LDA dx+1 : STA umul16.ma+1
    LDA ey : STA umul16.mb
    LDA ey+1 : STA umul16.mb+1
    JSR umul16
    LDA umul16.mp : PHA
    LDA umul16.mp+1 : PHA
    LDA umul16.mp+2 : PHA
    LDA umul16.mp+3 : PHA
    LDA dy : STA umul16.ma
    LDA dy+1 : STA umul16.ma+1
    LDA ex : STA umul16.mb
    LDA ex+1 : STA umul16.mb+1
    JSR umul16
    PLA : CMP umul16.mp+3 : BNE pop3
    PLA : CMP umul16.mp+2 : BNE pop2
    PLA : CMP umul16.mp+1 : BNE pop1
    PLA : CMP umul16.mp : BNE off_line
.next
    INC i : LDA i : CMP p_n : BEQ on_line
    JMP vertex
.on_line
    CLC
    RTS
.pop3
    PLA
.pop2
    PLA
.pop1
    PLA
.off_line
    SEC
    RTS
}

\ emit_face: the polygon as a drawn face of colour A: its vertices into
\ out_v*, its record into tf_*. Nothing if they'd run out (out_over set).
.emit_face
{
    ZA_AUTO1 col
    STA col
    LDA tf_n : CMP #OUT_FACES : BCS over
    LDA out_vn : CLC : ADC p_n : BCS over
    LDY out_vn
    LDX #0
.vertex
    LDA pa_xl,X : STA out_vxl,Y
    LDA pa_xh,X : STA out_vxh,Y
    LDA pa_yl,X : STA out_vyl,Y
    LDA pa_yh,X : STA out_vyh,Y
    INY
    INX : CPX p_n : BNE vertex
    LDX tf_n
    LDA p_n : STA tf_fn,X
    LDA out_vn : STA tf_fv,X
    LDA col : STA tf_fc,X
    STY out_vn
    INC tf_n
    RTS
.over
    LDA #1 : STA out_over
    RTS
}

\ ===========================================================================
\ A face, and an object's.

\ draw_face: face X of the object being drawn, its vertices in vx* (the
\ model's draw_faces for one face).
.draw_face
{
    ZA_AUTO1 face, n, every, any, k, near
    STX face
    LDA fa_nv,X : STA n
    LDY fa_loop,X
    STZ near
    LDX #0
.loop
    LDA lp_table,Y : STA fp_idx,X : STA fq_idx,X
    PHY
    TAY : LDA vflag,Y : AND #VF_NEAR : TSB near
    PLY
    INY : INX : CPX n : BNE loop
    LDA #VMAX : STA next_new
    LDA near : BEQ guard
    LDA n : JSR near_clip
    BNE near_kept
    RTS
.near_kept
    STA n
.guard
    \ wholly beyond a plane outside the view's sides, it isn't drawn; with
    \ a vertex outside the guard band, it's clipped to the band
    LDA #&FF : STA every
    STZ any
    STZ k
.guard_test
    LDX k : LDY fq_idx,X
    JSR vertex_guard
    BCC in_band
    LDX #1 : STX any                ; (outside the band)
.in_band
    AND every : STA every
    INC k : LDA k : CMP n : BNE guard_test
    LDA every : BEQ visible
    RTS
.visible
    LDA any : BEQ projecting
    LDA n : JSR guard_clip
    BNE guarded
    RTS
.guarded
    STA n
.projecting
    \ each vertex projected, and its outcode: none beyond one edge for every
    \ vertex
    LDA #&FF : STA every
    STZ any
    STZ k
.project_loop
    LDX k : LDY fq_idx,X
    JSR vertex_project
    LDA voc,Y : TSB any
    AND every : STA every
    LDX k
    LDA vsxl,Y : STA pa_xl,X
    LDA vsxh,Y : STA pa_xh,X
    LDA vsyl,Y : STA pa_yl,X
    LDA vsyh,Y : STA pa_yh,X
    INC k : LDA k : CMP n : BNE project_loop
    STA p_n
    LDA every : BEQ seen
    RTS
.seen
    \ widened, a line or a point is always clipped
    LDX of_slot
    LDA ob_flags,X : BIT #F_LINE : BNE line
    AND #K_MASK : CMP #K_SENSOR : BEQ point
    LDA any : BNE clip              ; (A: the edges to clip to)
    JSR dedupe
    BRA drawn
.line
    JSR line_quad
    BRA widened
.point
    JSR point_square
.widened
    LDA #OC_LEFT OR OC_RIGHT OR OC_TOP OR OC_BOTTOM
.clip
    JSR clip2d
.drawn
    JSR drawable : BCC rejected
    LDX face : LDA fa_col,X
    JMP emit_face
.rejected
    RTS
}

\ draw_object: the candidate of_cand's seen faces, in order; it joins the
\ draw list if any is drawn.
.draw_object
{
    ZA_ENTRY
    ZA_AUTO1 face, mask, first
    LDX of_slot : LDA ob_f0,X : STA face
    LDX of_cand : LDA cd_mask,X : STA mask
    LDA tf_n : STA first
.face_loop
    LSR mask : BCC next
    LDX face : JSR draw_face
.next
    INC face
    LDA mask : BNE face_loop
    LDA tf_n : SEC : SBC first : BEQ none
    LDY dl_n
    STA dl_nf,Y
    LDA first : STA dl_f0,Y
    LDA of_slot : STA dl_obj,Y
    INC dl_n
.none
    RTS
}

ENDSECTION

SECTION ObjConst
\ A byte's nibbles moved: lo4[n] = (n << 4) AND &FF, hi4[n] = n >> 4
.lo4
    EQUB ((0..255) << 4) AND &FF
.hi4
    EQUB (0..255) >> 4
ENDSECTION

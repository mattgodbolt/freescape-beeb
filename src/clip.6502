\ ***************************************************************************
\ FREESCAPE for the BBC Master - a candidate's faces: the vertex pass, the
\ projection, the 2D clip and the cone (docs/engine.md, stages 4-6;
\ tools/model/clip.py, and render.py's draw_faces, which this follows step
\ for step)
\
\ For a polygon object (vertex_pass, then each face the camera sees, in its
\ object's face order):
\
\ - each vertex its seen faces use tested once against the band the
\   projection takes (band_test, the model's projectable), and each vertex
\   of a face with none outside it projected once (vertex_shared), in an
\   order that puts vertices sharing x and z, or z, together for project_y
\   and project_z, with its outcode against the view's rectangle;
\ - a face with every vertex projected (poly_face): wholly beyond one edge
\   it isn't drawn; with a vertex beyond any it's clipped in 2D; else its
\   repeats are dropped;
\ - any other face (cone_face, the model's cone_clip): every vertex in one
\   of code3's half-spaces drops it; else the view's rectangle clipped by
\   each of its edges' planes through the eye that cuts it, as a line on
\   the screen (edge_normal, edge_line, cone_pass): no near plane;
\ - drawn if three or more vertices are left, not all on one line.
\
\ A line's face or a point's (draw_segment): with an end the projection
\ can't take, a point isn't drawn and a line is clipped in 3D to the near
\ plane and the planes beyond the view's sides (seg_clip); then projected,
\ widened to the quad a one-pixel line covers or a pixel's square, and
\ clipped in 2D.
\
\ A crossing (the model's crossing_t and lerp) is one fraction t =
\ floor(2^16 f_P / (f_P - f_Q)) from the edge's inside end P (frac16), and
\ each coordinate P + (Q - P) t / 2^16 rounded half up (lerp).
\
\ The clips' new vertices are vertices VMAX onwards of the same arrays,
\ made afresh for each face. A drawn face's polygon goes into the output's
\ vertices (out_vx*, out_vy*: view coordinates, 16-bit) and its record into
\ tf_* in the order found; emit_faces (src/order.6502) puts the records in
\ out_f* nearest first.
\
\ Entry point:
\   draw_object   the candidate of_cand (slot of_slot), its vertices
\                 transformed: its drawn faces in tf_*, and the object on
\                 the draw list (dl_*) if any is. Needs the maths' tables
\                 readable.
\ ***************************************************************************

NPOLY       = 16                    ; a 3D polygon's vertices, at most
NP2         = 20                    ; a 2D polygon's, at most
NLINES      = VMAX                  ; a face's edges, at most
OUT_FACES   = 128                   ; faces a frame draws, at most
OUT_VERTS   = 256                   ; their vertices
OC_LEFT = 2 : OC_RIGHT = 4 : OC_TOP = 8 : OC_BOTTOM = 16
CLIP_W      = SUB * VIEW_W          ; the view's rectangle, in view coordinates
CLIP_H      = SUB * VIEW_H
HALF        = SUB DIV 2
ASSERT ZNEAR >= PROJ_ZNEAR          ; the projection takes what's in front of the near plane
\ Inside the guard band, which the band a vertex is projected in is inside
\ (tools/model/clip.py asserts), a projection is within 16 FX (8 FY) of the
\ centre, so the 2D clip's coordinates, their distances from the view's
\ edges and the differences of two (a crossing's denominator) all fit 16
\ bits.
ASSERT PROJ_XC + (VIEW_FX << GUARD_XS) + CLIP_W < &8000
ASSERT PROJ_YC + (VIEW_FY << GUARD_YS) + CLIP_H < &8000

SECTION ObjWork
.voc        SKIP VALL               ; a vertex's outcode against the view's rectangle
.vsxl       SKIP VALL               ; its projection
.vsxh       SKIP VALL
.vsyl       SKIP VALL
.vsyh       SKIP VALL
.fp_idx     SKIP NPOLY              ; the face's loop, as vertex indices (the cone's: the first again after the last)
.fp_bh      SKIP VMAX + 1           ; the cone's: 1 for a vertex of the loop at or behind the eye, the first again
\ the 2D polygons, 16-bit coordinates: the clip's passes go from one
\ buffer to the other and back; each pb array follows its pa array, so
\ that the cone's passes can take either as theirs by an index's base
.pa_xl      SKIP NP2
.pb_xl      SKIP NP2
.pa_xh      SKIP NP2
.pb_xh      SKIP NP2
.pa_yl      SKIP NP2
.pb_yl      SKIP NP2
.pa_yh      SKIP NP2
.pb_yh      SKIP NP2
.p_fl       SKIP 2 * NP2 + 1        ; a pass's f (bound - v, or v - bound) for each
.p_fh       SKIP 2 * NP2 + 1        ; vertex, the first again after the last (either half's)
.p_n        SKIP 1                  ; the 2D polygon's vertices
\ the faces drawn, in the order found
.tf_n       SKIP 1
.tf_fn      SKIP OUT_FACES          ; vertices
.tf_fv      SKIP OUT_FACES          ; the first, in out_v*
.tf_fc      SKIP OUT_FACES          ; colour
\ the draw list
.dl_n       SKIP 1
.dl_obj     SKIP N_OBJ
.dl_f0      SKIP N_OBJ
.dl_nf      SKIP N_OBJ
.dl_ord     SKIP N_OBJ              ; the sort's order: dl indices, farthest first
.next_new   SKIP 1                  ; the clips' next new vertex
.of_cand    SKIP 1                  ; the candidate being drawn
.of_slot    SKIP 1                  ; its slot
.out_over   SKIP 1                  ; non-zero if a frame's faces didn't fit
.vp_off     SKIP 1                  ; the object's vertices the projection can't take
.vp_need    SKIP 1                  ; ... and those to project, before they are
.vs_last    SKIP 1                  ; the vertex last projected (vertex_shared), or &FF
.vp_done    SKIP 1                  ; the object's vertices projected so far
\ the cone's: the vectors a plane's normal is made from, its lines (the
\ kept ones' f = A x + B y + C, as A, B and f at the rectangle's corners),
\ and the f of each vertex of the polygon a line clips (the first again
\ after the last)
.cn_v       SKIP 9                  ; three 24-bit, to cut to 16
.cn_w       SKIP 6                  ; ... cut
.cn_a16     SKIP 6                  ; an edge's start, cut
.lna0       SKIP NLINES             ; A, 16-bit
.lna1       SKIP NLINES
.lnb0       SKIP NLINES             ; B, 16-bit
.lnb1       SKIP NLINES
.lfc        SKIP 16 * NLINES        ; f at corner k, byte b: lfc + 32 k + 8 b
.cf0        SKIP 2 * NP2 + 1        ; (by the vertex's index, either half's)
.cf1        SKIP 2 * NP2 + 1
.cf2        SKIP 2 * NP2 + 1
.cf3        SKIP 2 * NP2 + 1
.pa_tg      SKIP NP2                ; the cone's tags: the rectangle's sides a vertex is on
.pb_tg      SKIP NP2
.pa_lb      SKIP NP2                ; ... and its edge to the next: LB_SIDE + a side, or a line's slot
.pb_lb      SKIP NP2
.ln_v0      SKIP NLINES             ; a kept line's edge: its vertices
.ln_v1      SKIP NLINES
.cp_src     SKIP 1                  ; the cone's polygon: at pa (0) or pb (NP2)
ENDSECTION
ASSERT pb_xl = pa_xl + NP2 AND pb_xh = pa_xh + NP2 AND pb_yl = pa_yl + NP2 AND pb_yh = pa_yh + NP2
ASSERT pb_tg = pa_tg + NP2 AND pb_lb = pa_lb + NP2

SECTION ObjOut
.out_nf     SKIP 1                  ; faces, nearest first
.out_vn     SKIP 1                  ; vertices used
.out_fn     SKIP OUT_FACES          ; a face's vertex count ...
.out_fv     SKIP OUT_FACES          ; ... its first vertex ...
.out_fc     SKIP OUT_FACES          ; ... and its colour index (1-15)
.out_vxl    SKIP OUT_VERTS          ; vertices, view coordinates (sixteenths), 16-bit
.out_vxh    SKIP OUT_VERTS
.out_vyl    SKIP OUT_VERTS
.out_vyh    SKIP OUT_VERTS
ENDSECTION
ASSERT OUT_VERTS = 256              ; (indexed by a byte)

\ NEG4 v: the 4-byte value v negated
MACRO NEG4 v
    LDA #0 : SEC : SBC v+0 : STA v+0
    LDA #0 : SBC v+1 : STA v+1
    LDA #0 : SBC v+2 : STA v+2
    LDA #0 : SBC v+3 : STA v+3
ENDMACRO

\ SEXT: A = &FF if C was set, else 0 (C as a sign bit, extended)
MACRO SEXT
    LDA #0 : ADC #&FF : EOR #&FF
ENDMACRO

\ ADD4 dst, src / SUB4 dst, src: 32-bit dst plus or less src
MACRO ADD4 dst, src
    LDA dst : CLC : ADC src : STA dst
    LDA dst+1 : ADC src+1 : STA dst+1
    LDA dst+2 : ADC src+2 : STA dst+2
    LDA dst+3 : ADC src+3 : STA dst+3
ENDMACRO
MACRO SUB4 dst, src
    LDA dst : SEC : SBC src : STA dst
    LDA dst+1 : SBC src+1 : STA dst+1
    LDA dst+2 : SBC src+2 : STA dst+2
    LDA dst+3 : SBC src+3 : STA dst+3
ENDMACRO
\ COPY4 dst, src
MACRO COPY4 dst, src
    LDA src : STA dst
    LDA src+1 : STA dst+1
    LDA src+2 : STA dst+2
    LDA src+3 : STA dst+3
ENDMACRO

SECTION ObjCode

\ ===========================================================================
\ Big numbers, for round_div (tools/model/clip.py): a byte product on the
\ maths' quarter squares, a product of four bytes by four, a long division
\ and the rounding.

\ umul8: up = A * Y, unsigned: sq[a + b] - ng[a - b + 255] (src/maths.6502's
\ tables, page-aligned, with b patched into the operands). Clobbers A, X.
.umul8
{
    ZA_AUTO2 up
    TAX
    TYA
    STA ul+1 : STA uh+1
    EOR #&FF
    STA nl+1 : STA nh+1
    SEC
.ul LDA sq_lo,X
.nl SBC ng_lo,X
    STA up
.uh LDA sq_hi,X
.nh SBC ng_hi,X
    STA up+1
    RTS
}

\ ===========================================================================
\ Crossings (the model's crossing_t and lerp).

\ frac16: ft = the model's crossing_t, from fp (4 bytes, at least 0) and fd
\ (4 bytes, fp less): fp and fd shifted right together by s = bitlen(fd) -
\ 16 if positive, so that fd fits 16 bits (whole bytes, then s MOD 8 bits
\ right, or 8 less that left and a byte down), then floor(2^16 fp / fd) by
\ sixteen steps of a long division, unrolled; then patched into lerp's
\ products. (When the shifts leave fp = fd, every step takes and ft is
\ &FFFF, the model's clamp.)
.frac16
{
    ZA_AUTO 4, fp
    ZA_AUTO 4, fd
    ZA_AUTO2 ft
    LDA fd+3 : BNE past24
    LDA fd+2 : BNE past16
    JMP divide                          ; (fd < 2^16: no shift)
.past16
    \ s = bitlen(fd's byte 2): bits from fd's byte 0, or a byte up when s = 8
    TAY : LDX proj_bl2,Y                ; 2 s
    CPX #16 : BNE shift
    LDA fd+1 : STA fd : LDA fd+2 : STA fd+1
    LDA fp+1 : STA fp : LDA fp+2 : STA fp+1
    JMP divide
.past24
    \ s = 8 + bitlen(fd's byte 3): bits from byte 1, or byte 2 when s = 16
    TAY : LDX proj_bl2,Y
    CPX #16 : BEQ s16
    LDA fd+1 : STA fd : LDA fd+2 : STA fd+1 : LDA fd+3 : STA fd+2
    LDA fp+1 : STA fp : LDA fp+2 : STA fp+1 : LDA fp+3 : STA fp+2
.shift
    JMP (fr_shift,X)
    ZA_CANJUMP FR_SHIFTS
.s16
    LDA fd+2 : STA fd : LDA fd+3 : STA fd+1
    LDA fp+2 : STA fp : LDA fp+3 : STA fp+1
    BRA divide
.r4 LSR fd+2 : ROR fd+1 : ROR fd : LSR fp+2 : ROR fp+1 : ROR fp
.r3 LSR fd+2 : ROR fd+1 : ROR fd : LSR fp+2 : ROR fp+1 : ROR fp
.r2 LSR fd+2 : ROR fd+1 : ROR fd : LSR fp+2 : ROR fp+1 : ROR fp
.r1 LSR fd+2 : ROR fd+1 : ROR fd : LSR fp+2 : ROR fp+1 : ROR fp
    BRA divide
.l3 ASL fd : ROL fd+1 : ROL fd+2 : ASL fp : ROL fp+1 : ROL fp+2
.l2 ASL fd : ROL fd+1 : ROL fd+2 : ASL fp : ROL fp+1 : ROL fp+2
.l1 ASL fd : ROL fd+1 : ROL fd+2 : ASL fp : ROL fp+1 : ROL fp+2
    LDA fd+1 : STA fd : LDA fd+2 : STA fd+1
    LDA fp+1 : STA fp : LDA fp+2 : STA fp+1
.divide
    LDA fp+1
    FOR k = 1..16
        ASL fp : ROL A
        BCS take                    ; (past 16 bits: at least fd)
        CMP fd+1 : BCC bit
        BNE take
        LDY fp : CPY fd : BCC bit
    .take
        TAY                         ; (C is set on every way here)
        LDA fp : SBC fd : STA fp
        TYA : SBC fd+1
        SEC
    .bit
        ROL ft : ROL ft+1
    NEXT
    \ t's bytes into lerp's quarter-square products (lerp.t0, lerp.t1)
    LDA ft
    STA lerp.a1+1 : STA lerp.a3+1
    EOR #&FF
    STA lerp.a2+1 : STA lerp.a4+1
    LDA ft+1
    STA lerp.b1+1 : STA lerp.b3+1
    EOR #&FF
    STA lerp.b2+1 : STA lerp.b4+1
    RTS
FR_SHIFTS = {divide, r1, r2, r3, r4, l3, l2, l1}
\ by 2 (s MOD 8)
.fr_shift
    EQUW divide, r1, r2, r3, r4, l3, l2, l1
}

\ lerp: lr (3 bytes) = round half up of ld (32-bit signed, its magnitude
\ within 24 bits) times frac16.ft / 2^16, modulo 2^24 (the model's lerp,
\ less p: the callers add it to a coordinate, and the sum fits): ld's
\ magnitude by t's two bytes, which frac16 patched into t0 and t1.
.lerp
{
    ZA_AUTO 4, ld
    ZA_AUTO 3, lr
    ZA_AUTO 3, u
    ZA_AUTO 5, p
    LDA ld+3 : BPL positive
    LDA #0 : SEC : SBC ld : STA u
    LDA #0 : SBC ld+1 : STA u+1
    LDA #0 : SBC ld+2 : STA u+2
    BRA sized
.positive
    LDA ld : STA u
    LDA ld+1 : STA u+1
    LDA ld+2 : STA u+2
.sized
    STZ p+3 : STZ p+4
    \ u0 t0 at byte 0, u0 t1 at 1
    LDX u
    JSR t0 : STA p+1
    LDA lerp_lo : STA p
    JSR t1 : STA p+2
    LDA lerp_lo : CLC : ADC p+1 : STA p+1
    BCC u1
    INC p+2
.u1
    \ u1 t0 at 1, u1 t1 at 2
    LDX u+1 : BEQ u2
    JSR t0 : TAY
    LDA lerp_lo : CLC : ADC p+1 : STA p+1
    TYA : ADC p+2 : STA p+2
    BCC u1_hi
    INC p+3
.u1_hi
    JSR t1 : TAY
    LDA lerp_lo : CLC : ADC p+2 : STA p+2
    TYA : ADC p+3 : STA p+3
    BCC u2
    INC p+4
.u2
    \ u2 t0 at 2, u2 t1 at 3
    LDX u+2 : BEQ rounded
    JSR t0 : TAY
    LDA lerp_lo : CLC : ADC p+2 : STA p+2
    TYA : ADC p+3 : STA p+3
    BCC u2_hi
    INC p+4
.u2_hi
    JSR t1 : TAY
    LDA lerp_lo : CLC : ADC p+3 : STA p+3
    TYA : ADC p+4 : STA p+4
.rounded
    \ (|product| + 2^15) >> 16 rounds a positive one half up; for a negative
    \ one it's -((|product| + 2^15 - 1) >> 16). So &7FFF plus C, with C set
    \ for a positive product, then >> 16.
    LDA ld+3 : EOR #&80 : ASL A
    LDA p : ADC #&FF
    LDA p+1 : ADC #&7F
    LDA p+2 : ADC #0 : STA lr
    LDA p+3 : ADC #0 : STA lr+1
    LDA p+4 : ADC #0 : STA lr+2
    BIT ld+3 : BPL done
    LDA #0 : SEC : SBC lr : STA lr
    LDA #0 : SBC lr+1 : STA lr+1
    LDA #0 : SBC lr+2 : STA lr+2
.done
    RTS
\ t0, t1: X times t's low or high byte: the product's low byte in lerp_lo, its
\ high byte in A
.t0
    SEC
.a1 LDA sq_lo,X
.a2 SBC ng_lo,X
    STA lerp_lo
.a3 LDA sq_hi,X
.a4 SBC ng_hi,X
    RTS
.t1
    SEC
.b1 LDA sq_lo,X
.b2 SBC ng_lo,X
    STA lerp_lo
.b3 LDA sq_hi,X
.b4 SBC ng_hi,X
    RTS
}
ZA_AUTO1 lerp_lo


\ ===========================================================================
\ In two dimensions: the polygon in pa_* (p_n vertices, 16-bit signed view
\ coordinates).

\ COPY2D: pa's vertex X copied to vertex Y
MACRO COPY2D
    LDA pa_xl,X : STA pa_xl,Y
    LDA pa_xh,X : STA pa_xh,Y
    LDA pa_yl,X : STA pa_yl,Y
    LDA pa_yh,X : STA pa_yh,Y
ENDMACRO

\ QUAD_OFF l, h, tab: pa's coordinate (l, h) at X plus tab's offset for X
\ (four low bytes, then four high)
MACRO QUAD_OFF l, h, tab
    LDA l,X : CLC : ADC tab,X : STA l,X
    LDA h,X : ADC tab+4,X : STA h,X
ENDMACRO

\ line_quad: the line from vertex 0 to vertex 1 as the polygon a one-pixel
\ line covers (the model's line_quad): a, b, b, a, moved half a pixel each
\ way across its major axis.
.line_quad
{
    ZA_AUTO2 dx, dy
    \ |b - a| on each axis: the difference has 17 bits, its sign N EOR V
    LDA pa_xl+1 : SEC : SBC pa_xl : STA dx
    LDA pa_xh+1 : SBC pa_xh : STA dx+1
    BVC dx_signed
    EOR #&80
.dx_signed
    BPL dx_pos
    LDA #0 : SEC : SBC dx : STA dx
    LDA #0 : SBC dx+1 : STA dx+1
.dx_pos
    LDA pa_yl+1 : SEC : SBC pa_yl : STA dy
    LDA pa_yh+1 : SBC pa_yh : STA dy+1
    BVC dy_signed
    EOR #&80
.dy_signed
    BPL dy_pos
    LDA #0 : SEC : SBC dy : STA dy
    LDA #0 : SBC dy+1 : STA dy+1
.dy_pos
    \ vertices 2 and 3 are b and a again
    LDX #1 : LDY #2
    COPY2D
    LDX #0 : LDY #3
    COPY2D
    LDA #4 : STA p_n
    \ |dx| >= |dy|: across is y
    LDA dx : CMP dy
    LDA dx+1 : SBC dy+1
    LDX #3
    BCC steep
.flat
    QUAD_OFF pa_yl, pa_yh, quad_across
    DEX : BPL flat
    RTS
.steep
    QUAD_OFF pa_xl, pa_xh, quad_across
    DEX : BPL steep
    RTS
}
ASSERT (PROJ_XC + (VIEW_FX << GUARD_XS)) * 2 < &10000   ; (|b - a| fits 16 bits)

\ point_square: vertex 0 as the square round the pixel it's in (the
\ model's point_square).
.point_square
{
    LDX #0
    LDY #1 : COPY2D
    LDY #2 : COPY2D
    LDY #3 : COPY2D
    LDA #4 : STA p_n
    LDX #3
.corner
    QUAD_OFF pa_xl, pa_xh, quad_x
    QUAD_OFF pa_yl, pa_yh, quad_across
    DEX : BPL corner
    RTS
}
\ the quads' offsets: across a line (and a square's y), and a square's x
.quad_across
    EQUB LO(-HALF), LO(-HALF), LO(HALF), LO(HALF)
    EQUB HI(-HALF), HI(-HALF), HI(HALF), HI(HALF)
.quad_x
    EQUB LO(-HALF), LO(HALF), LO(HALF), LO(-HALF)
    EQUB HI(-HALF), HI(HALF), HI(HALF), HI(-HALF)

\ The 2D clip is in ObjMore (main RAM, which any bank paged sees), its four
\ sides' passes each written out, with its crossings (clip_cut) and their
\ table; lerp and dedupe are ObjCode's.
ENDSECTION
SECTION ObjMore

\ clip_cut: r = the crossing's other coordinate, P's + lerp(Q's - P's) by
\ the 2D clip's fraction (the model's crossing_r), from fp >= 0 at P and fq
\ < 0 at Q (16-bit signed each, so d = fp - fq fits 16 bits unsigned): d's
\ nine bits from its top one, dn = d >> s (s = bitlen(d) - 9, a shift left
\ when it's negative), R = 256 + clip_m[dn - 256], and t = fp R >> k, k = s
\ + 1, at most &FFFF, then patched into lerp's products.
.clip_cut
{
    ZA_AUTO2 fp, fq, po, qo, r
    ZA_AUTO2 d
    ZA_AUTO 4, pr
    ZA_AUTO1 k
    LDA fp : SEC : SBC fq : STA d
    LDA fp+1 : SBC fq+1 : STA d+1 : BEQ small
    \ d >= 256: k = bitlen(d's high byte), 1 to 8, and dn's low byte is d's
    \ low byte with s = k - 1 of its high byte's bits shifted in from above
    TAY : LDA proj_bl2,Y : LSR A : STA k
    TAY : DEY
    LDA d
    CPY #0 : BEQ indexed
.right
    LSR d+1 : ROR A
    DEY : BNE right
    BRA indexed
.small
    \ d < 256: k = bitlen(d) - 8, -7 to 0, and dn = d << (1 - k), its top
    \ bit (the implicit one) shifted out
    LDY d : LDA proj_bl2,Y : LSR A
    SEC : SBC #8 : STA k
    EOR #&FF : TAY : INY : INY
    LDA d
.left
    ASL A
    DEY : BNE left
.indexed
    \ fp R = fp M + 256 fp, M = clip_m[dn - 256], by cone_qs's products
    TAY : LDA clip_m,Y
    STA cone_qs.a+1 : STA cone_qs.c+1   ; (QS_SET's)
    EOR #&FF
    STA cone_qs.b+1 : STA cone_qs.d+1
    LDX fp : JSR cone_qs
    STA pr+1
    LDA cq_lo : STA pr
    LDX fp+1 : JSR cone_qs
    STA pr+2
    STZ pr+3
    LDA cq_lo : CLC : ADC pr+1 : STA pr+1
    BCC carried
    INC pr+2                            ; (hi(fh M) < 255: no carry on)
.carried
    LDA pr+1 : CLC : ADC fp : STA pr+1
    LDA pr+2 : ADC fp+1 : STA pr+2      ; (fp < 2^15, R < 2^9: no carry on)
    \ t = fp R >> k: k from 4 up, left 8 - k and a byte down; 1 to 3,
    \ right k; at most 0, left -k
    LDA k : BMI up
    BEQ shifted
    CMP #4 : BCS byte
    TAY
.down
    LSR pr+3 : ROR pr+2 : ROR pr+1 : ROR pr
    DEY : BNE down
    BRA shifted
.byte
    LDA #8 : SEC : SBC k : TAY          ; 8 - k, 0 to 4
    BEQ moved
.across
    ASL pr : ROL pr+1 : ROL pr+2 : ROL pr+3
    DEY : BNE across
.moved
    LDA pr+1 : STA pr
    LDA pr+2 : STA pr+1
    LDA pr+3 : STA pr+2
    STZ pr+3
    BRA shifted
.up
    EOR #&FF : TAY : INY                ; -k, 1 to 7
.lift
    ASL pr : ROL pr+1 : ROL pr+2 : ROL pr+3
    DEY : BNE lift
.shifted
    \ at most &FFFF, then into lerp's products (lerp.t0, lerp.t1)
    LDA pr+2 : ORA pr+3 : BEQ fits
    LDA #&FF : STA pr : STA pr+1
.fits
    LDA pr
    STA lerp.a1+1 : STA lerp.a3+1
    EOR #&FF
    STA lerp.a2+1 : STA lerp.a4+1
    LDA pr+1
    STA lerp.b1+1 : STA lerp.b3+1
    EOR #&FF
    STA lerp.b2+1 : STA lerp.b4+1
    \ Q's - P's, 17 bits signed, as lerp's 32
    LDA qo : SEC : SBC po : STA lerp.ld
    LDA qo+1 : SBC po+1 : STA lerp.ld+1
    \ (the sign from the 17th bit: V gives it with N)
    LDA #0 : BVC no_overflow
    LDA #&FF
.no_overflow
    EOR lerp.ld+1 : ASL A               ; C = the true sign
    SEXT : STA lerp.ld+2 : STA lerp.ld+3
    JSR lerp
    LDA lerp.lr : CLC : ADC po : STA r
    LDA lerp.lr+1 : ADC po+1 : STA r+1
    RTS
}
\ the 2D clip's reciprocals, less 256 (tools/model/maths.py's CLIP_M)
.clip_m
    EQUB CLIP_M
ASSERT CLIP_RBITS = 9 AND LEN(CLIP_M) = 256


\ CLIP_PASS sa_l, sa_h, so_l, so_h, bound, below: one side of the view's
\ rectangle (the model's _clip_edge), from the polygon's half of the pa and
\ pb arrays (clip2d.src: 0 or NP2) to the other: its arrays on the side's
\ axis, then the other's; keep the axis's coordinate <= bound if below,
\ else >= bound (which is 0); a crossing from the edge's inside end. Z set
\ if nothing's left.
MACRO CLIP_PASS sa_l, sa_h, so_l, so_h, bound, below
    LDX clip2d.src
    TXA : CLC : ADC p_n : STA clip2d.end
.f
    IF below
        LDA #LO(bound) : SEC : SBC sa_l,X : STA p_fl,X
        LDA #HI(bound) : SBC sa_h,X : STA p_fh,X
    ELSE
        ASSERT bound = 0
        LDA sa_l,X : STA p_fl,X
        LDA sa_h,X : STA p_fh,X
    ENDIF
    INX : CPX clip2d.end : BNE f
    LDY clip2d.src                      ; the first again after the last
    LDA p_fl,Y : STA p_fl,X
    LDA p_fh,Y : STA p_fh,X
    LDA #NP2 : SEC : SBC clip2d.src : STA clip2d.m
    TYA : TAX
.vertex
    STX clip2d.i
    LDA p_fh,X : BMI a_out
    LDY clip2d.m
    LDA sa_l,X : STA sa_l,Y
    LDA sa_h,X : STA sa_h,Y
    LDA so_l,X : STA so_l,Y
    LDA so_h,X : STA so_h,Y
    INC clip2d.m
    LDA p_fh+1,X : BPL next             ; both in
    \ the crossing from a (X) to b
    STX clip2d.ip
    INX : CPX clip2d.end : BNE b_set
    LDX clip2d.src
.b_set
    STX clip2d.iq
    BRA cut
.a_out
    LDA p_fh+1,X : BMI next             ; both out
    \ the crossing from b to a (X)
    STX clip2d.iq
    INX : CPX clip2d.end : BNE p_set
    LDX clip2d.src
.p_set
    STX clip2d.ip
.cut
    LDX clip2d.ip : LDY clip2d.iq
    LDA p_fl,X : STA clip_cut.fp
    LDA p_fh,X : STA clip_cut.fp+1
    LDA p_fl,Y : STA clip_cut.fq
    LDA p_fh,Y : STA clip_cut.fq+1
    LDA so_l,X : STA clip_cut.po
    LDA so_h,X : STA clip_cut.po+1
    LDA so_l,Y : STA clip_cut.qo
    LDA so_h,Y : STA clip_cut.qo+1
    JSR clip_cut
    LDY clip2d.m
    LDA #LO(bound) : STA sa_l,Y
    LDA #HI(bound) : STA sa_h,Y
    LDA clip_cut.r : STA so_l,Y
    LDA clip_cut.r+1 : STA so_h,Y
    INC clip2d.m
.next
    LDX clip2d.i : INX : CPX clip2d.end : BEQ finished
    JMP vertex
.finished
    \ the other half's now
    LDA #NP2 : SEC : SBC clip2d.src : STA clip2d.src
    LDA clip2d.m : SEC : SBC clip2d.src : STA p_n
ENDMACRO
ASSERT NP2 >= 4 + 4 * 2                 ; a widened line, cut by every edge

\ clip2d: the polygon in pa clipped to the view's rectangle, [0, CLIP_W] x
\ [0, CLIP_H] (the model's clip2d), then its repeats dropped. A = the edges
\ a vertex is beyond (OC_*): the passes for the others are skipped, as
\ they'd change nothing (a crossing lies between its edge's ends, so it
\ isn't beyond an edge neither of them is). Each pass writes the other half
\ of the pa and pb arrays; the polygon comes back to pa at the end.
.clip2d
{
    ZA_AUTO1 m, i, ip, iq, edges, src, end
    STA edges
    STZ src
    LDA #OC_LEFT : BIT edges : BNE pass1
    JMP pass2
.pass1
    CLIP_PASS pa_xl, pa_xh, pa_yl, pa_yh, 0, FALSE
    BNE pass2
    RTS
.pass2
    LDA #OC_RIGHT : BIT edges : BNE pass2_do
    JMP pass3
.pass2_do
    CLIP_PASS pa_xl, pa_xh, pa_yl, pa_yh, CLIP_W, TRUE
    BNE pass3
    RTS
.pass3
    LDA #OC_TOP : BIT edges : BNE pass3_do
    JMP pass4
.pass3_do
    CLIP_PASS pa_yl, pa_yh, pa_xl, pa_xh, 0, FALSE
    BNE pass4
    RTS
.pass4
    LDA #OC_BOTTOM : BIT edges : BNE pass4_do
    JMP passed
.pass4_do
    CLIP_PASS pa_yl, pa_yh, pa_xl, pa_xh, CLIP_H, TRUE
    BNE passed
    RTS
.passed
    \ in pb: down to pa
    LDA src : BEQ in_pa
    LDX p_n
.down
    DEX
    LDA pb_xl,X : STA pa_xl,X
    LDA pb_xh,X : STA pa_xh,X
    LDA pb_yl,X : STA pa_yl,X
    LDA pb_yh,X : STA pa_yh,X
    TXA : BNE down
.in_pa
    JMP dedupe
}

ENDSECTION
SECTION ObjCode
\ SAME2D: Z set if pa's vertices X and Y are the same point
MACRO SAME2D
    LDA pa_xl,X : CMP pa_xl,Y : BNE done
    LDA pa_xh,X : CMP pa_xh,Y : BNE done
    LDA pa_yl,X : CMP pa_yl,Y : BNE done
    LDA pa_yh,X : CMP pa_yh,Y
.done
ENDMACRO

\ dedupe: the polygon without repeated vertices next to each other, the
\ last and first included (the model's dedupe).
.dedupe
{
    ZA_AUTO1 m
    LDA p_n : BNE some
    RTS
.some
    LDA #1 : STA m                  ; vertex 0 stays
    LDX #1
    CPX p_n : BEQ wrap
.vertex
    LDY m : DEY
    SAME2D
    BEQ next
    LDY m
    COPY2D
    INC m
.next
    INX : CPX p_n : BNE vertex
.wrap
    \ while more than one and the last is the first, drop the last
    LDY m
.tail
    CPY #2 : BCC counted
    DEY : LDX #0
    SAME2D
    BEQ tail
    INY
.counted
    STY p_n
    RTS
}

\ umul16: mp (4 bytes) = ma * mb, each unsigned 16-bit; a zero high byte
\ costs nothing.
.umul16
{
    ZA_AUTO2 ma, mb
    ZA_AUTO 4, mp
    LDA ma : LDY mb : JSR umul8
    LDA umul8.up : STA mp
    LDA umul8.up+1 : STA mp+1
    STZ mp+2 : STZ mp+3
    LDY mb+1 : BEQ no_b1
    LDA ma : JSR umul8
    LDA mp+1 : CLC : ADC umul8.up : STA mp+1
    LDA mp+2 : ADC umul8.up+1 : STA mp+2
.no_b1
    LDA ma+1 : BEQ done
    LDY mb : JSR umul8
    LDA mp+1 : CLC : ADC umul8.up : STA mp+1
    LDA mp+2 : ADC umul8.up+1 : STA mp+2
    BCC no_carry
    INC mp+3
.no_carry
    LDY mb+1 : BEQ done
    LDA ma+1 : JSR umul8
    LDA mp+2 : CLC : ADC umul8.up : STA mp+2
    LDA mp+3 : ADC umul8.up+1 : STA mp+3
.done
    RTS
}

\ A drawn face goes into the output in three steps: its polygon into out_v*
\ from out_vn (stage_pa from pa, or poly_face's own), the drawn test on it
\ there (drawable), and its record (commit), which counts its vertices in.

\ DIFF2D dst, arr_l, arr_h: dst = out_v's coordinate at X less vertex 0's
\ at Y (16-bit; inside the view, so small)
MACRO DIFF2D dst, arr_l, arr_h
    LDA arr_l,X : SEC : SBC arr_l,Y : STA dst
    LDA arr_h,X : SBC arr_h,Y : STA dst+1
ENDMACRO

\ ABS16 v: |v| (16-bit), and A = v's sign: &81 negative, 1 positive, 0 (Z
\ set) zero. Two such signs EORed, ORed with 1, are their product's.
MACRO ABS16 v
    LDA v+1 : BPL positive
    LDA #0 : SEC : SBC v : STA v
    LDA #0 : SBC v+1 : STA v+1
    LDA #&81
    BRA done
.positive
    LDA v : ORA v+1 : BEQ done
    LDA #1
.done
ENDMACRO

\ PSIGN s: A = the sign (ABS16's) of the product of A's and s's
MACRO PSIGN s
    BEQ done                        ; (A zero: the product's zero)
    LDX s : BEQ zero
    EOR s : ORA #1
    BRA done
.zero
    LDA #0
.done
ENDMACRO

\ ORDER16 a, b: A = 1 if |a| > |b|, &FF if less, 0 if equal (sizes under
\ 2^15). Clobbers X.
MACRO ORDER16 a, b
    LDA a : SEC : SBC b : TAX
    LDA a+1 : SBC b+1 : BMI less
    BNE more
    CPX #0 : BEQ done               ; (A = 0)
.more
    LDA #1
    BRA done
.less
    LDA #&FF
.done
ENDMACRO

\ drawable: C set if the polygon staged in out_v (p_n vertices from out_vn,
\ its repeats dropped, inside the view) is drawn (the model's drawable):
\ three or more vertices, one off the line through the first two. dx ey =
\ dy ex is decided by the products' zeros and signs where it can be (from
\ the differences' high bytes, before any size is taken), then by the
\ sizes' order (|dx| > |dy| and |ey| > |ex| make dx ey the larger, and the
\ other way about), else by the products.
.drawable
{
    ZA_AUTO2 dx, dy, ex, ey
    ZA_AUTO1 i, s1, end, dxz, dyz, sized, sxy
    LDA p_n : CMP #3 : BCS enough
    RTS                             ; (C clear)
.enough
    CLC : ADC out_vn : STA end
    LDY out_vn : LDX out_vn : INX
    DIFF2D dx, out_vxl, out_vxh
    DIFF2D dy, out_vyl, out_vyh
    \ dxz, dyz: non-zero if dx, dy are zero; sxy: their signs EORed (bit 7)
    LDA dx : ORA dx+1 : CMP #1 : LDA #0 : ROL A : EOR #1 : STA dxz
    LDA dy : ORA dy+1 : CMP #1 : LDA #0 : ROL A : EOR #1 : STA dyz
    LDA dx+1 : EOR dy+1 : STA sxy
    STZ sized
    LDA out_vn : CLC : ADC #2 : STA i
.vertex
    LDX i : LDY out_vn
    DIFF2D ex, out_vxl, out_vxh
    DIFF2D ey, out_vyl, out_vyh
    \ dx ey zero? then dy ex must be too, else it's off the line
    LDA dxz : BNE e1_zero
    LDA ey : ORA ey+1 : BEQ e1_zero
    \ dx ey not zero: dy ex must be, with the same sign, for it to be on the line
    LDA dyz : BNE off_line
    LDA ex : ORA ex+1 : BEQ off_line
    LDA ey+1 : EOR ex+1 : EOR sxy : BMI off_line
    JMP sizes                       ; (the same sign)
.e1_zero
    LDA dyz : BNE next
    LDA ex : ORA ex+1 : BNE off_line
.next
    INC i : LDA i : CMP end : BEQ on_line
    JMP vertex
.on_line
    CLC
    RTS
.off_line
    SEC
    RTS
.sizes
    \ the same sign: the sizes decide, by their order if it can
    LDA sized : BNE have_sizes
    INC sized
    ABS16 dx
    ABS16 dy
    ORDER16 dx, dy : STA s1
.have_sizes
    ABS16 ex
    ABS16 ey
    LDA s1 : BEQ products
    ORDER16 ey, ex : CMP s1 : BEQ off
.products
    LDA dx : STA umul16.ma
    LDA dx+1 : STA umul16.ma+1
    LDA ey : STA umul16.mb
    LDA ey+1 : STA umul16.mb+1
    JSR umul16
    LDA umul16.mp : PHA
    LDA umul16.mp+1 : PHA
    LDA umul16.mp+2 : PHA
    LDA umul16.mp+3 : PHA
    LDA dy : STA umul16.ma
    LDA dy+1 : STA umul16.ma+1
    LDA ex : STA umul16.mb
    LDA ex+1 : STA umul16.mb+1
    JSR umul16
    PLA : CMP umul16.mp+3 : BNE pop3
    PLA : CMP umul16.mp+2 : BNE pop2
    PLA : CMP umul16.mp+1 : BNE pop1
    PLA : CMP umul16.mp : BNE off
    JMP next
.pop3
    PLA
.pop2
    PLA
.pop1
    PLA
.off
    SEC
    RTS
}

\ stage_pa: pa's polygon (p_n vertices) into out_v* from out_vn, not yet
\ counted: C clear if it has fewer than three vertices, or if it wouldn't
\ fit (out_over set).
.stage_pa
{
    LDA p_n : CMP #3 : BCC none
    LDA tf_n : CMP #OUT_FACES : BCS over
    LDA out_vn : CLC : ADC p_n : BCS over
    LDY out_vn
    LDX #0
.vertex
    LDA pa_xl,X : STA out_vxl,Y
    LDA pa_xh,X : STA out_vxh,Y
    LDA pa_yl,X : STA out_vyl,Y
    LDA pa_yh,X : STA out_vyh,Y
    INY
    INX : CPX p_n : BNE vertex
    SEC
    RTS
.over
    LDA #1 : STA out_over
    CLC
.none
    RTS
}

\ commit: the polygon staged in out_v (p_n vertices from out_vn) as a drawn
\ face of colour A: its record into tf_*, its vertices counted.
.commit
    LDX tf_n
    STA tf_fc,X
    LDA p_n : STA tf_fn,X
    LDA out_vn : STA tf_fv,X
    CLC : ADC p_n : STA out_vn
    INC tf_n
    RTS

\ ===========================================================================
\ A line's face, or a point's (the model's _cone_face for them): with an end
\ the projection can't take, a point isn't drawn and a line is first
\ clipped in 3D (seg_clip); projected, wholly beyond one of the view's edges
\ it isn't drawn; else widened to the quad a one-pixel line covers, or a
\ pixel's square, and clipped to the view.

\ seg_f: sf (32-bit) = the plane seg_clip.plane's f at vertex X (the
\ model's SEGMENT_PLANES: z - ZNEAR, z + x, z - x, z - 2y, z + 2y). X is
\ kept.
.seg_f
{
    ZA_AUTO 4, st
    LDA vz0,X : STA sf
    LDA vz1,X : STA sf+1
    LDA vz2,X : STA sf+2
    ASL A : SEXT : STA sf+3
    LDY seg_clip.plane : BEQ near
    CPY #3 : BCS y_plane
    LDA vx0,X : STA st
    LDA vx1,X : STA st+1
    LDA vx2,X : STA st+2
    ASL A : SEXT : STA st+3
    BRA got
.y_plane
    LDA vy0,X : ASL A : STA st
    LDA vy1,X : ROL A : STA st+1
    LDA vy2,X : ROL A : STA st+2
    SEXT : STA st+3                     ; (C: y's sign)
.got
    LDA adds,Y : BEQ less
    ADD4 sf, st
    RTS
.less
    SUB4 sf, st
    RTS
.near
    LDA sf : SEC : SBC #LO(ZNEAR) : STA sf
    LDA sf+1 : SBC #HI(ZNEAR) : STA sf+1
    LDA sf+2 : SBC #ZNEAR >> 16 : STA sf+2
    LDA sf+3 : SBC #0 : STA sf+3
    RTS
.adds
    EQUB 0, 1, 0, 0, 1
}
ZA_AUTO 4, sf

\ SP_AXIS a0, a1, a2: seg_point's new vertex on one axis (its arrays): P +
\ lerp(Q - P)
MACRO SP_AXIS a0, a1, a2
    LDX seg_point.ip : LDY seg_point.iq
    LDA a2,X : ASL A : SEXT : STA seg_point.sp
    LDA a2,Y : ASL A : SEXT : STA seg_point.sq
    LDA a0,Y : SEC : SBC a0,X : STA lerp.ld+0
    LDA a1,Y : SBC a1,X : STA lerp.ld+1
    LDA a2,Y : SBC a2,X : STA lerp.ld+2
    LDA seg_point.sq : SBC seg_point.sp : STA lerp.ld+3
    JSR lerp
    LDY next_new : LDX seg_point.ip
    LDA lerp.lr+0 : CLC : ADC a0,X : STA a0,Y
    LDA lerp.lr+1 : ADC a1,X : STA a1,Y
    LDA lerp.lr+2 : ADC a2,X : STA a2,Y
ENDMACRO

\ seg_point: vertex next_new = the crossing (the model's crossing) from
\ vertex X, inside the plane (its f in frac16.fp, and fp less the outside
\ end's f in frac16.fd), to vertex Y.
.seg_point
{
    ZA_AUTO1 ip, iq, sp, sq
    STX ip : STY iq
    JSR frac16
    SP_AXIS vx0, vx1, vx2
    SP_AXIS vy0, vy1, vy2
    SP_AXIS vz0, vz1, vz2
    RTS
}

\ seg_clip: the segment from vertex fp_idx to vertex fp_idx+1 clipped to
\ each plane of the model's SEGMENT_PLANES in turn, a crossing from the
\ inside end replacing an end outside: its ends in fp_idx and fp_idx+1, C
\ clear if nothing's left. New vertices from VMAX on.
.seg_clip
{
    ZA_AUTO1 plane
    ZA_AUTO 4, fa
    LDA #VMAX : STA next_new
    STZ plane
.plane_loop
    LDX fp_idx : JSR seg_f
    COPY4 fa, sf
    LDX fp_idx+1 : JSR seg_f            ; (sf: b's)
    LDA fa+3 : BPL a_in
    LDA sf+3 : BMI empty                ; both outside
    \ a outside: the crossing from b
    LDX fp_idx+1 : LDY fp_idx
    JSR from_b
    LDA next_new : STA fp_idx
    BRA made
.a_in
    LDA sf+3 : BPL next                 ; both inside
    \ b outside: the crossing from a
    LDX fp_idx : LDY fp_idx+1
    JSR from_a
    LDA next_new : STA fp_idx+1
.made
    INC next_new
.next
    INC plane : LDA plane : CMP #5 : BNE plane_loop
    SEC
    RTS
.empty
    CLC
    RTS
\ from_a, from_b: frac16's fp the inside end's f, fd it less the outside
\ end's, then seg_point (X and Y kept for it)
.from_a
    LDA fa : STA frac16.fp : SEC : SBC sf : STA frac16.fd
    LDA fa+1 : STA frac16.fp+1 : SBC sf+1 : STA frac16.fd+1
    LDA fa+2 : STA frac16.fp+2 : SBC sf+2 : STA frac16.fd+2
    LDA fa+3 : STA frac16.fp+3 : SBC sf+3 : STA frac16.fd+3
    JMP seg_point
.from_b
    LDA sf : STA frac16.fp : SEC : SBC fa : STA frac16.fd
    LDA sf+1 : STA frac16.fp+1 : SBC fa+1 : STA frac16.fd+1
    LDA sf+2 : STA frac16.fp+2 : SBC fa+2 : STA frac16.fd+2
    LDA sf+3 : STA frac16.fp+3 : SBC fa+3 : STA frac16.fd+3
    JMP seg_point
}
ASSERT VMAX + 5 <= VALL                 ; (a new vertex a plane at most)

\ draw_segment: face X of a line or a point object.
.draw_segment
{
    ZA_AUTO1 face, n
    STX face
    LDA fa_nv,X : STA n
    LDY fa_loop,X
    LDA lp_table,Y : STA fp_idx
    LDA lp_table+1,Y : STA fp_idx+1
    LDX fp_idx : JSR band_test : BCS hard
    LDA n : CMP #2 : BNE project
    LDX fp_idx+1 : JSR band_test : BCC project
.hard
    LDA n : CMP #2 : BNE rejected       ; (a point the projection can't take)
    JSR seg_clip : BCC rejected
.project
    LDA #&FF : STA vs_last
    LDX fp_idx : JSR vertex_shared
    LDA n : CMP #2 : BNE projected
    LDX fp_idx+1 : JSR vertex_shared
.projected
    LDX #0
.gather
    LDY fp_idx,X
    LDA vsxl,Y : STA pa_xl,X
    LDA vsxh,Y : STA pa_xh,X
    LDA vsyl,Y : STA pa_yl,X
    LDA vsyh,Y : STA pa_yh,X
    INX : CPX n : BNE gather
    STX p_n
    \ wholly beyond one of the view's edges: not drawn
    LDY fp_idx : LDA voc,Y
    CPX #2 : BNE every
    LDY fp_idx+1 : AND voc,Y
.every
    TAY : BNE rejected                  ; (the code: CPX left Z its own)
    CPX #2 : BNE point
    JSR line_quad
    BRA widened
.point
    JSR point_square
.widened
    LDA #OC_LEFT OR OC_RIGHT OR OC_TOP OR OC_BOTTOM
    JSR clip2d
    JSR stage_pa : BCC rejected
    JSR drawable : BCC rejected
    LDX face : LDA fa_col,X
    JMP commit
.rejected
    RTS
}

\ ===========================================================================
\ The cone (the model's clip.py, "The cone", and render.py's edge_lines): a
\ face the projection can't take whole is the view's rectangle clipped, in
\ 2D, by its edges' planes through the eye, each a line on the screen.
\ Every quantity is the model's integer, exactly.

\ QS_SET: the quarter squares' operands patched for the byte in A (umul8's
\ way), for cone_qs. Clobbers A.
MACRO QS_SET
    STA cone_qs.a+1 : STA cone_qs.c+1
    EOR #&FF
    STA cone_qs.b+1 : STA cone_qs.d+1
ENDMACRO

\ cone_qs: X times the patched byte: its low byte in cq_lo, its high byte in
\ A. Clobbers nothing else.
.cone_qs
{
    SEC
.a  LDA sq_lo,X
.b  SBC ng_lo,X
    STA cq_lo
.c  LDA sq_hi,X
.d  SBC ng_hi,X
    RTS
}
ZA_AUTO1 cq_lo

\ smul16: sm_p (4 bytes) = sm_a times sm_b, each signed 16-bit (umul16 on
\ their sizes).
.smul16
{
    ZA_AUTO1 neg
    LDA sm_a+1 : EOR sm_b+1 : STA neg
    LDA sm_a+1 : BPL a_pos
    LDA #0 : SEC : SBC sm_a : STA umul16.ma
    LDA #0 : SBC sm_a+1 : STA umul16.ma+1
    BRA a_got
.a_pos
    STA umul16.ma+1
    LDA sm_a : STA umul16.ma
.a_got
    LDA sm_b+1 : BPL b_pos
    LDA #0 : SEC : SBC sm_b : STA umul16.mb
    LDA #0 : SBC sm_b+1 : STA umul16.mb+1
    BRA b_got
.b_pos
    STA umul16.mb+1
    LDA sm_b : STA umul16.mb
.b_got
    JSR umul16
    LDA umul16.mp : STA sm_p
    LDA umul16.mp+1 : STA sm_p+1
    LDA umul16.mp+2 : STA sm_p+2
    LDA umul16.mp+3 : STA sm_p+3
    BIT neg : BPL done
    NEG4 sm_p
.done
    RTS
}
ZA_AUTO 2, sm_a
ZA_AUTO 2, sm_b
ZA_AUTO 4, sm_p

OC_BEHIND = 32

\ vertex_code3: A = vertex Y's code3 (the model's): which of x < -z, x > z,
\ 2y > z, 2y < -z and z <= 0 it's in (OC_LEFT, OC_RIGHT, OC_TOP, OC_BOTTOM,
\ OC_BEHIND), each a 32-bit sum's sign. X and Y are kept.
.vertex_code3
{
    ZA_AUTO1 code, xs, zs
    ZA_AUTO 4, y2
    STZ code
    LDA vx2,Y : ASL A : SEXT : STA xs
    LDA vz2,Y : ASL A : SEXT : STA zs
    LDA vy0,Y : ASL A : STA y2
    LDA vy1,Y : ROL A : STA y2+1
    LDA vy2,Y : ROL A : STA y2+2
    SEXT : STA y2+3                     ; (C: 2y's sign, which is y's)
    \ x + z < 0
    LDA vx0,Y : CLC : ADC vz0,Y
    LDA vx1,Y : ADC vz1,Y
    LDA vx2,Y : ADC vz2,Y
    LDA xs : ADC zs : BPL not_left
    LDA #OC_LEFT : TSB code
.not_left
    \ z - x < 0
    LDA vz0,Y : SEC : SBC vx0,Y
    LDA vz1,Y : SBC vx1,Y
    LDA vz2,Y : SBC vx2,Y
    LDA zs : SBC xs : BPL not_right
    LDA #OC_RIGHT : TSB code
.not_right
    \ z - 2y < 0
    LDA vz0,Y : SEC : SBC y2
    LDA vz1,Y : SBC y2+1
    LDA vz2,Y : SBC y2+2
    LDA zs : SBC y2+3 : BPL not_top
    LDA #OC_TOP : TSB code
.not_top
    \ z + 2y < 0
    LDA vz0,Y : CLC : ADC y2
    LDA vz1,Y : ADC y2+1
    LDA vz2,Y : ADC y2+2
    LDA zs : ADC y2+3 : BPL not_bottom
    LDA #OC_BOTTOM : TSB code
.not_bottom
    \ z <= 0
    LDA vz2,Y : BMI behind
    ORA vz1,Y : ORA vz0,Y : BNE in_front
.behind
    LDA #OC_BEHIND : TSB code
.in_front
    LDA code
    RTS
}
ASSERT OC_BEHIND <> OC_LEFT AND OC_BEHIND <> OC_RIGHT AND OC_BEHIND <> OC_TOP
ASSERT OC_BEHIND <> OC_BOTTOM

\ CN_COORD k: cn_v's coordinate k = vertex X's (24-bit)
MACRO CN_COORD k
    LDA vx0 + 3 * VALL * k,X : STA cn_v + 3 * k
    LDA vx1 + 3 * VALL * k,X : STA cn_v + 3 * k + 1
    LDA vx2 + 3 * VALL * k,X : STA cn_v + 3 * k + 2
ENDMACRO
\ CN_DIFF k: cn_v's coordinate k = vertex Y's less vertex X's
MACRO CN_DIFF k
    LDA vx0 + 3 * VALL * k,Y : SEC : SBC vx0 + 3 * VALL * k,X : STA cn_v + 3 * k
    LDA vx1 + 3 * VALL * k,Y : SBC vx1 + 3 * VALL * k,X : STA cn_v + 3 * k + 1
    LDA vx2 + 3 * VALL * k,Y : SBC vx2 + 3 * VALL * k,X : STA cn_v + 3 * k + 2
ENDMACRO

\ en_mul: en_p (4 bytes) = the coordinate at vx0 + Y (24-bit signed) times
\ the byte en_ca, which QS_SET patched into cone_qs: the raw bytes'
\ products, and en_ca off the top byte for a negative coordinate (whose top
\ byte reads 256 more). Clobbers A, X.
.en_mul
{
    LDX vx0,Y : JSR cone_qs : STA en_p+1
    LDA cq_lo : STA en_p
    LDX vx1,Y : JSR cone_qs : STA en_p+2
    LDA cq_lo : CLC : ADC en_p+1 : STA en_p+1
    BCC c1
    INC en_p+2                          ; (a byte by at most 65: nothing carries on)
.c1
    LDX vx2,Y : JSR cone_qs : STA en_p+3
    LDA cq_lo : CLC : ADC en_p+2 : STA en_p+2
    BCC c2
    INC en_p+3
.c2
    LDA vx2,Y : BPL done
    LDA en_p+3 : SEC : SBC en_ca : STA en_p+3
.done
    RTS
}
ASSERT 255 * 65 < &FF00                 ; (en_mul's high bytes take a carry)

\ en_shl6: en_p = the coordinate at vx0 + Y times 64: shifted a byte up, then
\ two arithmetic shifts right. Clobbers A.
.en_shl6
    LDA vx2,Y : CMP #&80 : ROR A : STA en_p+3
    LDA vx1,Y : ROR A : STA en_p+2
    LDA vx0,Y : ROR A : STA en_p+1
    LDA #0 : ROR A : STA en_p
    LDA en_p+3 : CMP #&80 : ROR A : STA en_p+3
    ROR en_p+2 : ROR en_p+1 : ROR en_p
    RTS

\ en_acc: en_n's component at X (0, 4, 8) plus en_p if A's bit 7 is clear,
\ less it if set. Clobbers A.
.en_acc
{
    ASL A : BCS less
    LDA en_n,X : ZA_INDEXEDBY 0,4,8     ; (C clear)
    ADC en_p : STA en_n,X : ZA_INDEXEDBY 0,4,8
    LDA en_n+1,X : ZA_INDEXEDBY 0,4,8
    ADC en_p+1 : STA en_n+1,X : ZA_INDEXEDBY 0,4,8
    LDA en_n+2,X : ZA_INDEXEDBY 0,4,8
    ADC en_p+2 : STA en_n+2,X : ZA_INDEXEDBY 0,4,8
    LDA en_n+3,X : ZA_INDEXEDBY 0,4,8
    ADC en_p+3 : STA en_n+3,X : ZA_INDEXEDBY 0,4,8
    RTS
.less
    LDA en_n,X : ZA_INDEXEDBY 0,4,8     ; (C set)
    SBC en_p : STA en_n,X : ZA_INDEXEDBY 0,4,8
    LDA en_n+1,X : ZA_INDEXEDBY 0,4,8
    SBC en_p+1 : STA en_n+1,X : ZA_INDEXEDBY 0,4,8
    LDA en_n+2,X : ZA_INDEXEDBY 0,4,8
    SBC en_p+2 : STA en_n+2,X : ZA_INDEXEDBY 0,4,8
    LDA en_n+3,X : ZA_INDEXEDBY 0,4,8
    SBC en_p+3 : STA en_n+3,X : ZA_INDEXEDBY 0,4,8
    RTS
}
ZA_AUTO 12, en_n                        ; N: Nx, Ny, Nz, 32-bit signed
ZA_AUTO 4, en_p                         ; a term
ZA_AUTO1 en_c, en_ca                    ; a column entry, signed, and its size

\ en_store: en_n's component at X (0, 4, 8) = en_p, or less it if A's bit
\ 7 is set. Clobbers A.
.en_store
{
    ASL A : BCS less
    LDA en_p : STA en_n,X : ZA_INDEXEDBY 0,4,8
    LDA en_p+1 : STA en_n+1,X : ZA_INDEXEDBY 0,4,8
    LDA en_p+2 : STA en_n+2,X : ZA_INDEXEDBY 0,4,8
    LDA en_p+3 : STA en_n+3,X : ZA_INDEXEDBY 0,4,8
    RTS
.less
    LDA #0 : SBC en_p : STA en_n,X : ZA_INDEXEDBY 0,4,8      ; (C set)
    LDA #0 : SBC en_p+1 : STA en_n+1,X : ZA_INDEXEDBY 0,4,8
    LDA #0 : SBC en_p+2 : STA en_n+2,X : ZA_INDEXEDBY 0,4,8
    LDA #0 : SBC en_p+3 : STA en_n+3,X : ZA_INDEXEDBY 0,4,8
    RTS
}

\ en_term: en_n's component at X (0, 8) = c times the coordinate at vx0 + Y
\ (24-bit signed), c = A, a signed byte within -64..64, negated if en_fl's
\ bit 7 is set. Clobbers A, X.
.en_term
{
    STX en_k
    TAX : BEQ zero
    EOR en_fl : STA en_sg               ; (the term's sign)
    TXA : BPL positive
    EOR #&FF : INC A
.positive
    CMP #64 : BEQ by64
    STA en_ca
    QS_SET
    JSR en_mul
    BRA store
.by64
    JSR en_shl6
.store
    LDX en_k
    LDA en_sg
    JMP en_store
.zero
    LDX en_k
    STZ en_n,X : ZA_INDEXEDBY 0,8
    STZ en_n+1,X : ZA_INDEXEDBY 0,8
    STZ en_n+2,X : ZA_INDEXEDBY 0,8
    STZ en_n+3,X : ZA_INDEXEDBY 0,8
    RTS
}
ZA_AUTO1 en_fl, en_sg, en_k

\ en_cell: en_d = 64 times the cell A (its high byte; the caller takes the
\ camera's coordinate off). Clobbers A.
.en_cell
    STA en_d
    LSR A : LSR A : STA en_d+1
    LDA en_d : LSR A : ROR A : ROR A : AND #&C0 : STA en_d
    RTS
ZA_AUTO 2, en_d                         ; a world offset, 16-bit signed

\ en_dmul: en_p = mat_d times en_d, mat_d's bytes in the quarter squares'
\ instructions (en_dset, as the matrix is built): the products of en_d's
\ raw bytes, and mat_d off the top two bytes for a negative en_d (whose high
\ byte reads 256 more). Clobbers A, X.
.en_dmul
{
    LDA mat_d : BNE bytes
    \ mat_d = 4096 (the yaw a multiple of 90 degrees): a shift
    LDA mat_d+1 : CMP #&10 : BNE bytes
    STZ en_p
    LDA en_d : ASL A : ASL A : ASL A : ASL A : STA en_p+1
    LDA en_d+1 : ASL A : ASL A : ASL A : ASL A : STA en_p+2
    LDA en_d : LSR A : LSR A : LSR A : LSR A : ORA en_p+2 : STA en_p+2
    LDA en_d+1
    FOR k = 1..4
        CMP #&80 : ROR A
    NEXT
    STA en_p+3
    RTS
.bytes
    LDX en_d
    SEC
.a1 LDA sq_lo,X
.a2 SBC ng_lo,X
    STA en_p
.a3 LDA sq_hi,X
.a4 SBC ng_hi,X
    STA en_p+1                          ; lo d0
    SEC
.b1 LDA sq_lo,X
.b2 SBC ng_lo,X
    TAY
.b3 LDA sq_hi,X
.b4 SBC ng_hi,X
    STA en_p+2                          ; lo d1 (under 2^14)
    TYA : CLC : ADC en_p+1 : STA en_p+1
    BCC c1
    INC en_p+2
.c1
    LDX en_d+1
    SEC
.c1l LDA sq_lo,X
.c2l SBC ng_lo,X
    TAY
.c3l LDA sq_hi,X
.c4l SBC ng_hi,X
    STA en_p+3                          ; hi d0, at byte 1
    TYA : CLC : ADC en_p+1 : STA en_p+1
    LDA en_p+3 : ADC en_p+2 : STA en_p+2
    LDA #0 : ROL A : STA en_p+3
    SEC
.d1 LDA sq_lo,X
.d2 SBC ng_lo,X
    TAY
.d3 LDA sq_hi,X
.d4 SBC ng_hi,X
    TAX                                 ; hi d1, at byte 2
    TYA : CLC : ADC en_p+2 : STA en_p+2
    TXA : ADC en_p+3 : STA en_p+3
    LDA en_d+1 : BPL done
    LDA en_p+2 : SEC : SBC mat_d : STA en_p+2
    LDA en_p+3 : SBC mat_d+1 : STA en_p+3
.done
    RTS
}

\ en_dset: mat_d's bytes into en_dmul's instructions (matrix_build).
.en_dset
{
    LDA mat_d
    STA en_dmul.a1+1 : STA en_dmul.a3+1 : STA en_dmul.c1l+1 : STA en_dmul.c3l+1
    EOR #&FF
    STA en_dmul.a2+1 : STA en_dmul.a4+1 : STA en_dmul.c2l+1 : STA en_dmul.c4l+1
    LDA mat_d+1
    STA en_dmul.b1+1 : STA en_dmul.b3+1 : STA en_dmul.d1+1 : STA en_dmul.d3+1
    EOR #&FF
    STA en_dmul.b2+1 : STA en_dmul.b4+1 : STA en_dmul.d2+1 : STA en_dmul.d4+1
    RTS
}

\ edge_normal: en_n (Nx, Ny, Nz, 32-bit each) = the plane through the eye
\ and the edge from vertex X to vertex Y of the object being drawn: the
\ model's edge_normal_axis for a box's edge, along a world axis (sign
\ times A x M's column for it), and edge_normal for any other (cut16(A) x
\ cut16(B - A)).
\
\ A box's: each non-zero entry c of the column (negated going down the
\ axis) gives two terms of N = A x col: entry r adds A's (r + 2) MOD 3
\ times c to N's (r + 1) MOD 3, and takes A's (r + 1) MOD 3 times c from
\ N's (r + 2) MOD 3. A product by 64 is a shift; any other's, three byte
\ products. Under a level camera (mat_tilt 0), the same N by the cofactors
\ (level, below), with fewer products.
.edge_normal
{
    ZA_AUTO1 vi, vk, axis, down, r, bits
    STX vi : STY vk
    LDX of_slot
    LDA ob_flags,X : AND #K_MASK
    CMP #K_RECT : BEQ rect
    BCC cuboid
    JMP generic
.cuboid
    \ vertex i's bit k is the high side on axis k
    LDA vi : STA bits
    EOR vk
    LDX #0
.which
    LSR A : BCS found
    INX : BRA which
.found
    STX axis
    LDA bit8,X : AND vk                 ; non-zero going up the axis
    BRA column
.rect
    \ vertex (du, dv) = 0 (0, 0), 1 (1, 0), 2 (1, 1), 3 (0, 1): an edge with
    \ ends differing by 1 runs along u, by 3 along v
    LDY ob_aux,X
    TYA : ASL A : ASL A : ORA vi : TAX
    LDA rect_bits,X : STA bits
    LDA vi : EOR vk : CMP #1 : BNE along_v
    LDA rect_u,Y : STA axis
    LDX vk : LDA rect_du,X
    BRA column
.along_v
    LDA rect_v,Y : STA axis
    LDX vk : LDA rect_dv,X
.column
    \ down = &FF going down the axis, else 0: c = (m EOR down) - down
    CMP #1 : LDA #0 : SBC #0 : STA down
    LDA mat_tilt : BNE general
    JMP level
.general
    FOR k = 0..11
        STZ en_n + k
    NEXT
    LDA axis : STA r                    ; r = 3 (entry) + axis, from entry 0
.entry
    LDX r : LDA mat,X : BNE nonzero
    JMP next
.nonzero
    EOR down : SEC : SBC down
    STA en_c
    BPL c_pos
    EOR #&FF : INC A
.c_pos
    LDX r : LDY en_j1,X                 ; (by r: the coordinates' offsets ...)
    CMP #64 : BEQ by64
    STA en_ca
    QS_SET
    TYA : CLC : ADC vi : TAY
    JSR en_mul
    LDX r : LDA en_k1,X : TAX
    LDA en_c : JSR en_acc
    LDX r : LDA en_j2,X : CLC : ADC vi : TAY
    JSR en_mul
    LDX r : LDA en_k2,X : TAX
    LDA en_c : EOR #&80 : JSR en_acc
    BRA next
.by64
    TYA : CLC : ADC vi : TAY
    JSR en_shl6
    LDX r : LDA en_k1,X : TAX
    LDA en_c : JSR en_acc
    LDX r : LDA en_j2,X : CLC : ADC vi : TAY
    JSR en_shl6
    LDX r : LDA en_k2,X : TAX
    LDA en_c : EOR #&80 : JSR en_acc
.next
    LDA r : CLC : ADC #3 : STA r
    CMP #9 : BCS entries
    JMP entry
.entries
    RTS
.level
    \ A level camera's box edge: M = [[m00, 0, m02], [0, 64, 0], [m20, 0,
    \ m22]]. Along y, A x (0, 64, 0) = (-64 Az, 0, 64 Ax). Along x or z, A x
    \ M e_k = cof(M) (D x e_k), D = A's world offset from the eye (A = M D),
    \ so along x N = (m20 Ay, d dz, -m00 Ay) and along z N = (m22 Ay, -d dx,
    \ -m02 Ay), d = mat_d, the y cofactor. All exact, as the general way's.
    LDX axis : CPX #1 : BNE flat
    LDA vi : CLC : ADC #2 * 3 * VALL : TAY
    JSR en_shl6
    LDA down : EOR #&80 : LDX #0 : JSR en_store
    LDY vi
    JSR en_shl6
    LDA down : LDX #8 : JSR en_store
    STZ en_n+4 : STZ en_n+5 : STZ en_n+6 : STZ en_n+7
    RTS
.flat
    LDA down : STA en_fl
    LDA vi : CLC : ADC #3 * VALL : STA r          ; (Ay's offset)
    LDA mat + 6,X : LDY r : LDX #0 : JSR en_term  ; Nx: m20 (m22) Ay
    LDA down : EOR #&80 : STA en_fl
    LDX axis : LDA mat,X : LDY r : LDX #8 : JSR en_term   ; Nz: -m00 (-m02) Ay
    \ Ny: d times the world offset on the other horizontal axis, z along x
    \ and -x along z
    LDX of_slot
    LDA axis : BNE along_z
    LDA bits : AND #4 : BEQ low_z
    LDA ob_hz,X : BRA cell_z
.low_z
    LDA ob_lz,X
.cell_z
    JSR en_cell
    LDA en_d : SEC : SBC cam_z : STA en_d
    LDA en_d+1 : SBC cam_z+1 : STA en_d+1
    JSR en_dmul
    LDA down
    BRA ny
.along_z
    LDA bits : AND #1 : BEQ low_x
    LDA ob_hx,X : BRA cell_x
.low_x
    LDA ob_lx,X
.cell_x
    JSR en_cell
    LDA en_d : SEC : SBC cam_x : STA en_d
    LDA en_d+1 : SBC cam_x+1 : STA en_d+1
    JSR en_dmul
    LDA down : EOR #&80
.ny
    LDX #4
    JMP en_store
.generic
    LDX vi
    CN_COORD 0
    CN_COORD 1
    CN_COORD 2
    JSR cut16
    FOR k = 0..5
        LDA cn_w + k : STA cn_a16 + k
    NEXT
    LDX vi : LDY vk
    CN_DIFF 0
    CN_DIFF 1
    CN_DIFF 2
    JSR cut16
    \ N = cn_a16 x cn_w: N's k = a_p d_q - a_q d_p, (p, q) = (1, 2), (2, 0), (0, 1)
    LDX #4
.cross
    STX r
    LDY cr_p,X : LDA cn_a16,Y : STA sm_a : LDA cn_a16+1,Y : STA sm_a+1
    LDY cr_q,X : LDA cn_w,Y : STA sm_b : LDA cn_w+1,Y : STA sm_b+1
    JSR smul16
    LDA r : ASL A : TAX
    LDA sm_p : STA en_n,X : ZA_INDEXEDBY 0,4,8
    LDA sm_p+1 : STA en_n+1,X : ZA_INDEXEDBY 0,4,8
    LDA sm_p+2 : STA en_n+2,X : ZA_INDEXEDBY 0,4,8
    LDA sm_p+3 : STA en_n+3,X : ZA_INDEXEDBY 0,4,8
    LDX r
    LDY cr_q,X : LDA cn_a16,Y : STA sm_a : LDA cn_a16+1,Y : STA sm_a+1
    LDY cr_p,X : LDA cn_w,Y : STA sm_b : LDA cn_w+1,Y : STA sm_b+1
    JSR smul16
    LDA r : ASL A : TAX
    LDA en_n,X : ZA_INDEXEDBY 0,4,8
    SEC : SBC sm_p : STA en_n,X : ZA_INDEXEDBY 0,4,8
    LDA en_n+1,X : ZA_INDEXEDBY 0,4,8
    SBC sm_p+1 : STA en_n+1,X : ZA_INDEXEDBY 0,4,8
    LDA en_n+2,X : ZA_INDEXEDBY 0,4,8
    SBC sm_p+2 : STA en_n+2,X : ZA_INDEXEDBY 0,4,8
    LDA en_n+3,X : ZA_INDEXEDBY 0,4,8
    SBC sm_p+3 : STA en_n+3,X : ZA_INDEXEDBY 0,4,8
    LDX r : DEX : DEX : BMI crossed
    JMP cross
.crossed
    RTS
\ by 3 (entry) + axis: the coordinate entry r multiplies for each of its two
\ terms (vx0's offset), and the component it goes to (en_n's)
.en_j1
    EQUB 2 * 3 * VALL, 2 * 3 * VALL, 2 * 3 * VALL
    EQUB 0, 0, 0
    EQUB 3 * VALL, 3 * VALL, 3 * VALL
.en_k1
    EQUB 4, 4, 4, 8, 8, 8, 0, 0, 0
.en_j2
    EQUB 3 * VALL, 3 * VALL, 3 * VALL
    EQUB 2 * 3 * VALL, 2 * 3 * VALL, 2 * 3 * VALL
    EQUB 0, 0, 0
.en_k2
    EQUB 8, 8, 8, 0, 0, 0, 4, 4, 4
\ the cross product's (p, q), by N's component's offset in 16-bit words
.cr_p
    EQUB 2, 0, 4, 0, 0
.cr_q
    EQUB 4, 0, 0, 0, 2
.rect_u
    EQUB 1, 0, 0                        ; u for the zero axis x, y, z
.rect_v
    EQUB 2, 2, 1                        ; and v
.rect_du
    EQUB 0, 1, 1, 0                     ; each vertex's du
.rect_dv
    EQUB 0, 0, 1, 1                     ; ... and dv
.rect_bits
    \ by 4 (the zero axis) + the vertex: its high sides, a bit an axis, as a
    \ cuboid's vertex's index has them
    EQUB 0, 2, 6, 4                     ; across x: u is y, v is z
    EQUB 0, 1, 5, 4                     ; across y: x, z
    EQUB 0, 1, 3, 2                     ; across z: x, y
}
ASSERT vx1 = vx0 + VALL AND vx2 = vx1 + VALL AND vy0 = vx0 + 3 * VALL
ASSERT vy1 = vy0 + VALL AND vy2 = vy1 + VALL AND vz0 = vy0 + 3 * VALL
ASSERT vz1 = vz0 + VALL AND vz2 = vz1 + VALL

\ cut16: cn_w (three signed 16-bit) = cn_v (three signed 24-bit) shifted
\ right, rounding down, by s = bitlen(the largest magnitude) - 15 if that's
\ more than 0 (the model's cut16).
.cut16
{
    ZA_AUTO1 or1, or2, s, t
    STZ or1 : STZ or2
    LDX #6
.size
    LDA cn_v+2,X : BPL positive
    LDA #0 : SEC : SBC cn_v,X           ; (|v|'s low byte doesn't count)
    LDA #0 : SBC cn_v+1,X : ORA or1 : STA or1
    LDA #0 : SBC cn_v+2,X : ORA or2 : STA or2
    BRA next
.positive
    ORA or2 : STA or2
    LDA cn_v+1,X : ORA or1 : STA or1
.next
    DEX : DEX : DEX : BPL size
    \ the bit length's excess over 15
    LDX or2 : BEQ low
    LDA proj_bl2,X : LSR A : CLC : ADC #1     ; 16 + bitlen(or2) - 15
    BRA got
.low
    LDA or1 : BMI one                   ; bit 15: one
    LDA #0
    BRA got
.one
    LDA #1
.got
    STA s
    LDX #6
    LDY #4
.each
    LDA cn_v+2,X : STA t
    LDA s : BEQ moved
    PHY
    TAY
.bit
    LDA t : CMP #&80 : ROR t
    ROR cn_v+1,X : ROR cn_v,X
    DEY : BNE bit
    PLY
.moved
    LDA cn_v,X : STA cn_w,Y
    LDA cn_v+1,X : STA cn_w+1,Y
    DEY : DEY
    DEX : DEX : DEX : BPL each
    RTS
}

\ MULK v, k, out: out (3 bytes) = v (2 bytes, raw) times the constant byte
\ k, by quarter squares with k in the instructions: modulo 2^24 the signed
\ product if k comes off out's top byte for a negative v
MACRO MULK v, k, out
    LDX v
    SEC
    LDA sq_lo + k,X : SBC ng_lo + 255 - k,X : STA out
    LDA sq_hi + k,X : SBC ng_hi + 255 - k,X : STA out+1
    LDX v+1
    SEC
    LDA sq_lo + k,X : SBC ng_lo + 255 - k,X : TAY
    LDA sq_hi + k,X : SBC ng_hi + 255 - k,X : STA out+2
    TYA : CLC : ADC out+1 : STA out+1
    BCC done
    INC out+2
.done
ENDMACRO

\ EL_OR k: el_or |= |N's component k|
MACRO EL_OR k
    LDA en_n + 4 * k + 3 : BMI negative
    ORA el_or+3 : STA el_or+3
    LDA en_n + 4 * k + 2 : ORA el_or+2 : STA el_or+2
    LDA en_n + 4 * k + 1 : ORA el_or+1 : STA el_or+1
    LDA en_n + 4 * k : ORA el_or : STA el_or
    BRA done
.negative
    SEC
    LDA #0 : SBC en_n + 4 * k : ORA el_or : STA el_or
    LDA #0 : SBC en_n + 4 * k + 1 : ORA el_or+1 : STA el_or+1
    LDA #0 : SBC en_n + 4 * k + 2 : ORA el_or+2 : STA el_or+2
    LDA #0 : SBC en_n + 4 * k + 3 : ORA el_or+3 : STA el_or+3
.done
ENDMACRO

\ EL_RIGHT / EL_LEFT: el_w's three windows shifted a bit right, or left
MACRO EL_RIGHT
    FOR k = 0..2
        LSR el_w + 3 * k + 2 : ROR el_w + 3 * k + 1 : ROR el_w + 3 * k
    NEXT
ENDMACRO
MACRO EL_LEFT
    FOR k = 0..2
        ASL el_w + 3 * k : ROL el_w + 3 * k + 1 : ROL el_w + 3 * k + 2
    NEXT
ENDMACRO

\ EL_CORNER k, a, b: line slot X's f at corner k = a + b (4 bytes each, el_*)
MACRO EL_CORNER k, a, b, less
    IF less
        SEC
        LDA a : SBC b : STA lfc + 32 * k,X
        LDA a+1 : SBC b+1 : STA lfc + 32 * k + 8,X
        LDA a+2 : SBC b+2 : STA lfc + 32 * k + 16,X
        LDA a+3 : SBC b+3 : STA lfc + 32 * k + 24,X
    ELSE
        CLC
        LDA a : ADC b : STA lfc + 32 * k,X
        LDA a+1 : ADC b+1 : STA lfc + 32 * k + 8,X
        LDA a+2 : ADC b+2 : STA lfc + 32 * k + 16,X
        LDA a+3 : ADC b+3 : STA lfc + 32 * k + 24,X
    ENDIF
ENDMACRO

\ edge_line: line slot X = en_n's plane on the screen (the model's
\ screen_line): N' = N >> s (rounding down), s = bitlen(the largest
\ magnitude) - LINE_BITS if positive; A = -2 N'x, B = N'y, and f = A x + B y
\ + C at the rectangle's corners (0, 0), (W, 0), (W, H) and (0, H): P - Q -
\ R, -P - Q - R, -P + Q - R and P + Q - R, as C = P - Q - R, A W = -2P and B
\ H = 2Q, with P = 2 XC N'x = 128 (13 N'x), Q = YC N'y = 64 (13 N'y), R = 2
\ FX N'z = 8 (317 N'z). The slot gets A (lna*), B (lnb*) and the corners'
\ f (lfc). Returns A = how many corners are outside (f < 0). X is kept.
.edge_line
{
    ZA_AUTO1 slot, b
    ZA_AUTO 4, nr                       ; -R
    ZA_AUTO 4, u                        ; -R - Q, then -R + Q
    STX slot
    STZ el_or : STZ el_or+1 : STZ el_or+2 : STZ el_or+3
    EL_OR 0
    EL_OR 1
    EL_OR 2
    \ s = bitlen - LINE_BITS, at least 0: b = s DIV 8, and el_r = 2 (s MOD 8)
    LDX #3
.top
    LDA el_or,X : ZA_INDEXEDBY 0..3
    BNE topped
    DEX : BPL top
    INX                                 ; (all zero: no shift)
.topped
    TAY : LDA proj_bl2,Y                ; 2 bitlen(the byte)
    CLC : ADC el_16x,X                  ; 2 bitlen
    SEC : SBC #2 * LINE_BITS : BCS shift
    LDA #0
.shift
    TAY                                 ; 2 s
    AND #15 : STA el_r
    TYA : LSR A : LSR A : LSR A : LSR A : STA b
    \ each component's window: its bytes b, b + 1, b + 2 (its sign past
    \ the fourth)
    TAX
    FOR k = 0..2
        LDA en_n + 4 * k,X : ZA_INDEXEDBY 0..2
        STA el_w + 3 * k
        LDA en_n + 4 * k + 1,X : ZA_INDEXEDBY 0..2
        STA el_w + 3 * k + 1
    NEXT
    CPX #2 : BEQ b2
    FOR k = 0..2
        LDA en_n + 4 * k + 2,X : ZA_INDEXEDBY 0..1
        STA el_w + 3 * k + 2
    NEXT
    BRA windows
.b2
    FOR k = 0..2
        LDA en_n + 4 * k + 3 : ASL A : SEXT : STA el_w + 3 * k + 2
    NEXT
.windows
    \ the windows shifted s MOD 8 right, or 8 - that left and a byte down
    LDX el_r
    JMP (el_shift,X)
    ZA_CANJUMP EL_SHIFTS
.r4 EL_RIGHT
.r3 EL_RIGHT
.r2 EL_RIGHT
.r1 EL_RIGHT
.r0
    FOR k = 0..5
        LDA el_w + 3 * (k DIV 2) + (k MOD 2) : STA el_np + k
    NEXT
    BRA have
.l3 EL_LEFT
.l2 EL_LEFT
.l1 EL_LEFT
    FOR k = 0..5
        LDA el_w + 3 * (k DIV 2) + (k MOD 2) + 1 : STA el_np + k
    NEXT
.have
    \ A = -2 N'x, B = N'y
    LDX slot
    LDA el_np : ASL A : TAY
    LDA el_np+1 : ROL A : PHA
    TYA : EOR #&FF : CLC : ADC #1 : STA lna0,X
    PLA : EOR #&FF : ADC #0 : STA lna1,X
    LDA el_np+2 : STA lnb0,X
    LDA el_np+3 : STA lnb1,X
    \ R = 8 (317 N'z) = 8 (61 N'z + 256 N'z), to 24 bits, then -R
    MULK el_np+4, 61, el_t
    LDA el_np+5 : BPL r_pos
    LDA el_t+2 : SEC : SBC #61 : STA el_t+2
.r_pos
    LDA el_t+1 : CLC : ADC el_np+4 : STA el_t+1
    LDA el_t+2 : ADC el_np+5 : STA el_t+2
    ASL A : SEXT : STA el_t+3
    ASL el_t : ROL el_t+1 : ROL el_t+2 : ROL el_t+3
    ASL el_t : ROL el_t+1 : ROL el_t+2 : ROL el_t+3
    ASL el_t : ROL el_t+1 : ROL el_t+2 : ROL el_t+3
    SEC
    LDA #0 : SBC el_t : STA nr
    LDA #0 : SBC el_t+1 : STA nr+1
    LDA #0 : SBC el_t+2 : STA nr+2
    LDA #0 : SBC el_t+3 : STA nr+3
    \ Q = 64 (13 N'y) = (13 N'y << 8) >> 2
    LDA el_np+2 : ORA el_np+3 : BNE q_some
    STZ el_q : STZ el_q+1 : STZ el_q+2 : STZ el_q+3
    BRA q_done
.q_some
    MULK el_np+2, 13, el_t
    LDA el_np+3 : BPL q_pos
    LDA el_t+2 : SEC : SBC #13 : STA el_t+2
.q_pos
    LDA el_t+2 : CMP #&80 : ROR A : STA el_q+3
    LDA el_t+1 : ROR A : STA el_q+2
    LDA el_t : ROR A : STA el_q+1
    LDA #0 : ROR A : STA el_q
    LDA el_q+3 : CMP #&80 : ROR A : STA el_q+3
    ROR el_q+2 : ROR el_q+1 : ROR el_q
.q_done
    \ P = 128 (13 N'x) = (13 N'x << 8) >> 1
    MULK el_np, 13, el_t
    LDA el_np+1 : BPL p_pos
    LDA el_t+2 : SEC : SBC #13 : STA el_t+2
.p_pos
    LDA el_t+2 : CMP #&80 : ROR A : STA el_p+3
    LDA el_t+1 : ROR A : STA el_p+2
    LDA el_t : ROR A : STA el_p+1
    LDA #0 : ROR A : STA el_p
    \ the corners: -R - Q + P, -R - Q - P, -R + Q - P, -R + Q + P
    SEC
    LDA nr : SBC el_q : STA u
    LDA nr+1 : SBC el_q+1 : STA u+1
    LDA nr+2 : SBC el_q+2 : STA u+2
    LDA nr+3 : SBC el_q+3 : STA u+3
    LDX slot
    EL_CORNER 0, u, el_p, FALSE
    EL_CORNER 1, u, el_p, TRUE
    CLC
    LDA nr : ADC el_q : STA u
    LDA nr+1 : ADC el_q+1 : STA u+1
    LDA nr+2 : ADC el_q+2 : STA u+2
    LDA nr+3 : ADC el_q+3 : STA u+3
    EL_CORNER 2, u, el_p, TRUE
    EL_CORNER 3, u, el_p, FALSE
    \ how many are outside
    LDA lfc + 24,X : ASL A
    LDA #0 : ROL A
    LDY lfc + 32 + 24,X : BPL c1
    INC A
.c1
    LDY lfc + 64 + 24,X : BPL c2
    INC A
.c2
    LDY lfc + 96 + 24,X : BPL c3
    INC A
.c3
    RTS
EL_SHIFTS = {r0, r1, r2, r3, r4, l3, l2, l1}
.el_shift
    EQUW r0, r1, r2, r3, r4, l3, l2, l1
\ 16 times a byte's place, for 2 bitlen
.el_16x
    EQUB 0, 16, 32, 48
}
ZA_AUTO 4, el_or                        ; the magnitudes ORed
ZA_AUTO 9, el_w                         ; the components' windows
ZA_AUTO 6, el_np                        ; N' (three signed 16-bit)
ZA_AUTO 4, el_t
ZA_AUTO 4, el_p
ZA_AUTO 4, el_q
ZA_AUTO1 el_r
ASSERT CLIP_W = 2 * PROJ_XC AND CLIP_H = 2 * PROJ_YC   ; (A W = -2P, B H = 2Q)
ASSERT 2 * PROJ_XC = 128 * 13 AND PROJ_YC = 64 * 13 AND 2 * VIEW_FX = 8 * 317
ASSERT LINE_BITS = 13                   ; (|N'| at most 2^13: 13 |N'| fits 24 bits, 317 |N'| 23, and A 16)

\ The cone's products of a line's A or B by a coordinate: |A| and |B|'s
\ bytes patched into four quarter-square readers (ce_al, ce_ah, ce_bl,
\ ce_bh: X times the byte, the product's low byte in ce_lo and its high in
\ A) once a pass (cone_line), each vertex's coordinate's bytes in X.
.ce_al
{
    SEC
.p1 LDA sq_lo,X
.p2 SBC ng_lo,X
    STA ce_lo
.p3 LDA sq_hi,X
.p4 SBC ng_hi,X
    RTS
}
.ce_ah
{
    SEC
.p1 LDA sq_lo,X
.p2 SBC ng_lo,X
    STA ce_lo
.p3 LDA sq_hi,X
.p4 SBC ng_hi,X
    RTS
}
.ce_bl
{
    SEC
.p1 LDA sq_lo,X
.p2 SBC ng_lo,X
    STA ce_lo
.p3 LDA sq_hi,X
.p4 SBC ng_hi,X
    RTS
}
.ce_bh
{
    SEC
.p1 LDA sq_lo,X
.p2 SBC ng_lo,X
    STA ce_lo
.p3 LDA sq_hi,X
.p4 SBC ng_hi,X
    RTS
}
ZA_AUTO1 ce_lo

\ cone_line: line X's |A| and |B| patched into the readers, their signs in
\ ce_as and ce_bs (bit 7). X is kept.
.cone_line
{
    LDA lna1,X : STA ce_as : BPL a_pos
    LDA #0 : SEC : SBC lna0,X : PHA
    LDA #0 : SBC lna1,X
    BRA a_got
.a_pos
    LDA lna0,X : PHA
    LDA lna1,X
.a_got
    STA ce_ah.p1+1 : STA ce_ah.p3+1
    EOR #&FF
    STA ce_ah.p2+1 : STA ce_ah.p4+1
    PLA
    STA ce_al.p1+1 : STA ce_al.p3+1
    EOR #&FF
    STA ce_al.p2+1 : STA ce_al.p4+1
    LDA lnb1,X : STA ce_bs : BPL b_pos
    LDA #0 : SEC : SBC lnb0,X : PHA
    LDA #0 : SBC lnb1,X
    BRA b_got
.b_pos
    LDA lnb0,X : PHA
    LDA lnb1,X
.b_got
    STA ce_bh.p1+1 : STA ce_bh.p3+1
    EOR #&FF
    STA ce_bh.p2+1 : STA ce_bh.p4+1
    PLA
    STA ce_bl.p1+1 : STA ce_bl.p3+1
    EOR #&FF
    STA ce_bl.p2+1 : STA ce_bl.p4+1
    RTS
}
ZA_AUTO1 ce_as
ZA_AUTO1 ce_bs

\ CE_TERM lo, hi, rl, rh, sign: ce_t (4 bytes) = |a| v, v = pa's coordinate
\ (lo, hi at Y, under 2^11), |a| in the readers rl (its low byte) and rh
\ (its high), then added to cf*,Y or taken from it by sign's bit 7
MACRO CE_TERM lo, hi, rl, rh, sign
    LDX lo,Y
    JSR rl : STA ce_t+1                 ; v0 a0
    LDA ce_lo : STA ce_t
    JSR rh : STA ce_t+2                 ; v0 a1
    LDA ce_lo : CLC : ADC ce_t+1 : STA ce_t+1
    BCC c1
    INC ce_t+2
.c1
    STZ ce_t+3
    LDX hi,Y : BEQ summed               ; (v's high byte: under 8)
    JSR rl : TAX                        ; v1 a0
    LDA ce_lo : CLC : ADC ce_t+1 : STA ce_t+1
    TXA : ADC ce_t+2 : STA ce_t+2
    BCC c2
    INC ce_t+3
.c2
    LDX hi,Y
    JSR rh : TAX                        ; v1 a1
    LDA ce_lo : CLC : ADC ce_t+2 : STA ce_t+2
    TXA : ADC ce_t+3 : STA ce_t+3
.summed
    BIT sign : BMI less
    LDA cf0,Y : CLC : ADC ce_t : STA cf0,Y
    LDA cf1,Y : ADC ce_t+1 : STA cf1,Y
    LDA cf2,Y : ADC ce_t+2 : STA cf2,Y
    LDA cf3,Y : ADC ce_t+3 : STA cf3,Y
    BRA done
.less
    LDA cf0,Y : SEC : SBC ce_t : STA cf0,Y
    LDA cf1,Y : SBC ce_t+1 : STA cf1,Y
    LDA cf2,Y : SBC ce_t+2 : STA cf2,Y
    LDA cf3,Y : SBC ce_t+3 : STA cf3,Y
.done
ENDMACRO
ASSERT CLIP_W < 2048 AND CLIP_H < 2048   ; (v's high byte under 8)

\ CE_BASE k: cf*,Y = line cp_line's f at corner k
MACRO CE_BASE k
    LDX cp_line
    LDA lfc + 32 * k,X : STA cf0,Y
    LDA lfc + 32 * k + 8,X : STA cf1,Y
    LDA lfc + 32 * k + 16,X : STA cf2,Y
    LDA lfc + 32 * k + 24,X : STA cf3,Y
ENDMACRO

\ cone_eval: cf*,Y = line cp_line's f at pa's vertex Y, A x + B y + C, by
\ its tag (pa_tg: the rectangle's sides it's on, OC_*): a corner's is the
\ line's own, and a side's the corner's at its start plus a product (A x
\ along the top and bottom, B y down the left and right); any other's two
\ products. (Every way gives the same f, the tag only the shortest.) Its A
\ and B in the readers (cone_line). Y is kept, and A is f's top byte
\ (cf3,Y: every way's last store).
.cone_eval
    LDX pa_tg,Y
    JMP (ce_jump,X)
    ZA_CANJUMP CE_JUMPS
.ce_c0
    CE_BASE 0 : RTS
.ce_c1
    CE_BASE 1 : RTS
.ce_c2
    CE_BASE 2 : RTS
.ce_c3
    CE_BASE 3 : RTS
.ce_left
    CE_BASE 0 : JMP ce_y
.ce_right
    CE_BASE 1 : JMP ce_y
.ce_top
    CE_BASE 0 : JMP ce_x
.ce_bottom
    CE_BASE 3 : JMP ce_x
.ce_in
    CE_BASE 0 : JSR ce_x
.ce_y
    CE_TERM pa_yl, pa_yh, ce_bl, ce_bh, ce_bs
    RTS
.ce_x
    CE_TERM pa_xl, pa_xh, ce_al, ce_ah, ce_as
    RTS
CE_JUMPS = {ce_in, ce_left, ce_right, ce_top, ce_bottom, ce_c0, ce_c1, ce_c2, ce_c3}
\ by tag: 0 inside; OC_LEFT, OC_RIGHT, OC_TOP, OC_BOTTOM; and the corners
.ce_jump
    EQUW ce_in, ce_left, ce_right, ce_in, ce_top, ce_c0, ce_c1, ce_in
    EQUW ce_bottom, ce_c3, ce_c2, ce_in, ce_in, ce_in, ce_in, ce_in
ASSERT OC_LEFT = 2 AND OC_RIGHT = 4 AND OC_TOP = 8 AND OC_BOTTOM = 16
ZA_AUTO 4, ce_t
ZA_AUTO1 cp_line                        ; the line cone_pass clips by

\ CC_AXIS sl, sh: cone_cut's new vertex on one axis: P + lerp(Q - P),
\ straight across when they're the same
MACRO CC_AXIS sl, sh
    LDX cone_cut.ip : LDY cone_cut.iq
    LDA sl,Y : SEC : SBC sl,X : STA lerp.ld
    LDA sh,Y : SBC sh,X : STA lerp.ld+1
    ORA lerp.ld : BNE across
    LDY cp_m
    LDA sl,X : STA sl,Y
    LDA sh,X : STA sh,Y
    BRA done
.across
    LDA lerp.ld+1 : ASL A : SEXT        ; (inside the rectangle: 12 bits)
    STA lerp.ld+2 : STA lerp.ld+3
    JSR lerp
    LDY cp_m : LDX cone_cut.ip
    LDA lerp.lr : CLC : ADC sl,X : STA sl,Y
    LDA lerp.lr+1 : ADC sh,X : STA sh,Y
.done
ENDMACRO

\ CLAMP sl, sh, dl, dh, top: d,Y (16-bit) = s,X (16-bit, signed) clamped
\ to [0, top]
MACRO CLAMP sl, sh, dl, dh, top
    LDA sh,X : BMI low
    CMP #HI(top) : BCC within : BNE high
    LDA sl,X : CMP #LO(top) : BCC within : BEQ within
.high
    LDA #LO(top) : STA dl,Y
    LDA #HI(top) : STA dh,Y
    BRA done
.low
    LDA #0 : STA dl,Y : STA dh,Y
    BRA done
.within
    LDA sl,X : STA dl,Y
    LDA sh,X : STA dh,Y
.done
ENDMACRO

\ The cone's polygon is in one half of the pa and pb arrays and a pass
\ writes the other, its vertices indexed with their half's base (cp_src, 0
\ or NP2): pa_xl,X for vertex X is pb's when X >= NP2.

\ cone_cut: the polygon's vertex cp_m = where its edge labelled
\ cc_edge (a side, or the line it lies along), from vertex X, inside line
\ cp_line (cf >= 0), to vertex Y, outside, crosses that line, labelled
\ cc_new (the model's _cone_pass): on a side, the line's own crossing with
\ it (side_cut); along the line of an edge sharing a vertex with cp_line's,
\ that vertex's image if the projection takes it (projected now if it
\ wasn't), clamped to the rectangle; else the model's crossing, its tag the
\ sides both ends are on.
.cone_cut
{
    ZA_AUTO1 ip, iq
    STX ip : STY iq
    LDY cp_m
    LDA cc_new : STA pa_lb,Y
    LDA cc_edge : BPL along
    AND #3 : TAY
    JMP side_cut
.along
    \ along line slot cc_edge: consecutive edges share a vertex
    TAX : LDY cp_line
    LDA ln_v1,X : CMP ln_v0,Y : BEQ shared
    LDA ln_v1,Y : CMP ln_v0,X : BEQ shared
.not_joined
    JMP general
.shared
    TAX : LDA bit8,X : BIT vp_off : BNE not_joined
    BIT vp_done : BNE projected
    TSB vp_done
    JSR vertex_shared
.projected
    LDY cp_m
    LDA #0 : STA pa_tg,Y
    CLAMP vsxl, vsxh, pa_xl, pa_xh, CLIP_W
    CLAMP vsyl, vsyh, pa_yl, pa_yh, CLIP_H
    RTS
.general
    LDX ip : LDY iq
    LDA pa_tg,X : AND pa_tg,Y
    LDY cp_m : STA pa_tg,Y
    LDY iq
    LDA cf0,X : STA frac16.fp
    SEC : SBC cf0,Y : STA frac16.fd
    LDA cf1,X : STA frac16.fp+1
    SBC cf1,Y : STA frac16.fd+1
    LDA cf2,X : STA frac16.fp+2
    SBC cf2,Y : STA frac16.fd+2
    LDA cf3,X : STA frac16.fp+3
    SBC cf3,Y : STA frac16.fd+3
    JSR frac16
    CC_AXIS pa_xl, pa_xh
    CC_AXIS pa_yl, pa_yh
    RTS
}
ZA_AUTO1 cc_edge, cc_new
ZA_AUTO1 cp_m                           ; the vertex a pass writes next
LB_SIDE = &80                           ; a label: the rectangle's side k is LB_SIDE + k
ASSERT NLINES < LB_SIDE

\ cone_pass: the polygon (p_n vertices, tagged and labelled, in cp_src's
\ half) clipped to line X (the model's _cone_pass) into the other half,
\ which cp_src then names: p_n left, Z set if none. With every vertex
\ inside the line, it's left where it is, as it was.
.cone_pass
{
    ZA_AUTO1 i, end, outs
    JSR cone_line
    STX cp_line
    STZ outs
    LDA cp_src : TAY : CLC : ADC p_n : STA end
.f
    JSR cone_eval
    ORA outs : STA outs                 ; (f's sign)
    INY : CPY end : BNE f
    BIT outs : BMI some_out
    LDA p_n                             ; (none: Z clear)
    RTS
.some_out
    LDX cp_src                          ; the first again after the last
    LDA cf0,X : STA cf0,Y
    LDA cf1,X : STA cf1,Y
    LDA cf2,X : STA cf2,Y
    LDA cf3,X : STA cf3,Y
    LDA #NP2 : SEC : SBC cp_src : STA cp_m
.vertex
    STX i
    LDA pa_lb,X : STA cc_edge           ; (its edge to the next)
    LDA cf3,X : BMI a_out
    LDY cp_m
    LDA pa_xl,X : STA pa_xl,Y
    LDA pa_xh,X : STA pa_xh,Y
    LDA pa_yl,X : STA pa_yl,Y
    LDA pa_yh,X : STA pa_yh,Y
    LDA pa_tg,X : STA pa_tg,Y
    LDA cc_edge : STA pa_lb,Y
    INC cp_m
    LDA cf3+1,X : BPL next              ; both in
    \ from a (X) to b: the crossing's edge is along this line
    LDA cp_line : STA cc_new
    INX : CPX end : BNE b_set
    LDX cp_src
.b_set
    TXA : TAY : LDX i
    BRA cut
.a_out
    LDA cf3+1,X : BMI next              ; both out
    \ from b to a (X): the crossing's edge goes on along this one
    LDA cc_edge : STA cc_new
    TXA : TAY
    INX : CPX end : BNE p_set
    LDX cp_src
.p_set
.cut
    JSR cone_cut
    INC cp_m
.next
    LDX i : INX : CPX end : BNE vertex
    \ the other half's now
    LDA #NP2 : SEC : SBC cp_src : STA cp_src
    LDA cp_m : SEC : SBC cp_src : STA p_n
    RTS
}

\ The rectangle's corner k, (0, 0), (W, 0), (W, H) and (0, H), and its tag
FUNCTION RECT_X(k) = WHERE(k = 1 OR k = 2, CLIP_W, 0)
FUNCTION RECT_Y(k) = WHERE(k >= 2, CLIP_H, 0)
FUNCTION RECT_TG(k) = WHERE(k = 1 OR k = 2, OC_RIGHT, OC_LEFT) OR WHERE(k >= 2, OC_BOTTOM, OC_TOP)

\ CF_CORNER k: cone_first's corner k, and its side's crossing if its ends
\ are either side of the line (the rectangle's own pass of the model's
\ _cone_pass, from the corners' signs)
MACRO CF_CORNER k
    LDX cp_line
    LDA lfc + 32 * k + 24,X : BMI out
    LDY cp_m
    LDA #LO(RECT_X(k)) : STA pa_xl,Y
    LDA #HI(RECT_X(k)) : STA pa_xh,Y
    LDA #LO(RECT_Y(k)) : STA pa_yl,Y
    LDA #HI(RECT_Y(k)) : STA pa_yh,Y
    LDA #RECT_TG(k) : STA pa_tg,Y
    LDA #LB_SIDE + k : STA pa_lb,Y
    INY : STY cp_m
    LDA lfc + 32 * ((k + 1) MOD 4) + 24,X : BPL done
    TXA                                 ; (on from the corner: along the line)
    BRA cut
.out
    LDA lfc + 32 * ((k + 1) MOD 4) + 24,X : BMI done
    LDA #LB_SIDE + k                    ; (on to the next corner: along the side)
.cut
    LDY cp_m : STA pa_lb,Y
    LDY #k : JSR side_cut
    INC cp_m
.done
ENDMACRO

\ cone_first: the rectangle clipped to line X, into pa (the model's
\ _cone_pass on the rectangle): each corner inside it, and each side's
\ crossing where its corners are either side. Z set if none's left.
.cone_first
    STX cp_line
    STZ cp_src
    STZ cp_m
    CF_CORNER 0
    CF_CORNER 1
    CF_CORNER 2
    CF_CORNER 3
    LDA cp_m : STA p_n
    RTS

\ cone_face: face X of the object being drawn, the projection unable to
\ take some vertex of it, as the cone's polygon in pa (p_n vertices, its
\ repeats dropped): C clear if nothing's left. (render.py's draw_faces and
\ edge_lines, and clip.py's cone_clip.) An edge with both ends at or behind
\ the eye (z <= 0) has no line; the lines of those with both in front come
\ first, then those with one, each in the loop's order.
.cone_face
{
    ZA_AUTO1 face, n, j, every, nl, vi, vk, phase
    STX face
    LDA fa_nv,X : STA n
    LDY fa_loop,X
    LDX #0
.index
    LDA lp_table,Y : STA fp_idx,X
    \ fp_bh: 1 if it's at or behind the eye (z <= 0)
    PHY : TAY
    LDA vz2,Y : BMI behind
    ORA vz1,Y : ORA vz0,Y : BEQ behind
    LDA #0
    BRA placed
.behind
    LDA #1
.placed
    STA fp_bh,X
    PLY
    INY : INX : CPX n : BNE index
    LDA fp_idx : STA fp_idx,X           ; the first again after the last
    LDA fp_bh : STA fp_bh,X
    \ every vertex in one of code3's half-spaces: not seen (the AND is
    \ settled once it's 0)
    LDA #&FF : STA every
    LDX #0
.code
    LDY fp_idx,X
    JSR vertex_code3
    AND every : STA every : BEQ coded
    INX : CPX n : BNE code
    JMP none
.coded
    \ each edge's line, kept if it cuts the rectangle: in phase 0 those with
    \ both ends in front, in phase 1 those with one behind (an edge's ends
    \ behind, counted, is its phase)
    STZ nl
    STZ phase
.phases
    STZ j
.edge
    LDX j
    LDA fp_bh,X : CLC : ADC fp_bh+1,X : CMP phase : BNE passed
    LDA fp_idx+1,X : STA vk : TAY
    LDA fp_idx,X : STA vi : TAX
    JSR edge_normal
    LDX nl
    JSR edge_line
    CMP #4 : BEQ none                   ; (every corner out)
    CMP #0 : BEQ passed                 ; (every corner in: it cuts nothing)
    LDX nl
    LDA vi : STA ln_v0,X
    LDA vk : STA ln_v1,X
    INC nl
.passed
    INC j : LDA j : CMP n : BNE edge
    LDA phase : BNE made
    INC phase : BRA phases
.made
    \ the rectangle, clipped by each line kept
    LDA nl : BEQ whole
    LDX #0
    JSR cone_first
    BEQ none
    LDA #1 : STA j
.line
    LDX j : CPX nl : BEQ clipped
    JSR cone_pass
    BEQ none
    INC j : BRA line
.none
    CLC
    RTS
.whole
    LDX #3
.corner
    LDA rect_x,X : STA pa_xl,X
    LDA rect_x+4,X : STA pa_xh,X
    LDA rect_y,X : STA pa_yl,X
    LDA rect_y+4,X : STA pa_yh,X
    DEX : BPL corner
    LDA #4 : STA p_n
    BRA deduped
.clipped
    \ in pb: down to pa
    LDA cp_src : BEQ in_pa
    LDX p_n
.down
    DEX
    LDA pb_xl,X : STA pa_xl,X
    LDA pb_xh,X : STA pa_xh,X
    LDA pb_yl,X : STA pa_yl,X
    LDA pb_yh,X : STA pa_yh,X
    TXA : BNE down
.in_pa
    JSR dedupe
.deduped
    SEC
    RTS
.rect_x
    EQUB LO(RECT_X(0..3))
    EQUB HI(RECT_X(0..3))
.rect_y
    EQUB LO(RECT_Y(0..3))
    EQUB HI(RECT_Y(0..3))
}
ENDSECTION
SECTION ObjMore

\ SC_STEP: a step of side_cut's division: the next dividend bit from sc_l's
\ top into the remainder (sc_r and A), the last quotient bit (C) into sc_l's
\ bottom, and the divisor taken off if it goes (C set).
MACRO SC_STEP
    ROL sc_l : ROL sc_l+1
    ROL sc_r : ROL A
    CMP sc_a+1 : BCC zero : BNE one
    LDY sc_r : CPY sc_a : BCC zero
.one
    TAY
    LDA sc_r : SBC sc_a : STA sc_r      ; (C set)
    TYA : SBC sc_a+1
    SEC
.zero
ENDMACRO

\ side_cut: the cone's vertex cp_m = where line cp_line crosses side
\ Y of the rectangle (0 top, 1 right, 2 bottom, 3 left), which it cuts (the
\ model's side_crossing): from the side's corner K inside the line (f >= 0),
\ d = (f(K) + (a >> 1)) DIV a along it, a = |A| along the top and bottom
\ and |B| down the sides, which is f(K) / a rounded half up; tagged with
\ the side. f(K) < a W (the side's other corner is outside), so d has
\ eleven bits and D >> 11 is under a: eleven steps of a long division.
.side_cut
{
    ZA_AUTO1 side, flip
    ZA_AUTO 4, dv
    STY side
    \ K: the side's first corner (corner Y) if f >= 0 there, else the next;
    \ the coordinate along the side is d from the side's start (top, right)
    \ or its end (bottom, left), the other way from the second corner
    TYA : LSR A : AND #1 : STA flip     ; (sides 2 and 3: from the end)
    TYA : ASL A : ASL A : ASL A : ASL A : ASL A
    ORA cp_line : TAX                   ; lfc's index for corner Y
    LDA lfc + 24,X : BPL first
    TXA : CLC : ADC #32 : AND #127 : TAX
    LDA flip : EOR #1 : STA flip
.first
    LDA lfc,X : STA dv
    LDA lfc + 8,X : STA dv+1
    LDA lfc + 16,X : STA dv+2
    LDA lfc + 24,X : STA dv+3
    \ a
    LDX cp_line
    LDA side : LSR A : BCS sides
    LDA lna1,X : BPL a_pos
    LDA #0 : SEC : SBC lna0,X : STA sc_a
    LDA #0 : SBC lna1,X : STA sc_a+1
    BRA got_a
.a_pos
    STA sc_a+1
    LDA lna0,X : STA sc_a
    BRA got_a
.sides
    LDA lnb1,X : BPL b_pos
    LDA #0 : SEC : SBC lnb0,X : STA sc_a
    LDA #0 : SBC lnb1,X : STA sc_a+1
    BRA got_a
.b_pos
    STA sc_a+1
    LDA lnb0,X : STA sc_a
.got_a
    \ D = f(K) + (a >> 1), then D << 5 as D << 8 >> 3: the remainder starts
    \ at D >> 11 (sc_r and A), and D's low eleven bits at sc_l's top
    LDA sc_a+1 : LSR A : TAY
    LDA sc_a : ROR A
    CLC : ADC dv : STA dv
    TYA : ADC dv+1 : STA dv+1
    BCC added
    INC dv+2
    BNE added
    INC dv+3
.added
    STZ sc_l
    FOR k = 1..3
        LSR dv+3 : ROR dv+2 : ROR dv+1 : ROR dv : ROR sc_l
    NEXT
    LDA dv : STA sc_l+1
    LDA dv+1 : STA sc_r
    LDA dv+2
    CLC
    FOR k = 1..11
        SC_STEP
    NEXT
    ROL sc_l : ROL sc_l+1               ; (d: eleven bits)
    \ the point: d, or W less it, along the side
    LDA flip : BEQ along
    LDA #LO(CLIP_W) : SEC : SBC sc_l : STA sc_l
    LDA #HI(CLIP_W) : SBC sc_l+1 : STA sc_l+1
.along
    LDY cp_m
    LDX side
    LDA sc_tag,X : STA pa_tg,Y
    TXA : LSR A : BCS on_y
    LDA sc_l : STA pa_xl,Y
    LDA sc_l+1 : STA pa_xh,Y
    LDA sc_fixl,X : STA pa_yl,Y
    LDA sc_fixh,X : STA pa_yh,Y
    RTS
.on_y
    LDA sc_l : STA pa_yl,Y
    LDA sc_l+1 : STA pa_yh,Y
    LDA sc_fixl,X : STA pa_xl,Y
    LDA sc_fixh,X : STA pa_xh,Y
    RTS
\ by side: its tag, and its other coordinate (y on the top and bottom, x
\ on the right and left)
.sc_tag
    EQUB OC_TOP, OC_RIGHT, OC_BOTTOM, OC_LEFT
.sc_fixl
    EQUB LO(0), LO(CLIP_W), LO(CLIP_H), LO(0)
.sc_fixh
    EQUB HI(0), HI(CLIP_W), HI(CLIP_H), HI(0)
}
ZA_AUTO2 sc_l, sc_a
ZA_AUTO1 sc_r
ASSERT CLIP_W = CLIP_H AND CLIP_W < 2048    ; (d has eleven bits whichever side)
ASSERT NLINES <= 32                         ; (lfc's index: 32 corner + slot)
ENDSECTION
SECTION ObjCode

\ ===========================================================================
\ The vertex pass: which of the object's vertices the projection takes,
\ and those projected once each, sharing what they can.

\ BAND_TEST: C set if vertex X isn't projectable (the model's projectable):
\ nearer than ZNEAR (z's top two bytes zero, or z negative), or x beyond
\ 2^(n + BAND_XS) or y beyond 2^(n + BAND_YS) either way, n = bitlen(z). v
\ is within 2^k when v + 2^k has no bit from k + 1 up: the band_* tables,
\ indexed by 2n, have that bias and the mask of those bits for each of v's
\ top two bytes, read 32 on (2 bitlen(z's top byte) indexing them) or 16 on
\ (2 bitlen(its middle byte)). From BAND_MID up, k is past 15 for both x and
\ y, so the top byte alone decides. X is kept.
MACRO BAND_TEST
    LDY vz2,X : BEQ near : BMI off_top
    LDA proj_bl2,Y : TAY                ; 2n - 32
    LDA vx2,X : CLC : ADC band_xb2 + 32,Y : AND band_xm2 + 32,Y : BNE off_top
    LDA vy2,X : CLC : ADC band_yb2 + 32,Y : AND band_ym2 + 32,Y : BNE off_top
    CLC
    BRA done
.off_top
    SEC
    BRA done
.near
    LDY vz1,X : BEQ off                 ; (z < 256: nearer than ZNEAR)
    CPY #BAND_MID : BCC low
    LDA proj_bl2,Y : TAY                ; 2n - 16
    LDA vx2,X : CLC : ADC band_xb2 + 16,Y : AND band_xm2 + 16,Y : BNE off
    LDA vy2,X : CLC : ADC band_yb2 + 16,Y : AND band_ym2 + 16,Y : BNE off
    CLC
    BRA done
.low
    LDA proj_bl2,Y : TAY                ; 2n - 16
    LDA vx1,X : CLC : ADC band_xb1 + 16,Y : STA band_t
    LDA vx2,X : ADC band_xb2 + 16,Y : AND band_xm2 + 16,Y : BNE off
    LDA band_t : AND band_xm1 + 16,Y : BNE off
    LDA vy1,X : CLC : ADC band_yb1 + 16,Y : STA band_t
    LDA vy2,X : ADC band_yb2 + 16,Y : AND band_ym2 + 16,Y : BNE off
    LDA band_t : AND band_ym1 + 16,Y : BNE off
    CLC
    BRA done
.off
    SEC
.done
ENDMACRO
ASSERT ZNEAR = 256                      ; (BAND_TEST's: not nearer, a top byte non-zero)
ZA_AUTO1 band_t
\ z's middle byte from BAND_MID up (z's top byte 0): n at least 14, so k
\ past 15 for x and y both, and the band's low bytes (biases and masks) 0
BAND_MID = 1 << (16 - 1 - BAND_YS - 8)
ASSERT BAND_XS >= BAND_YS AND 14 + BAND_YS >= 16

\ band_test: BAND_TEST, as a routine.
.band_test
    BAND_TEST
    RTS

\ vertex_shared: vertex X projected (the maths' project) into vsx and vsy,
\ its outcode into voc, and vs_last made X: by project_y if it has the last
\ one's x and z (vs_last; its x's outcode too), by project_z if its z, else
\ by project. X is kept. vertex_shared.full: by project, sharing nothing.
\ vertex_up: for vertex X when under a level camera (mat_tilt 0) it has
\ vertex Y's x and z, by project_y without the compares if Y was the last
\ projected.
.vertex_up
    CPY vs_last : BNE vertex_shared
    LDA mat_tilt : BNE vertex_shared
    LDA vy0,X : STA proj_y
    LDA vy1,X : STA proj_y+1
    LDA vy2,X : STA proj_y+2
    BRA vertex_shared.xz_shared
.vertex_shared
{
    LDY vs_last : BMI full
    LDA vz0,X : CMP vz0,Y : BNE full
    LDA vz1,X : CMP vz1,Y : BNE full
    LDA vz2,X : CMP vz2,Y : BNE full
    LDA vy0,X : STA proj_y
    LDA vy1,X : STA proj_y+1
    LDA vy2,X : STA proj_y+2
    LDA vx0,X : CMP vx0,Y : BNE z_shared
    LDA vx1,X : CMP vx1,Y : BNE z_shared
    LDA vx2,X : CMP vx2,Y : BNE z_shared
.xz_shared
    PHX : JSR project_y : PLX           ; (proj_sx is the last one's, the same)
    LDA proj_sy : STA vsyl,X
    LDA proj_sy+1 : STA vsyh,X
    LDA proj_sx : STA vsxl,X
    LDA proj_sx+1 : STA vsxh,X
    LDY vs_last
    LDA voc,Y : AND #OC_LEFT OR OC_RIGHT
    BRA x_done
.z_shared
    LDA vx0,X : STA proj_x
    LDA vx1,X : STA proj_x+1
    LDA vx2,X : STA proj_x+2
    PHX : JSR project_z : PLX
    BRA got
.full
    LDA vx0,X : STA proj_x
    LDA vx1,X : STA proj_x+1
    LDA vx2,X : STA proj_x+2
    LDA vy0,X : STA proj_y
    LDA vy1,X : STA proj_y+1
    LDA vy2,X : STA proj_y+2
    LDA vz0,X : STA proj_z
    LDA vz1,X : STA proj_z+1
    LDA vz2,X : STA proj_z+2
    PHX : JSR project : PLX
.got
    \ the outcode (the model's outcode2d)
    LDA proj_sy : STA vsyl,X
    LDA proj_sy+1 : STA vsyh,X
    LDA proj_sx : STA vsxl,X
    LDA proj_sx+1 : STA vsxh,X : BPL x_right
    LDA #OC_LEFT
    BRA x_done
.x_right
    LDA #LO(CLIP_W) : CMP proj_sx
    LDA #HI(CLIP_W) : SBC proj_sx+1
    LDA #0
    BCS x_done                          ; (no borrow: sx <= CLIP_W)
    LDA #OC_RIGHT
.x_done
    STX vs_last
    LDY proj_sy+1 : BPL y_down
    ORA #OC_TOP
    STA voc,X
    RTS
.y_down
    TAY
    LDA #LO(CLIP_H) : CMP proj_sy
    LDA #HI(CLIP_H) : SBC proj_sy+1
    TYA
    BCS y_done                          ; (no borrow: sy <= CLIP_H)
    ORA #OC_BOTTOM
.y_done
    STA voc,X
    RTS
}

\ vertex_pass: the candidate's (of_cand, slot of_slot, a polygon object)
\ vertices its seen faces use, transformed: vp_off has a bit for each the
\ projection can't take; each vertex of a seen face with none of those is
\ projected, with its outcode (vertex_shared), in the order for the
\ object's kind, which puts those likely to share x and z, or z, together.
.vertex_pass
{
    ZA_AUTO1 used, mask
    LDX of_cand : LDA cd_vmask,X : STA used : STA vp_need
    STZ vp_off
    LDX #0
    BRA band
.unused
    INX
.band
    LSR used : BCC unused
    BAND_TEST : BCC band_next
    LDA bit8,X : TSB vp_off
.band_next
    INX
    LDA used : BEQ banded
    JMP band
.banded
    \ the vertices to project: every one used, unless some are off the band
    LDA vp_off : BEQ needed
    STZ vp_need
    LDY of_slot : LDX ob_f0,Y
    LDY of_cand : LDA cd_mask,Y : STA mask
.need
    LSR mask : BCC need_next
    LDA fa_vmask,X : BIT vp_off : BNE need_next
    TSB vp_need
.need_next
    INX
    LDA mask : BNE need
.needed
    LDA vp_need : STA vp_done           ; (the cone projects more as it needs them)
    LDA #&FF : STA vs_last
    \ projected in an order for the object's kind (vp_*)
    LDX of_slot
    LDA ob_flags,X : AND #K_MASK : BEQ cuboid
    CMP #K_RECT : BEQ rect
    JMP vp_generic
.cuboid
    JMP vp_cuboid
.rect
    LDY ob_aux,X : BEQ across_x
    DEY : BEQ across_y
    JMP vp_rect_z
.across_x
    JMP vp_rect_x
.across_y
    JMP vp_rect_y
    ASSERT K_CUBOID = 0 AND K_RECT = 1 AND K_GENERIC = 2 AND K_SENSOR = 3
}

\ VP_ONE j: vertex j projected if vp_need has it (vertex_need); VP_FIRST j,
\ the same for an order's first (vertex_first); VP_UP j, p, for vertex j,
\ which under a level camera has vertex p's x and z (vertex_up)
MACRO VP_ONE j
    LDA #1 << j : BIT vp_need : BEQ skip
    LDX #j : JSR vertex_shared
.skip
ENDMACRO
MACRO VP_FIRST j
    LDA #1 << j : BIT vp_need : BEQ skip
    LDX #j : JSR vertex_shared.full
.skip
ENDMACRO
MACRO VP_UP j, p
    LDA #1 << j : BIT vp_need : BEQ skip
    LDX #j : LDY #p : JSR vertex_up
.skip
ENDMACRO

\ The orders: a cuboid's vertex i + 2 is vertex i up its y edge, which under
\ a level camera adds to y alone, as does a rectangle's edge along y (its u
\ across x, its v across z). The order puts those pairs together.
.vp_cuboid
    VP_FIRST 0 : VP_UP 2, 0
    VP_ONE 1 : VP_UP 3, 1
    VP_ONE 4 : VP_UP 6, 4
    VP_ONE 5 : VP_UP 7, 5
    RTS
.vp_rect_x                              ; (u, v) = (y, z)
    VP_FIRST 0 : VP_UP 1, 0
    VP_ONE 3 : VP_UP 2, 3
    RTS
.vp_rect_y                              ; (x, z)
    VP_FIRST 0 : VP_ONE 1 : VP_ONE 2 : VP_ONE 3
    RTS
.vp_rect_z                              ; (x, y)
    VP_FIRST 0 : VP_UP 3, 0
    VP_ONE 1 : VP_UP 2, 1
    RTS
.vp_generic
    VP_FIRST 0
    FOR j = 1..7
        VP_ONE j
    NEXT
    RTS
ASSERT VMAX = 8

\ ===========================================================================
\ A face projected whole (the model's draw_faces, its every vertex
\ projectable): wholly beyond one of the view's edges it isn't drawn; with a
\ vertex beyond any it's clipped (clip2d), else its repeats are dropped;
\ then the drawn test.

\ poly_face: face X of the object being drawn, its vertices projected. They
\ go into the output from out_vn as they're gathered, with their outcodes'
\ AND and OR: wholly inside the view, with no vertex the one before it again
\ (the last before the first), the drawn test takes them there; else they go
\ to pa for the 2D clip, or for dedupe, and are staged back.
.poly_face
{
    ZA_AUTO1 face, lp, end, every, any
    STX face
    LDA fa_loop,X : STA lp
    LDA fa_nv,X : STA p_n
    LDA #&FF : STA every
    STZ any
    \ (no room where they'd go: by pa, and stage_pa finds no room unless the
    \ clip leaves fewer)
    LDA tf_n : CMP #OUT_FACES : BCS no_room
    LDA out_vn : TAX : CLC : ADC p_n : BCC room
.no_room
    JMP by_pa
.room
    STA end
.gather
    LDY lp : INC lp
    LDA lp_table,Y : TAY
    LDA voc,Y : TSB any
    AND every : STA every
    LDA vsxl,Y : STA out_vxl,X
    LDA vsxh,Y : STA out_vxh,X
    LDA vsyl,Y : STA out_vyl,X
    LDA vsyh,Y : STA out_vyh,X
    INX : CPX end : BNE gather
    LDA every : BEQ seen
    RTS
.seen
    LDA any : BNE to_pa
    \ a repeat? each vertex against the one before it, the first against the last
    LDX out_vn : LDY end : DEY
.repeat
    LDA out_vxl,X : CMP out_vxl,Y : BNE differ
    LDA out_vxh,X : CMP out_vxh,Y : BNE differ
    LDA out_vyl,X : CMP out_vyl,Y : BNE differ
    LDA out_vyh,X : CMP out_vyh,Y : BEQ to_pa
.differ
    TXA : TAY
    INX : CPX end : BNE repeat
    JSR drawable : BCC rejected
    LDX face : LDA fa_col,X
    JMP commit
.to_pa
    LDY out_vn
    LDX #0
.copy
    LDA out_vxl,Y : STA pa_xl,X
    LDA out_vxh,Y : STA pa_xh,X
    LDA out_vyl,Y : STA pa_yl,X
    LDA out_vyh,Y : STA pa_yh,X
    INY
    INX : CPX p_n : BNE copy
.in_pa
    LDA any : BEQ repeats
    JSR clip2d
    BRA staged
.repeats
    JSR dedupe
.staged
    JSR stage_pa : BCC rejected
    JSR drawable : BCC rejected
    LDX face : LDA fa_col,X
    JMP commit
.rejected
    RTS
.by_pa
    LDX #0
.pa_gather
    LDY lp : INC lp
    LDA lp_table,Y : TAY
    LDA voc,Y : TSB any
    AND every : STA every
    LDA vsxl,Y : STA pa_xl,X
    LDA vsxh,Y : STA pa_xh,X
    LDA vsyl,Y : STA pa_yl,X
    LDA vsyh,Y : STA pa_yh,X
    INX : CPX p_n : BNE pa_gather
    LDA every : BNE rejected
    BRA in_pa
}

\ draw_object: the candidate of_cand's seen faces, in order; it joins the
\ draw list if any is drawn. A polygon object's vertices go through the
\ vertex pass first; a face with every vertex projected goes by poly_face,
\ and the rest of its faces by cone_face; a line's or a point's by
\ draw_segment.
.draw_object
{
    ZA_ENTRY
    ZA_AUTO1 face, mask, first
    LDX of_slot : LDA ob_f0,X : STA face
    LDX of_cand : LDA cd_mask,X : STA mask
    LDA tf_n : STA first
    LDX of_slot
    LDA ob_flags,X : BIT #F_LINE : BNE each3d
    AND #K_MASK : CMP #K_SENSOR : BEQ each3d
    JSR vertex_pass
.passed                             ; (tools/objectcheck.mjs reads vp_off here)
.face_loop
    LSR mask : BCC next
    LDX face
    LDA fa_vmask,X : BIT vp_off : BNE hard
    JSR poly_face
    BRA next
.hard
    JSR cone_face : BCC next
    JSR stage_pa : BCC next
    JSR drawable : BCC next
    LDX face : LDA fa_col,X
    JSR commit
.next
    INC face
    LDA mask : BNE face_loop
    BRA listed
.each3d
    LSR mask : BCC next3d
    LDX face : JSR draw_segment
.next3d
    INC face
    LDA mask : BNE each3d
.listed
    LDA tf_n : SEC : SBC first : BEQ none
    LDY dl_n
    STA dl_nf,Y
    LDA first : STA dl_f0,Y
    LDA of_slot : STA dl_obj,Y
    INC dl_n
.none
    RTS
}


\ The vertex pass's tables.
.bit8
    EQUB 1 << (0..7)
ASSERT CONE                             ; (the model's render.CONE: the 6502 has only it)
ASSERT BEHIND_EDGES AND FRONT_FIRST AND SIDE_CROSSINGS AND JOINS AND RECIP_2D   ; (and these)
\ The band (band_test), indexed by 2 bitlen(z) from ZNEAR's: for k = n +
\ BAND_XS (x) and n + BAND_YS (y), the bias 2^k on each of the top two
\ bytes and the mask of the bits from k + 1 up.
BAND_I0 = 2 * 9
ASSERT ZNEAR >= 1 << 8 AND ZNEAR < 1 << 9
BAND_N = (BAND_I0..47) DIV 2
BAND_KX = BAND_N + BAND_XS
BAND_KY = BAND_N + BAND_YS
band_xb1 = P% - BAND_I0
    EQUB WHERE(BAND_KX >= 8 AND BAND_KX <= 15, 1 << (BAND_KX - 8), 0)
band_xb2 = P% - BAND_I0
    EQUB WHERE(BAND_KX >= 16 AND BAND_KX <= 22, 1 << (BAND_KX - 16), 0)
band_xm1 = P% - BAND_I0
    EQUB WHERE(BAND_KX <= 15, (&FF << (BAND_KX - 7)) AND &FF, 0)
band_xm2 = P% - BAND_I0
    EQUB WHERE(BAND_KX <= 15, &FF, WHERE(BAND_KX <= 22, (&FF << (BAND_KX - 15)) AND &FF, 0))
band_yb1 = P% - BAND_I0
    EQUB WHERE(BAND_KY >= 8 AND BAND_KY <= 15, 1 << (BAND_KY - 8), 0)
band_yb2 = P% - BAND_I0
    EQUB WHERE(BAND_KY >= 16 AND BAND_KY <= 22, 1 << (BAND_KY - 16), 0)
band_ym1 = P% - BAND_I0
    EQUB WHERE(BAND_KY <= 15, (&FF << (BAND_KY - 7)) AND &FF, 0)
band_ym2 = P% - BAND_I0
    EQUB WHERE(BAND_KY <= 15, &FF, WHERE(BAND_KY <= 22, (&FF << (BAND_KY - 15)) AND &FF, 0))

ENDSECTION

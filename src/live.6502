\ ***************************************************************************
\ FREESCAPE for the BBC Master - Driller, live: Driller's own logic and the
\ whole pipeline on the BBC
\
\ Driller's player logic (src/logic/, docs/research/logic6502.md) takes the
\ keys a pass at a time, as the original does: its steps, turns, climbs,
\ falls, walls, doorways and area edges, and the FCL. Every frame, from the
\ camera alone, the object pipeline (stages 1-7: src/objects.6502's
\ objects_frame, from the area's records), then the rasteriser and writer
\ (stages 8-10: src/raster.6502's raster_frame), between frame_begin and
\ frame_end (src/screen.6502). Nothing of a view is worked out off the BBC.
\ Driller's own data (decision 6: a tech demo, attributed on the screen):
\ its database, in the logic's bank as the logic keeps it, which area_enter
\ builds each area's working copy from (src/area.6502).
\
\ The logic moves a whole step or turn a pass; the frames between show it
\ (decision 4): a pass's camera goes from where the last left it to where
\ this one does over PASS_FIELDS fields, along the segment its move walked,
\ a turn in its 5-degree steps (lv_setup, lv_camera). A held key's passes
\ follow on without a gap once it repeats (lv_pass: the pace, decision 48,
\ with the port's start sizes). An area's change comes once the old area's
\ frames of the walk into it are shown. The crosshair (B) is drawn over the
\ view, by EOR as the original draws it.
\
\ -D FREE_CAMERA=TRUE builds the free camera instead, for checking views:
\ cursor left and right (or Q and W) turn a step of 5 degrees a frame,
\ cursor up and down (or O and K) walk LIVE_STEP world units along the view
\ a frame, through anything; P and L look, N and M roll; SPACE goes on to
\ the next entrance; with no key for DEMO_FIELDS fields the camera turns on
\ the spot and goes on to the next entrance after a whole turn.
\
\ Around the view, drawn into both buffers: Driller's panel (src/panel.6502,
\ docs/research/panel.md), the ST's console redrawn, its instruments the
\ logic's (or with the free camera, the camera's), the area's name and its
\ message (or the entrance), the frames a second, and the credit. The
\ frames a second is the mean over the frames since it was last drawn,
\ every FIGURE_FIELDS fields, or once the frames stop; the cycles a frame
\ of stages 1-7 (objects_frame's call) and of stages 8-10 (raster_frame's)
\ are timed by User VIA T2 (clock), for the check.
\ A frame is drawn only when something it's made from has changed since
\ the frame last handed over (the camera, the area, the objects'
\ visibility, the crosshair: docs/research/live.md, "The idle loop"), and
\ then whole, so the figures are always the pipeline's cost; while nothing
\ changes, the loop goes on taking the keys and the logic's passes, and
\ draws nothing.
\
\ This file is the glue, and the only place that knows how the stages meet:
\ the memory map, the paging, the camera, the area's patterns, the
\ animation and the figures. docs/research/live.md has the design.
\ ***************************************************************************

INCLUDE "defs.6502"
INCLUDE "zp.6502"
INCLUDE "macros.6502"
INCLUDE "../build/maths/consts.6502"
INCLUDE "../build/logic6502/data.6502"

IF DEFINED(BUILD)
    build_stamp = BUILD
ELSE
    build_stamp = "DEV"
ENDIF
IF DEFINED(FREE_CAMERA)
    LIVE_LOGIC = NOT(FREE_CAMERA)   ; the camera Driller's logic moves, or a free one
ELSE
    LIVE_LOGIC = TRUE
ENDIF

\ ---------------------------------------------------------------------------
\ The memory map (docs/research/live.md, "Memory"; every boundary ASSERTed
\ at the end of this file).
\
\ Sideways RAM:
\   BANK_DB      the logic's LOGIC_BANK: Driller's database at its top, which
\                the logic walks and area_enter builds each area's working
\                copy from, and the logic's code that reads it (Logic,
\                src/logic/bank.6502); in the gap between them, this file's
\                glue (LiveGlue: the animation and the crosshair, or the
\                free camera)
\   BANK_DATA    the logic's LOGIC_CODE_BANK: the rest of the logic's code
\                (LogicCode), then LiveData (the areas' patterns:
\                tools/mklive.py, LDATA; and the lines' code), the panel's
\                code and tables (PanelData, PDATA: src/panel.6502), and the
\                working copy's conversion (AreaConv, ACONV: src/area.6502)
\   BANK_OBJ     the object pipeline's code (ObjCode): the transform's and
\                the object pass's first, below obj_andy_reach, then the
\                rest, which ANDY's code may call
\   ANDY         (ROMSEL's bit 7, over BANK_OBJ's first 4K) the object
\                pipeline's rarely run code (ObjAndy, decision 52: the
\                lines and points, the planes' own lines, the matrix's
\                build, the sensors, frac16, the slow fills), which its
\                code calls through trampolines in ObjMore
\                (src/transform.6502's ANDY_CALL); the loader puts it in
\                once the OS is gone (LIVE_LATE)
\   BANK_RASTER  the rasteriser's row runs, code and work (decision 20)
\ HAZEL (ACCCON's Y, set for good once the OS is gone):
\   the maths' tables (the logic's multiplies share their quarter squares)
\   and the transform's f64 table (ObjTables), which the loader unpacks once
\   the OS is gone; then the pipeline's work (ObjWork, the camera with it)
\ Main RAM below &3000 (which ACCCON's X switches), read whatever X and
\ whatever bank is paged:
\   &0E00 on: the rasteriser's state (RasterState, on a page), this code
\   (LIVE), area_init's and area_enter's (AreaCode: they page the banks in,
\   so can't be in one), the logic's variables (LogicWork), and the front
\   end's code (ObjMore: the maths', which patches itself, and the 2D
\   clip's), to &3000
\   Work (src/zp.6502), then RasterIn, the rasteriser's input, where it ends
\   at RASTER_IN_END: the object pipeline's output (ObjOut) is laid over it,
\   array for array, so no copy goes between them
\   page &0D: the start (LiveBoot), which runs once
\ Main RAM's &3000 up to SCREEN: the front end's data, which only
\   objects_frame and area_enter read and write: the transform's cache
\   (ObjCache), the sort's memory (ObjMemo), the pipeline's tables
\   (ObjConst), the area's working copy (ObjArea) and the objects' bounds
\   (ObjBound, kept with the cache); so live_loop clears
\   ACCCON's X before objects_frame (frame_begin sets X for the buffer
\   drawn, after), and lv_enter_area before area_enter. The rest, to
\   SCREEN, is the front end's room for more of the same. Until clear_work
\   clears the cache at the start, the panel's packed picture is there
\   (PanelPack, PANEL: the loader puts it there, panel_init unpacks it).
\ Shadow RAM's &3000 up to SCREEN: the logic's lists by face (LogicFaces),
\   which only its passes read and write, so lv_pass sets ACCCON's X round
\   each
\
\ A routine in a bank is called with its bank paged (PAGE_IN); area_enter puts
\ back the bank in ROMSEL_COPY, so PAGE_IN keeps that too. The logic's entries
\ (src/logic/call.6502) page their own banks and leave one in.
\
\ The disc (src/loader.6502): this build writes each part's section as a
\ file (baron -p) and PRINTs where each goes (channel 1, below: LD_PARTS and
\ LD_LATE); the loader's build packs them into !BOOT and DRILLER, and the
\ loader unpacks each into its place, HAZEL's and ANDY's once the OS is gone, then
\ starts this at start.

BANK_DB     = 4                 ; src/logic/vars.6502's LOGIC_BANK
BANK_DATA   = 5                 ; ... and its LOGIC_CODE_BANK
BANK_RASTER = 6
BANK_OBJ    = OBJ_BANK          ; (src/defs.6502's: the check build's too)
BANK_GLUE   = BANK_DB           ; (LiveGlue's)
AREA_DB_BANK   = BANK_DB        ; (src/area.6502's)
AREA_CONV_BANK = BANK_DATA
IF LIVE_LOGIC
    OBJ_LOGIC    = TRUE         ; (src/area.6502, src/objects.6502: what's hidden is the logic's)
    AREA_GLOBALS = Globals      ; (the globals' records are the logic's, which moves the rig's parts)
ENDIF
\ (ROMSEL_COPY, the OS's copy of romsel, is src/area.6502's, outside
\ baron's pool)

MACRO PAGE_IN bank
    LDA #bank : STA ROMSEL_COPY : STA romsel
ENDMACRO

\ HAZEL: the maths' tables and the f64 table, then the work.
SECTION Hazel, org = &C000, filename = "HAZEL"
INCLUDE "../build/maths/tables.6502"
.hazel_tables_end
ENDSECTION
SECTION ObjTables, org = hazel_tables_end, filename = "OTABLE"
ENDSECTION
SECTION ObjWork, org = obj_tables_end, guard = &E000, virtual = TRUE
ENDSECTION
\ The cache: main RAM's &3000 on, with ACCCON's X clear.
OBJ_CACHE_ORG = &3000
SECTION ObjCache, org = OBJ_CACHE_ORG, guard = SCREEN, virtual = TRUE
ENDSECTION
\ the sort's memory after it, likewise only objects_frame's (src/order.6502)
SECTION ObjMemo, org = obj_cache_end, guard = SCREEN, virtual = TRUE
ENDSECTION
\ then the pipeline's tables (the loader puts them there, in main RAM) and
\ the area's working copy, which objects_frame reads and area_enter writes,
\ both with X clear; the rest up to SCREEN is the front end's room for
\ such data
SECTION ObjConst, org = obj_memo_end, filename = "OCONST", guard = SCREEN
ENDSECTION
SECTION ObjArea, org = obj_const_end, guard = SCREEN, virtual = TRUE
ENDSECTION
\ (and the objects' bounds, kept with the cache: src/transform.6502)
SECTION ObjBound, org = obj_area_end, guard = SCREEN, virtual = TRUE
ENDSECTION

\ The logic, in this build's map: its variables after area_enter's code,
\ its keys' bitmap this file's, its quarter squares the maths' in HAZEL,
\ its lists by face in shadow RAM's &3000 on, three of its hooks this
\ file's.
LOGIC_WORK_ORG    = area_code_end
LOGIC_WORK_GUARD  = &3000
LOGIC_SQUARES     = sq_lo
\ The fill's quarter squares the same (src/raster.6502's RASTER_SQUARES):
\ HAZEL is paged whenever it runs.
RASTER_SQUARES    = sq_lo
IF LIVE_LOGIC
    LOGIC_KEYS        = lv_lkeys
    LOGIC_HOOK_WAIT   = lv_hook_wait
    LOGIC_HOOK_WALKED = lv_hook_walked
    LOGIC_HOOK_LOADED = lv_hook_loaded
ENDIF
\ (the same table: n * n DIV 4 for n from 0 to 511, low bytes then high)
ASSERT LEN(MATHS_SQ) = 512 AND MAX(ABS(MATHS_SQ - (0..511) * (0..511) DIV 4)) = 0 AND sq_hi = sq_lo + 512
LOGIC_FACES_ORG   = &3000
SECTION LogicFaces, org = LOGIC_FACES_ORG, guard = SCREEN, virtual = TRUE
ENDSECTION
INCLUDE "logic/vars.6502"
INCLUDE "logic/bank.6502"
ASSERT LOGIC_BANK = BANK_DB AND LOGIC_CODE_BANK = BANK_DATA
ASSERT IX_HIDDEN = &60          ; (src/area.6502's: bit 6 invisible, bit 5 destroyed)

\ The banks. The front end's code from OBJ_CODE_ORG (src/defs.6502): its
\ hot loops' branches cross pages, or don't, by where it starts, and that
\ page offset was the fastest of a sweep (docs/research/live.md,
\ "Measurements", 2026-11-01); aligning those loops would take the bytes
\ before it back.
SECTION ObjCode, org = OBJ_CODE_ORG, guard = &C000, filename = "OCODE", cmos = TRUE
ENDSECTION
SECTION ObjAndy, org = &8000, guard = &9000, filename = "OANDY", cmos = TRUE
ENDSECTION
SECTION RasterRuns, org = &8000, guard = &C000, filename = "RRUNS", cmos = TRUE
ENDSECTION
SECTION RasterCode, org = raster_runs_end, guard = &C000, filename = "RCODE", cmos = TRUE
ENDSECTION
SECTION RasterWork, org = raster_code_end, guard = &C000, virtual = TRUE
ENDSECTION
SECTION LiveData, org = logic_code_end, guard = &C000, filename = "LDATA", cmos = TRUE
ENDSECTION
SECTION PanelData, org = live_data_end, guard = &C000, filename = "PDATA", cmos = TRUE
ENDSECTION
SECTION AreaConv, org = panel_data_end, guard = &C000, filename = "ACONV", cmos = TRUE
ENDSECTION
SECTION LiveGlue, org = logic_db_code_end, guard = LOGIC_DB, filename = "LGLUE", cmos = TRUE
ENDSECTION
INCLUDE "../build/live/data.6502"

\ Main RAM below &3000. First the rasteriser's state, which it reads and
\ writes whatever ACCCON's X (the buffer it draws), on a page as its ALIGN
\ asks, so none is lost to it; LIVE straight after.
RASTER_STATE_ORG = &0E00
SECTION RasterState, org = RASTER_STATE_ORG, guard = &3000, virtual = TRUE
ENDSECTION
SECTION AreaCode, org = live_end, filename = "LAREA", guard = &3000, cmos = TRUE
ENDSECTION
\ (LogicWork after it: src/logic/vars.6502, LOGIC_WORK_ORG above)
\ ObjMore: the front end's code outside its bank, and its room, the rest of
\ main RAM below &3000 (docs/research/live.md, "Memory"), read whatever
\ bank is paged and whatever ACCCON's X: first the maths' code, which
\ patches itself so lives in RAM, then the 2D clip's (src/clip.6502). The
\ maths' code starts on a page, as in its own check (tools/mathscheck.6502),
\ so its branches take the cycles that check counts.
SECTION ObjMore, org = logic_work_end, filename = "OMORE", guard = &3000, cmos = TRUE
ALIGN 256
INCLUDE "maths.6502"
INCLUDE "project.6502"
\ live_shared: never called. It reaches the projection's shared-coordinate
\ entries as a caller would (mk/objects.mk's check_shared), since no stage
\ calls them yet, so that baron places their zero page.
.live_shared
    ZA_ENTRY
    JSR shared_in : JSR project
    JSR shared_in : JSR project_z
    JSR shared_in : JSR project_y
    RTS
.shared_in
    ZA_DISCARD proj_v
    FOR i = 0..8
        STZ proj_v + i
    NEXT
    RTS
ENDSECTION
\ RasterIn ends at RASTER_IN_END, its vertices (from rs_vxl) page-aligned
\ straight after its faces' arrays, as ObjOut's are.
RASTER_IN_END = &0D00                   ; (&0D00 on is the NMI's and the MOS's)
RASTER_IN_HEAD = 11                     ; rs_nfaces .. rs_overflow
RASTER_IN_ORG = RASTER_IN_END - 5 * 256 - 3 * RS_FACES - RASTER_IN_HEAD
SECTION RasterIn, org = RASTER_IN_ORG, guard = RASTER_IN_END, virtual = TRUE
ENDSECTION
\ Page &0D: the start, which runs once (LiveBoot: start, before live_loop,
\ with lv_start and clock_init). The
\ DFS's NMI code is there until the loader's last read, and nothing after;
\ a soft BREAK reads the Master's extended vectors from &0D9F, so the start
\ stays below. The loader puts it in once the OS is gone (LIVE_LATE).
LIVE_BOOT_ORG = RASTER_IN_END
SECTION LiveBoot, org = LIVE_BOOT_ORG, guard = &0D9F, filename = "LBOOT", cmos = TRUE
ENDSECTION
SECTION ObjOut, org = rs_fn - 2, guard = rs_pat, virtual = TRUE
ENDSECTION
\ The panel's packed picture, which the loader puts in the transform's
\ cache, which nothing uses until clear_work clears it after panel_init;
\ and the page panel_init copies the picture through, RasterIn's, likewise.
PANEL_LOAD = OBJ_CACHE_ORG
SECTION PanelPack, org = PANEL_LOAD, filename = "PANEL", guard = SCREEN
ENDSECTION
PANEL_BOUNCE = RASTER_IN_ORG

\ The records, the pipeline and the rasteriser. In the pipeline's bank the
\ transform's code and the object pass's come first, as nothing ANDY's
\ code reaches is theirs: from obj_andy_reach on, past the bank's first 4K
\ (ASSERTed below), ANDY's code may call the rest (src/transform.6502's
\ ANDY_CALL).
INCLUDE "../build/gen/areas.6502"
INCLUDE "area.6502"
INCLUDE "transform.6502"
INCLUDE "objects.6502"
SECTION ObjCode
.obj_andy_reach
ENDSECTION
INCLUDE "matrix.6502"
INCLUDE "clip.6502"
INCLUDE "order.6502"
INCLUDE "raster.6502"
INCLUDE "writer.6502"

\ ObjOut over RasterIn: the same arrays, and its two counts on the horizon's
\ bytes, which go unread with no horizon (decision 8a), and rs_overflow,
\ which raster_frame sets once out_vn is done with.
ASSERT out_fn = rs_fn AND out_fv = rs_fv AND out_fc = rs_fc
ASSERT out_vxl = rs_vxl AND out_vxh = rs_vxh AND out_vyl = rs_vyl AND out_vyh = rs_vyh
ASSERT OUT_FACES = RS_FACES AND OUT_VERTS = RS_VERTICES
ASSERT out_nf > rs_horizon AND out_nf <> rs_overflow AND out_vn < rs_fn
ASSERT rs_fn - rs_nfaces = RASTER_IN_HEAD
\ The patterns: 0 the sky, then the colour indices', so out_fc is rs_fc.
LIVE_PATTERNS = 16
ASSERT LIVE_PATTERNS <= RS_PATTERNS

\ ---------------------------------------------------------------------------
\ LIVE: all below &3000, after the rasteriser's state.
SECTION Live, org = raster_state_end, filename = "LIVE", guard = &3000, cmos = TRUE

\ User VIA T2, which nothing else uses: free-running down at 1MHz (clock).
usrvia_t2cl = &FE68
usrvia_t2ch = &FE69

\ The panel's values (src/panel.6502): the logic's, or with the free camera
\ the camera's position, heading and pitch, the rest as the logic starts,
\ and the entrance where the logic's message goes.
IF LIVE_LOGIC
    PANEL_FREE  = FALSE
    PANEL_POS   = PlayerX
    PANEL_YAW   = Yaw
    PANEL_PITCH = Pitch
ELSE
    PANEL_FREE  = TRUE
    PANEL_POS   = lv_x
    PANEL_YAW   = lv_yaw
    PANEL_PITCH = lv_pitch
ENDIF
INCLUDE "panel.6502"
\ The free camera's message: " ENTRANCE nn  " or "     DEMO nn  ".
ENTRANCE_CELL = PF_MESSAGE + 1  ; "ENTRANCE" or "    DEMO" ...
ENTRANCE_ID   = PF_MESSAGE + 10 ; ... the entrance's id, two digits, the first blank if 0
ASSERT ENTRANCE_ID + 2 < PF_MESSAGE + PN_MESSAGE

DEMO_FIELDS   = 500             ; fields without a key before the demo
FIGURE_FIELDS = 100             ; fields between the figures' updates
\ The field's rate, a hundred times: frames a second from fields a frame.
FIELDS_100S = 200000000 DIV FIELD_CYCLES
FIELD_US2 = FIELD_US            ; (clock's window, below)
ASSERT 2 * FIELD_US < 65536     ; (clock: two fields' doubt inside T2's wrap)

\ The pace (decisions 4, 36 and 48, docs/research/live.md, "The pace"):
\ PASS_FIELDS and REPEAT_FIELDS are tools/logic/state.py's, with the
\ port's start (through build/logic6502/data.6502), Matt's to change there.
\ A pass's frames take PASS_FIELDS fields, so a key held takes
\ 50 / PASS_FIELDS passes a second, each a step or a turn of its size; a
\ key going down gives a pass at once, and the keys held repeat
\ REPEAT_FIELDS fields after it (lv_pass), so a tap shorter than that is
\ one pass, as a keyboard's auto-repeat.
MINUTE_FIELDS = 50 * 60         ; a minute of the original's clock, a field a frame of its
ASSERT PASS_FIELDS >= 2 AND PASS_FIELDS < 128   ; (lv_setup: a pass's first frame isn't its last)
ASSERT REPEAT_FIELDS < 256

\ ---------------------------------------------------------------------------
\ The start, run once, in page &0D (LiveBoot, above). An NMI comes to
\ &0D00: none does with the disc done with, but one would find an RTI.
SECTION LiveBoot
    RTI

\ start (the loader's LD_EXEC, with every part in place and the OS gone):
\ the machine taken, the panel's picture unpacked into both buffers before
\ clear_work clears where it was loaded, everything set up, then the
\ frames, for ever.
.start
    ZA_ENTRY
    SEI
    LDX #&FF : TXS                              ; (nothing returns to the OS)
    LDA #ACCCON_D OR ACCCON_X OR ACCCON_E : TRB acccon
    LDA #ACCCON_Y : TSB acccon                  ; HAZEL, for good
    JSR screen_init
    PAGE_IN BANK_DATA
    JSR panel_init
    JSR clear_work
    PAGE_IN BANK_RASTER
    JSR raster_init
    PAGE_IN BANK_OBJ
    JSR area_init
    PAGE_IN BANK_DATA
    JSR live_init
    JSR frame_init
IF LIVE_LOGIC
    JSR lv_start                                ; Driller's start: the logic's camera, its area
ELSE
    PAGE_IN BANK_GLUE
    JSR live_first                              ; the first entrance
ENDIF
    PAGE_IN BANK_DATA
    JSR panel_flush                             ; (both buffers, before anything is shown)
    JSR input_init
    JSR irq_install
    JSR clock_init
    JMP live_loop
ENDSECTION

\ live_loop: a frame at a time. The logic's pass when one is due, and the
\ frame's camera (or the free camera's keys); then, if anything the view is
\ made from has changed since the frame last handed over (lv_inputs),
\ objects_frame makes the faces in rs_*'s arrays, and raster_frame draws
\ them, between frame_begin and frame_end, with the crosshair over them;
\ the text when the beam allows, and the figures (live_measure) from the
\ clock round each. If nothing has, nothing is drawn (live_idle).
.live_loop
IF LIVE_LOGIC
    JSR read_counters
    LDA count_fields : STA lv_now
    LDA count_fields+1 : STA lv_now+1
    LDA lv_request : BEQ passing
    JSR lv_requested
.passing
    JSR lv_pass
    PAGE_IN BANK_GLUE
    JSR lv_camera
ELSE
    PAGE_IN BANK_GLUE
    JSR live_keys
ENDIF
    JSR lv_inputs                               ; (vw_new: whether there's anything new to draw)
    PAGE_IN BANK_DATA
    JSR panel_sync
    LDA vw_new : BNE live_draw
    \ Nothing new since the frame last handed over, so nothing is drawn
    \ (docs/research/live.md, "The idle loop"): the keys and passes go on,
    \ so the next frame starts as soon as anything changes. (The panel needs
    \ no waiting for here: panel_sync, every loop, finds the beam's window.)
.live_idle                                      ; (tools/livecheck.mjs: the loop drew nothing)
    PAGE_IN BANK_GLUE
    JSR live_idle_measure
    JMP live_loop
.live_draw
IF NOT(LIVE_LOGIC)
    JSR panel_values                            ; (the camera's moved, or the area's changed)
ENDIF
    \ stages 1-7
    LDX #LV_CAM_BYTES - 1
.camera
    LDA lv_cam,X : STA cam_x,X
    DEX : BPL camera
    JSR clock : LDX #T_FRONT : JSR clock_from
    PAGE_IN BANK_OBJ
    LDA #ACCCON_X : TRB acccon                  ; (main RAM's &3000 on: the cache)
    JSR objects_frame
.live_front_done                                ; (tools/livecheck.mjs times objects_frame to here)
    JSR clock
    PAGE_IN BANK_GLUE
    LDX #T_FRONT : JSR clock_to
    LDA out_nf : STA rs_nfaces
    \ stages 8-10
    PAGE_IN BANK_DATA
    JSR panel_sync
    JSR frame_begin
IF LIVE_LOGIC
    PAGE_IN BANK_GLUE
    JSR lv_cross_off                            ; (the crosshair this buffer had, off)
ENDIF
    PAGE_IN BANK_RASTER
    JSR clock : LDX #T_FILL : JSR clock_from
    JSR raster_frame
.live_fill_done                                 ; (... and raster_frame to here)
    JSR clock
    PAGE_IN BANK_GLUE
    LDX #T_FILL : JSR clock_to
IF LIVE_LOGIC
    JSR lv_cross_on                             ; (and the crosshair now, if it's shown)
ENDIF
    JSR live_measure
    PAGE_IN BANK_DATA
    LDA lv_named : BNE named
    LDA #NAMED_CELLS : JSR panel_wait           ; a new area's name and message with its first frame
    INC lv_named
.named
    JSR panel_catch_up
.live_frame_done                                ; (tools/livecheck.mjs: the frame's made)
    JSR frame_end
    JMP live_loop
NAMED_CELLS = PF_NAME + PN_NAME                 ; (the cells before the name's end: the message's in them)
ASSERT PF_MESSAGE < PF_NAME

INCLUDE "screen.6502"
INCLUDE "irq.6502"
INCLUDE "input.6502"
INCLUDE "logic/call.6502"
INCLUDE "logic/hooks.6502"

SECTION Work
    \ the camera, as objects_frame takes it (src/matrix.6502's cam_*)
.lv_cam
.lv_x           SKIP 2
.lv_y           SKIP 2
.lv_z           SKIP 2
.lv_yaw         SKIP 1
.lv_pitch       SKIP 1
.lv_roll        SKIP 1
LV_CAM_BYTES = P% - lv_cam
.lv_area        SKIP 1      ; the area entered (its index in the records' directory)
.lv_entered     SKIP 1      ; areas entered, mod 256 (lv_inputs)
.lv_named       SKIP 1      ; non-zero once the area's lines are drawn
.vw_new         SKIP 1      ; non-zero: the frame's inputs aren't the last frame's (lv_inputs)
.vw_none        SKIP 1      ; non-zero until the first frame's
ENDSECTION
ASSERT cam_y = cam_x + 2 AND cam_z = cam_x + 4 AND cam_yaw = cam_x + 6
ASSERT cam_pitch = cam_x + 7 AND cam_roll = cam_x + 8 AND LV_CAM_BYTES = 9

\ ---------------------------------------------------------------------------
\ Setting up.

\ clear_work: the object pipeline's and the rasteriser's memory zeroed, as
\ their checks start from (the matrix and the cache know nothing yet).
.clear_work
{
    ZA_AUTO2 p, end
    LDX #0
.region
    LDA regions,X : STA p : LDA regions+1,X : STA p+1
    LDA regions+2,X : STA end : LDA regions+3,X : STA end+1
.byte
    LDA p : CMP end : LDA p+1 : SBC end+1 : BCS next
    LDA #0 : STA (p)
    INCW p
    BRA byte
.next
    TXA : CLC : ADC #4 : TAX
    CPX #REGIONS : BNE region
    RTS
.regions
    EQUW obj_tables_end, obj_work_end
    EQUW OBJ_CACHE_ORG, obj_cache_end           ; (with ACCCON's X clear)
    EQUW obj_area_start, obj_area_end           ; (likewise)
    EQUW RASTER_IN_ORG, raster_in_end
    EQUW RASTER_STATE_ORG, raster_state_end     ; (the OS's user memory before)
REGIONS = P% - regions
}

\ lv_enter_area: area A (its index in the records' directory) entered: its
\ patterns, the records' working copy, the rasteriser told, its lines of
\ text. Returns with BANK_GLUE paged.
.lv_enter_area
{
    ZA_AUTO2 p
    STA lv_area
    INC lv_entered
    PAGE_IN BANK_DATA
    \ the area's patterns: ld_pats + 4 LIVE_PATTERNS area
    ASSERT LIVE_PATTERNS * 4 = 64
    LDA lv_area
    STZ p+1
    ASL A : ASL A : ASL A : ASL A : ROL p+1 : ASL A : ROL p+1 : ASL A : ROL p+1
    CLC : ADC #LO(ld_pats) : STA p
    LDA p+1 : ADC #HI(ld_pats) : STA p+1
    LDY #LIVE_PATTERNS * 4 - 1
.pattern
    LDA (p),Y : STA rs_pat,Y
    DEY : BPL pattern
    PAGE_IN BANK_OBJ
    LDA #ACCCON_X : TRB acccon                  ; (the working copy, and the sort's memory its cache_reset clears, are main RAM's &3000 on)
    LDA lv_area : JSR area_enter
    PAGE_IN BANK_RASTER
    JSR raster_forget
    PAGE_IN BANK_DATA
    JSR live_lines
    PAGE_IN BANK_GLUE
    RTS
}

IF LIVE_LOGIC
\ ---------------------------------------------------------------------------
\ Driller's logic, in main RAM, as its entries change the bank paged.

SECTION Work
.lv_now         SKIP 2      ; fields at the frame's start
.lv_lkeys       SKIP KEYS_BYTES     ; the logic's keys: held, or gone down since the last pass
.lv_until       SKIP 2      ; fields before which no pass comes: its frames and its waits
.lv_repeat      SKIP 2      ; ... and before which the keys held don't repeat, if none goes down
.lv_made        SKIP 1      ; non-zero: the pass took a key gone down since the last
.lv_minute      SKIP 2      ; fields when the clock's minute ends
.lv_over        SKIP 1      ; non-zero once the game is over (2, the pass's answer)
.lv_switch      SKIP 1      ; non-zero: the area changes once the old area's frames are shown
.lv_request     SKIP 1      ; non-zero: tools/livecheck.mjs has set the logic's state (lv_requested)
    \ what the hooks saw in the pass
.lv_walks       SKIP 1      ; moves walked
.lv_walk_d      SKIP 6      ; the first's: where it stopped less where it began, x y z
.lv_walk_jet    SKIP 1      ; ... and InJet as it walked
.lv_loaded      SKIP 1      ; non-zero: an area loaded
.lv_wait        SKIP 1      ; the fields the original would have waited
    \ the animation (lv_setup, lv_camera)
.an_on          SKIP 1      ; non-zero: the frames show a pass
.an_t0          SKIP 2      ; fields at its start ...
.an_end         SKIP 2      ; ... and its end, PASS_FIELDS on
.an_p0          SKIP 6      ; the camera's position before the pass: x y z ...
.an_a0          SKIP 3      ; ... and angles: yaw pitch roll (lv_cam's order)
.an_d           SKIP 6      ; the way it goes, x y z
.an_da          SKIP 3      ; the angles' turns, the short way: signed
.an_hold        SKIP 1      ; non-zero: y holds until the end (the probe's step)
    \ the crosshair in each buffer (draw_buffer's index): shown, x, y
.lv_xon         SKIP 2
.lv_xx          SKIP 2
.lv_xy          SKIP 2
ENDSECTION
ASSERT PlayerY = PlayerX + 2 AND PlayerZ = PlayerX + 4
ASSERT lv_y = lv_x + 2 AND lv_z = lv_x + 4 AND lv_pitch = lv_yaw + 1 AND lv_roll = lv_yaw + 2

\ lv_start: the game's start, as LOGICW and LOGIC load it: the logic's
\ index, its area and camera. The clock's first minute from now. (Run once,
\ with start, in page &0D.)
SECTION LiveBoot
.lv_start
    STZ lv_now : STZ lv_now+1                   ; (frame_init's fields)
    STZ lv_repeat : STZ lv_repeat+1
    STZ lv_request
    STZ lv_xon : STZ lv_xon+1
    LDA lv_now : CLC : ADC #LO(MINUTE_FIELDS) : STA lv_minute
    LDA lv_now+1 : ADC #HI(MINUTE_FIELDS) : STA lv_minute+1
    JMP lv_requested
ENDSECTION

\ lv_requested: the logic's state set from outside (tools/livecheck.mjs
\ writes it, then lv_request): its index made again, its area entered, and
\ its camera shown as it is, with nothing between.
.lv_requested
    STZ lv_request
    JSR logic_go_init
    STZ lv_over
    LDA lv_now : STA lv_until
    LDA lv_now+1 : STA lv_until+1
    \ (on into lv_switched)

\ lv_switched: the area the logic has loaded entered (AreaId's: unless
\ it's none of the records'), the screen's colours as its redraw would
\ take them, the objects' flags, the panel; its camera from the next frame.
.lv_switched
{
    STZ lv_switch : STZ an_on
    PAGE_IN BANK_DATA
    LDX AreaId : BMI none
    LDA ld_area_of,X : BMI none
    JSR lv_enter_area
.none
    LDA AreaChanged : BEQ shown
    JSR logic_go_colours
.shown
    JSR logic_go_shown
    PAGE_IN BANK_DATA
    JMP panel_values
}
ASSERT LIVE_AREA_IDS = 128 AND LIVE_AREAS < 128

\ lv_pass: a pass of the logic when one is due, with the keys held or gone
\ down since the last pass, and the frames that show it (lv_setup). None is
\ due until the last pass's frames are shown and its waits done (lv_until);
\ an area's change waits for the last of the old area's frames, and takes
\ the frame (lv_switched); none comes once the game's over. The keys held
\ alone repeat no sooner than REPEAT_FIELDS after a pass that took a key
\ gone down (lv_repeat), as a keyboard's auto-repeat: a key going down
\ since the last pass, or a minute's end, brings one as soon as it's due,
\ so a tap is one pass, and a key held passes every PASS_FIELDS after the
\ first repeat (the pace, decision 48). A minute of the clock goes in just
\ before the pass it ends, as the original's interrupt would count it in
\ its input's wait.
.lv_pass
{
    LDA lv_now : CMP lv_until : LDA lv_now+1 : SBC lv_until+1 : BPL due
    RTS
.due
    LDA lv_switch : BEQ here
    JMP lv_switched
.here
    LDA lv_over : BEQ alive
    RTS
.alive
    \ (keys_made read, not taken: a key the vertical sync reads after this
    \ waits for the next loop. A minute's end brings its pass whatever is
    \ held, as the original's input takes it without waiting for a key.)
    LDA lv_now : CMP lv_repeat : LDA lv_now+1 : SBC lv_repeat+1 : BPL repeats
    LDA lv_now : CMP lv_minute : LDA lv_now+1 : SBC lv_minute+1 : BPL repeats
    LDX #KEYS_BYTES - 1
.made
    LDA keys_made,X : BNE repeats
    DEX : BPL made
    RTS
.repeats
    LDA lv_now : CMP lv_minute : LDA lv_now+1 : SBC lv_minute+1 : BMI timed
    LDA lv_minute : CLC : ADC #LO(MINUTE_FIELDS) : STA lv_minute
    LDA lv_minute+1 : ADC #HI(MINUTE_FIELDS) : STA lv_minute+1
    JSR logic_go_minute
.timed
    \ (with the interrupt held off, so a key the vertical sync reads between
    \ the two isn't taken as held now and as gone down by the next pass)
    PHP : SEI
    STZ lv_made
    LDX #KEYS_BYTES - 1
.key
    JSR key_take : TSB lv_made : ORA keys,X : STA lv_lkeys,X
    DEX : BPL key
    PLP
    \ the camera before
    LDX #5
.was
    LDA PlayerX,X : STA an_p0,X
    DEX : BPL was
    LDA Yaw : JSR mod72 : STA an_a0
    LDA Pitch : JSR mod72 : STA an_a0+1
    LDA Roll : JSR mod72 : STA an_a0+2
    STZ lv_walks : STZ lv_loaded : STZ lv_wait
    LDA #ACCCON_X : TSB acccon                  ; (LogicFaces: shadow RAM's)
    JSR logic_go_pass
    TAX
    LDA #ACCCON_X : TRB acccon
    TXA
.live_passed                                    ; (tools/livecheck.mjs: A, the pass's answer)
    BEQ done
    CMP #2 : BNE ran
    STA lv_over
    PAGE_IN BANK_DATA
    JSR live_lines                              ; ("game over")
.ran
    \ The next pass after the waits the pass asked for, and on a reading of
    \ the keys made after this pass ends (the vertical sync's, a field
    \ apart): a pass that shows nothing needn't wait for a frame (live.md,
    \ "The idle loop"), so held keys that change nothing would otherwise
    \ make passes as fast as the loop goes, on readings already taken.
    LDA lv_now : CLC : ADC lv_wait : STA lv_until
    LDA lv_now+1 : ADC #0 : STA lv_until+1
    JSR read_counters
    LDA count_fields : CLC : ADC #1 : TAX
    LDA count_fields+1 : ADC #0 : TAY
    CPX lv_until : SBC lv_until+1               ; (the later of the two)
    BMI waits
    STX lv_until : STY lv_until+1
.waits
    LDA lv_made : BEQ held                      ; (a key gone down: the keys held repeat from REPEAT_FIELDS on)
    LDA lv_now : CLC : ADC #REPEAT_FIELDS : STA lv_repeat
    LDA lv_now+1 : ADC #0 : STA lv_repeat+1
.held
    LDA lv_loaded : BNE away
    JSR logic_go_shown                          ; (with an area's change, once it's entered)
    PAGE_IN BANK_DATA
    JSR panel_values                            ; (likewise)
.away
    PAGE_IN BANK_GLUE
    JMP lv_setup
.done
    RTS
}

\ The hooks (src/logic/hooks.6502) this disc fills in, called from the
\ logic's banks. They page nothing.

\ lv_hook_wait (hook_wait): the original waits A frames of its interrupt
\ here (the size keys, the crosshair's, the FCL's DELAY); the next pass
\ waits that many fields more from this one.
.lv_hook_wait
{
    CLC : ADC lv_wait : BCC fits
    LDA #&FF
.fits
    STA lv_wait
    RTS
}

\ lv_hook_walked (hook_walked): the first move's segment, where it stopped
\ less where it began, and InJet as it walked; and the moves counted.
.lv_hook_walked
{
    LDA lv_walks : BNE counted
    LDX #4
.axis
    LDA TargetX,X : SEC : SBC PlayerX,X : STA lv_walk_d,X
    LDA TargetX+1,X : SBC PlayerX+1,X : STA lv_walk_d+1,X
    DEX : DEX : BPL axis
    LDA InJet : STA lv_walk_jet
.counted
    INC lv_walks
    RTS
}
ASSERT TargetY = TargetX + 2 AND TargetZ = TargetX + 4

\ lv_hook_loaded (hook_loaded): an area is loading.
.lv_hook_loaded
    LDA #1 : STA lv_loaded
    RTS

\ mod72: A mod 72. The logic's angles are bytes, and the database can make
\ any byte one: a GOTO to an id an entrance shares with an object before it
\ (area 2's 16 is a cuboid's too) puts the camera at that object, its size
\ for its angles. The renderer takes each mod 72, as the model's entrance
\ cameras do (tools/model/camera.py's from_entrance). Keeps X and Y.
.mod72
{
.again
    CMP #STEPS_TURN : BCC done
    SBC #STEPS_TURN
    BRA again
.done
    RTS
}
ENDIF

\ ---------------------------------------------------------------------------
\ The clock: User VIA T2 counting down at 1MHz, round from 0 to &FFFF and
\ on, and the fields counted. A span's length in microseconds is its T2
\ difference modulo 65536, and the fields it saw say which: a span with
\ n fields flagged in it is more than (n - 1) fields long and less than
\ n + 1, a window narrower than T2's wrap.
T_FRONT = 0                     ; spans: stages 1-7's ...
T_FILL  = 4                     ; ... and 8-10's (clock_from's and clock_to's X)

SECTION Work
.clk_t          SKIP 2      ; clock's: T2 ...
.clk_f          SKIP 2      ; ... and the fields, counting a sync flagged and not yet taken
.span_t         SKIP 8      ; each span's start, then its length in microseconds (low 16 bits)
.span_us        SKIP 8      ; each span's length: microseconds, 24-bit, then a spare byte
.win_n          SKIP 1      ; frames since the figures
.win_f0         SKIP 2      ; fields and frames shown when the figures were last drawn
.win_s0         SKIP 2
ENDSECTION

\ clock_init: T2 started, one-shot (so free-running down), its interrupt
\ left off. (Run once, with start, in page &0D.)
SECTION LiveBoot
.clock_init
    LDA usrvia_acr : AND #&DF : STA usrvia_acr
    LDA #&FF : STA usrvia_t2cl : STA usrvia_t2ch
    RTS
ENDSECTION

\ clock: the time now in clk_t and clk_f. Keeps X.
.clock
{
    PHP : SEI
.again
    LDA usrvia_t2ch : STA clk_t+1
    LDA usrvia_t2cl : STA clk_t
    LDA usrvia_t2ch : CMP clk_t+1 : BNE again   ; (the low byte wrapped between)
    LDA fields : STA clk_f
    LDA fields+1 : STA clk_f+1
    LDA sysvia_ifr : AND #2 : BEQ counted       ; a sync flagged, not yet counted
    INCW clk_f
.counted
    PLP
    RTS
}

\ clock_from: span X starts now (clk_*): its start's T2 and fields kept.
.clock_from
    LDA clk_t : STA span_t,X
    LDA clk_t+1 : STA span_t+1,X
    LDA clk_f : STA span_us,X
    LDA clk_f+1 : STA span_us+1,X
    RTS

\ clock_to: span X ends now: its length in microseconds into span_us,X
\ (24 bits). With n the fields seen and d the T2 difference, the length is
\ lo + ((d - lo) AND &FFFF), lo = (n - 1) FIELD_US.
\ In BANK_GLUE (main RAM is the front end's): called with it paged, after
\ the clock's read in main RAM.
ASSERT FIELD_US = 78 * 256      ; ((n - 1) FIELD_US: (n - 1) 78, a byte up)
SECTION LiveGlue
.clock_to
{
    ZA_AUTO 3, lo
    ZA_AUTO2 d
    \ d = T2's fall
    LDA span_t,X : SEC : SBC clk_t : STA d
    LDA span_t+1,X : SBC clk_t+1 : STA d+1
    \ n - 1, then lo = (n - 1) 78 256, 24-bit signed
    LDA clk_f : SEC : SBC span_us,X : STA lo+1
    LDA clk_f+1 : SBC span_us+1,X : STA lo+2
    LDA lo+1 : SEC : SBC #1 : STA lo+1
    LDA lo+2 : SBC #0 : STA lo+2
    STZ lo
    JSR times78
    \ the length: lo + ((d - lo) AND &FFFF)
    LDA d : SEC : SBC lo : STA d
    LDA d+1 : SBC lo+1 : STA d+1
    LDA lo : CLC : ADC d : STA span_us,X
    LDA lo+1 : ADC d+1 : STA span_us+1,X
    LDA lo+2 : ADC #0 : STA span_us+2,X
    RTS
\ times78: lo+1..lo+2, a signed 16-bit count of fields, times 78 in place.
.times78
    ZA_AUTO2 m
    LDA lo+1 : STA m : LDA lo+2 : STA m+1
    \ 78 = 64 + 8 + 4 + 2: m 2 (1 + 2 + 4 + 32)
    ASL m : ROL m+1                             ; 2m
    LDA m : STA lo+1 : LDA m+1 : STA lo+2
    ASL m : ROL m+1                             ; 4m
    LDA lo+1 : CLC : ADC m : STA lo+1 : LDA lo+2 : ADC m+1 : STA lo+2
    ASL m : ROL m+1                             ; 8m
    LDA lo+1 : CLC : ADC m : STA lo+1 : LDA lo+2 : ADC m+1 : STA lo+2
    ASL m : ROL m+1 : ASL m : ROL m+1 : ASL m : ROL m+1   ; 64m
    LDA lo+1 : CLC : ADC m : STA lo+1 : LDA lo+2 : ADC m+1 : STA lo+2
    RTS
}
ENDSECTION
ASSERT 78 = 2 + 4 + 8 + 64

\ read_counters: fields and frames (src/zp.6502), which the interrupt
\ changes, read whole.
SECTION Work
.count_fields   SKIP 2
.count_frames   SKIP 2
ENDSECTION
.read_counters
    PHP : SEI
    LDA fields : STA count_fields : LDA fields+1 : STA count_fields+1
    LDA frames : STA count_frames : LDA frames+1 : STA count_frames+1
    PLP
    RTS

\ ---------------------------------------------------------------------------
\ In BANK_DATA, after LiveData: the lines, called with that bank paged, and
\ paging nothing.
SECTION LiveData

\ live_init: the background; no area yet, the game not over, no figures.
.live_init
    STZ rs_sky : STZ rs_ground : STZ rs_horizon
    LDA #&FF : STA lv_area : STA vw_none : STA panel_area
    STZ lv_entered : STZ panel_over
    JMP panel_blank

\ live_lines: the area whose name the panel shows (lv_area's), and with the
\ logic whether the game's over (its message then says so); drawn, with
\ the panel's next values, before the next frame is handed over
\ (lv_named). (The free camera's entrance_text sets the message.)
.live_lines
    LDA lv_area : STA panel_area
IF LIVE_LOGIC
    LDA lv_over : STA panel_over
    STZ lv_named
ENDIF
    RTS

ENDSECTION

\ ---------------------------------------------------------------------------
\ In BANK_GLUE (LiveGlue, in the logic's database bank, between its code
\ and the database): the figures, the frames between passes and the
\ crosshair, or the free camera. Called with that bank paged; what they
\ call in main RAM leaves it paged.
SECTION LiveGlue

\ ---------------------------------------------------------------------------
\ lv_inputs (every loop, after the camera's made): whether anything the
\ frame's view is made from differs from the frame last handed over's
\ (docs/research/live.md, "The idle loop"), in vw_new, non-zero if so;
\ and the record (vw_rec) made this frame's. What a view is made from: the camera (lv_cam), the area and
\ how many times one has been entered (lv_entered: entering puts the area's
\ records together again, and the logic moves the rig's parts as it loads
\ one), and with the logic what's hidden of every object it indexes
\ (ix_flags AND IX_HIDDEN, all IX_MAX, as the object pass reads them
\ through ob_ix) and the crosshair (CrossOn, and CrossX and CrossY if it's
\ on). A frame differing is always drawn after it, so the record is the
\ last frame's. Nothing else the frame reads changes but as an area is
\ entered (the patterns, the working copy).
VW_CAM   = 0                    ; vw_rec: lv_cam's bytes ...
VW_AREA  = LV_CAM_BYTES         ; ... lv_entered ...
IF LIVE_LOGIC
    VW_CROSS = VW_AREA + 1      ; ... CrossOn (0 or 1), CrossX, CrossY (0 when off) ...
    VW_HID   = VW_CROSS + 3     ; ... and each index's flags AND IX_HIDDEN
    VW_BYTES = VW_HID + IX_MAX
ELSE
    VW_BYTES = VW_AREA + 1
ENDIF
ASSERT VW_CAM = 0 AND IX_MAX <= 128
.vw_rec     SKIP VW_BYTES
.lv_inputs
{
    LDA vw_none : STA vw_new                    ; (no frame yet: one's new)
    STZ vw_none
    LDX #LV_CAM_BYTES - 1
.camera
    LDA lv_cam,X : JSR vw_byte
    DEX : BPL camera
    LDX #VW_AREA : LDA lv_entered : JSR vw_byte
IF LIVE_LOGIC
    INX
    LDA CrossOn : BEQ off
    LDA #1 : JSR vw_byte
    INX : LDA CrossX : JSR vw_byte
    INX : LDA CrossY : JSR vw_byte
    BRA flags
.off
    JSR vw_byte                                 ; (A is 0)
    INX : LDA #0 : JSR vw_byte
    INX : LDA #0 : JSR vw_byte
.flags
    LDX #IX_MAX - 1
.flag
    LDA ix_flags,X : AND #IX_HIDDEN
    CMP vw_rec + VW_HID,X : BEQ same
    STA vw_rec + VW_HID,X
    LDA #&FF : STA vw_new
.same
    DEX : BPL flag
ENDIF
    RTS
\ vw_byte: A, the input at vw_rec + X, against the record: if it differs,
\ the record takes it and vw_new is set. Keeps X and Y.
.vw_byte
    CMP vw_rec,X : BEQ unchanged
    STA vw_rec,X
    LDA #&FF : STA vw_new
.unchanged
    RTS
}

\ ---------------------------------------------------------------------------
\ live_measure (after each frame's spans): the frame added to the window,
\ and every FIGURE_FIELDS fields the figures drawn from it (live_figures).
\ live_idle_measure (each loop that draws nothing): once the window's last
\ frame is shown, its figures drawn at once; a window with no frames
\ starts again from now, so its first frame is measured from the loop
\ before it, not from the fields nothing was drawn in.
.live_measure
{
    INC win_n
    JSR fig_fields
    LDA div_n : CMP #LO(FIGURE_FIELDS) : LDA div_n+1 : SBC #HI(FIGURE_FIELDS) : BCS figures
    RTS
.figures
    JMP live_figures
}
.live_idle_measure
{
    LDA win_n : BEQ again
    LDA frame_ready : BNE wait                  ; (its last frame isn't shown yet)
    JSR fig_fields
    JMP live_figures
.again
    JSR read_counters
    JMP fig_restart
.wait
    RTS
}
\ fig_fields: the fields since the window began, in div_n.
.fig_fields
    JSR read_counters
    LDA count_fields : SEC : SBC win_f0 : STA div_n
    LDA count_fields+1 : SBC win_f0+1 : STA div_n+1
    RTS

\ live_figures: the frames a second drawn from the window, from the frames
\ shown (flips) and the fields; then a new window from read_counters' time.
.live_figures
{
    LDA count_frames : SEC : SBC win_s0 : STA mul_b
    LDA count_frames+1 : SBC win_s0+1 : STA mul_b+1
    ORA mul_b : BEQ restart                     ; (no flip yet: none to measure)
    \ frames a second, tenths: (rate dn + 10 df / 2) / (10 df)
    LDA #LO(FIELDS_100S) : STA mul_a : LDA #HI(FIELDS_100S) : STA mul_a+1
    LDA div_n : STA div_d : LDA div_n+1 : STA div_d+1 : STZ div_d+2 : STZ div_d+3
    LDA #10 : JSR div_times
    JSR fig_ratio
    JSR tenths
.restart
    \ (on into fig_restart)
}
\ fig_restart: a new window, from read_counters' time.
.fig_restart
    LDA count_fields : STA win_f0 : LDA count_fields+1 : STA win_f0+1
    LDA count_frames : STA win_s0 : LDA count_frames+1 : STA win_s0+1
    STZ win_n
    RTS

\ ---------------------------------------------------------------------------
\ The arithmetic for the figures, which runs once in FIGURE_FIELDS.
SECTION Work
.mul_a          SKIP 2      ; fig_ratio's factors ...
.mul_b          SKIP 2
.div_d          SKIP 4      ; ... the divisor ...
.div_n          SKIP 2      ; (live_measure's fields)
.quot           SKIP 4      ; ... the product, then the quotient
.rem            SKIP 4
ENDSECTION

\ div_times: div_d (24-bit) times A, in place. A >= 1.
.div_times
{
    ZA_AUTO 3, base
    ZA_AUTO1 k
    STA k
    LDA div_d : STA base : LDA div_d+1 : STA base+1 : LDA div_d+2 : STA base+2
    STZ div_d : STZ div_d+1 : STZ div_d+2
.bit
    LSR k : BCC skip
    LDA div_d : CLC : ADC base : STA div_d
    LDA div_d+1 : ADC base+1 : STA div_d+1
    LDA div_d+2 : ADC base+2 : STA div_d+2
.skip
    ASL base : ROL base+1 : ROL base+2
    LDA k : BNE bit
    RTS
}

\ fig_ratio: quot = (mul_a mul_b + div_d DIV 2) DIV div_d, rounded; mul_b lost.
.fig_ratio
{
    STZ quot : STZ quot+1 : STZ quot+2 : STZ quot+3
    LDX #16
.mbit
    LSR mul_b+1 : ROR mul_b : BCC mskip
    LDA quot+2 : CLC : ADC mul_a : STA quot+2
    LDA quot+3 : ADC mul_a+1 : STA quot+3
.mskip
    ROR quot+3 : ROR quot+2 : ROR quot+1 : ROR quot
    DEX : BNE mbit
    \ (on into fig_divide)
}
\ fig_divide: quot = (quot + div_d DIV 2) DIV div_d, 32-bit, rounded; div_d
\ isn't 0.
.fig_divide
{
    LDA div_d+3 : LSR A : STA rem+3
    LDA div_d+2 : ROR A : STA rem+2
    LDA div_d+1 : ROR A : STA rem+1
    LDA div_d : ROR A
    CLC : ADC quot : STA quot
    LDA rem+1 : ADC quot+1 : STA quot+1
    LDA rem+2 : ADC quot+2 : STA quot+2
    LDA rem+3 : ADC quot+3 : STA quot+3
    STZ rem : STZ rem+1 : STZ rem+2 : STZ rem+3
    LDX #32
.bit
    ASL quot : ROL quot+1 : ROL quot+2 : ROL quot+3
    ROL rem : ROL rem+1 : ROL rem+2 : ROL rem+3
    LDA rem : CMP div_d : LDA rem+1 : SBC div_d+1
    LDA rem+2 : SBC div_d+2 : LDA rem+3 : SBC div_d+3
    BCC next
    LDA rem : SBC div_d : STA rem               ; (C is set)
    LDA rem+1 : SBC div_d+1 : STA rem+1
    LDA rem+2 : SBC div_d+2 : STA rem+2
    LDA rem+3 : SBC div_d+3 : STA rem+3
    INC quot
.next
    DEX : BNE bit
    RTS
}

\ digits: quot's low 16 bits, at most 999 (more is shown as 999), as three
\ digits in dg (hundreds first).
SECTION Work
.dg             SKIP 3
ENDSECTION
.digits
{
    ZA_AUTO2 v
    LDA quot+2 : ORA quot+3 : BNE most
    LDA quot : STA v : LDA quot+1 : STA v+1
    LDA v : CMP #LO(1000) : LDA v+1 : SBC #HI(1000) : BCC fits
.most
    LDA #LO(999) : STA v : LDA #HI(999) : STA v+1
.fits
    LDY #0
.hundreds
    LDA v : CMP #100 : LDA v+1 : SBC #0 : BCC tens
    LDA v : SEC : SBC #100 : STA v
    LDA v+1 : SBC #0 : STA v+1
    INY : BRA hundreds
.tens
    STY dg
    LDY #0
    LDA v
.ten
    CMP #10 : BCC units
    SBC #10 : INY
    BRA ten
.units
    STY dg+1 : STA dg+2
    RTS
}

\ tenths: quot as "dd.d" (the first blank if it's 0) in the panel's frames
\ a second.
.tenths
{
    JSR digits
    LDX #PF_FPS
    LDA dg : BEQ blank
    CLC : ADC #PC_DIGIT0
    BRA first
.blank
    LDA #PC_SPACE
.first
    JSR panel_set : INX
    LDA dg+1 : CLC : ADC #PC_DIGIT0 : JSR panel_set : INX
    LDA #PC_DOT : JSR panel_set : INX
    LDA dg+2 : CLC : ADC #PC_DIGIT0 : JMP panel_set
}
ASSERT PN_FPS = 4

IF LIVE_LOGIC
\ lv_setup (lv_pass's, after a pass that ran): the frames that show it,
\ from where the last pass left the camera (an_p0, an_a0) to where the
\ logic has it now, over PASS_FIELDS fields (decision 4). The angles turn
\ the short way, in steps of one (5 degrees). The position goes along the
\ segment the move walked when the pass had one move and ended within the
\ margin's push (Margin, on each axis) of its end: from there it's put
\ where the logic has it at the end. On the probe's step y holds until the
\ end, as a climb or fall comes at the crossing that ends the step. Any
\ other pass that moves goes straight. A pass that loaded an area shows
\ its walk, if it had just one, in the old area, its angles as they were,
\ and the new area comes after (lv_switch). A pass that changed nothing shows
\ nothing. A held key's passes follow on from the last's end, without a
\ gap.
.lv_setup
{
    LDA lv_loaded : BEQ same_area
    LDA lv_walks : CMP #1 : BEQ away_walked
    LDA #1 : STA lv_switch                      ; no walk to show: the new area at once
    RTS
.away_walked
    LDX #2
.held
    STZ an_da,X
    DEX : BPL held
    JMP walked
.same_area
    \ did the camera move or turn?
    LDX #5
.position
    LDA PlayerX,X : CMP an_p0,X : BNE moves
    DEX : BPL position
    LDA Yaw : JSR mod72 : CMP an_a0 : BNE moves
    LDA Pitch : JSR mod72 : CMP an_a0+1 : BNE moves
    LDA Roll : JSR mod72 : CMP an_a0+2 : BNE moves
    RTS
.moves
    \ the angles' turns, the short way: (a1 - a0) mod 72, in -35 .. 36
    LDA Yaw : JSR mod72 : LDX #0 : JSR turn
    LDA Pitch : JSR mod72 : LDX #1 : JSR turn
    LDA Roll : JSR mod72 : LDX #2 : JSR turn
    \ the walk, if there's one and the pass ended near its end
    LDA lv_walks : CMP #1 : BNE straight
    LDX #4
.near
    \ (an_p0 + walk - the logic's), within Margin either way
    LDA an_p0,X : CLC : ADC lv_walk_d,X : STA an_d,X
    LDA an_p0+1,X : ADC lv_walk_d+1,X : STA an_d+1,X
    LDA an_d,X : SEC : SBC PlayerX,X : STA an_d,X
    LDA an_d+1,X : SBC PlayerX+1,X : STA an_d+1,X
    BPL plus
    LDA #0 : SEC : SBC an_d,X : STA an_d,X
    LDA #0 : SBC an_d+1,X : STA an_d+1,X
.plus
    LDA an_d+1,X : BNE straight
    LDA Margin : CMP an_d,X : BCC straight
    DEX : DEX : BPL near
.walked
    LDX #5
.walk
    LDA lv_walk_d,X : STA an_d,X
    DEX : BPL walk
    LDA lv_walk_jet : EOR #1 : AND #1 : STA an_hold   ; (InJet is 0 or 1)
    BRA start
.straight
    LDX #4
.line
    LDA PlayerX,X : SEC : SBC an_p0,X : STA an_d,X
    LDA PlayerX+1,X : SBC an_p0+1,X : STA an_d+1,X
    DEX : DEX : BPL line
    STZ an_hold
.start
    LDA lv_loaded : BEQ timed
    LDA #1 : STA lv_switch
.timed
    \ from the last pass's end if this runs straight on from it (its last
    \ frame not yet shown: the pass came in the frame its time ran out),
    \ but no earlier than PASS_FIELDS - 1 fields before now: a frame slower
    \ than the pace takes a pass a frame (one pass a loop), each frame shows
    \ its pass most of the way, and the passes after don't make the time up;
    \ else now. (Its first frame is never its last, so an area's change
    \ still comes before the logic's camera is shown: lv_pass's lv_switch.)
    LDA an_on : BEQ fresh
    LDA lv_now : SEC : SBC #PASS_FIELDS - 1 : TAX
    LDA lv_now+1 : SBC #0 : TAY                 ; (now less PASS_FIELDS - 1)
    TXA : CMP an_end : TYA : SBC an_end+1 : BPL behind
    LDX an_end : LDY an_end+1
.behind
    STX an_t0 : STY an_t0+1
    BRA on
.fresh
    LDA lv_now : STA an_t0 : LDA lv_now+1 : STA an_t0+1
.on
    LDA an_t0 : CLC : ADC #PASS_FIELDS : STA an_end
    LDA an_t0+1 : ADC #0 : STA an_end+1
    LDA #1 : STA an_on
    \ no pass before the end (or the waits, if they're longer)
    LDA lv_until : CMP an_end : LDA lv_until+1 : SBC an_end+1 : BPL waits
    LDA an_end : STA lv_until : LDA an_end+1 : STA lv_until+1
.waits
    RTS
    \ turn: an_da,X = (A - an_a0,X) mod 72, the short way
.turn
    SEC : SBC an_a0,X
    BPL positive
    CLC : ADC #72                               ; (0 .. 71)
.positive
    CMP #37 : BCC set
    SEC : SBC #72                               ; (-35 .. -1)
.set
    STA an_da,X
    RTS
}
ASSERT STEPS_TURN = 72 AND Yaw = Pitch + 1 AND Roll = Pitch + 2

\ lv_camera (every loop): the frame's camera into lv_cam: the logic's,
\ or, while a pass's frames show, the fraction of the way PASS_FIELDS
\ fields take: f = 256 e / PASS_FIELDS at e fields on (pace_f); each
\ coordinate an_p0 + sign(d) ((|d| f) >> 8), y an_p0's if an_hold; each
\ angle an_a0 + sign(t) ((|t| f + 255) >> 8), mod 72: each 5-degree step
\ as soon as the fraction is into it, so a turn shows from its first field
\ (live.md, "The idle loop"), as a step does.
.lv_camera
{
    ZA_AUTO1 f, k
    ZA_AUTO2 m
    LDA an_on : BEQ logic
    LDA lv_now : SEC : SBC an_t0 : TAX
    LDA lv_now+1 : SBC an_t0+1 : BNE done        ; (an_t0 is never after now)
    CPX #PASS_FIELDS : BCC going
.done
    STZ an_on
.logic
    LDX #5
.p
    LDA PlayerX,X : STA lv_cam,X
    DEX : BPL p
    LDA Yaw : JSR mod72 : STA lv_yaw
    LDA Pitch : JSR mod72 : STA lv_pitch
    LDA Roll : JSR mod72 : STA lv_roll
    RTS
.going
    LDA pace_f,X : STA f
    LDX #4
.axis
    LDA an_p0,X : STA lv_cam,X
    LDA an_p0+1,X : STA lv_cam+1,X
    CPX #2 : BNE along
    LDA an_hold : BNE next                      ; (y holds)
.along
    \ m = |d| f >> 8, then lv_cam +- m
    LDA an_d+1,X : PHP
    BPL mag
    LDA #0 : SEC : SBC an_d,X : STA m
    LDA #0 : SBC an_d+1,X : STA m+1
    BRA scale
.mag
    LDA an_d,X : STA m
    LDA an_d+1,X : STA m+1
.scale
    JSR times_f
    PLP : BMI minus
    LDA lv_cam,X : CLC : ADC m : STA lv_cam,X
    LDA lv_cam+1,X : ADC m+1 : STA lv_cam+1,X
    BRA next
.minus
    LDA lv_cam,X : SEC : SBC m : STA lv_cam,X
    LDA lv_cam+1,X : SBC m+1 : STA lv_cam+1,X
.next
    DEX : DEX : BPL axis
    \ the angles
    LDX #2
.angle
    LDA an_da,X : PHP
    BPL amag
    EOR #&FF : INC A
.amag
    STA m : STZ m+1
    JSR times_f                                 ; |t| f >> 8 ...
    LDA k : BEQ rounded                         ; ... rounded up by the bits below it
    INC m
.rounded
    LDA an_a0,X
    PLP : BMI aminus
    CLC : ADC m
    CMP #72 : BCC put
    SBC #72
    BRA put
.aminus
    SEC : SBC m
    BCS put
    ADC #72
.put
    STA lv_yaw,X
    DEX : BPL angle
    RTS
    \ times_f: m = (m f) >> 8, m 16-bit; k the bits below (bit 7 the half).
    \ By the maths' quarter squares in HAZEL, each byte of m by f: f g =
    \ sq(f + g) - ng(255 + g - f), through pointers f into the tables. Most
    \ of a frame's are 0: a step's angles, a turn's position.
.times_f
{
    ZA_AUTO2 sl, sh, nl, nh
    ZA_AUTO1 lh, hl
    LDA m : ORA m+1 : BEQ zero
    LDA f : STA sl : STA sh
    EOR #&FF : STA nl : STA nh
    LDA #HI(sq_lo) : STA sl+1
    LDA #HI(sq_hi) : STA sh+1
    LDA #HI(ng_lo) : STA nl+1
    LDA #HI(ng_hi) : STA nh+1
    \ m's low byte by f: the bits below, and what goes into m's
    LDY m
    SEC
    LDA (sl),Y : SBC (nl),Y : STA k
    LDA (sh),Y : SBC (nh),Y : STA lh
    \ its high byte by f, and the low's top byte added in
    LDY m+1
    SEC
    LDA (sl),Y : SBC (nl),Y : STA hl
    LDA (sh),Y : SBC (nh),Y : STA m+1
    LDA hl : CLC : ADC lh : STA m
    BCC done
    INC m+1
.done
    RTS
.zero
    STZ k
    RTS
}
ASSERT LO(sq_lo) = 0 AND LO(sq_hi) = 0 AND LO(ng_lo) = 0 AND LO(ng_hi) = 0
.pace_f
    EQUB (0..PASS_FIELDS - 1) * 256 DIV PASS_FIELDS
}
ASSERT lv_pitch = lv_yaw + 1 AND lv_roll = lv_yaw + 2 AND STEPS_TURN = 72

\ The crosshair (CrossOn, CrossX, CrossY: the logic's; B shows and hides
\ it): the original's ($AAA0) at half the width, drawn by EOR over the view
\ as it's drawn: its centre the view's pixel ((CrossX - 1) DIV 2,
\ VIEW_H - CrossY), each arm across a pixel at two from it, each up and
\ down two lines at two and three, each pixel's colour turned to its
\ opposite (EOR 7). Each buffer's crosshair is taken off again before the
\ rasteriser next draws there (lv_cross_off), so the buffer holds what the
\ rasteriser drew, which it relies on (raster_forget's note).
.lv_cross_off
{
    LDX draw_buffer
    LDA lv_xon,X : BEQ none
    STZ lv_xon,X
    LDY lv_xy,X
    LDA lv_xx,X
    JMP cross_eor
.none
    RTS
}
.lv_cross_on
{
    LDX draw_buffer
    LDA CrossOn : STA lv_xon,X : BEQ none
    LDA CrossX : STA lv_xx,X
    LDY CrossY : TYA : STA lv_xy,X
    LDA CrossX
    JMP cross_eor
.none
    RTS
}
\ cross_eor: the crosshair at CrossX = A, CrossY = Y EORed into the buffer
\ drawn, each pixel inside the view.
CROSS_LEFT  = mode2_byte(7, 0)
CROSS_RIGHT = mode2_byte(0, 7)
.cross_eor
{
    ZA_AUTO1 bc, r, px, py
    ZA_AUTO2 at
    DEC A : LSR A : STA bc
    STY r : LDA #VIEW_H : SEC : SBC r : STA r
    LDX #CROSS_N - 1
.pixel
    LDA bc : CLC : ADC cross_dx,X : STA px
    CMP #VIEW_W : BCS next
    LDA r : CLC : ADC cross_dy,X : STA py
    CMP #VIEW_H : BCS next
    \ VIEW_ADDR + (py DIV 8) SCREEN_ROW + 8 (px DIV 2) + py MOD 8
    STZ at+1
    LDA px : AND #&FE
    ASL A : ROL at+1
    ASL A : ROL at+1
    STA at
    LDA py : AND #7 : ORA at : STA at
    LDA py : LSR A : LSR A : AND #&FE : CLC : ADC at+1 : STA at+1
    LDA at : CLC : ADC #LO(VIEW_ADDR) : STA at
    LDA at+1 : ADC #HI(VIEW_ADDR) : STA at+1
    LDA px : LSR A
    LDA #CROSS_RIGHT : BCS right
    LDA #CROSS_LEFT
.right
    EOR (at) : STA (at)
.next
    DEX : BPL pixel
    RTS
.cross_dx   EQUB CROSS_DX AND &FF
.cross_dy   EQUB CROSS_DY AND &FF
}
CROSS_DX = {-2, 2, 0, 0, 0, 0}
CROSS_DY = {0, 0, -3, -2, 2, 3}
CROSS_N  = LEN(CROSS_DX)
ASSERT LEN(CROSS_DY) = CROSS_N AND SCREEN_ROW = 512
ASSERT VIEW_W < 254 AND VIEW_H < 253          ; (an arm off an edge wraps past the view)

ELSE
\ ---------------------------------------------------------------------------
\ The free camera.

SECTION Work
.lv_entrance    SKIP 1      ; the entrance last gone to (its index, LIVE_ENTRANCES of them)
.lv_want        SKIP 1      ; the entrance to go to: lv_entrance but when poked
.lv_demo        SKIP 1      ; non-zero: the demo's turning
.lv_turned      SKIP 1      ; the demo's steps at this entrance
.lv_key_f       SKIP 2      ; fields at the last key
.lv_keys        SKIP KEYS_BYTES     ; live_keys': the keys held or made since the last frame
.lv_any         SKIP 1      ; ... non-zero if there are any
ENDSECTION

\ live_no_logic: never called. It reaches the logic's entries as the
\ logic's disc does, since this one doesn't, so that baron places their
\ zero page (the logic is assembled the same for both, so the map is).
.live_no_logic
    ZA_ENTRY
    JSR logic_go_init : JSR logic_go_minute : JSR logic_go_pass
    JSR logic_go_colours : JSR logic_go_shown
    RTS

\ live_first: the demo off, and the first entrance.
.live_first
    STZ lv_demo : STZ lv_turned
    STZ lv_key_f : STZ lv_key_f+1
    LDA #0
    \ (on into live_go)

\ live_go: entrance A (0 .. LIVE_ENTRANCES - 1): its area entered if it
\ isn't already, its camera, and its lines of text.
.live_go
{
    STA lv_entrance : STA lv_want
    TAX
    LDA en_xl,X : STA lv_x : LDA en_xh,X : STA lv_x+1
    LDA en_yl,X : STA lv_y : LDA en_yh,X : STA lv_y+1
    LDA en_zl,X : STA lv_z : LDA en_zh,X : STA lv_z+1
    LDA en_yaw,X : STA lv_yaw
    LDA en_pitch,X : STA lv_pitch
    LDA en_roll,X : STA lv_roll
    STZ lv_turned
    LDA en_area,X : CMP lv_area : BEQ text
    JSR lv_enter_area
.text
    \ (on into entrance_text)
}

\ entrance_text: the panel's message: the entrance's id, after "ENTRANCE",
\ or "DEMO" while the demo's on; drawn before the next frame is handed over
\ (lv_named).
.entrance_text
{
    STZ lv_named
    LDX #PF_MESSAGE
    LDA #PC_SPACE
.blank
    JSR panel_set
    INX : CPX #PF_MESSAGE + PN_MESSAGE : BNE blank
    LDX #ENTRANCE_CELL
    LDY #0
.label
    LDA entrance_label,Y
    BIT lv_demo : BPL plain
    LDA demo_label,Y
.plain
    JSR panel_set
    INX : INY : CPY #LEN(PANEL_ENTRANCE) : BNE label
    LDY lv_entrance
    LDA en_id,Y
    LDX #ENTRANCE_ID
    LDY #0
.tens
    CMP #10 : BCC units
    SBC #10 : INY
    BRA tens
.units
    PHA
    TYA : BEQ blank_tens
    CLC : ADC #PC_DIGIT0
    BRA tens_digit
.blank_tens
    LDA #PC_SPACE
.tens_digit
    JSR panel_set : INX
    PLA : CLC : ADC #PC_DIGIT0 : JMP panel_set
.entrance_label
    EQUB PANEL_ENTRANCE
.demo_label
    EQUB PANEL_DEMO
}
ASSERT LEN(PANEL_ENTRANCE) = LEN(PANEL_DEMO) AND ENTRANCE_CELL + LEN(PANEL_ENTRANCE) < ENTRANCE_ID

\ live_keys: the camera moved by the keys held, or by the demo; SPACE (or
\ the demo, after a turn) to the next entrance. Turns before looks, rolls
\ and steps, as the original acts (decision 19). The keys are Driller's
\ (decision 10): Q and W or the cursors left and right turn, O and K or
\ the cursors up and down walk, P and L look, N and M roll.
A_LEFT = 0 : A_RIGHT = 1 : A_UP = 2 : A_DOWN = 3
A_ROLL_L = 4 : A_ROLL_R = 5 : A_ON = 6 : A_BACK = 7
LIVE_KEYS = {
    {K_Q, A_LEFT}, {K_5, A_LEFT}, {K_W, A_RIGHT}, {K_8, A_RIGHT},
    {K_P, A_UP}, {K_L, A_DOWN}, {K_N, A_ROLL_L}, {K_M, A_ROLL_R},
    {K_O, A_ON}, {K_7, A_ON}, {K_K, A_BACK}, {K_6, A_BACK}
}
LIVE_KEY_COUNT = LEN(LIVE_KEYS)
.live_keys
{
    ZA_AUTO1 held
    \ an entrance asked for from outside (tools/livecheck.mjs, make
    \ live-run), as a key would
    LDA lv_want : CMP lv_entrance : BEQ not_wanted
    PHA : JSR keyed : PLA
    JMP live_go
.not_wanted
    \ the keys held, and those that went down since the last frame (a tap
    \ shorter than a frame acts once), each byte with any made in lv_any
    STZ lv_any
    PHP : SEI                                   ; (as lv_pass takes them)
    LDX #KEYS_BYTES - 1
.take
    JSR key_take
    STA lv_keys,X
    TSB lv_any
    ORA keys,X : STA lv_keys,X
    DEX : BPL take
    LDA keys_any : TSB lv_any
    PLP
    LDA lv_keys + K_SPACE DIV 8 : AND #1 << (K_SPACE AND 7) : BEQ no_space
    JSR keyed
    LDA lv_entrance : INC A
    CMP #LIVE_ENTRANCES : BCC go
    LDA #0
.go
    JMP live_go
.no_space
    \ the actions those keys ask for, a bit each
    STZ held
    LDY #LIVE_KEY_COUNT - 1
.key
    LDX lk_byte,Y
    LDA lv_keys,X : AND lk_mask,Y : BEQ not_held
    LDA lk_act,Y : TSB held
.not_held
    DEY : BPL key
    LDA lv_any : BEQ idle
    JSR keyed
    BRA moves
.idle
    LDA lv_demo : BNE demo
    \ the demo, once no key has come for DEMO_FIELDS fields
    JSR read_counters
    LDA count_fields : SEC : SBC lv_key_f : STA held
    LDA count_fields+1 : SBC lv_key_f+1
    CMP #HI(DEMO_FIELDS) : BCC no_demo : BNE start_demo
    LDA held : CMP #LO(DEMO_FIELDS) : BCS start_demo
.no_demo
    RTS
.start_demo
    LDA #&80 : STA lv_demo
    STZ lv_turned
    JSR entrance_text
.demo
    LDA #1 << A_RIGHT : STA held
    INC lv_turned
    LDA lv_turned : CMP #STEPS_TURN + 1 : BCC moves
    LDA lv_entrance : INC A
    CMP #LIVE_ENTRANCES : BCC demo_go
    LDA #0
.demo_go
    JMP live_go
.moves
    LDA held : AND #1 << A_LEFT : BEQ no_tl
    LDX #lv_yaw - lv_cam : JSR angle_down
.no_tl
    LDA held : AND #1 << A_RIGHT : BEQ no_tr
    LDX #lv_yaw - lv_cam : JSR angle_up
.no_tr
    LDA held : AND #1 << A_UP : BEQ no_lu
    LDX #lv_pitch - lv_cam : JSR angle_down     ; (pitch is positive looking down)
.no_lu
    LDA held : AND #1 << A_DOWN : BEQ no_ld
    LDX #lv_pitch - lv_cam : JSR angle_up
.no_ld
    LDA held : AND #1 << A_ROLL_L : BEQ no_rl
    LDX #lv_roll - lv_cam : JSR angle_up        ; (roll is positive rolling left)
.no_rl
    LDA held : AND #1 << A_ROLL_R : BEQ no_rr
    LDX #lv_roll - lv_cam : JSR angle_down
.no_rr
    LDA held : AND #1 << A_ON : BEQ no_on
    LDY lv_yaw
    LDA st_dx,Y : LDX #lv_x - lv_cam : JSR lv_step
    LDY lv_yaw
    LDA st_dz,Y : LDX #lv_z - lv_cam : JSR lv_step
.no_on
    LDA held : AND #1 << A_BACK : BEQ no_back
    LDY lv_yaw
    LDA #0 : SEC : SBC st_dx,Y : LDX #lv_x - lv_cam : JSR lv_step
    LDY lv_yaw
    LDA #0 : SEC : SBC st_dz,Y : LDX #lv_z - lv_cam : JSR lv_step
.no_back
    RTS
\ keyed: a key's come: the demo's off, and its wait starts again.
.keyed
    JSR read_counters
    LDA count_fields : STA lv_key_f
    LDA count_fields+1 : STA lv_key_f+1
    LDA lv_demo : BEQ keyed_done
    STZ lv_demo
    JSR entrance_text
.keyed_done
    RTS
.lk_byte    EQUB LIVE_KEYS[.., 0] DIV 8
.lk_mask    EQUB 1 << (LIVE_KEYS[.., 0] AND 7)
.lk_act     EQUB 1 << LIVE_KEYS[.., 1]
}
ASSERT LIVE_KEY_COUNT <= 128
ASSERT LIVE_STEP < 128 AND STEPS_TURN < 128

\ angle_up, angle_down: the camera's angle at lv_cam + X a step on or back,
\ round 0-71.
.angle_up
{
    LDA lv_cam,X : INC A
    CMP #STEPS_TURN : BCC same
    LDA #0
.same
    STA lv_cam,X
    RTS
}
.angle_down
{
    LDA lv_cam,X : BNE same
    LDA #STEPS_TURN
.same
    DEC A : STA lv_cam,X
    RTS
}

\ lv_step: the coordinate at lv_cam + X moved by A, a signed byte, kept to
\ 0 .. &7FFF (objects_frame's range).
.lv_step
{
    CMP #&80 : BCS minus
    CLC : ADC lv_cam,X : STA lv_cam,X
    LDA lv_cam+1,X : ADC #0
    CMP #&80 : BCC fine
    LDA #&FF : STA lv_cam,X
    LDA #&7F
.fine
    STA lv_cam+1,X
    RTS
.minus
    CLC : ADC lv_cam,X : STA lv_cam,X
    LDA lv_cam+1,X : ADC #&FF : BPL fine
    LDA #0 : STA lv_cam,X
    BRA fine
}
ENDIF
STEPS_TURN = 72                 ; a whole turn, in 5-degree steps

ENDSECTION

.live_end
ENDSECTION

\ Where each section ends, for the next's org and the clearing.
SECTION ObjCode
.obj_code_end
ENDSECTION
SECTION AreaCode
.area_code_end
ENDSECTION
SECTION LiveBoot
.live_boot_end
ENDSECTION
SECTION ObjConst
.obj_const_end
ENDSECTION
SECTION ObjTables
.obj_tables_end
ENDSECTION
SECTION ObjArea
.obj_area_end
ENDSECTION
SECTION LogicWork
.logic_work_end
ENDSECTION
SECTION ObjMore
.obj_more_end
ENDSECTION
SECTION ObjCache
.obj_cache_end
ENDSECTION
SECTION ObjMemo
.obj_memo_end
ENDSECTION
SECTION ObjWork
.obj_work_end
ENDSECTION
SECTION RasterRuns
.raster_runs_end
ENDSECTION
SECTION RasterCode
.raster_code_end
ENDSECTION
SECTION RasterWork
.raster_work_end
ENDSECTION
SECTION RasterState
.raster_state_end
ENDSECTION
SECTION RasterIn
.raster_in_end
ENDSECTION
SECTION ObjOut
.obj_out_end
ENDSECTION
SECTION PanelData
.panel_data_end
ENDSECTION
SECTION PanelPack
.panel_pack_end
ENDSECTION
SECTION LiveData
.live_data_end
ENDSECTION
SECTION ObjAndy
.obj_andy_end
ENDSECTION
SECTION ObjBound
.obj_bound_end
ENDSECTION
SECTION AreaConv
.area_conv_end
ENDSECTION
SECTION LiveGlue
.live_glue_end
ENDSECTION
SECTION LogicFaces
.logic_faces_end
ENDSECTION
SECTION Work
.work_end
ENDSECTION
obj_area_start = obj_const_end

\ The map's boundaries.
\ HAZEL: the tables, then the work, below the MOS's &E000.
ASSERT obj_work_end <= &E000
\ The f64 table on a page boundary (src/transform.6502), and in HAZEL.
ASSERT LO(fq0) = 0 AND fq0 >= &C000 AND obj_tables_end <= &E000
\ The banks: each section after the last in its bank, below &C000.
ASSERT raster_runs_end <= raster_code_end AND raster_code_end <= raster_work_end AND raster_work_end <= &C000
ASSERT live_data_end <= panel_data_end AND panel_data_end <= area_conv_end AND area_conv_end <= &C000
\ The panel's packed picture where nothing is till clear_work clears it,
\ after panel_init: the transform's cache (which is virtual: !BOOT loads
\ nothing else there); and the page panel_init copies through, RasterIn's
\ (cleared after it too).
ASSERT PANEL_LOAD >= OBJ_CACHE_ORG AND panel_pack_end <= obj_cache_end
ASSERT PANEL_BOUNCE >= RASTER_IN_ORG AND PANEL_BOUNCE + 256 <= raster_in_end
ASSERT logic_code_end <= live_data_end
ASSERT logic_db_code_end <= live_glue_end AND live_glue_end <= LOGIC_DB
ASSERT OBJ_CODE_ORG >= &8000 AND obj_code_end <= &C000
\ ANDY, over the pipeline's bank's first 4K: what its code reaches there
\ is past it.
ASSERT obj_andy_end <= &9000 AND obj_andy_reach >= &9000
\ Main RAM: RasterState (from a page, so its ALIGN costs nothing), LIVE,
\ AreaCode, LogicWork, ObjMore, to &3000: never in &3000-&7FFF, which
\ ACCCON's X switches, as the frame reads them whatever X.
ASSERT LO(RASTER_STATE_ORG) = 0 AND RASTER_STATE_ORG >= &0E00
ASSERT live_end <= area_code_end AND area_code_end <= LOGIC_WORK AND logic_work_end <= LOGIC_WORK_END
ASSERT logic_work_end <= obj_more_end AND obj_more_end <= &3000
\ The OS's pages: Work, then RasterIn (with ObjOut over it) to the NMI's
\ page, and there the start, below the MOS's extended vectors.
ASSERT work_end <= RASTER_IN_ORG AND obj_out_end <= rs_pat AND raster_in_end <= RASTER_IN_END
ASSERT LIVE_BOOT_ORG = &0D00 AND live_boot_end <= &0D9F
\ Main RAM's &3000 up to SCREEN (with X clear): the cache, the sort's
\ memory, the pipeline's tables, the area's working copy and the objects'
\ bounds.
ASSERT obj_cache_end <= obj_memo_end AND obj_memo_end <= obj_const_end
ASSERT obj_const_end <= obj_area_end AND obj_area_end <= obj_bound_end AND obj_bound_end <= SCREEN
\ Shadow RAM's &3000 on (with X set): the logic's lists by face.
ASSERT logic_faces_end <= SCREEN AND LOGIC_FACES_ORG >= &3000
ASSERT BANK_DB <> BANK_DATA AND BANK_DB <> BANK_OBJ AND BANK_DB <> BANK_RASTER
ASSERT BANK_DATA <> BANK_OBJ AND BANK_DATA <> BANK_RASTER AND BANK_OBJ <> BANK_RASTER

\ The disc's parts, for the loader (src/loader.6502), which the build has
\ this PRINT into its description: every section saved, {file, where,
\ from, to}, where a sideways bank or -1 (main RAM, nothing paged). The
\ loader writes LIVE_PARTS while the OS reads them, in this order (LGLUE
\ over the gap in LOGIC), and LIVE_LATE, HAZEL's, ANDY's (the MOS's until
\ then) and page &0D's, once it's gone; then it starts this at start. It runs from SCREEN, which
\ screen_init clears.
LIVE_PARTS = {
    {"LOGIC", BANK_DB, &8000, &C000},
    {"LGLUE", BANK_DB, logic_db_code_end, live_glue_end},
    {"LOGICC", BANK_DATA, &8000, logic_code_end},
    {"LDATA", BANK_DATA, logic_code_end, live_data_end},
    {"PDATA", BANK_DATA, live_data_end, panel_data_end},
    {"ACONV", BANK_DATA, panel_data_end, area_conv_end},
    {"OCODE", BANK_OBJ, OBJ_CODE_ORG, obj_code_end},
    {"RRUNS", BANK_RASTER, &8000, raster_runs_end},
    {"RCODE", BANK_RASTER, raster_runs_end, raster_code_end},
    {"LIVE", -1, raster_state_end, live_end},
    {"LAREA", -1, live_end, area_code_end},
    {"LOGICW", -1, LOGIC_WORK, logic_work_end},
    {"OMORE", -1, logic_work_end, obj_more_end},
    {"PANEL", -1, PANEL_LOAD, panel_pack_end},
    {"OCONST", -1, obj_memo_end, obj_const_end}
}
LIVE_LATE = {
    {"HAZEL", -1, &C000, hazel_tables_end},
    {"OTABLE", -1, hazel_tables_end, obj_tables_end},
    {"OANDY", BANK_OBJ OR ROMSEL_ANDY, &8000, obj_andy_end},
    {"LBOOT", -1, LIVE_BOOT_ORG, live_boot_end}
}
PRINT #1, "\ src/live.6502's parts, for src/loader.6502"
PRINT #1, "LD_TITLE = ", CHR(34) + "FREESCAPE for the BBC Master: Driller, live " + build_stamp + CHR(34)
PRINT #1, "LD_ORG = ", SCREEN
PRINT #1, "LD_EXEC = ", start
PRINT #1, "LD_KEEP_OS = FALSE"
PRINT #1, "LD_PARTS = ", LIVE_PARTS
PRINT #1, "LD_LATE = ", LIVE_LATE

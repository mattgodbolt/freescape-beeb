.work_end
ENDSECTION
obj_area_start = obj_const_end

\ The map's boundaries.
\ HAZEL: the tables, then the work, below the MOS's &E000.
ASSERT obj_work_end <= &E000
\ The f64 table on a page boundary (src/transform.6502), and in HAZEL.
ASSERT LO(fq0) = 0 AND fq0 >= &C000 AND obj_tables_end <= &E000
\ The banks: each section after the last in its bank, below &C000.
ASSERT raster_state_end <= &C000
ASSERT live_data_end <= text_ram_end AND text_ram_end <= area_conv_end AND area_conv_end <= &C000
ASSERT logic_code_end <= live_data_end
ASSERT logic_db_code_end <= live_glue_end AND live_glue_end <= LOGIC_DB
\ Main RAM: LIVE, AreaCode, ObjConst, ObjArea, LogicWork, ObjMore, to &3000:
\ never in &3000-&7FFF, which ACCCON's X switches, as the frame reads them.
ASSERT obj_area_end <= LOGIC_WORK AND logic_work_end <= LOGIC_WORK_END
ASSERT logic_work_end <= obj_more_end AND obj_more_end <= &3000
\ The OS's pages: Work, then RasterIn (with ObjOut over it) to the NMI's page.
ASSERT work_end <= RASTER_IN_ORG AND obj_out_end <= rs_pat AND raster_in_end <= RASTER_IN_END
\ Main RAM's &3000 on (with X clear): the cache and the sort's memory.
ASSERT obj_cache_end <= obj_memo_end AND obj_memo_end <= SCREEN
\ Shadow RAM's &3000 on (with X set): the logic's lists by face.
ASSERT logic_faces_end <= SCREEN AND LOGIC_FACES_ORG >= &3000
ASSERT BANK_DB <> BANK_DATA AND BANK_DB <> BANK_OBJ AND BANK_DB <> BANK_RASTER
ASSERT BANK_DATA <> BANK_OBJ AND BANK_DATA <> BANK_RASTER AND BANK_OBJ <> BANK_RASTER

.logic_work_end
ENDSECTION
SECTION ObjMore
.obj_more_end
ENDSECTION
SECTION ObjCache
.obj_cache_end
ENDSECTION
SECTION ObjMemo
.obj_memo_end
ENDSECTION
SECTION ObjWork
.obj_work_end
ENDSECTION
SECTION RasterRuns
.raster_runs_end
ENDSECTION

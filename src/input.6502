\ ***************************************************************************
\ FREESCAPE for the BBC Master - the keyboard, read from the System VIA
\
\ The vertical sync's interrupt (src/irq.6502) reads the keys Driller uses
\ into a bitmap: key K_x is bit (K_x AND 7) of byte K_x DIV 8, of keys
\ (held at the last sync) and of keys_made (gone down since key_take last
\ took that byte). The logic reads keys as it is: the interrupt writes
\ each byte whole.
\
\ The keys are Driller's own, the ZX's (decision 10, from its key table in
\ docs/research/zx-logic.md), and the bitmap is the ZX's keyboard: byte r
\ is the ZX's half-row r (ports &FEFE to &7FFE) and bit b its key b, as
\ the original reads them (CPL AND &1F), so the logic takes them in the
\ ZX's order (decision 19; src/logic/pass.6502). K_x is the ZX's key x.
\ Each BBC key is the ZX key of the same name, but for these. Motion is
\ also on the BBC's own keys (decision 10): Z and X turn (the ZX's Q and
\ W), : and / walk (its O and K). So Driller's Z and X, which size the turn
\ and the step, move to f0 and f2, with f1 and f3 for the A and S that
\ grow them. ESCAPE is the ZX's 1 (the information screen's key), and COPY
\ and the cursor keys are the ZX's cursor joystick: 0 fires, and 5, 6, 7
\ and 8 are left, down, up and right.
\
\ The interrupt leaves port A as the sound chip wants it (the keyboard on
\ auto-scan, the port an output).
\ ***************************************************************************

\ The ZX's keyboard (tools/logic/passes.py's MATRIX): K_x = 8 * its
\ half-row + its bit.
    \ &FEFE: CAPS Z X C V
K_Z     = 0 * 8 + 1         ; the turn's size down
K_X     = 0 * 8 + 2         ; the step's size down
K_C     = 0 * 8 + 3         ; collect a rig
    \ &FDFE: A S D F G
K_A     = 1 * 8 + 0         ; the turn's size up
K_S     = 1 * 8 + 1         ; the step's size up
K_D     = 1 * 8 + 2         ; drill
K_F     = 1 * 8 + 3         ; fall
    \ &FBFE: Q W E R T
K_Q     = 2 * 8 + 0         ; turn left
K_W     = 2 * 8 + 1         ; turn right
K_R     = 2 * 8 + 3         ; rise
K_T     = 2 * 8 + 4         ; (nothing in play)
    \ &F7FE: 1 2 3 4 5
K_1     = 3 * 8 + 0         ; the information screen's
K_5     = 3 * 8 + 4         ; cursor left: turn left
    \ &EFFE: 0 9 8 7 6
K_0     = 4 * 8 + 0         ; fire
K_8     = 4 * 8 + 2         ; cursor right: turn right
K_7     = 4 * 8 + 3         ; cursor up: forward
K_6     = 4 * 8 + 4         ; cursor down: back
    \ &DFFE: P O I U Y
K_P     = 5 * 8 + 0         ; look up
K_O     = 5 * 8 + 1         ; forward
K_I     = 5 * 8 + 2         ; information
K_U     = 5 * 8 + 3         ; turn round
K_Y     = 5 * 8 + 4         ; (nothing in play)
    \ &BFFE: ENTER L K J H
K_ENTER = 6 * 8 + 0         ; (nothing in play: the end's wait and the demo take any key)
K_L     = 6 * 8 + 1         ; look down
K_K     = 6 * 8 + 2         ; back
    \ &7FFE: SPACE SYM M N B
K_SPACE = 7 * 8 + 0         ; shooting mode
K_M     = 7 * 8 + 2         ; roll
K_N     = 7 * 8 + 3         ; roll the other way
K_B     = 7 * 8 + 4         ; the crosshair
KEYS_BYTES = 8              ; the ZX's half-rows

\ Each BBC key read (its internal key number, row * 16 + column) and the
\ ZX key it is. A K_ may have more than one.
KEY_MAP = {
    {&36, K_O}, {&46, K_K}, {&10, K_Q}, {&21, K_W},
    {&37, K_P}, {&56, K_L}, {&55, K_N}, {&65, K_M},
    {&33, K_R}, {&43, K_F}, {&35, K_U},
    {&61, K_Q}, {&42, K_W}, {&48, K_O}, {&68, K_K}, ; Z, X, : and /: the BBC's own (decision 10)
    {&20, K_Z}, {&71, K_A}, {&72, K_X}, {&73, K_S}, ; f0 and f1 the turn's size, f2 and f3 the step's
    {&27, K_0}, {&13, K_5}, {&34, K_6}, {&24, K_7}, {&15, K_8},
    {&32, K_D}, {&52, K_C}, {&62, K_SPACE}, {&64, K_B}, {&25, K_I},
    {&23, K_T}, {&44, K_Y},
    {&70, K_1}, {&30, K_1},                     ; ESCAPE, and 1 (the information screen's ABORT)
    {&49, K_ENTER},                             ; RETURN
    {&69, K_0},                                 ; COPY
    {&39, K_7}, {&29, K_6}, {&19, K_5}, {&79, K_8}  ; the cursor keys: up, down, left, right
}
KEY_COUNT = LEN(KEY_MAP)
ASSERT KEY_COUNT <= 128                                 ; (input_irq's index counts down to BPL)
ASSERT MAX(KEY_MAP[.., 1]) < KEYS_BYTES * 8
ASSERT MAX(KEY_MAP[.., 1] AND 7) < 5                    ; five keys a half-row
ASSERT MIN(KEY_MAP[.., 0] AND &F0) >= &10               ; none on row 0, which auto-scan leaves out

\ The keys by the keyboard's column (an internal key number's low nibble),
\ and where each column's start in that order: key_first + c, the last's
\ end after it.
KEY_SORTED  = SORT(ZIP(KEY_MAP[.., 0] AND 15, KEY_MAP[.., 0], KEY_MAP[.., 1]), 0)
KEY_COLUMN  = KEY_SORTED[.., 0]
KEY_COLUMNS = MAX(KEY_COLUMN) + 1
KEY_NONE    = &0F           ; a column the keyboard hasn't (its decoder's ten): no key, CA2 low
ASSERT KEY_COLUMNS <= 10 AND KEY_COLUMNS < 128
.key_number EQUB KEY_SORTED[.., 1]
.key_byte   EQUB KEY_SORTED[.., 2] DIV 8
.key_mask   EQUB 1 << (KEY_SORTED[.., 2] AND 7)
.key_first
    FOR c = 0..KEY_COLUMNS
        EQUB SUM(WHERE(KEY_COLUMN < c, 1, 0))
    NEXT

\ input_irq (the vertical sync's): the keys read, if one may have changed,
\ into keys, and those gone down since the last read into keys_made.
\ Below &3000, as the interrupt is: what it reads and writes is too.
CA2 = 1                     ; sysvia_ifr's bit: the keyboard's auto-scan found a key
.input_irq
{
    \ The keys are read only when one may have changed: one was held at
    \ the last read, or since then auto-scan has found one down (its CA2,
    \ as the OS's keyboard interrupt has it).
    LDA sysvia_ifr : AND #CA2 : ORA keys_any : BNE read
    RTS
.read
    LDA #&7F : STA sysvia_ddra                  ; bits 0-6 the key, bit 7 its state
    LDA #3 : STA sysvia_orb                     ; auto-scan off: the matrix is ours
    FOR i = 0..KEYS_BYTES - 1
        STZ keys_scan + i
    NEXT
    \ A column's keys read only when it has one down: with auto-scan off,
    \ CA2 is high while the column on port A has a key down (rows 1-7, as
    \ the OS's own scan reads it), so from CA2 low (a column with none, or
    \ KEY_NONE) and its flag clear, the flag says whether this one has. A
    \ key made after its column is looked at sets CA2 again by auto-scan,
    \ for the next read.
    LDA #KEY_NONE : STA sysvia_ora_nh
    LDA #CA2 : STA sysvia_ifr
    LDX #KEY_COLUMNS - 1
.column
    STX sysvia_ora_nh                           ; (row 0: the column alone)
    LDA sysvia_ifr : LSR A : BCC column_next    ; (CA2 is bit 0)
    STX keys_col
    LDA key_first,X : STA keys_first
    LDY key_first + 1,X
.key
    DEY
    LDA key_number,Y : STA sysvia_ora_nh
    LDA sysvia_ora_nh : BPL up                  ; (bit 7 set: held)
    LDX key_byte,Y
    LDA key_mask,Y : ORA keys_scan,X : STA keys_scan,X
.up
    CPY keys_first : BNE key
    LDA #KEY_NONE : STA sysvia_ora_nh           ; (CA2 low again, and its flag clear)
    LDA #CA2 : STA sysvia_ifr
    LDX keys_col
.column_next
    DEX : BPL column
    LDA #&0B : STA sysvia_orb                   ; auto-scan back
    LDA #&FF : STA sysvia_ddra
    \ made: held now and not at the last read, kept until taken (written
    \ out: this runs every field a key is held)
    FOR i = 0..KEYS_BYTES - 1
        LDA keys + i : EOR #&FF : AND keys_scan + i
        ORA keys_made + i : STA keys_made + i
        LDA keys_scan + i : STA keys + i
    NEXT
    LDA keys_scan
    FOR i = 1..KEYS_BYTES - 1
        ORA keys_scan + i
    NEXT
    STA keys_any
    RTS
}
ASSERT P% <= &3000

\ key_take: A the keys of byte X made since the last take of that byte,
\ and those cleared, with the interrupt held off between the two.
.key_take
    PHP : SEI
    LDA keys_made,X : STZ keys_made,X
    PLP
    RTS

\ input_init: no key held or made, before the interrupt is on.
.input_init
{
    LDX #KEYS_BYTES - 1
.clear
    STZ keys,X : STZ keys_made,X
    DEX : BPL clear
    STZ keys_any
    RTS
}

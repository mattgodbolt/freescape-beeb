\ ***************************************************************************
\ FREESCAPE for the BBC Master - the interrupt
\
\ The engine owns IRQ1V. Two interrupts are on:
\
\ - The vertical sync's (the System VIA's CA1): the field counted and the
\   keyboard read (src/input.6502); with FLIP_AT_VSYNC, the flip too.
\ - User VIA T1's, at FLIP_LINE, as the view's last line has gone (not
\   with FLIP_AT_VSYNC): the shown buffer's view marked shown whole, and a
\   frame frame_end handed over shown (src/screen.6502). T1 runs free, a
\   field a period, started in step with the sync by irq_install, so a
\   late interrupt is only late: the handler reads T1 and shows the frame
\   only if the beam is still outside the view, as frame_end does.
\
\ A flip at FLIP_LINE may come as late as the next view's top, FLIP_LEAD
\ lines short of it, so nothing should hold interrupts off for that long.
\ With FLIP_AT_VSYNC the window is the vertical blank's, FLAG_TO_TOP
\ lines. Neither may miss a sync: never a field with interrupts off.
\ ***************************************************************************

\ irq_install: irq_handler on IRQ1V, every VIA interrupt off but the
\ vertical sync's and T1's, and interrupts on. The OS's handler is kept in
\ os_irq1v: an interrupt that isn't the engine's goes on to it.
.irq_install
    SEI
    LDA #&7F : STA sysvia_ier : STA usrvia_ier  ; anything not serviced would hold IRQ
    LDA irq1v : STA os_irq1v
    LDA irq1v+1 : STA os_irq1v+1
    LDA #LO(irq_handler) : STA irq1v
    LDA #HI(irq_handler) : STA irq1v+1
IF NOT(FLIP_AT_VSYNC)
    \ T1 free-running, its first count from a sync's flag to FLIP_LINE in
    \ the next field, then a field's each time (T1_SYNC, T1_PERIOD)
    LDA usrvia_acr : AND #&3F : ORA #&40 : STA usrvia_acr
    LDA #LO(T1_SYNC) : STA usrvia_t1cl          ; (the latch's low byte)
    LDA #2 : STA sysvia_ifr                     ; a sync already flagged
.sync
    BIT sysvia_ifr : BEQ sync                   ; (A is 2: the sync's flag)
    LDA #HI(T1_SYNC) : STA usrvia_t1ch          ; the count starts
    LDA #LO(T1_PERIOD) : STA usrvia_t1ll
    LDA #HI(T1_PERIOD) : STA usrvia_t1lh
    LDA #&C0 : STA usrvia_ier                   ; T1
ENDIF
    LDA #2 : STA sysvia_ifr                     ; a sync already flagged
    LDA #&82 : STA sysvia_ier                   ; CA1: the vertical sync
    CLI
    RTS

\ irq_handler: from the MOS's IRQ entry, which keeps A in &FC.
.irq_handler
{
    ZA_INTERRUPT
    LDA sysvia_ifr : AND #2 : BNE sync
IF NOT(FLIP_AT_VSYNC)
    BIT usrvia_ifr : BVS view_gone              ; (T1 is bit 6)
ENDIF
    JMP (os_irq1v)
IF NOT(FLIP_AT_VSYNC)
.view_gone
    LDA usrvia_t1cl                             ; acknowledged
    LDA usrvia_t1ch : CMP #HI(SAFE_T1) + 1 : BCC done  ; (so late that the next view has begun)
    LDA #1 : STA view_shown
    LDA frame_ready : BEQ done
    PHX
    JSR flip
    PLX
.done
    LDA &FC                                     ; the interrupted A, which the MOS kept
    RTI
ENDIF
.sync
    STA sysvia_ifr                              ; acknowledged
    PHX : PHY
    INCW fields
IF FLIP_AT_VSYNC
    LDA frame_ready : BEQ shown
    JSR flip
.shown
ENDIF
    JSR input_irq
    PLY : PLX
    LDA &FC
    RTI
}
ASSERT P% <= &3000                              ; (X moves &3000-&7FFF)

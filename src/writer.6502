\ ***************************************************************************
\ FREESCAPE for the BBC Master - the writer (docs/engine.md, stage 10)
\
\ The view's bytes, written once each as the span buffer (raster.6502)
\ settles them: nothing on the screen is read and nothing is cleared.
\
\ - Whole bytes go through the row runs: for each character row of the
\   view, a routine of VIEW_BYTES `STA abs,Y`, one a byte column, with Y the
\   line within the row (Solid Elite's way). A piece of a line is written
\   by entering its row's run at the piece's first whole byte, with an RTS
\   planted after its last. Each row keeps one plant, moved only when a
\   piece ends somewhere else, so lines that end alike don't move it.
\ - A byte two runs share is `left AND PIX_LEFT OR right AND PIX_RIGHT` of
\   their pattern bytes, stored through r_bp0 or r_bp1, the line's address
\   in the screen's two pages of its character row.
\
\ Both screens share one address (main and shadow RAM), so one copy of the
\ row runs serves both; the caller sets ACCCON's X for the one drawn.
\ ***************************************************************************

OP_STA_ABSY = &99                   ; what a row run's slot holds
OP_RTS      = &60
RR_ROWS     = VIEW_H DIV 8
RR_END      = 3 * VIEW_BYTES        ; the offset of a run's own RTS
ASSERT RR_END < 256                 ; a row's run fits its page

\ The view's columns cross from a character row's first page to its second
\ at this pixel (the screen's column 32).
BND_SPLIT   = 2 * (32 - VIEW_COL0)
ASSERT VIEW_COL0 < 32 AND VIEW_COL0 + VIEW_BYTES <= 64

\ The line being written (line_setup): its character row, its line within
\ that row, and where both are on the screen and in the row runs.
ZA_AUTO1 r_row, r_l
ZA_AUTO2 r_bp0, r_bp1, r_rr
\ A piece: its pixels [r_lo, r_hi) and its pattern byte; a shared byte's
\ value while put_bnd finds its place.
ZA_AUTO1 r_lo, r_hi, r_v, r_bv, r_plant

\ ---------------------------------------------------------------------------
\ The row runs, a page each.

SECTION RasterRuns
    ALIGN 256
.rr_rows
FOR r = 0..<RR_ROWS
    ASSERT LO(P%) = 0
    FOR c = 0..<VIEW_BYTES
        STA VIEW_ADDR + r * SCREEN_ROW + 8 * c, Y
    NEXT
    RTS
    IF r < RR_ROWS - 1
        ALIGN 256
    ENDIF
NEXT
ENDSECTION

SECTION RasterCode

\ Per pixel boundary p (0..VIEW_W): a piece starting at p enters its row's
\ run at rr_en (its first whole byte's slot), and one ending at p plants the
\ RTS at rr_pl (the slot after its last whole byte).
.rr_en
FOR p = 0..VIEW_W
    EQUB 3 * ((p + 1) DIV 2)
NEXT
.rr_pl
FOR p = 0..VIEW_W
    EQUB 3 * (p DIV 2)
NEXT
\ For an odd p, the shared byte p DIV 2's offset from r_bp0 (p < BND_SPLIT)
\ or from r_bp1.
.bnd_ofs
FOR p = 0..VIEW_W
    EQUB ((VIEW_COL0 + p DIV 2) AND 31) * 8
NEXT

\ Per line: its character row, and that row's high bytes on the screen
\ and in the row runs.
.ln_row
FOR y = 0..<VIEW_H
    EQUB y DIV 8
NEXT
.ln_scr
FOR y = 0..<VIEW_H
    EQUB HI(VIEW_ADDR + (y DIV 8) * SCREEN_ROW)
NEXT
.ln_rr
FOR y = 0..<VIEW_H
    EQUB HI(rr_rows) + y DIV 8
NEXT
\ (A character row's view starts VIEW_COL0 columns into a page-aligned row,
\ which is what r_bp0 and bnd_ofs assume.)
ASSERT (VIEW_ADDR AND &FF) = VIEW_COL0 * 8 AND SCREEN_ROW MOD 256 = 0

\ line_setup: the writer's pointers for line X.
.line_setup
{
    TXA : AND #7 : STA r_l
    STA r_bp0 : STA r_bp1
    LDA ln_scr,X : STA r_bp0+1 : INC A : STA r_bp1+1
    LDA ln_rr,X : STA r_rr+1 : STA put_run.jsr+2
    STZ r_rr
    LDA ln_row,X : STA r_row
    RTS
}

\ put_run: the whole bytes of the piece [r_lo, r_hi) of the line set up,
\ in pattern byte r_v. Keeps X.
.put_run
{
    LDY r_hi : LDA rr_pl,Y
    LDY r_lo : CMP rr_en,Y : BEQ none : BCC none
    STA r_plant
    LDA rr_en,Y : STA jsr+1
    \ The row's plant: moved if it isn't where this piece ends. A run's own
    \ RTS (RR_END) is never planted or taken out.
    LDY r_row : LDA rr_planted,Y : CMP r_plant : BEQ go
    TAY : CPY #RR_END : BEQ fresh
    LDA #OP_STA_ABSY : STA (r_rr),Y
.fresh
    LDY r_plant : CPY #RR_END : BEQ planted
    LDA #OP_RTS : STA (r_rr),Y
.planted
    TYA : LDY r_row : STA rr_planted,Y
.go
    LDY r_l : LDA r_v
.jsr
    JSR rr_rows                         ; patched: the piece's row and entry
    ZA_CANCALL rr_rows
.none
    RTS
}

\ put_bnd: A into the shared byte at odd pixel boundary Y of the line set
\ up. Keeps X.
.put_bnd
{
    STA r_bv
    LDA bnd_ofs,Y
    CPY #BND_SPLIT
    TAY
    LDA r_bv
    BCS second
    STA (r_bp0),Y
    RTS
.second
    STA (r_bp1),Y
    RTS
}

\ writer_init: no RTS planted in any row's run (raster_init calls it once).
.writer_init
{
    LDX #RR_ROWS - 1
    LDA #RR_END
.each
    STA rr_planted,X
    DEX : BPL each
    RTS
}
ENDSECTION

\ Where each row's plant is: lasts from frame to frame, as the runs do.
SECTION RasterState
.rr_planted     SKIP RR_ROWS
ENDSECTION

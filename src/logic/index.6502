\ ***************************************************************************
\ FREESCAPE for the BBC Master - the index of the area's objects
\ (src/logic/touch.6502 and lookup scan it)
\
\ The original scans the area's records and the globals' for every
\ crossing ($A597), and for an object by id ($A8BA). Their cells, sizes and
\ ids change only as an area loads (the rig's parts move then), so the
\ logic keeps them in an index in main RAM (ix_*, src/logic/vars.6502),
\ built from the records in the original's order as the area loads: each
\ object's first cell and end (first plus size, AND 255) on each axis, its
\ id, and its record; and the sensors among them (ix_sn, for the sensors'
\ test after a redraw, src/sensors.6502). Its flags and type, which the FCL changes or the
\ answer needs, are read from the record itself (answer), as the original
\ reads them. In LOGIC_BANK, with the records.
\ ***************************************************************************

\ index_objects: the index, from the area's records (AreaObjPtr,
\ AreaObjects) and then the globals' (NGlobals), as the original scans
\ them. Clobbers A, X, Y.
.index_objects
{
    ZA_AUTO2 p
    ZA_AUTO1 n
    LDX #0
    STZ ix_ns
    LDA AreaObjects : BEQ globals
    STA n
    LDA AreaObjPtr : STA p
    LDA AreaObjPtr+1 : STA p+1
    JSR records
.globals
    LDA NGlobals : STA n
    LDA #LO(Globals) : STA p
    LDA #HI(Globals) : STA p+1
    JSR records
    STX ix_n
    LDA #1 : STA ix_dirty                       ; (touch's lists to build again)
    RTS
.records
    LDA p : STA ix_pl,X
    LDA p+1 : STA ix_ph,X
    LDY #1 : LDA (p),Y : STA ix_xo,X
    LDY #4 : CLC : ADC (p),Y : STA ix_xe,X
    LDY #2 : LDA (p),Y : STA ix_yo,X
    LDY #5 : CLC : ADC (p),Y : STA ix_ye,X
    LDY #3 : LDA (p),Y : STA ix_zo,X
    LDY #6 : CLC : ADC (p),Y : STA ix_ze,X
    LDY #7 : LDA (p),Y : STA ix_id,X
    LDA (p) : AND #&0F : CMP #IX_SENSOR : BNE not_sensor
    LDY ix_ns : TXA : STA ix_sn,Y
    INC ix_ns
.not_sensor
    LDY #8 : LDA (p),Y
    CLC : ADC p : STA p
    BCC same
    INC p+1
.same
    INX
    DEC n : BNE records
    RTS
}
ASSERT ZX_N_GLOBALS > 0 AND ZX_AREAS_MOST + ZX_N_GLOBALS < IX_MAX     ; (and a byte after the last, where touch stops)
IX_SENSOR = 2               ; a sensor's type (the record's flags' low nibble)

\ shown_flags: each indexed object's flags byte (its record's +0: bit 6
\ invisible, bit 5 destroyed, the low nibble its type) into ix_flags, in
\ the index's order, for the renderer, which runs with its own bank in:
\ the area's objects from 0 (AreaObjects of them), then the globals.
.shown_flags
{
    ZA_AUTO2 p
    LDX #0
    BRA test
.object
    LDA ix_pl,X : STA p
    LDA ix_ph,X : STA p+1
    LDA (p) : STA ix_flags,X
    INX
.test
    CPX ix_n : BNE object
    RTS
}

\ answer: object X of the index is entered. If it's visible, a rectangle,
\ a line or a polygon is the answer (C set, A its id) and any other is
\ remembered in HitRemembered (C clear); invisible, C clear. Keeps X.
\ (touch calls it through far_answer, from LOGIC_CODE_BANK.)
.answer
{
    ZA_AUTO2 p
    LDA ix_pl,X : STA p
    LDA ix_ph,X : STA p+1
    LDA (p) : AND #&40 : BNE go_on
    LDY #7 : LDA (p),Y : TAY                    ; its id
    LDA (p) : AND #&0F
    CMP #3 : BEQ at_once
    CMP #&0A : BMI remember
.at_once
    TYA
    SEC
    RTS
.remember
    STY HitRemembered
.go_on
    CLC
    RTS
}

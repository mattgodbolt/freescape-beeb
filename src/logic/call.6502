\ ***************************************************************************
\ FREESCAPE for the BBC Master - the logic's main RAM part: the frame's way
\ in, and the way between its two banks (docs/research/logic6502.md, "The
\ frame's interface")
\
\ Each entry pages the bank it needs in (ROMSEL, and logic_paged, which a
\ hook that pages another bank puts back) and goes on to the logic, which
\ returns to the caller with LOGIC_CODE_BANK or LOGIC_BANK in. The engine
\ owns the machine, so nothing else pages a bank behind it; a caller that
\ wants another bank pages it back itself. Include in main RAM, with
\ src/logic/hooks.6502.
\ ***************************************************************************

\ LOGIC_PAGE reg, bank: bank paged in, by register reg (A or Y), which it
\ clobbers. (Not PAGE: a macro's name is a keyword, and the engine has a
\ label .page.)
MACRO LOGIC_PAGE "A", bank
    LDA #bank : STA romsel : STA logic_paged
ENDMACRO
MACRO LOGIC_PAGE "Y", bank
    LDY #bank : STY romsel : STY logic_paged
ENDMACRO

\ logic_go_pass: a pass of the logic (logic_pass): A = 0 if nothing was to
\ be done (no key and no minute), 1 if a pass ran, 2 if the game is over.
.logic_go_pass
    LOGIC_PAGE A, LOGIC_CODE_BANK
    JMP logic_pass

\ logic_go_clock: A frames of the original's interrupt's clock
\ (logic_clock), A from 1: the seconds, a minute's end (which the next
\ pass takes), the time out. Keeps nothing.
.logic_go_clock
{
    TAX
    LOGIC_PAGE A, LOGIC_CODE_BANK
.frame
    PHX
    JSR logic_clock
    PLX
    DEX : BNE frame
    RTS
}

\ logic_go_tick: the checks' minute (logic_tick): the seconds held at 00,
\ the frame at the second's last, and a frame of the clock.
.logic_go_tick
    LOGIC_PAGE A, LOGIC_CODE_BANK
    JMP logic_tick

\ logic_go_init: the logic ready, once LOGICW, LOGIC and LOGICC are
\ loaded: the area's objects indexed.
.logic_go_init
    LOGIC_PAGE A, LOGIC_BANK
    JMP index_objects

\ logic_go_colours: the screen takes the area's colours (the original's
\ $A77A, which its redraw runs when AreaChanged is set): ScreenColours,
\ the sensors' flash counters, and AreaChanged cleared.
.logic_go_colours
    LOGIC_PAGE A, LOGIC_BANK
    JMP screen_update

\ logic_go_shown: each of the area's objects' and the globals' flags into
\ ix_flags, for the renderer (shown_flags).
.logic_go_shown
    LOGIC_PAGE A, LOGIC_BANK
    JMP shown_flags

\ far_events: the events (LOGIC_BANK), from the pass (LOGIC_CODE_BANK).
.far_events
    LOGIC_PAGE A, LOGIC_BANK
    JSR events
    LOGIC_PAGE A, LOGIC_CODE_BANK
    RTS

\ The rigs' parts in LOGIC_BANK, from theirs in LOGIC_CODE_BANK
\ (src/logic/rig.6502): far_rig_parts ($C259's $CD3B), the rig's parts
\ placed, and the index after them (the 6502's own: the original scans the
\ records); far_rig_score, the score += rig_v by the FCL's ADDSCORE, its
\ instruction where the original makes it ($BEF6: RigScratch + 2 on) and
\ run; the place suitable (src/logic/rigdb.6502, keeping C); a message
\ shown (hook_message, with the messages' bank in).
.far_rig_parts
    LOGIC_PAGE A, LOGIC_BANK
    JSR place_rigs
    JSR index_objects
    BRA rig_back
.far_rig_score
    LOGIC_PAGE A, LOGIC_BANK
    LDA #LO(RigScratch + 2) : STA run.ip
    LDA #HI(RigScratch + 2) : STA run.ip+1
    LDA #4 : STA run.n
    JSR run
    BRA rig_back
ASSERT ZXI_RigScratch[2] = 1                    ; (the instruction's ADDSCORE, which the original never writes)
.far_rig_message
    LOGIC_PAGE A, LOGIC_BANK
    JSR hook_message
    BRA rig_back
.far_rig_suitable
    LOGIC_PAGE Y, LOGIC_BANK
    JSR suitable
    LOGIC_PAGE Y, LOGIC_CODE_BANK
    RTS
.rig_back
    LOGIC_PAGE A, LOGIC_CODE_BANK
    RTS

\ far_answer: answer (LOGIC_BANK, which has the records) for touch
\ (LOGIC_CODE_BANK), keeping A and C. Clobbers Y.
.far_answer
    LOGIC_PAGE Y, LOGIC_BANK
    JSR answer
    LOGIC_PAGE Y, LOGIC_CODE_BANK
    RTS

\ wait ($A56F, $A9D0): Countdown = A, and the interrupt counts it to 0
\ (hook_wait: the frame's to time). Both banks call it.
.wait
    STA Countdown
    JSR hook_wait
    STZ Countdown
    RTS

\ The game's end, a new game and the demo, and the information screen (in
\ LogicMore, main RAM, which the includer declares, with InfoData in bank
\ INFO_BANK).
INCLUDE "end.6502"
INCLUDE "info.6502"

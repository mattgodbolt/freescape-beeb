\ ***************************************************************************
\ FREESCAPE for the BBC Master - the logic's sideways RAM banks
\ (docs/research/logic6502.md, "Memory")
\
\ LOGIC_BANK (file LOGIC) holds Driller's database at its top (LOGIC_DB),
\ the ZX's bytes in the original's layout, so the logic walks the records
\ the original walks, and below it the code that reads the database: the
\ areas, the FCL and the objects' index. The FCL changes the objects' flags
\ in it, so a new game loads it afresh.
\
\ LOGIC_CODE_BANK (file LOGICC) holds the rest of the logic: the pass and
\ the keys, the movement, the walk and the object test, and the
\ arithmetic, with the original's tables they read. It has room to share.
\
\ The code and the database together come to more than a bank. The two
\ halves call each other through main RAM (src/logic/call.6502), which is
\ where the frame calls in too, and the logic's variables are in main RAM
\ (src/logic/vars.6502).
\
\ Include at the top level, after src/logic/vars.6502 and with
\ src/input.6502's KEYS_BYTES and keys about. It needs
\ build/logic6502/db.bin.
\ ***************************************************************************

SECTION Logic, org = &8000, guard = &C000, filename = "LOGIC", cmos = TRUE
.logic_db_code
INCLUDE "area.6502"
INCLUDE "fcl.6502"
INCLUDE "index.6502"
.logic_db_code_end
ASSERT P% <= LOGIC_DB
    SKIPTO LOGIC_DB
.logic_db
    INCBIN "../../build/logic6502/db.bin"
ASSERT P% = &C000
ENDSECTION
ASSERT logic_db = LOGIC_DB

SECTION LogicCode, org = &8000, guard = &C000, filename = "LOGICC", cmos = TRUE
.logic_code
INCLUDE "pass.6502"
INCLUDE "move.6502"
INCLUDE "walk.6502"
INCLUDE "touch.6502"
INCLUDE "arith.6502"
    \ the original's tables (tools/mklogicdata.py)
.SinCos     EQUB ZX_SINCOS                      ; 72 (sin, cos) pairs, signed, 1.0 = 64
.KeyCodes   EQUB ZX_KEY_CODES                   ; a code for each key, five a half-row
.KeyActions EQUB ZX_ACTIONS                     ; each code's action, from the key table ...
.KeyShootActions EQUB ZX_SHOOT_ACTIONS          ; ... and in shooting mode
ASSERT LEN(ZX_ACTIONS) = 128 AND MAX(ZX_KEY_CODES) < 128
    \ the quarter squares, n * n DIV 4 for n from 0 to 511 (mul88)
ALIGN 256
.sq_lo      EQUB LO((0..511) * (0..511) DIV 4)
.sq_hi      EQUB HI((0..511) * (0..511) DIV 4)
    \ the lists of the objects by face (src/logic/touch.6502's link_faces)
.face_xo    SKIP 256
.face_xe    SKIP 256
.face_yo    SKIP 256
.face_ye    SKIP 256
.face_zo    SKIP 256
.face_ze    SKIP 256
.next_xo    SKIP IX_MAX
.next_xe    SKIP IX_MAX
.next_yo    SKIP IX_MAX
.next_ye    SKIP IX_MAX
.next_zo    SKIP IX_MAX
.next_ze    SKIP IX_MAX
.logic_code_end
ENDSECTION

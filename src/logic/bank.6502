\ ***************************************************************************
\ FREESCAPE for the BBC Master - the logic's sideways RAM banks
\ (docs/research/logic6502.md, "Memory")
\
\ LOGIC_BANK (file LOGIC) holds Driller's database at its top (LOGIC_DB),
\ the ZX's bytes in the original's layout, so the logic walks the records
\ the original walks, and below it the code that reads the database: the
\ areas, the FCL and the objects' index. The FCL changes the objects' flags
\ in it, so a new game loads it afresh.
\
\ LOGIC_CODE_BANK (file LOGICC) holds the rest of the logic: the pass and
\ the keys, the movement, the walk and the object test, and the
\ arithmetic, with the original's tables they read, the quarter squares
\ its multiplies use and the object test's lists by face (unless the
\ includer places those: LOGIC_SQUARES, LogicFaces, below). It has room to
\ share.
\
\ The code and the database together come to more than a bank. The two
\ halves call each other through main RAM (src/logic/call.6502), which is
\ where the frame calls in too, and the logic's variables are in main RAM
\ (src/logic/vars.6502).
\
\ Include at the top level, after src/logic/vars.6502 and with
\ src/input.6502's KEYS_BYTES and keys about. It needs
\ build/logic6502/db.bin.
\ ***************************************************************************

SECTION Logic, org = &8000, guard = &C000, filename = "LOGIC", cmos = TRUE
.logic_db_code
INCLUDE "area.6502"
INCLUDE "fcl.6502"
INCLUDE "index.6502"
INCLUDE "rigdb.6502"
INCLUDE "enddb.6502"
.logic_db_code_end
ASSERT P% <= LOGIC_DB
    SKIPTO LOGIC_DB
.logic_db
    INCBIN "../../build/logic6502/db.bin"
ASSERT P% = &C000
ENDSECTION
ASSERT logic_db = LOGIC_DB

SECTION LogicCode, org = &8000, guard = &C000, filename = "LOGICC", cmos = TRUE
.logic_code
INCLUDE "pass.6502"
INCLUDE "move.6502"
INCLUDE "walk.6502"
INCLUDE "touch.6502"
INCLUDE "arith.6502"
INCLUDE "rig.6502"
    \ the original's tables (tools/mklogicdata.py)
.SineTable  EQUB ZX_SINE                        ; the sines of the first half of the 72 angles, signed, 1.0 = 64 (sine, src/logic/move.6502)
ASSERT LEN(ZX_SINE) = 36
.KeyCodes   EQUB ZX_KEY_CODES                   ; a code for each key, five a half-row
.KeyActions EQUB ZX_ACTIONS                     ; the action of each code from KEY_LOW, from the key table (action_of)
ASSERT MAX(ZX_KEY_CODES) < 128
    \ the quarter squares, n * n DIV 4 for n from 0 to 511 (mul88): the
    \ includer's (LOGIC_SQUARES, the address of a table laid out as this
    \ one: the live disc shares the maths' in HAZEL), or the logic's own
IF DEFINED(LOGIC_SQUARES)
    lq_lo = LOGIC_SQUARES
    lq_hi = LOGIC_SQUARES + 512
ELSE
ALIGN 256
.lq_lo      EQUB LO((0..511) * (0..511) DIV 4)
.lq_hi      EQUB HI((0..511) * (0..511) DIV 4)
ENDIF
    \ the lists of the objects by face (src/logic/touch.6502's link_faces),
    \ in section LogicFaces: here, or wherever the includer declared it
    \ first (the live disc keeps them in shadow RAM, which its passes run
    \ with)
SECTION LogicFaces
.face_xo    SKIP 256
.face_xe    SKIP 256
.face_yo    SKIP 256
.face_ye    SKIP 256
.face_zo    SKIP 256
.face_ze    SKIP 256
.next_xo    SKIP IX_MAX
.next_xe    SKIP IX_MAX
.next_yo    SKIP IX_MAX
.next_ye    SKIP IX_MAX
.next_zo    SKIP IX_MAX
.next_ze    SKIP IX_MAX
ENDSECTION
.logic_code_end
ENDSECTION

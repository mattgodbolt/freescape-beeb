\ ***************************************************************************
\ FREESCAPE for the BBC Master - the draw order (docs/engine.md, stage 7;
\ decision 3; tools/model/order.py)
\
\ The original's sort: up to n - 1 bubble passes over the draw list in the
\ object pass's order, stopping after a pass with no swap; a pair keeps its
\ order only when the second is nearer on some axis and the first on none.
\ On one axis (the model's compare_axis), with the header boxes relative to
\ the camera:
\
\ - overlapping boxes (each's min below the other's max): no verdict;
\ - a box across the camera's coordinate is the nearer, the first first;
\ - boxes on opposite sides: no verdict;
\ - else, of two below the camera, the one whose (min, max) is the greater
\   is nearer, and of two above it the one whose (min, max) is the less, a
\   tie going to the second below and the first above (the model's sign
\   test on min_b - min_a, or max_b - max_a when the mins are equal).
\
\ Every quantity is 64 cells - c, so each compare is of cells: min_a <
\ max_b is L_a < H_b, and below the camera (min < 0) is L < e, e the
\ camera's ceiling cell (src/objects.6502). So each entry gets its cells
\ and its side of the camera on each axis once, and a compare is byte
\ compares.
\
\ Entry points:
\   sort_objects  dl_ord = the draw list's entries farthest first
\   emit_faces    the drawn faces nearest first (dl_ord backwards, each
\                 object's in its face order) into out_fn, out_fv, out_fc,
\                 and their count in out_nf
\ ***************************************************************************

SK_ACROSS = 0 : SK_BELOW = 1 : SK_ABOVE = 2     ; an entry's side of the camera

SECTION ObjWork
.sk_lx      SKIP N_OBJ              ; each entry's header box, cells
.sk_ly      SKIP N_OBJ
.sk_lz      SKIP N_OBJ
.sk_hx      SKIP N_OBJ
.sk_hy      SKIP N_OBJ
.sk_hz      SKIP N_OBJ
.sk_sx      SKIP N_OBJ              ; its side of the camera on each axis (SK_*)
.sk_sy      SKIP N_OBJ
.sk_sz      SKIP N_OBJ
.dl_rl      SKIP N_OBJ              ; each entry's row of the sort's memory
.dl_rh      SKIP N_OBJ
ENDSECTION

\ The compares remembered (sort_objects): a compare of two objects' boxes
\ depends on nothing but them and each box's side of the camera on each axis
\ (SK_AXIS's: L >= e above, H < e below, else across), so its keep or swap
\ is kept by the pair of slots, as so_gen << 1 OR keep, until a ceiling cell
\ e moves past some box's L or H (a new so_gen), or the objects move
\ (sort_forget).
SECTION ObjMemo
.so_memo    SKIP ((N_OBJ * N_OBJ + 255) DIV 256) * 256   ; (whole pages: so_new clears them)
\ The last sort's draw list and its order (so_save): a list the same as it,
\ slot for slot, under the same generation has every compare the same, so
\ the same order.
.so_ln      SKIP 1                  ; its length, or &FF for none
.so_lgen    SKIP 1                  ; its generation
.so_lobj    SKIP N_OBJ              ; its slots
.so_lord    SKIP N_OBJ              ; its order
ENDSECTION
SECTION ObjWork
.so_cells   SKIP 3                  ; the cells the memory is for
.so_valid   SKIP 1                  ; non-zero once so_cells are
.so_gen     SKIP 1                  ; its generation, 1 .. 127, shifted left one
ENDSECTION

SECTION ObjCode

\ sort_forget: the sort remembers no compare (cache_reset calls it, as an
\ area is entered): a new generation, which no remembered compare has, so the
\ memory is cleared only as generations run out, not each entry.
.sort_forget
    STZ so_valid                        ; (the next sort starts one more)
    \ (on to so_new)

\ so_new: the next generation; when they run out, the memory cleared and
\ the first again.
.so_new
    LDA so_gen : CLC : ADC #2 : STA so_gen
    BEQ so_clear
    RTS
\ so_clear: the memory cleared, and the first generation: once at the start
\ (area_init), before any generation of its can be trusted.
.so_clear
{
    ZA_AUTO2 at
    LDA #&FF : STA so_ln                ; (no last order: its generation comes again)
    LDA #LO(so_memo) : STA at
    LDA #HI(so_memo) : STA at+1
    LDX #HI(N_OBJ * N_OBJ + 255)
    LDY #0
    TYA
.clear
    STA (at),Y
    INY : BNE clear
    INC at+1
    DEX : BNE clear
    LDA #2 : STA so_gen
.done
    RTS
}
ASSERT (N_OBJ * N_OBJ + 255) DIV 256 < 256

\ SK_AXIS k, lo, hi, side, olo, ohi: entry X's keys on axis k, from slot Y's
\ header box (olo, ohi)
MACRO SK_AXIS k, lo, hi, side, olo, ohi
    LDA olo,Y : STA lo,X
    CMP cell_e + k : BCS above      ; L >= e: wholly above
    LDA ohi,Y : STA hi,X
    CMP cell_e + k : BCC below      ; H < e: wholly below
    LDA #SK_ACROSS : BRA set
.above
    LDA ohi,Y : STA hi,X
    LDA #SK_ABOVE : BRA set
.below
    LDA #SK_BELOW
.set
    STA side,X
ENDMACRO

\ SK_COMPARE lo, hi, side: one axis of a pair's compare (X = a, Y = b): on
\ to sort_objects.first if a is the nearer, set second if b is, and on if
\ neither
MACRO SK_COMPARE lo, hi, side
    LDA lo,X : CMP hi,Y : BCS apart     ; L_a >= H_b
    LDA lo,Y : CMP hi,X : BCC done      ; L_b < H_a: they overlap
.apart
    LDA side,X : BEQ first_x            ; a across the camera
    LDA side,Y : BEQ second_x           ; b across
    CMP side,X : BNE done               ; opposite sides
    CMP #SK_ABOVE : BEQ above
    \ both below: a is nearer if (L_b, H_b) < (L_a, H_a)
    LDA lo,Y : CMP lo,X : BNE below_decided
    LDA hi,Y : CMP hi,X
.below_decided
    BCC first_x
    BRA second_x
.above
    \ both above: a is nearer unless (L_b, H_b) < (L_a, H_a)
    LDA lo,Y : CMP lo,X : BNE above_decided
    LDA hi,Y : CMP hi,X
.above_decided
    BCC second_x
.first_x
    JMP sort_objects.first
.second_x
    LDA #1 : STA sort_objects.second
.done
ENDMACRO

\ sort_objects: the original's sort of the draw list into dl_ord, each
\ pair's verdict from the memory when it has it (so_memo). A draw list the
\ same as the last sort's, under the same generation, takes the last sort's
\ order, since every compare is the same. Each entry's row of the memory
\ (by its slot) is found once a frame (dl_rl, dl_rh), and a pass keeps its
\ place in X.
.sort_objects
{
    ZA_ENTRY
    ZA_AUTO1 last, passes, changed, j, mslot, second, keyed, lo, span, axis
    ZA_AUTO2 row
    LDX dl_n : BNE some
    RTS
.some
    \ a ceiling cell moved past a box's L or H, which some slot's side then
    \ changes on: a new generation (any slot's: the memory keeps them all)
    LDA so_valid : BEQ moved
    LDX #2
.cells
    LDA cell_e,X : CMP so_cells,X : BEQ cell_kept
    \ e moved from e0 to e1: a side changed if L or H is in [min, max)
    BCS up
    STA lo                              ; (moved down: from e1)
    LDA so_cells,X
    BRA spanned
.up
    LDA so_cells,X : STA lo
    LDA cell_e,X
.spanned
    SEC : SBC lo : STA span
    LDA sc_ll,X : STA box_l+1
    LDA sc_lh,X : STA box_l+2
    LDA sc_hl,X : STA box_h+1
    LDA sc_hh,X : STA box_h+2
    STX axis
    LDX ob_n : DEX
.slot
.box_l
    LDA ob_lx,X : SEC : SBC lo : CMP span : BCC moved
.box_h
    LDA ob_hx,X : SEC : SBC lo : CMP span : BCC moved
    DEX : BPL slot
    LDX axis
    LDA cell_e,X : STA so_cells,X       ; (no side changed: the memory holds)
.cell_kept
    DEX : BPL cells
    BRA same
.moved
    STA so_valid                        ; (non-zero: a cell, or so_valid's 0 ...
    LDA #1 : STA so_valid               ; ... made 1)
    LDA cell_e : STA so_cells
    LDA cell_e+1 : STA so_cells+1
    LDA cell_e+2 : STA so_cells+2
    JSR so_new
.same
    \ the last sort's list under its generation: its order
    LDA so_gen : CMP so_lgen : BNE fresh
    LDX dl_n : CPX so_ln : BNE fresh
    DEX
.same_list
    LDA dl_obj,X : CMP so_lobj,X : BNE fresh
    DEX : BPL same_list
    LDX dl_n : DEX
.again
    LDA so_lord,X : STA dl_ord,X
    DEX : BPL again
    RTS
.fresh
    LDX dl_n : DEX
.order
    TXA : STA dl_ord,X
    LDY dl_obj,X
    LDA so_row_lo,Y : STA dl_rl,X
    LDA so_row_hi,Y : STA dl_rh,X
    DEX : BPL order
    STZ keyed
    LDX dl_n : DEX : BNE pairs
    JMP so_save                         ; (one entry)
.pairs
    STX last                            ; the pairs: 0 .. last - 1
    STX passes                          ; at most this many passes
.pass
    STZ changed
    LDX #0
.pair
    \ remembered? (so_memo's row for a's slot, at b's)
    LDY dl_ord,X                        ; a
    LDA dl_rl,Y : STA row
    LDA dl_rh,Y : STA row+1
    LDY dl_ord+1,X                      ; b
    LDA dl_obj,Y : TAY
    LDA (row),Y : EOR so_gen
    CMP #2 : BCS compare                ; (another generation's, or none)
.verdict
    LSR A : BCC swap                    ; (C: keep)
.next
    INX : CPX last : BCC pair
    LDA changed : BEQ sorted
    DEC passes : BNE pass
.sorted
    JMP so_save
.swap
    \ b, then a
    LDA dl_ord,X : PHA
    LDA dl_ord+1,X : STA dl_ord,X
    PLA : STA dl_ord+1,X
    INC changed                         ; (fewer than 256 swaps a pass)
    BRA next
.compare
    STX j : STY mslot
    LDA keyed : BNE have_keys
    JSR sort_keys
    INC keyed
.have_keys
    LDY j : LDX dl_ord,Y
    LDA dl_ord+1,Y : TAY
    STZ second
    SK_COMPARE sk_lx, sk_hx, sk_sx
    SK_COMPARE sk_ly, sk_hy, sk_sy
    SK_COMPARE sk_lz, sk_hz, sk_sz
    LDA second : BEQ first
    LDA #1                              ; kept
    BRA remember
.first
    LDA #0                              ; swapped
.remember
    LDY mslot
    PHA : ORA so_gen : STA (row),Y : PLA
    LDX j
    JMP verdict
\ by axis: the header box's L and H arrays, for the cells' check
.sc_ll
    EQUB LO(ob_lx), LO(ob_ly), LO(ob_lz)
.sc_lh
    EQUB HI(ob_lx), HI(ob_ly), HI(ob_lz)
.sc_hl
    EQUB LO(ob_hx), LO(ob_hy), LO(ob_hz)
.sc_hh
    EQUB HI(ob_hx), HI(ob_hy), HI(ob_hz)
}
ASSERT N_OBJ < 128                      ; (the cells' check counts slots down to 0)

\ so_save: the draw list and its order kept for the next sort.
.so_save
{
    LDX dl_n : STX so_ln
    LDA so_gen : STA so_lgen
    DEX
.save
    LDA dl_obj,X : STA so_lobj,X
    LDA dl_ord,X : STA so_lord,X
    DEX : BPL save
    RTS
}

\ sort_keys: each draw-list entry's keys: its header box's cells and its
\ side of the camera on each axis.
.sort_keys
{
    LDX dl_n : DEX
.keys
    LDY dl_obj,X
    SK_AXIS 0, sk_lx, sk_hx, sk_sx, ob_lx, ob_hx
    SK_AXIS 1, sk_ly, sk_hy, sk_sy, ob_ly, ob_hy
    SK_AXIS 2, sk_lz, sk_hz, sk_sz, ob_lz, ob_hz
    DEX : BMI done
    JMP keys
.done
    RTS
}

\ so_memo's rows, by slot
.so_row_lo
    EQUB LO(so_memo + (0..N_OBJ - 1) * N_OBJ)
.so_row_hi
    EQUB HI(so_memo + (0..N_OBJ - 1) * N_OBJ)

\ emit_faces: the faces nearest first, from the sorted draw list.
.emit_faces
{
    ZA_ENTRY
    ZA_AUTO1 p, f, end
    STZ out_nf
    LDX dl_n : BEQ done
.object
    DEX : STX p
    LDY dl_ord,X
    LDA dl_f0,Y : STA f
    CLC : ADC dl_nf,Y : STA end
.face
    LDY f
    LDX out_nf
    LDA tf_fn,Y : STA out_fn,X
    LDA tf_fv,Y : STA out_fv,X
    LDA tf_fc,Y : STA out_fc,X
    INC out_nf
    INC f : LDA f : CMP end : BNE face
    LDX p : BNE object
.done
    RTS
}

ENDSECTION

\ ***************************************************************************
\ FREESCAPE for the BBC Master - shared constants (docs/engine.md)
\
\ Constants only: no sections, so every build (the disc, the spike and each
\ track's checks) can include it.
\ ***************************************************************************

\ --- Hardware ------------------------------------------------------------

crtc_reg    = &FE00
crtc_data   = &FE01
ula_ctrl    = &FE20         ; the video ULA's control register
ula_pal     = &FE21         ; the video ULA's palette
romsel      = &FE30         ; the sideways bank at &8000
acccon      = &FE34         ; the Master's access control
ACCCON_D    = 1             ; ... D: the CRTC shows shadow RAM
ACCCON_E    = 2             ; ... E: the VDU's code sees shadow RAM
ACCCON_X    = 4             ; ... X: the CPU's &3000-&7FFF is shadow RAM
ACCCON_Y    = 8             ; ... Y: HAZEL's RAM at &C000-&DFFF
sysvia_orb  = &FE40
sysvia_ddra = &FE43
sysvia_t1cl = &FE44
sysvia_t1ch = &FE45
sysvia_acr  = &FE4B
sysvia_pcr  = &FE4C
sysvia_ifr  = &FE4D         ; bit 1: the vertical sync (CA1) has come
sysvia_ier  = &FE4E         ; write bit 7 clear to disable the bits set
sysvia_ora_nh = &FE4F       ; port A without handshake: the keyboard
usrvia_t1cl = &FE64         ; T1's counter, low (reading it acknowledges T1); written, its latch
usrvia_t1ch = &FE65         ; ... high (reading it doesn't; writing it starts the count)
usrvia_t1ll = &FE66         ; T1's latch, which a free-running T1 reloads from ...
usrvia_t1lh = &FE67         ; ... written without starting a count
usrvia_acr  = &FE6B
usrvia_ifr  = &FE6D         ; bit 6: T1
usrvia_ier  = &FE6E
irq1v       = &0204         ; the OS's IRQ vector, which the engine takes
FUNCTION ula_entry(entry, phys) = entry * 16 + (phys EOR 7)

\ --- The screen (docs/engine.md, section 1; decision 2) ------------------

\ Driller's screen, as the ZX's, is 192 lines: the view and the panel below
\ it. So the CRTC shows SCREEN_ROWS character rows, not MODE 2's 32, and
\ each buffer is the top of its RAM, from SCREEN up to &8000: main and
\ shadow RAM's &3000 up to SCREEN go on from what the engine keeps at &3000
\ in each (src/live.6502's map; docs/research/live.md, "Memory").
SCREEN_COLS = 64            ; bytes a line: R1, MODE 2's 128 pixels
SCREEN_ROW  = SCREEN_COLS * 8   ; bytes a character row
SCREEN_ROWS = 24            ; character rows: R6, Driller's 192 lines
SCREEN      = &8000 - SCREEN_ROWS * SCREEN_ROW  ; both buffers, main and shadow RAM
ASSERT SCREEN_ROWS * 8 = 192 AND LO(SCREEN) = 0 AND SCREEN >= &3000

VIEW_W      = 104           ; pixels: the ZX's 208 at half the width
VIEW_H      = 104           ; lines: the ZX's
VIEW_BYTES  = VIEW_W DIV 2  ; MODE 2: two pixels a byte
ASSERT VIEW_W MOD 2 = 0
ASSERT VIEW_H MOD 8 = 0
ASSERT VIEW_BYTES <= SCREEN_COLS

\ The view's top left: a whole character row down, centred across.
VIEW_ROW0   = 1
VIEW_COL0   = (SCREEN_COLS - VIEW_BYTES) DIV 2
VIEW_ADDR   = SCREEN + VIEW_ROW0 * SCREEN_ROW + VIEW_COL0 * 8
ASSERT VIEW_ROW0 + VIEW_H DIV 8 <= SCREEN_ROWS

\ Sixteenths of a pixel: the view coordinates (docs/engine.md, section 9).
SUB         = 16

\ The bits of a MODE 2 byte that hold its left and right pixels.
PIX_LEFT    = &AA
PIX_RIGHT   = &55
\ A MODE 2 byte's bits for logical colour c as its left pixel (colour bits
\ 3-0 in bits 7, 5, 3 and 1) and as its right (bits 6, 4, 2 and 0); a
\ byte of two pixels is their OR. Each broadcasts over a list of colours.
FUNCTION mode2_left(c) = ((c AND 8) << 4) OR ((c AND 4) << 3) OR ((c AND 2) << 2) OR ((c AND 1) << 1)
FUNCTION mode2_right(c) = mode2_left(c) >> 1
FUNCTION mode2_byte(l, r) = mode2_left(l) OR mode2_right(r)
ASSERT mode2_byte(15, 0) = PIX_LEFT AND mode2_byte(0, 15) = PIX_RIGHT

\ --- The display (docs/engine.md, section 1) ------------------------------
\ MODE 2 in the hardware: the video ULA's control register as the MOS sets
\ it for MODE 2 (the CRTC at 2MHz, four pixels a microsecond), and the
\ CRTC's registers as MOS 3.20 sets them for MODE 2 with *TV 0,1, narrowed
\ to SCREEN_COLS bytes a line and SCREEN_ROWS character rows from SCREEN,
\ with the syncs moved so the picture keeps MODE 2's centre (decision 9),
\ across and down; not
\ interlaced, and no cursor. MOS 3.20's vertical sync row is its table's
\ (OS 1.20's) plus the *TV setting plus one, so it sits a row later than
\ OS 1.20's MODE 2; the CMOS's own *TV setting isn't followed.
\ screen_init (src/screen.6502) writes them; tools/frames.mjs reads them
\ back from jsbeeb's CRTC and compares them with the MOS's own MODE 2.
ULA_MODE2   = &F4
MODE2_R1    = 80            ; MOS 3.20's MODE 2: bytes a line ...
MODE2_R2    = 98            ; ... the horizontal sync's character ...
MODE2_R6    = 32            ; ... character rows shown ...
MODE2_R7    = 35            ; ... and the vertical sync's row, at *TV 0
CRTC_R0     = 127           ; a line: 128 characters, 64us
CRTC_R1     = SCREEN_COLS
CRTC_R2     = MODE2_R2 - (MODE2_R1 - CRTC_R1) DIV 2
CRTC_R3     = &28           ; the vertical sync 2 lines, the horizontal 8 characters
CRTC_R4     = 38            ; 39 character rows a field ...
CRTC_R5     = 0             ; ... and no extra lines
CRTC_R6     = SCREEN_ROWS
CRTC_R7     = MODE2_R7 - (MODE2_R6 - CRTC_R6) DIV 2
CRTC_R8     = 0             ; not interlaced (as *TV 0,1), no display or cursor delay
CRTC_R9     = 7             ; 8 lines a character row
CRTC_R10    = &20           ; no cursor
CRTC_R12    = HI(SCREEN DIV 8)
CRTC_R13    = LO(SCREEN DIV 8)
ASSERT (MODE2_R1 - CRTC_R1) MOD 2 = 0 AND (MODE2_R6 - CRTC_R6) MOD 2 = 0
ASSERT CRTC_R7 > CRTC_R6 AND CRTC_R7 <= CRTC_R4
\ The screen never reaches &8000, where the hardware's wrap-around (the
\ System VIA latch's C0 and C1) would come in.
ASSERT SCREEN + CRTC_R6 * CRTC_R1 * (CRTC_R9 + 1) <= &8000

\ The field the CRTC makes, in 2MHz cycles: a line is R0 + 1 characters of
\ its 2MHz clock. Lines are counted from the field's first line shown. The
\ System VIA flags the vertical sync at the sync's end (CA1's falling
\ edge, as the MOS sets the PCR), VSYNC_LINES after it begins, on
\ FLAG_LINE, and the next field's first line shown comes FLAG_TO_TOP lines
\ later.
LINE_CYCLES = CRTC_R0 + 1
LINE_US     = LINE_CYCLES DIV 2         ; the VIAs count microseconds
FIELD_LINES = (CRTC_R4 + 1) * (CRTC_R9 + 1) + CRTC_R5
FIELD_CYCLES = FIELD_LINES * LINE_CYCLES
FIELD_US    = FIELD_LINES * LINE_US
VSYNC_LINES = CRTC_R3 >> 4
FLAG_LINE   = CRTC_R7 * (CRTC_R9 + 1) + VSYNC_LINES
FLAG_TO_TOP = FIELD_LINES - FLAG_LINE
ASSERT FLAG_TO_TOP = (CRTC_R4 + 1 - CRTC_R7) * (CRTC_R9 + 1) + CRTC_R5 - VSYNC_LINES
ASSERT LINE_CYCLES MOD 2 = 0

\ --- The flip (src/screen.6502, src/irq.6502) -----------------------------
\ The view's lines: from VIEW_TOP_LINE up to VIEW_END_LINE. Everything
\ else on the screen is the same in both buffers, so a finished frame is
\ shown (ACCCON's D) whenever the CRTC isn't fetching the view: at once if
\ the beam is outside it, or at FLIP_LINE, just past it, when User VIA T1
\ times out. T1 runs free, a field a period, started in step with the
\ vertical sync, so its count says where the beam is whatever any
\ interrupt's latency: a count above SAFE_T1 is a beam at least FLIP_LEAD
\ lines short of the view's top, or past FLIP_LINE.
\
\ -D VSYNC_FLIP=TRUE builds the flip at the vertical sync instead: the
\ buffers swap in the vertical blank, and T1 isn't used.
FLIP_AT_VSYNC = DEFINED(VSYNC_FLIP)
VIEW_TOP_LINE = VIEW_ROW0 * 8
VIEW_END_LINE = VIEW_TOP_LINE + VIEW_H
FLIP_LINE   = VIEW_END_LINE + 1         ; a line's margin past the view
FLIP_LEAD   = 2                         ; lines before the view's top a flip mustn't start in
ASSERT FLIP_LINE < FLAG_LINE
\ T1's first count, from the sync's flag (polled for: SYNC_LAG microseconds
\ to the count's start) to its first time-out at FLIP_LINE; then its
\ period, a field (a count of n times out every n + 2 microseconds).
SYNC_LAG    = 5
T1_SYNC     = (FIELD_LINES - FLAG_LINE + FLIP_LINE) * LINE_US - SYNC_LAG - 2
T1_PERIOD   = FIELD_US - 2
\ The count left at the beam's latest safe line before the view, to T1's
\ next time-out at FLIP_LINE. frame_end reads T1's high byte alone, so a
\ high byte above HI(SAFE_T1) is safe.
SAFE_T1     = (FLIP_LINE - VIEW_TOP_LINE + FLIP_LEAD) * LINE_US
ASSERT HI(SAFE_T1) < HI(T1_PERIOD) AND T1_SYNC < 65536

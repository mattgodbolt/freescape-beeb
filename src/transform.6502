\ ***************************************************************************
\ FREESCAPE for the BBC Master - the transform (docs/engine.md, stage 3;
\ tools/model/transform.py)
\
\ A camera-space vertex is V = M (v - c), 24-bit signed, 64 to the world
\ unit, nothing rounded, so it's computed as M v - M c from a cache of M v
\ kept while the orientation holds:
\
\ - a frame computes M c once (transform_setup);
\ - an object's cache holds, for its orientation, M v of its box's low
\   corner and M times each of the box's edges (a cuboid, a rectangle), or
\   M v of each vertex (a generic object, a sensor); a box's vertex is the
\   corner's M v - M c plus edges, by additions, as the original builds a
\   cuboid's;
\ - the cache is filled when the object is first transformed under an
\   orientation, from slots handed out in order; all are taken back when
\   the orientation changes or they run out (cache_reset).
\
\ Every world vertex is 64 times a vertex's cells, so each product the
\ cache needs is 64 u m, u a cell (0..127) and m an entry of M (-64..64):
\ by quarter squares, f64(u + m) - f64(u - m) with f64(n) = 64 (n * n DIV
\ 4), read from fq0-fq2 at n + 64, so both indices are bytes. Under a level
\ camera they're read at bases patched for M (fill_patch), the cell the
\ index.
\
\ Entry points:
\   cache_reset       every object's cache emptied, and the sort's memory
\                     (area_enter; and anything that moves an object);
\                     cache_empty, the cache and the bounds alone
\                     (matrix_update and area_enter call it; so must
\                     anything that moves an object)
\   fill_patch        the level fills' bases for M (matrix_update)
\   transform_setup   M c for the frame (after matrix_update), and its
\                     bounds (bound_frame)
\   bound_object      X = a slot: its bounds from its cells (below, "The
\                     bounds"), when they aren't good (ob_bstamp isn't
\                     cache_gen); X kept
\   transform_fill    X = a slot: its cache filled, when it isn't good
\                     (ob_stamp isn't cache_gen)
\   transform_object  X = a slot, its cache good, A = the mask of its
\                     vertices wanted: those vertices in vx*, vy*, vz*
\                     (vertex j at index j). Others of its vertices may be
\                     computed too, as the ones wanted are built from them.
\                     Clobbers A, X, Y.
\
\ The camera's coordinates must be below &8000 (M c's products take them as
\ signed).
\
\ ANDY (decision 52): the front end's rarely run code is in ObjAndy, the
\ Master's 4K at &8000-&8FFF, which ROMSEL's bit 7 pages over the first 4K
\ of the front end's bank (src/defs.6502's OBJ_BANK). Code anywhere calls a
\ routine there through its trampoline in ObjMore (main RAM, which any
\ paging leaves in view), ANDY_CALL's: ANDY paged in, the routine, ANDY
\ paged out. So:
\ - what ANDY's code calls, reads or patches in the bank must be past the
\   bank's first 4K, which ANDY hides: the bank's code from obj_andy_reach
\   on (ASSERTed by the build). The builds put this file's code and
\   src/objects.6502's first in the bank, and nothing of either is reached
\   from ANDY's code;
\ - nothing ANDY's code reaches calls a trampoline, which would page ANDY
\   out under it;
\ - a routine there takes its inputs in X, Y or memory (the trampoline
\   clobbers A going in), and gives back X, Y, C and V (and A, by
\   ANDY_CALL_A's), N and Z clobbered.
\ tools/objectcheck.mjs fails a view that runs anything in sideways RAM but
\ the front end's own code: the bank's with the bank paged, ANDY's with
\ ANDY.
\ ***************************************************************************

MACRO ANDY_CALL entry
    LDA #OBJ_BANK OR ROMSEL_ANDY : STA romsel
    JSR entry
    LDA #OBJ_BANK : STA romsel
    RTS
ENDMACRO
MACRO ANDY_CALL_A entry
    LDA #OBJ_BANK OR ROMSEL_ANDY : STA romsel
    JSR entry
    PHA
    LDA #OBJ_BANK : STA romsel
    PLA
    RTS
ENDMACRO
ASSERT OBJ_BANK < 16 AND ROMSEL_ANDY = &80

VMAX        = 8                     ; vertices an object has, at most (the masks are bytes)
VALL        = 24                    ; the vertex arrays: the object's, then the clips' (src/clip.6502)

SECTION ObjWork
.mc         SKIP 9                  ; M c: x, y, z, each 24-bit signed, low byte first
.mc_cam     SKIP 6                  ; the camera it is for
.mc_valid   SKIP 1                  ; non-zero once it is, under this matrix (matrix_build clears it)
.cache_gen  SKIP 1                  ; the orientation's stamp: a cache is good when its
.ob_stamp   SKIP N_OBJ              ; object's ob_stamp is this
.slot_next  SKIP 1                  ; the next free slot
.ob_slot    SKIP N_OBJ              ; an object's first cache slot
\ the object being drawn's camera-space vertices, its own from 0 and the
\ near clip's from VMAX (src/clip.6502)
.vx0        SKIP VALL
.vx1        SKIP VALL
.vx2        SKIP VALL
.vy0        SKIP VALL
.vy1        SKIP VALL
.vy2        SKIP VALL
.vz0        SKIP VALL
.vz1        SKIP VALL
.vz2        SKIP VALL
\ the bounds (below, "The bounds")
.bd_mc      SKIP 3 * 3              ; each bound of M c, as bound_frame keeps it
.bb_bias    SKIP 3                  ; each bound's bias, &20 a term bound_box takes (bound_patch's)
.bb_lo      SKIP 3                  ; bound_box's box, its low cells ...
.bb_hi      SKIP 3                  ; ... and its high
.ob_bstamp  SKIP N_OBJ              ; an object's bounds are good when this is cache_gen
.bp_level   SKIP 1                  ; non-zero when bound_patch last patched a level camera's M
ENDSECTION

\ Each object's bounds, as the orientation sets them (bound_object): bound p
\ of object X is at bd_k0 + p N_OBJ + X, its middle and top bytes likewise
\ in bd_k1 and bd_k2, unsigned (biased, as bd_mc's are).
SECTION ObjBound
.bd_k0      SKIP 3 * N_OBJ
.bd_k1      SKIP 3 * N_OBJ
.bd_k2      SKIP 3 * N_OBJ
ENDSECTION

\ The cache: a slot is one vector, M v for a corner or M times an edge.
SECTION ObjCache
.ca_x0      SKIP 256
.ca_x1      SKIP 256
.ca_x2      SKIP 256
.ca_y0      SKIP 256
.ca_y1      SKIP 256
.ca_y2      SKIP 256
.ca_z0      SKIP 256
.ca_z1      SKIP 256
.ca_z2      SKIP 256
ENDSECTION

ASSERT ob_ly = ob_lx + N_OBJ AND ob_lz = ob_ly + N_OBJ
ASSERT ob_hy = ob_hx + N_OBJ AND ob_hz = ob_hy + N_OBJ
ASSERT cam_y = cam_x + 2 AND cam_z = cam_x + 4

SECTION ObjCode

\ cache_reset: no object's cache is good, and the sort remembers no
\ compare (sort_forget): for a new area, or an object moved.
.cache_reset
    ZA_ENTRY
    JSR sort_forget
\ cache_empty: no object's cache is good, nor its bounds (a new orientation,
\ or no room, after which the bounds are made again too).
.cache_empty
{
    ZA_ENTRY
    STZ slot_next
    INC cache_gen : BNE done
    \ The stamp wrapped: no old stamp may match the new one.
    LDA #1 : STA cache_gen
    LDX #N_OBJ - 1
.clear
    STZ ob_stamp,X
    STZ ob_bstamp,X
    DEX : BPL clear
.done
    RTS
}

\ transform_setup: M c, the camera's position through the matrix: a row at a
\ time by the maths' dot3 (src/maths.6502); or, while the matrix holds and
\ the camera has moved by less than 64 units on each axis since (a step),
\ the last M c plus M times the move, a byte product (mmul) a non-zero term.
\ Nothing is rounded, so the two are the same.
.transform_setup
{
    ZA_ENTRY
    ZA_AUTO 3, dl                       ; the move, a signed byte an axis
    ZA_AUTO1 ti, ext
    LDA mc_valid : BNE stepped
    JMP full
.stepped
    FOR k = 0..2
        LDA cam_x + 2 * k : SEC : SBC mc_cam + 2 * k : STA dl + k
        LDA cam_x + 2 * k + 1 : SBC mc_cam + 2 * k + 1 : BEQ pos
        CMP #&FF : BNE full_k
        LDA dl + k : CMP #&C1 : BCS ok      ; (-63 .. -1)
    .full_k
        JMP full
    .pos
        LDA dl + k : CMP #64 : BCS full_k   ; (0 .. 63)
    .ok
    NEXT
    LDX #8
.term
    LDA mat,X : BEQ next
    LDY tk3,X
    LDA dl,Y : ZA_INDEXEDBY 0..2
    BEQ next
    TAY
    LDA mat,X : STX ti
    JSR mmul                            ; (|m| <= 65 and |d| <= 63: within its table)
    LDX ti : LDY tr3,X
    LDA #0 : BIT mp+1 : BPL ext_got
    LDA #&FF
.ext_got
    STA ext
    LDA mc,Y : CLC : ADC mp : STA mc,Y
    LDA mc+1,Y : ADC mp+1 : STA mc+1,Y
    LDA mc+2,Y : ADC ext : STA mc+2,Y
.next
    DEX : BPL term
    JMP moved
.full
    LDA mat_tilt : BEQ level
    JMP rows
.level
    \ a level camera's: y is 64 cy, x and z two products each (as the fills
    \ have them)
    FOR q = 0..1
        r = 2 * q
        LDA mat + 3 * r : JSR mul_set
        LDA cam_x : STA mv0 : LDA cam_x+1 : STA mv0+1
        JSR mul
        LDA macc : STA mc + 3 * r
        LDA macc+1 : STA mc + 3 * r + 1
        LDA macc+2 : STA mc + 3 * r + 2
        LDA mat + 3 * r + 2 : JSR mul_set
        LDA cam_z : STA mv0 : LDA cam_z+1 : STA mv0+1
        JSR mul
        LDA mc + 3 * r : CLC : ADC macc : STA mc + 3 * r
        LDA mc + 3 * r + 1 : ADC macc+1 : STA mc + 3 * r + 1
        LDA mc + 3 * r + 2 : ADC macc+2 : STA mc + 3 * r + 2
    NEXT
    \ 64 cy: (cy << 8) >> 2, cy below &8000
    STZ mc+3
    LDA cam_y : STA mc+4
    LDA cam_y+1
    LSR A : ROR mc+4 : ROR mc+3
    LSR A : ROR mc+4 : ROR mc+3
    STA mc+5
    JMP valid
.rows
    FOR r = 0..2
        LDA mat + 3 * r + 0 : STA mrow+0
        LDA mat + 3 * r + 1 : STA mrow+1
        LDA mat + 3 * r + 2 : STA mrow+2
        JSR dot_set
        LDA cam_x+0 : STA mv0+0
        LDA cam_x+1 : STA mv0+1
        LDA cam_y+0 : STA mv1+0
        LDA cam_y+1 : STA mv1+1
        LDA cam_z+0 : STA mv2+0
        LDA cam_z+1 : STA mv2+1
        JSR dot3
        LDA macc+0 : STA mc + 3 * r + 0
        LDA macc+1 : STA mc + 3 * r + 1
        LDA macc+2 : STA mc + 3 * r + 2
    NEXT
.valid
    LDA #1 : STA mc_valid
.moved
    FOR k = 0..5
        LDA cam_x + k : STA mc_cam + k
    NEXT
    JMP bound_frame
\ by 3 r + k: k, and 3 r
.tk3
    EQUB 0, 1, 2, 0, 1, 2, 0, 1, 2
.tr3
    EQUB 0, 0, 0, 3, 3, 3, 6, 6, 6
}

\ ---------------------------------------------------------------------------
\ The cache's products: 64 u m = f64(u + 64 + m) - f64(u + 64 - m). FP_INDEX
\ leaves the two indices in X and Y from u64 = u + 64.

MACRO FP_INDEX m
    LDA u64 : CLC : ADC m : TAX
    LDA u64 : SEC : SBC m : TAY
ENDMACRO

\ FP_SET acc: acc (3 bytes) = f64(X) - f64(Y)
MACRO FP_SET acc
    LDA fq0,X : SEC : SBC fq0,Y : STA acc
    LDA fq1,X : SBC fq1,Y : STA acc+1
    LDA fq2,X : SBC fq2,Y : STA acc+2
ENDMACRO

\ FP_ADD acc: acc += f64(X) - f64(Y)
MACRO FP_ADD acc
    LDA acc : CLC : ADC fq0,X : STA acc
    LDA acc+1 : ADC fq1,X : STA acc+1
    LDA acc+2 : ADC fq2,X : STA acc+2
    LDA acc : SEC : SBC fq0,Y : STA acc
    LDA acc+1 : SBC fq1,Y : STA acc+1
    LDA acc+2 : SBC fq2,Y : STA acc+2
ENDMACRO

\ A level camera's fills (mat_tilt 0: M's y row and column (0, 64, 0), every
\ entry within -64..64): a point's y is 4096 py, its x and z two products
\ each, of px by M00 and pz by M02, and of px by M20 and pz by M22; an
\ edge's one each, or none along y. The product 64 u m (X = u) is read from
\ f64's tables at bases fill_patch sets for m, at u + 64 + m and u + 64 - m
\ (the table's page, as 64 + m is 0..128 and u below 128), into the cache.
\ Each macro's operands are at fixed offsets from its start: the bases for
\ + m at LV_*A0, A1, A2 and those for - m at LV_*B0, B1, B2.
\ LV_SET_ZP d: d (zero page, 3 bytes) = 64 u m
MACRO LV_SET_ZP d
.a0 LDA fq0,X
    SEC
.b0 SBC fq0,X
    STA d
.a1 LDA fq1,X
.b1 SBC fq1,X
    STA d+1
.a2 LDA fq2,X
.b2 SBC fq2,X
    STA d+2
    ASSERT a0 + 1 - a0 = LVZ_A0 AND a1 + 1 - a0 = LVZ_A1 AND a2 + 1 - a0 = LVZ_A2
    ASSERT b0 + 1 - a0 = LVZ_B0 AND b1 + 1 - a0 = LVZ_B1 AND b2 + 1 - a0 = LVZ_B2
ENDMACRO
LVZ_A0 = 1 : LVZ_A1 = 10 : LVZ_A2 = 18 : LVZ_B0 = 5 : LVZ_B1 = 13 : LVZ_B2 = 21
\ LV_SET_CA c0, c1, c2: cache slot Y's coordinate (c0,Y c1,Y c2,Y) = 64 u m
MACRO LV_SET_CA c0, c1, c2
.a0 LDA fq0,X
    SEC
.b0 SBC fq0,X
    STA c0,Y
.a1 LDA fq1,X
.b1 SBC fq1,X
    STA c1,Y
.a2 LDA fq2,X
.b2 SBC fq2,X
    STA c2,Y
    ASSERT a0 + 1 - a0 = LVC_A0 AND a1 + 1 - a0 = LVC_A1 AND a2 + 1 - a0 = LVC_A2
    ASSERT b0 + 1 - a0 = LVC_B0 AND b1 + 1 - a0 = LVC_B1 AND b2 + 1 - a0 = LVC_B2
ENDMACRO
LVC_A0 = 1 : LVC_A1 = 11 : LVC_A2 = 20 : LVC_B0 = 5 : LVC_B1 = 14 : LVC_B2 = 23
\ LV_ADD_CA s, c0, c1, c2: cache slot Y's coordinate = s (zero page) + 64 u m
MACRO LV_ADD_CA s, c0, c1, c2
.st LDA s
    CLC
.a0 ADC fq0,X
    STA s
    LDA s+1
.a1 ADC fq1,X
    STA s+1
    LDA s+2
.a2 ADC fq2,X
    STA s+2
    LDA s
    SEC
.b0 SBC fq0,X
    STA c0,Y
    LDA s+1
.b1 SBC fq1,X
    STA c1,Y
    LDA s+2
.b2 SBC fq2,X
    STA c2,Y
    ASSERT a0 + 1 - st = LVA_A0 AND a1 + 1 - st = LVA_A1 AND a2 + 1 - st = LVA_A2
    ASSERT b0 + 1 - st = LVA_B0 AND b1 + 1 - st = LVA_B1 AND b2 + 1 - st = LVA_B2
ENDMACRO
LVA_A0 = 4 : LVA_A1 = 11 : LVA_A2 = 18 : LVA_B0 = 26 : LVA_B1 = 34 : LVA_B2 = 42
ASSERT 4096 * 127 < &800000             ; (a level camera's y: 4096 py)
ASSERT fq1 = fq0 + &100 AND fq2 = fq1 + &100

\ fill_point: cache slot Y = M (64 p), p = (px, py, pz) in cells.
ZA_AUTO 9, fill_acc
.fill_point
{
    ZA_AUTO 3, p                    ; the point's cells
    px = p : py = p + 1 : pz = p + 2
    ZA_AUTO1 u64, slot
    acc = fill_acc
    STY slot
    LDA mat_big : BEQ fast
    JSR andy_fill_slow_point            ; (Y kept)
    JMP store
.fast
    LDA mat_tilt : BEQ level
    JMP tilted
.level
    \ a level camera's (above, "A level camera's fills"), into slot Y
    LDX px
.lv_x0
    LV_SET_ZP acc                       ; M00 px
.lv_z0
    LV_SET_ZP acc+6                     ; M20 px
    LDX pz
.lv_x1
    LV_ADD_CA acc, ca_x0, ca_x1, ca_x2  ; plus M02 pz
.lv_z1
    LV_ADD_CA acc+6, ca_z0, ca_z1, ca_z2    ; plus M22 pz
    LDA #0 : STA ca_y0,Y
    LDA py : ASL A : ASL A : ASL A : ASL A : STA ca_y1,Y
    LDA py : LSR A : LSR A : LSR A : LSR A : STA ca_y2,Y
    RTS
.tilted
    \ a column at a time, past a zero cell or a zero entry of M
    FOR k = 0..8
        STZ acc + k
    NEXT
    FOR k = 0..2
        LDA px + k : BNE column
        JMP next
    .column
        CLC : ADC #64 : STA u64
        FOR r = 0..2
            LDA mat + 3 * r + k : BEQ skip
            FP_INDEX mat + 3 * r + k
            FP_ADD acc + 3 * r
        .skip
        NEXT
    .next
    NEXT
    LDY slot
.store
    LDA acc+0 : STA ca_x0,Y
    LDA acc+1 : STA ca_x1,Y
    LDA acc+2 : STA ca_x2,Y
    LDA acc+3 : STA ca_y0,Y
    LDA acc+4 : STA ca_y1,Y
    LDA acc+5 : STA ca_y2,Y
    LDA acc+6 : STA ca_z0,Y
    LDA acc+7 : STA ca_z1,Y
    LDA acc+8 : STA ca_z2,Y
    RTS
}

\ fill_edge: cache slot Y = M times an edge of A cells along axis X.
.fill_edge
{
    ZA_AUTO1 u64, slot
    ZA_AUTO 3, col
    STY slot
    LDY mat_big : BEQ fast
    \ the slow fill's point: those cells on that axis and none on the others
    STZ fill_point.px : STZ fill_point.py : STZ fill_point.pz
    STA fill_point.p,X : ZA_INDEXEDBY 0..2
    LDY slot
    JSR andy_fill_slow_point            ; (Y kept)
    JMP fill_point.store
.fast
    LDY mat_tilt : BEQ level
    JMP tilted
.level
    \ a level camera's (above, "A level camera's fills"), into slot Y
    LDY slot
    CPX #1 : BEQ up : BCC along_x
    JMP along_z
.along_x
    TAX
.lv_xx
    LV_SET_CA ca_x0, ca_x1, ca_x2       ; M00 A
.lv_xz
    LV_SET_CA ca_z0, ca_z1, ca_z2       ; M20 A
    LDA #0 : STA ca_y0,Y : STA ca_y1,Y : STA ca_y2,Y
    RTS
.up
    \ 4096 A
    TAX
    LDA #0
    STA ca_x0,Y : STA ca_x1,Y : STA ca_x2,Y
    STA ca_z0,Y : STA ca_z1,Y : STA ca_z2,Y
    STA ca_y0,Y
    TXA : ASL A : ASL A : ASL A : ASL A : STA ca_y1,Y
    TXA : LSR A : LSR A : LSR A : LSR A : STA ca_y2,Y
    RTS
.along_z
    TAX
.lv_zx
    LV_SET_CA ca_x0, ca_x1, ca_x2       ; M02 A
.lv_zz
    LV_SET_CA ca_z0, ca_z1, ca_z2       ; M22 A
    LDA #0 : STA ca_y0,Y : STA ca_y1,Y : STA ca_y2,Y
    RTS
.tilted
    CLC : ADC #64 : STA u64
    LDA mat + 0,X : STA col
    LDA mat + 3,X : STA col+1
    LDA mat + 6,X : STA col+2
    FOR r = 0..2
        LDA col + r : BNE product
        STZ fill_acc + 3 * r
        STZ fill_acc + 3 * r + 1
        STZ fill_acc + 3 * r + 2
        BRA done
    .product
        FP_INDEX col + r
        FP_SET fill_acc + 3 * r
    .done
    NEXT
    LDY slot
    JMP fill_point.store
}

\ fill_patch: a level camera's fills' bases (above, "A level camera's
\ fills") for M, as it's built: + m's 64 + m, - m's 64 - m.
MACRO LV_PATCH site, m, a0, a1, a2, b0, b1, b2
    LDA m : CLC : ADC #64
    STA site + a0 : STA site + a1 : STA site + a2
    LDA #64 : SEC : SBC m
    STA site + b0 : STA site + b1 : STA site + b2
ENDMACRO
.fill_patch
{
    LDA mat_tilt : BEQ level
    RTS
.level
    LV_PATCH fill_point.lv_x0, M00, LVZ_A0, LVZ_A1, LVZ_A2, LVZ_B0, LVZ_B1, LVZ_B2
    LV_PATCH fill_point.lv_z0, M20, LVZ_A0, LVZ_A1, LVZ_A2, LVZ_B0, LVZ_B1, LVZ_B2
    LV_PATCH fill_point.lv_x1, M02, LVA_A0, LVA_A1, LVA_A2, LVA_B0, LVA_B1, LVA_B2
    LV_PATCH fill_point.lv_z1, M22, LVA_A0, LVA_A1, LVA_A2, LVA_B0, LVA_B1, LVA_B2
    LV_PATCH fill_edge.lv_xx, M00, LVC_A0, LVC_A1, LVC_A2, LVC_B0, LVC_B1, LVC_B2
    LV_PATCH fill_edge.lv_xz, M20, LVC_A0, LVC_A1, LVC_A2, LVC_B0, LVC_B1, LVC_B2
    LV_PATCH fill_edge.lv_zx, M02, LVC_A0, LVC_A1, LVC_A2, LVC_B0, LVC_B1, LVC_B2
    LV_PATCH fill_edge.lv_zz, M22, LVC_A0, LVC_A1, LVC_A2, LVC_B0, LVC_B1, LVC_B2
    RTS
}

\ An entry of M can be 65 (rounding), and then f64's indices can run off
\ the table for a cell of 0 or 127; matrix_build sets mat_big for such an
\ orientation (docs/research/objects.md counts them), whose fills take
\ this instead, in ANDY (it's rare): the products by the maths' mul
\ (src/maths.6502), 64 u as its coordinate.

ZA_AUTO 2, fs_v                     ; 64 u, the slow fills' coordinate

ENDSECTION
SECTION ObjMore
.andy_fill_slow_point
    ANDY_CALL fill_slow_point
ENDSECTION
SECTION ObjAndy

\ fill_slow_point: fill_acc = M (64 p), p fill_point.p's cells, a column at
\ a time, each product by the maths' mul; Y (the slot) kept, for
\ fill_point.store.
.fill_slow_point
{
    ZA_AUTO1 slot, k, i
    STY slot
    LDX #8
.zero
    STZ fill_acc,X : ZA_INDEXEDBY 0..8
    DEX : BPL zero
    STZ k
.column
    LDX k
    LDA fill_point.p,X : ZA_INDEXEDBY 0..2
    LSR A : LSR A : STA fs_v+1          ; fs_v = 64 u
    LDA fill_point.p,X : ZA_INDEXEDBY 0..2
    LSR A : ROR A : ROR A : AND #&C0 : STA fs_v
    STX i                               ; i = 3 r + k, row r
.row
    LDX i : LDA mat,X : BEQ next_row
    JSR mul_set
    LDA fs_v : STA mv0
    LDA fs_v+1 : STA mv0+1
    JSR mul
    LDA i : SEC : SBC k : TAX           ; 3 r
    LDA fill_acc,X : ZA_INDEXEDBY 0..6
    CLC : ADC macc
    STA fill_acc,X : ZA_INDEXEDBY 0..6
    LDA fill_acc+1,X : ZA_INDEXEDBY 0..6
    ADC macc+1
    STA fill_acc+1,X : ZA_INDEXEDBY 0..6
    LDA fill_acc+2,X : ZA_INDEXEDBY 0..6
    ADC macc+2
    STA fill_acc+2,X : ZA_INDEXEDBY 0..6
.next_row
    LDA i : CLC : ADC #3 : STA i
    CMP #9 : BCC row
    INC k : LDA k : CMP #3 : BNE column
    LDY slot
    RTS
}

ENDSECTION
SECTION ObjCode

\ transform_fill: object X's cache, from fresh slots.
.transform_fill
{
    ZA_AUTO1 obj, slot, n, k, j
    STX obj
    LDA ob_flags,X : AND #K_MASK : TAY
    LDA fill_slots,Y : BNE counted
    LDA ob_nv,X
.counted
    STA n
    CLC : ADC slot_next : BCC room
    JSR cache_empty
    LDX obj
.room
    LDA slot_next : STA slot : STA ob_slot,X
    CLC : ADC n : STA slot_next
    LDA cache_gen : STA ob_stamp,X
    LDA ob_flags,X : AND #K_MASK : CMP #K_GENERIC : BEQ generic
    \ a box's corner, or a sensor's point
    LDA ob_lx,X : STA fill_point.px
    LDA ob_ly,X : STA fill_point.py
    LDA ob_lz,X : STA fill_point.pz
    LDY slot : JSR fill_point
    LDX obj
    LDA ob_flags,X : AND #K_MASK : CMP #K_SENSOR : BEQ done
    \ the box's edges: each axis but a rectangle's zero one, in order
    STZ k
.edge
    LDX obj
    LDA ob_flags,X : AND #K_MASK : BEQ edge_wanted  ; (a cuboid has all three)
    LDA ob_aux,X : CMP k : BEQ edge_next
.edge_wanted
    LDA k : BEQ x_edge
    TXA
    CLC : ADC #N_OBJ
    LDY k : CPY #2 : BNE indexed
    CLC : ADC #N_OBJ
.indexed
    TAX                             ; ob_lx + k N_OBJ indexed by X is ob_l{k}
.x_edge
    LDA ob_hx,X : SEC : SBC ob_lx,X
    LDX k
    INC slot : LDY slot
    JSR fill_edge
.edge_next
    INC k : LDA k : CMP #3 : BNE edge
.done
    RTS
.generic
    \ each vertex's slot; a vertex the one before it again (a pointed
    \ pyramid's apex, three times over) takes that one's slot's vector
    LDA ob_aux,X : STA j
    LDX j : JSR gen_fill
    BRA kept
.vertex
    LDX j
    LDA gv_x,X : CMP gv_x - 1,X : BNE fresh
    LDA gv_y,X : CMP gv_y - 1,X : BNE fresh
    LDA gv_z,X : CMP gv_z - 1,X : BNE fresh
    LDY slot
    LDA ca_x0 - 1,Y : STA ca_x0,Y
    LDA ca_x1 - 1,Y : STA ca_x1,Y
    LDA ca_x2 - 1,Y : STA ca_x2,Y
    LDA ca_y0 - 1,Y : STA ca_y0,Y
    LDA ca_y1 - 1,Y : STA ca_y1,Y
    LDA ca_y2 - 1,Y : STA ca_y2,Y
    LDA ca_z0 - 1,Y : STA ca_z0,Y
    LDA ca_z1 - 1,Y : STA ca_z1,Y
    LDA ca_z2 - 1,Y : STA ca_z2,Y
    BRA kept
.fresh
    JSR gen_fill
.kept
    INC slot : INC j
    DEC n : BNE vertex
    RTS
\ gen_fill: generic vertex X's slot (slot)
.gen_fill
    LDA gv_x,X : STA fill_point.px
    LDA gv_y,X : STA fill_point.py
    LDA gv_z,X : STA fill_point.pz
    LDY slot : JMP fill_point
.fill_slots
    EQUB 4, 3, 0, 1                 ; cuboid, rectangle, generic (its vertices), sensor
    ASSERT K_CUBOID = 0 AND K_RECT = 1 AND K_GENERIC = 2 AND K_SENSOR = 3
}

\ ---------------------------------------------------------------------------
\ The bounds (the model's render.beyond_view, OBJECT_CULL). Each of three
\ functions of a camera-space point, L 3x + 2z, R 2z - 3x and T z - 3y, is
\ zero on a plane through the eye beyond one of the view's sides, so an
\ object with every vertex where one is negative can't be seen, and
\ objects_frame passes it over. Such a function F of a vertex is F(M v)
\ less F(M c), and F(M v) is linear in v's cells u: 64 (phi . u), phi F
\ of M's columns. So an object's greatest F(M v) over its vertices is 64
\ times its greatest phi . u, which over a box's corners is phi's terms
\ each with the box's high cell where phi is positive, else its low: three
\ products of a cell by a coefficient (bound_box, which bound_patch patches
\ for M), from the cells alone, so an object passed over is never filled.
\ A cuboid, a rectangle and a sensor are a box each, a pyramid two (its
\ base's and its apex's rectangles, each from two opposite corners), and
\ any other object a box a vertex (bound_object). Each of bound_box's
\ products is biased by &8000, so that its sums are unsigned, and an object
\ keeps 64 times its greatest sum, B. The frame's F(M c) is made once
\ (bound_frame); 64 S < F(M c) exactly when 64 S < 64 ceil(F(M c) / 64), so
\ it keeps that plus 64 times the same bias: an object whose B is below the
\ frame's is beyond the view.
BD_L = 0 : BD_R = 1 : BD_T = 2
BD_N = 3
ASSERT 3 * PROJ_XC < 2 * VIEW_FX AND 3 * PROJ_YC < VIEW_FY     ; (each plane beyond the view's side)

\ bound_box's terms. BB_FIRST f, k: bound f of bb_s = u phi + &8000; BB_ADD
\ f, k: plus that, or nothing (bound_patch's skip, for a phi of 0). u is
\ cell k of bb_lo, or of bb_hi (bound_patch picks, by phi's sign), phi
\ bound f's coefficient on axis k, and u phi = f(u + phi) - f(u - phi) by the
\ maths' quarter squares, f(n) = n * n DIV 4, from bases bound_patch sets.
\ Each term has the same layout from its start: the skip's operand (BB_ADD's
\ alone) at BB_SK, the cell's at BB_UX, the low bytes' bases at BB_A0 and
\ BB_B0, and the high bytes' BB_HI on from each.
BB_SK = 1 : BB_UX = 3 : BB_A0 = 7 : BB_B0 = 10 : BB_HI = 8
MACRO BB_FIRST f, k
.sk STZ bb_s + 3 * f + 2
.ux LDX bb_lo + k
    SEC
.a0 LDA sq_lo,X
.b0 SBC sq_lo,X
    STA bb_s + 3 * f
.a1 LDA sq_hi,X
.b1 SBC sq_hi,X
    EOR #&80
    STA bb_s + 3 * f + 1
    ASSERT ux + 1 - sk = BB_UX AND a0 + 1 - sk = BB_A0 AND b0 + 1 - sk = BB_B0
    ASSERT a1 - a0 = BB_HI AND b1 - b0 = BB_HI
ENDMACRO
MACRO BB_ADD f, k
.sk BRA site                            ; patched: past the term
    ZA_CANJUMP site, done
.site
.ux LDX bb_lo + k
    SEC
.a0 LDA sq_lo,X
.b0 SBC sq_lo,X
    STA bb_t
.a1 LDA sq_hi,X
.b1 SBC sq_hi,X
    EOR #&80
    TAY
    LDA bb_t : CLC : ADC bb_s + 3 * f : STA bb_s + 3 * f
    TYA : ADC bb_s + 3 * f + 1 : STA bb_s + 3 * f + 1
    BCC done
    INC bb_s + 3 * f + 2
.done
    ASSERT sk + 1 - sk = BB_SK AND ux + 1 - sk = BB_UX AND a0 + 1 - sk = BB_A0 AND b0 + 1 - sk = BB_B0
    ASSERT a1 - a0 = BB_HI AND b1 - b0 = BB_HI AND done - site = BB_SKIP
ENDMACRO
BB_SKIP = 37
ZA_AUTO 3 * BD_N, bb_s
ZA_AUTO1 bb_t

\ bound_box: bb_s = the three bounds of the box bb_lo to bb_hi, in cells,
\ each the sum of its terms (BB_FIRST's and BB_ADD's not skipped: bb_bias)
\ biased by &8000 a term. Clobbers A, X, Y.
.bound_box
.bb_t00 BB_FIRST BD_L, 0
.bb_t01 BB_ADD BD_L, 1
.bb_t02 BB_ADD BD_L, 2
.bb_t10 BB_FIRST BD_R, 0
.bb_t11 BB_ADD BD_R, 1
.bb_t12 BB_ADD BD_R, 2
.bb_t20 BB_FIRST BD_T, 0
.bb_t21 BB_ADD BD_T, 1
.bb_t22 BB_ADD BD_T, 2
    RTS
ASSERT BD_L = 0 AND BD_R = 1 AND BD_T = 2 AND BD_N = 3

\ BD_STORE s: object X's bounds = 64 times s's three (each below 2^18, so
\ the product fits 24 bits); s clobbered
MACRO BD_STORE s
    FOR p = 0..BD_N - 1
        LDA #0
        LSR s + 3 * p + 2 : ROR s + 3 * p + 1 : ROR s + 3 * p : ROR A
        LSR s + 3 * p + 2 : ROR s + 3 * p + 1 : ROR s + 3 * p : ROR A
        STA bd_k0 + p * N_OBJ,X
        LDA s + 3 * p : STA bd_k1 + p * N_OBJ,X
        LDA s + 3 * p + 1 : STA bd_k2 + p * N_OBJ,X
    NEXT
ENDMACRO

\ bound_object: object X's bounds (bd_k), as its kind takes them; X kept.
.bound_object
{
    ZA_AUTO1 obj, j, end
    STX obj
    LDA cache_gen : STA ob_bstamp,X
    LDA ob_flags,X : AND #K_MASK : CMP #K_GENERIC : BNE box
    JMP generic
.box
    \ a box: a cuboid's, a rectangle's (its size on its axis 0), a sensor's
    \ point (its high corner its low)
    FOR k = 0..2
        LDA ob_lx + k * N_OBJ,X : STA bb_lo + k
        LDA ob_hx + k * N_OBJ,X : STA bb_hi + k
    NEXT
    JSR bound_box
    LDX obj
    BD_STORE bb_s
    RTS
.generic
    LDY ob_aux,X : STY j
    LDA ob_nv,X : CMP #8 : BNE vertices
    \ a pyramid: its base's rectangle, vertices 0 to 3, from 0 and 2, and its
    \ apex's, 4 to 7, from 4 and 6 (tools/model/objects.py's order: each
    \ rectangle's corners in turn round it)
    JSR rect
    JSR bound_box
    JSR bm_put
    LDA j : CLC : ADC #4 : TAY
    JSR rect
    JSR bound_box
    JSR bm_max
    BRA done
.vertices
    \ any other generic object: a box a vertex
    TYA : CLC : ADC ob_nv,X : STA end
    JSR vertex
    JSR bound_box
    JSR bm_put
.next
    INC j
    LDY j : CPY end : BEQ done
    JSR vertex
    JSR bound_box
    JSR bm_max
    BRA next
.done
    LDX obj
    BD_STORE bm
    RTS
\ vertex: the box generic vertex Y alone
.vertex
    FOR k = 0..2
        LDA gv_x + k * N_GV,Y : STA bb_lo + k : STA bb_hi + k
    NEXT
    RTS
\ rect: the box from generic vertex Y to Y + 2, on each axis the lesser and
\ the greater
.rect
    FOR k = 0..2
        LDA gv_x + k * N_GV,Y : CMP gv_x + k * N_GV + 2,Y : BCC ordered
        STA bb_hi + k
        LDA gv_x + k * N_GV + 2,Y : STA bb_lo + k
        BRA rect_next
    .ordered
        STA bb_lo + k
        LDA gv_x + k * N_GV + 2,Y : STA bb_hi + k
    .rect_next
    NEXT
    RTS
\ bm_put: bm = bb_s; bm_max: bm the greater of the two, each bound
.bm_put
    FOR i = 0..3 * BD_N - 1
        LDA bb_s + i : STA bm + i
    NEXT
    RTS
.bm_max
    FOR p = 0..BD_N - 1
        LDA bm + 3 * p : CMP bb_s + 3 * p
        LDA bm + 3 * p + 1 : SBC bb_s + 3 * p + 1
        LDA bm + 3 * p + 2 : SBC bb_s + 3 * p + 2
        BCS kept
        LDA bb_s + 3 * p : STA bm + 3 * p
        LDA bb_s + 3 * p + 1 : STA bm + 3 * p + 1
        LDA bb_s + 3 * p + 2 : STA bm + 3 * p + 2
    .kept
    NEXT
    RTS
}
ZA_AUTO 3 * BD_N, bm

\ BD_CEIL p, v: bd_mc's bound p from v (32-bit signed), M c's bound p: 64
\ ceil(v / 64), plus 64 times bound p's bias (bb_bias), saturated to 24
\ bits unsigned
MACRO BD_CEIL p, v
    LDA v : CLC : ADC #63 : AND #&C0 : STA bd_mc + 3 * p
    LDA v+1 : ADC #0 : STA bd_mc + 3 * p + 1
    LDA v+2 : ADC bb_bias + p : STA bd_mc + 3 * p + 2
    LDA v+3 : ADC #0 : BEQ done
    BMI low
    LDA #&FF : STA bd_mc + 3 * p : STA bd_mc + 3 * p + 1 : STA bd_mc + 3 * p + 2
    BRA done
.low
    STZ bd_mc + 3 * p : STZ bd_mc + 3 * p + 1 : STZ bd_mc + 3 * p + 2
.done
ENDMACRO

\ bound_frame: bd_mc = the three bounds of M c, made in 32 bits (M c isn't
\ an object's), each as BD_CEIL keeps it.
.bound_frame
{
    ZA_AUTO 4, u, w, t, f
    ZA_AUTO1 zs
    \ u = 3x and t = 3y, each x + 2x from its 24 bits sign-extended
    FOR q = 0..1
        V = WHERE(q = 0, u, t)
        LDA mc + 3 * q + 2 : ASL A : LDA #0 : ADC #&FF : EOR #&FF : STA V+3   ; (its sign, extended)
        LDA mc + 3 * q : STA V : ASL A : STA f
        LDA mc + 3 * q + 1 : STA V+1 : ROL A : STA f+1
        LDA mc + 3 * q + 2 : STA V+2 : ROL A : STA f+2
        LDA V+3 : ROL A : STA f+3
        CLC
        LDA V : ADC f : STA V
        LDA V+1 : ADC f+1 : STA V+1
        LDA V+2 : ADC f+2 : STA V+2
        LDA V+3 : ADC f+3 : STA V+3
    NEXT
    \ w = 2z, and zs z's sign, extended
    LDA mc+8 : ASL A : LDA #0 : ADC #&FF : EOR #&FF : STA zs
    LDA mc+6 : ASL A : STA w
    LDA mc+7 : ROL A : STA w+1
    LDA mc+8 : ROL A : STA w+2
    LDA zs : ROL A : STA w+3
    \ L = w + u
    CLC
    LDA w : ADC u : STA f
    LDA w+1 : ADC u+1 : STA f+1
    LDA w+2 : ADC u+2 : STA f+2
    LDA w+3 : ADC u+3 : STA f+3
    BD_CEIL BD_L, f
    \ R = w - u
    SEC
    LDA w : SBC u : STA f
    LDA w+1 : SBC u+1 : STA f+1
    LDA w+2 : SBC u+2 : STA f+2
    LDA w+3 : SBC u+3 : STA f+3
    BD_CEIL BD_R, f
    \ T = z - t
    SEC
    LDA mc+6 : SBC t : STA f
    LDA mc+7 : SBC t+1 : STA f+1
    LDA mc+8 : SBC t+2 : STA f+2
    LDA zs : SBC t+3 : STA f+3
    BD_CEIL BD_T, f
    RTS
}

\ ---------------------------------------------------------------------------
\ transform_object: slot X's wanted vertices (mask A) in camera space.

\ V_SUB j: vertex j = cache slot X's vector - M c
MACRO V_SUB j
    LDA ca_x0,X : SEC : SBC mc+0 : STA vx0+j
    LDA ca_x1,X : SBC mc+1 : STA vx1+j
    LDA ca_x2,X : SBC mc+2 : STA vx2+j
    LDA ca_y0,X : SEC : SBC mc+3 : STA vy0+j
    LDA ca_y1,X : SBC mc+4 : STA vy1+j
    LDA ca_y2,X : SBC mc+5 : STA vy2+j
    LDA ca_z0,X : SEC : SBC mc+6 : STA vz0+j
    LDA ca_z1,X : SBC mc+7 : STA vz1+j
    LDA ca_z2,X : SBC mc+8 : STA vz2+j
ENDMACRO

\ V_ADD d, s, e: vertex d = vertex s + cache slot X + e's vector
MACRO V_ADD d, s, e
    LDA vx0+s : CLC : ADC ca_x0+e,X : STA vx0+d
    LDA vx1+s : ADC ca_x1+e,X : STA vx1+d
    LDA vx2+s : ADC ca_x2+e,X : STA vx2+d
    LDA vy0+s : CLC : ADC ca_y0+e,X : STA vy0+d
    LDA vy1+s : ADC ca_y1+e,X : STA vy1+d
    LDA vy2+s : ADC ca_y2+e,X : STA vy2+d
    LDA vz0+s : CLC : ADC ca_z0+e,X : STA vz0+d
    LDA vz1+s : ADC ca_z1+e,X : STA vz1+d
    LDA vz2+s : ADC ca_z2+e,X : STA vz2+d
ENDMACRO

\ A cuboid's vertex j is built from PARENT[j] and edge EDGE[j] (cache slot
\ X + EDGE[j]): its highest bit's axis added to the vertex without it.
CUBE_PARENT = {0, 0, 0, 1, 0, 1, 2, 3}
CUBE_EDGE   = {0, 1, 2, 2, 3, 3, 3, 3}

\ Under a level camera (mat_tilt 0) M's y row and column are (0, 64, 0), so
\ the cache's edges along x and z have y 0 and the one along y has x and z
\ 0, exactly: those coordinates are copies.
\ V_XZ d, s, e: vertex d = vertex s + cache slot X + e's vector, an edge along
\ x or z: x and z added, y copied
MACRO V_XZ d, s, e
    LDA vx0+s : CLC : ADC ca_x0+e,X : STA vx0+d
    LDA vx1+s : ADC ca_x1+e,X : STA vx1+d
    LDA vx2+s : ADC ca_x2+e,X : STA vx2+d
    LDA vz0+s : CLC : ADC ca_z0+e,X : STA vz0+d
    LDA vz1+s : ADC ca_z1+e,X : STA vz1+d
    LDA vz2+s : ADC ca_z2+e,X : STA vz2+d
    LDA vy0+s : STA vy0+d
    LDA vy1+s : STA vy1+d
    LDA vy2+s : STA vy2+d
ENDMACRO
\ V_UP d, s, e: the same along y: y added, x and z copied
MACRO V_UP d, s, e
    LDA vy0+s : CLC : ADC ca_y0+e,X : STA vy0+d
    LDA vy1+s : ADC ca_y1+e,X : STA vy1+d
    LDA vy2+s : ADC ca_y2+e,X : STA vy2+d
    LDA vx0+s : STA vx0+d
    LDA vx1+s : STA vx1+d
    LDA vx2+s : STA vx2+d
    LDA vz0+s : STA vz0+d
    LDA vz1+s : STA vz1+d
    LDA vz2+s : STA vz2+d
ENDMACRO
\ V_COPY d, s, u: vertex d's x and z vertex s's, its y vertex u's
MACRO V_COPY d, s, u
    LDA vx0+s : STA vx0+d
    LDA vx1+s : STA vx1+d
    LDA vx2+s : STA vx2+d
    LDA vz0+s : STA vz0+d
    LDA vz1+s : STA vz1+d
    LDA vz2+s : STA vz2+d
    LDA vy0+u : STA vy0+d
    LDA vy1+u : STA vy1+d
    LDA vy2+u : STA vy2+d
ENDMACRO
\ V_IF j: on past the next unless vertex j is wanted (transform_object's want)
MACRO V_IF j, past
    LDA #1 << j : BIT transform_object.want : BEQ past
ENDMACRO

.transform_object
{
    ZA_ENTRY
    ZA_AUTO1 want, slot
    STA want
    LDA ob_slot,X : STA slot
    LDA ob_flags,X : AND #K_MASK
    BNE not_cuboid
    JMP cuboid
.not_cuboid
    CMP #K_RECT : BNE not_rect
    JMP rect
.not_rect
    CMP #K_SENSOR : BNE generic
    JMP sensor
.generic
    \ a generic object: each wanted vertex from its own slot
    LDY #0
.gen_vertex
    LSR want : BCC gen_next
    TYA : CLC : ADC slot : TAX
    LDA ca_x0,X : SEC : SBC mc+0 : STA vx0,Y
    LDA ca_x1,X : SBC mc+1 : STA vx1,Y
    LDA ca_x2,X : SBC mc+2 : STA vx2,Y
    LDA ca_y0,X : SEC : SBC mc+3 : STA vy0,Y
    LDA ca_y1,X : SBC mc+4 : STA vy1,Y
    LDA ca_y2,X : SBC mc+5 : STA vy2,Y
    LDA ca_z0,X : SEC : SBC mc+6 : STA vz0,Y
    LDA ca_z1,X : SBC mc+7 : STA vz1,Y
    LDA ca_z2,X : SBC mc+8 : STA vz2,Y
.gen_next
    INY
    LDA want : BNE gen_vertex
    RTS
.sensor
    LDX slot
    V_SUB 0
    RTS
.rect
    LDX slot
    V_SUB 0
    V_ADD 1, 0, 1
    V_ADD 2, 1, 2
    V_ADD 3, 0, 2
    RTS
.cuboid
    LDA mat_tilt : BNE tilted
    JMP level
.tilted
    \ The vertices wanted and those they're built from: 7 from 3, 3 and 5
    \ from 1, 6 from 2, the rest from 0, which is always made.
    LDA want
    BIT #&80 : BEQ no7
    ORA #&08
.no7
    BIT #&28 : BEQ no35
    ORA #&02
.no35
    BIT #&40 : BEQ no6
    ORA #&04
.no6
    LSR A : STA want
    LDX slot
    V_SUB 0
    FOR j = 1..7
        LSR want : BCC skip
        V_ADD j, CUBE_PARENT[j], CUBE_EDGE[j]
    .skip
    NEXT
    RTS
.level
    \ A level camera's: 1, 4 and 5 (5 from 1) by x and z from 0, their y
    \ 0's; 2 by y from 0; 3, 6 and 7 copies, x and z from 1, 4 and 5, y from
    \ 2. So 7 wants 5, 5 and 3 want 1, 6 wants 4, and 3, 6 and 7 want 2.
    LDA want
    BIT #&80 : BEQ l_no7
    ORA #&20
.l_no7
    BIT #&28 : BEQ l_no35
    ORA #&02
.l_no35
    BIT #&40 : BEQ l_no6
    ORA #&10
.l_no6
    BIT #&C8 : BEQ l_no367
    ORA #&04
.l_no367
    STA want
    LDX slot
    V_SUB 0
    V_IF 1, l_1
    V_XZ 1, 0, 1
.l_1
    V_IF 4, l_4
    V_XZ 4, 0, 3
.l_4
    V_IF 5, l_5
    V_XZ 5, 1, 3
.l_5
    V_IF 2, l_2
    V_UP 2, 0, 2
.l_2
    V_IF 3, l_3
    V_COPY 3, 1, 2
.l_3
    V_IF 6, l_6
    V_COPY 6, 4, 2
.l_6
    V_IF 7, l_7
    V_COPY 7, 5, 2
.l_7
    RTS
}

ENDSECTION

SECTION ObjTables
\ f64(n - 64) = 64 ((n - 64)^2 DIV 4), n = 0..255, three bytes: read in the
\ frame, so never in sideways RAM nor &3000-&7FFF (the builds put it in
\ HAZEL, on a page boundary, so no read of it crosses a page).
FQ = 64 * (((0..255) - 64) * ((0..255) - 64) DIV 4)
.fq0
    EQUB FQ AND &FF
.fq1
    EQUB (FQ >> 8) AND &FF
.fq2
    EQUB (FQ >> 16) AND &FF
ENDSECTION


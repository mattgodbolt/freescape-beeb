\ ***************************************************************************
\ FREESCAPE for the BBC Master - the transform (docs/engine.md, stage 3;
\ tools/model/transform.py)
\
\ A camera-space vertex is V = M (v - c), 24-bit signed, 64 to the world
\ unit, nothing rounded, so it's computed as M v - M c from a cache of M v
\ kept while the orientation holds:
\
\ - a frame computes M c once (transform_setup);
\ - an object's cache holds, for its orientation, M v of its box's low
\   corner and M times each of the box's edges (a cuboid, a rectangle), or
\   M v of each vertex (a generic object, a sensor); a box's vertex is the
\   corner's M v - M c plus edges, by additions, as the original builds a
\   cuboid's;
\ - the cache is filled when the object is first transformed under an
\   orientation, from slots handed out in order; all are taken back when
\   the orientation changes or they run out (cache_reset).
\
\ Every world vertex is 64 times a vertex's cells, so each product the
\ cache needs is 64 u m, u a cell (0..127) and m an entry of M (-64..64):
\ by quarter squares, f64(u + m) - f64(u - m) with f64(n) = 64 (n * n DIV
\ 4), read from fq0-fq2 at n + 64, so both indices are bytes.
\
\ Entry points:
\   cache_reset       every object's cache emptied, and the sort's memory
\                     (area_enter; and anything that moves an object);
\                     cache_empty, the cache alone (matrix_update and
\                     area_enter call it; so must anything that moves an
\                     object)
\   transform_setup   M c for the frame (after matrix_update), and its
\                     bounds (bound_frame)
\   transform_fill    X = a slot: its cache filled, and its bounds
\                     (bound_fill), when it isn't good (ob_stamp isn't
\                     cache_gen)
\   transform_object  X = a slot, its cache good, A = the mask of its
\                     vertices wanted: those vertices in vx*, vy*, vz*
\                     (vertex j at index j). Others of its vertices may be
\                     computed too, as the ones wanted are built from them.
\                     Clobbers A, X, Y.
\
\ The camera's coordinates must be below &8000 (M c's products take them as
\ signed).
\
\ ANDY (decision 52): the front end's rarely run code is in ObjAndy, the
\ Master's 4K at &8000-&8FFF, which ROMSEL's bit 7 pages over the first 4K
\ of the front end's bank (src/defs.6502's OBJ_BANK). Code anywhere calls a
\ routine there through its trampoline in ObjMore (main RAM, which any
\ paging leaves in view), ANDY_CALL's: ANDY paged in, the routine, ANDY
\ paged out. So:
\ - what ANDY's code calls, reads or patches in the bank must be past the
\   bank's first 4K, which ANDY hides: the bank's code from obj_andy_reach
\   on (ASSERTed by the build). The builds put this file's code and
\   src/objects.6502's first in the bank, and nothing of either is reached
\   from ANDY's code;
\ - nothing ANDY's code reaches calls a trampoline, which would page ANDY
\   out under it;
\ - a routine there takes its inputs in X, Y or memory (the trampoline
\   clobbers A going in), and gives back X, Y, C and V (and A, by
\   ANDY_CALL_A's), N and Z clobbered.
\ tools/objectcheck.mjs fails a view that runs anything in sideways RAM but
\ the front end's own code: the bank's with the bank paged, ANDY's with
\ ANDY.
\ ***************************************************************************

MACRO ANDY_CALL entry
    LDA #OBJ_BANK OR ROMSEL_ANDY : STA romsel
    JSR entry
    LDA #OBJ_BANK : STA romsel
    RTS
ENDMACRO
MACRO ANDY_CALL_A entry
    LDA #OBJ_BANK OR ROMSEL_ANDY : STA romsel
    JSR entry
    PHA
    LDA #OBJ_BANK : STA romsel
    PLA
    RTS
ENDMACRO
ASSERT OBJ_BANK < 16 AND ROMSEL_ANDY = &80

VMAX        = 8                     ; vertices an object has, at most (the masks are bytes)
VALL        = 24                    ; the vertex arrays: the object's, then the clips' (src/clip.6502)

SECTION ObjWork
.mc         SKIP 9                  ; M c: x, y, z, each 24-bit signed, low byte first
.mc_cam     SKIP 6                  ; the camera it is for
.mc_valid   SKIP 1                  ; non-zero once it is, under this matrix (matrix_build clears it)
.cache_gen  SKIP 1                  ; the orientation's stamp: a cache is good when its
.ob_stamp   SKIP N_OBJ              ; object's ob_stamp is this
.slot_next  SKIP 1                  ; the next free slot
.ob_slot    SKIP N_OBJ              ; an object's first cache slot
\ the object being drawn's camera-space vertices, its own from 0 and the
\ near clip's from VMAX (src/clip.6502)
.vx0        SKIP VALL
.vx1        SKIP VALL
.vx2        SKIP VALL
.vy0        SKIP VALL
.vy1        SKIP VALL
.vy2        SKIP VALL
.vz0        SKIP VALL
.vz1        SKIP VALL
.vz2        SKIP VALL
\ the bounds (below, "The bounds")
.bd_sel     SKIP 3                  ; each bound's edges: bit k if M's column k raises it (bound_sel)
.bd_mc      SKIP 3 * 3              ; each bound of M c, 24-bit signed, saturated, its top bit flipped (bound_frame)
ENDSECTION

\ Each object's bounds, as its cache's orientation sets them (transform_fill):
\ bound p of object X is at bd_k0 + p N_OBJ + X, its middle and top bytes
\ likewise in bd_k1 and bd_k2, the top with its sign bit flipped (as
\ bd_mc's is), so that objects_frame orders them unsigned.
SECTION ObjBound
.bd_k0      SKIP 3 * N_OBJ
.bd_k1      SKIP 3 * N_OBJ
.bd_k2      SKIP 3 * N_OBJ
ENDSECTION

\ The cache: a slot is one vector, M v for a corner or M times an edge.
SECTION ObjCache
.ca_x0      SKIP 256
.ca_x1      SKIP 256
.ca_x2      SKIP 256
.ca_y0      SKIP 256
.ca_y1      SKIP 256
.ca_y2      SKIP 256
.ca_z0      SKIP 256
.ca_z1      SKIP 256
.ca_z2      SKIP 256
ENDSECTION

ASSERT ob_ly = ob_lx + N_OBJ AND ob_lz = ob_ly + N_OBJ
ASSERT ob_hy = ob_hx + N_OBJ AND ob_hz = ob_hy + N_OBJ
ASSERT cam_y = cam_x + 2 AND cam_z = cam_x + 4

SECTION ObjCode

\ cache_reset: no object's cache is good, and the sort remembers no
\ compare (sort_forget): for a new area, or an object moved.
.cache_reset
    ZA_ENTRY
    JSR sort_forget
\ cache_empty: no object's cache is good (a new orientation, or no room).
.cache_empty
{
    ZA_ENTRY
    STZ slot_next
    INC cache_gen : BNE done
    \ The stamp wrapped: no old stamp may match the new one.
    LDA #1 : STA cache_gen
    LDX #N_OBJ - 1
.clear
    STZ ob_stamp,X
    DEX : BPL clear
.done
    RTS
}

\ transform_setup: M c, the camera's position through the matrix: a row at a
\ time by the maths' dot3 (src/maths.6502); or, while the matrix holds and
\ the camera has moved by less than 64 units on each axis since (a step),
\ the last M c plus M times the move, a byte product (mmul) a non-zero term.
\ Nothing is rounded, so the two are the same.
.transform_setup
{
    ZA_ENTRY
    ZA_AUTO 3, dl                       ; the move, a signed byte an axis
    ZA_AUTO1 ti, ext
    LDA mc_valid : BNE stepped
    JMP full
.stepped
    FOR k = 0..2
        LDA cam_x + 2 * k : SEC : SBC mc_cam + 2 * k : STA dl + k
        LDA cam_x + 2 * k + 1 : SBC mc_cam + 2 * k + 1 : BEQ pos
        CMP #&FF : BNE full_k
        LDA dl + k : CMP #&C1 : BCS ok      ; (-63 .. -1)
    .full_k
        JMP full
    .pos
        LDA dl + k : CMP #64 : BCS full_k   ; (0 .. 63)
    .ok
    NEXT
    LDX #8
.term
    LDA mat,X : BEQ next
    LDY tk3,X
    LDA dl,Y : ZA_INDEXEDBY 0..2
    BEQ next
    TAY
    LDA mat,X : STX ti
    JSR mmul                            ; (|m| <= 65 and |d| <= 63: within its table)
    LDX ti : LDY tr3,X
    LDA #0 : BIT mp+1 : BPL ext_got
    LDA #&FF
.ext_got
    STA ext
    LDA mc,Y : CLC : ADC mp : STA mc,Y
    LDA mc+1,Y : ADC mp+1 : STA mc+1,Y
    LDA mc+2,Y : ADC ext : STA mc+2,Y
.next
    DEX : BPL term
    JMP moved
.full
    FOR r = 0..2
        LDA mat + 3 * r + 0 : STA mrow+0
        LDA mat + 3 * r + 1 : STA mrow+1
        LDA mat + 3 * r + 2 : STA mrow+2
        JSR dot_set
        LDA cam_x+0 : STA mv0+0
        LDA cam_x+1 : STA mv0+1
        LDA cam_y+0 : STA mv1+0
        LDA cam_y+1 : STA mv1+1
        LDA cam_z+0 : STA mv2+0
        LDA cam_z+1 : STA mv2+1
        JSR dot3
        LDA macc+0 : STA mc + 3 * r + 0
        LDA macc+1 : STA mc + 3 * r + 1
        LDA macc+2 : STA mc + 3 * r + 2
    NEXT
    LDA #1 : STA mc_valid
.moved
    FOR k = 0..5
        LDA cam_x + k : STA mc_cam + k
    NEXT
    JMP bound_frame
\ by 3 r + k: k, and 3 r
.tk3
    EQUB 0, 1, 2, 0, 1, 2, 0, 1, 2
.tr3
    EQUB 0, 0, 0, 3, 3, 3, 6, 6, 6
}

\ ---------------------------------------------------------------------------
\ The cache's products: 64 u m = f64(u + 64 + m) - f64(u + 64 - m). FP_INDEX
\ leaves the two indices in X and Y from u64 = u + 64.

MACRO FP_INDEX m
    LDA u64 : CLC : ADC m : TAX
    LDA u64 : SEC : SBC m : TAY
ENDMACRO

\ FP_SET acc: acc (3 bytes) = f64(X) - f64(Y)
MACRO FP_SET acc
    LDA fq0,X : SEC : SBC fq0,Y : STA acc
    LDA fq1,X : SBC fq1,Y : STA acc+1
    LDA fq2,X : SBC fq2,Y : STA acc+2
ENDMACRO

\ FP_ADD acc: acc += f64(X) - f64(Y)
MACRO FP_ADD acc
    LDA acc : CLC : ADC fq0,X : STA acc
    LDA acc+1 : ADC fq1,X : STA acc+1
    LDA acc+2 : ADC fq2,X : STA acc+2
    LDA acc : SEC : SBC fq0,Y : STA acc
    LDA acc+1 : SBC fq1,Y : STA acc+1
    LDA acc+2 : SBC fq2,Y : STA acc+2
ENDMACRO

\ LEVEL_SET m, acc: acc = 64 u m (u64 = u + 64), 0 for a zero m;
\ LEVEL_ADD m, acc: acc plus it
MACRO LEVEL_SET m, acc
    LDA m : BNE product
    STZ acc : STZ acc+1 : STZ acc+2
    BRA done
.product
    FP_INDEX m
    FP_SET acc
.done
ENDMACRO
MACRO LEVEL_ADD m, acc
    LDA m : BEQ done
    FP_INDEX m
    FP_ADD acc
.done
ENDMACRO
ASSERT 4096 * 127 < &800000             ; (a level camera's y: 4096 py)

\ fill_point: cache slot Y = M (64 p), p = (px, py, pz) in cells; the
\ vector left in fill_acc too (fill_edge's likewise), for the bounds.
ZA_AUTO 9, fill_acc
.fill_point
{
    ZA_AUTO 3, p                    ; the point's cells
    px = p : py = p + 1 : pz = p + 2
    ZA_AUTO1 u64, slot
    acc = fill_acc
    STY slot
    LDA mat_big : BEQ fast
    JSR andy_fill_slow_point            ; (Y kept)
    JMP store
.fast
    LDA mat_tilt : BEQ level
    JMP tilted
.level
    \ a level camera's M: its y row and column (0, 64, 0), so y is 4096 py,
    \ and x and z take two entries each of px's column and pz's
    STZ acc+3
    LDA py : ASL A : ASL A : ASL A : ASL A : STA acc+4
    LDA py : LSR A : LSR A : LSR A : LSR A : STA acc+5
    LDA px : BNE level_x
    STZ acc+0 : STZ acc+1 : STZ acc+2
    STZ acc+6 : STZ acc+7 : STZ acc+8
    BRA level_z
.level_x
    CLC : ADC #64 : STA u64
    LEVEL_SET M00, acc+0
    LEVEL_SET M20, acc+6
.level_z
    LDA pz : BNE level_pz
    JMP level_done
.level_pz
    CLC : ADC #64 : STA u64
    LEVEL_ADD M02, acc+0
    LEVEL_ADD M22, acc+6
.level_done
    LDY slot
    JMP store
.tilted
    \ a column at a time, past a zero cell or a zero entry of M
    FOR k = 0..8
        STZ acc + k
    NEXT
    FOR k = 0..2
        LDA px + k : BNE column
        JMP next
    .column
        CLC : ADC #64 : STA u64
        FOR r = 0..2
            LDA mat + 3 * r + k : BEQ skip
            FP_INDEX mat + 3 * r + k
            FP_ADD acc + 3 * r
        .skip
        NEXT
    .next
    NEXT
    LDY slot
.store
    LDA acc+0 : STA ca_x0,Y
    LDA acc+1 : STA ca_x1,Y
    LDA acc+2 : STA ca_x2,Y
    LDA acc+3 : STA ca_y0,Y
    LDA acc+4 : STA ca_y1,Y
    LDA acc+5 : STA ca_y2,Y
    LDA acc+6 : STA ca_z0,Y
    LDA acc+7 : STA ca_z1,Y
    LDA acc+8 : STA ca_z2,Y
    RTS
}

\ fill_edge: cache slot Y = M times an edge of A cells along axis X.
.fill_edge
{
    ZA_AUTO1 u64, slot
    ZA_AUTO 3, col
    STY slot
    LDY mat_big : BEQ fast
    \ the slow fill's point: those cells on that axis and none on the others
    STZ fill_point.px : STZ fill_point.py : STZ fill_point.pz
    STA fill_point.p,X : ZA_INDEXEDBY 0..2
    LDY slot
    JSR andy_fill_slow_point            ; (Y kept)
    JMP fill_point.store
.fast
    CLC : ADC #64 : STA u64
    LDA mat + 0,X : STA col
    LDA mat + 3,X : STA col+1
    LDA mat + 6,X : STA col+2
    FOR r = 0..2
        LDA col + r : BNE product
        STZ fill_acc + 3 * r
        STZ fill_acc + 3 * r + 1
        STZ fill_acc + 3 * r + 2
        BRA done
    .product
        FP_INDEX col + r
        FP_SET fill_acc + 3 * r
    .done
    NEXT
    LDY slot
    JMP fill_point.store
}

\ An entry of M can be 65 (rounding), and then f64's indices can run off
\ the table for a cell of 0 or 127; matrix_build sets mat_big for such an
\ orientation (docs/research/objects.md counts them), whose fills take
\ this instead, in ANDY (it's rare): the products by the maths' mul
\ (src/maths.6502), 64 u as its coordinate.

ZA_AUTO 2, fs_v                     ; 64 u, the slow fills' coordinate

ENDSECTION
SECTION ObjMore
.andy_fill_slow_point
    ANDY_CALL fill_slow_point
ENDSECTION
SECTION ObjAndy

\ fill_slow_point: fill_acc = M (64 p), p fill_point.p's cells, a column at
\ a time, each product by the maths' mul; Y (the slot) kept, for
\ fill_point.store.
.fill_slow_point
{
    ZA_AUTO1 slot, k, i
    STY slot
    LDX #8
.zero
    STZ fill_acc,X : ZA_INDEXEDBY 0..8
    DEX : BPL zero
    STZ k
.column
    LDX k
    LDA fill_point.p,X : ZA_INDEXEDBY 0..2
    LSR A : LSR A : STA fs_v+1          ; fs_v = 64 u
    LDA fill_point.p,X : ZA_INDEXEDBY 0..2
    LSR A : ROR A : ROR A : AND #&C0 : STA fs_v
    STX i                               ; i = 3 r + k, row r
.row
    LDX i : LDA mat,X : BEQ next_row
    JSR mul_set
    LDA fs_v : STA mv0
    LDA fs_v+1 : STA mv0+1
    JSR mul
    LDA i : SEC : SBC k : TAX           ; 3 r
    LDA fill_acc,X : ZA_INDEXEDBY 0..6
    CLC : ADC macc
    STA fill_acc,X : ZA_INDEXEDBY 0..6
    LDA fill_acc+1,X : ZA_INDEXEDBY 0..6
    ADC macc+1
    STA fill_acc+1,X : ZA_INDEXEDBY 0..6
    LDA fill_acc+2,X : ZA_INDEXEDBY 0..6
    ADC macc+2
    STA fill_acc+2,X : ZA_INDEXEDBY 0..6
.next_row
    LDA i : CLC : ADC #3 : STA i
    CMP #9 : BCC row
    INC k : LDA k : CMP #3 : BNE column
    LDY slot
    RTS
}

ENDSECTION
SECTION ObjCode

\ transform_fill: object X's cache, from fresh slots, and its bounds
\ (bound_fill).
.transform_fill
{
    ZA_AUTO1 obj, slot, n, k, j
    STX obj
    LDA ob_flags,X : AND #K_MASK : TAY
    LDA fill_slots,Y : BNE counted
    LDA ob_nv,X
.counted
    STA n
    CLC : ADC slot_next : BCC room
    JSR cache_empty
    LDX obj
.room
    LDA slot_next : STA slot : STA ob_slot,X
    CLC : ADC n : STA slot_next
    LDA cache_gen : STA ob_stamp,X
    LDA ob_flags,X : AND #K_MASK : CMP #K_GENERIC : BEQ generic
    \ a box's corner, or a sensor's point: its bounds, a box's raised by
    \ its edges' as they come
    LDA ob_lx,X : STA fill_point.px
    LDA ob_ly,X : STA fill_point.py
    LDA ob_lz,X : STA fill_point.pz
    LDY slot : JSR fill_point
    JSR bd_eval
    LDX obj
    LDA ob_flags,X : AND #K_MASK : CMP #K_SENSOR : BEQ done
    \ the box's edges: each axis but a rectangle's zero one, in order
    STZ k
.edge
    LDX obj
    LDA ob_flags,X : AND #K_MASK : BEQ edge_wanted  ; (a cuboid has all three)
    LDA ob_aux,X : CMP k : BEQ edge_next
.edge_wanted
    LDA k : BEQ x_edge
    TXA
    CLC : ADC #N_OBJ
    LDY k : CPY #2 : BNE indexed
    CLC : ADC #N_OBJ
.indexed
    TAX                             ; ob_lx + k N_OBJ indexed by X is ob_l{k}
.x_edge
    LDA ob_hx,X : SEC : SBC ob_lx,X
    LDX k
    INC slot : LDY slot
    JSR fill_edge
    LDY k : JSR bd_edge                 ; (added to the bounds it raises)
.edge_next
    INC k : LDA k : CMP #3 : BNE edge
.done
    LDX obj
    JMP bd_put
.generic
    \ each vertex's slot, and the bounds the greatest of theirs; a vertex
    \ the one before it again (a pointed pyramid's apex, three times over)
    \ takes that one's slot's vector, and can't raise them
    LDA ob_aux,X : STA j
    LDX j : JSR gen_fill
    JSR bd_eval
    LDX obj : JSR bd_put
    BRA kept
.vertex
    LDX j
    LDA gv_x,X : CMP gv_x - 1,X : BNE fresh
    LDA gv_y,X : CMP gv_y - 1,X : BNE fresh
    LDA gv_z,X : CMP gv_z - 1,X : BNE fresh
    LDY slot
    LDA ca_x0 - 1,Y : STA ca_x0,Y
    LDA ca_x1 - 1,Y : STA ca_x1,Y
    LDA ca_x2 - 1,Y : STA ca_x2,Y
    LDA ca_y0 - 1,Y : STA ca_y0,Y
    LDA ca_y1 - 1,Y : STA ca_y1,Y
    LDA ca_y2 - 1,Y : STA ca_y2,Y
    LDA ca_z0 - 1,Y : STA ca_z0,Y
    LDA ca_z1 - 1,Y : STA ca_z1,Y
    LDA ca_z2 - 1,Y : STA ca_z2,Y
    BRA kept
.fresh
    JSR gen_fill
    LDX obj : JSR bd_max
.kept
    INC slot : INC j
    DEC n : BNE vertex
    RTS
\ gen_fill: generic vertex X's slot (slot)
.gen_fill
    LDA gv_x,X : STA fill_point.px
    LDA gv_y,X : STA fill_point.py
    LDA gv_z,X : STA fill_point.pz
    LDY slot : JMP fill_point
.fill_slots
    EQUB 4, 3, 0, 1                 ; cuboid, rectangle, generic (its vertices), sensor
    ASSERT K_CUBOID = 0 AND K_RECT = 1 AND K_GENERIC = 2 AND K_SENSOR = 3
}

\ ---------------------------------------------------------------------------
\ The bounds (the model's render.beyond_view, OBJECT_CULL). Each of three
\ functions of a camera-space point, L 3x + 2z, R 2z - 3x and T z - 3y, is
\ zero on a plane through the eye beyond one of the view's sides, so an
\ object with every vertex where one is negative can't be seen, and
\ objects_frame passes it over. A vertex's value is the function of M v less
\ its value of M c, so an object's greatest, over its vertices, of M v's is
\ kept with its cache, which the orientation alone sets, made by
\ transform_fill as it fills each slot, from fill_acc (into bd_k), and the
\ frame's of M c is made once (bound_frame, into bd_mc): an object with a
\ bound below M c's is beyond the view. A box's greatest is at its corner
\ plus each edge that raises it, by the edge's axis (bd_sel, from M:
\ src/matrix.6502's bound_sel): bd_eval, each edge by bd_edge, then
\ bd_put; any other object's is the greatest of its vertices' (bd_eval and
\ bd_put, then bd_max). An object's bounds fit 23 bits signed (the model
\ asserts: BOUND_BITS), so 24-bit arithmetic is exact for them and their
\ edges' terms, and M c's, made in 32 bits, are saturated to 24, which keeps
\ their order with every object's.
BD_L = 0 : BD_R = 1 : BD_T = 2
BD_N = 3
ASSERT 3 * PROJ_XC < 2 * VIEW_FX AND 3 * PROJ_YC < VIEW_FY     ; (each plane beyond the view's side)

\ bd_eval: bd_f's three (L, R, T, 24-bit each, their top bytes' sign bits
\ flipped, which adding to them keeps) of fill_acc's vector, from u = 3x, w
\ = 2z and t = 3y: L w + u, R w - u, T z - t. X kept.
bd_v = fill_acc
.bd_eval
{
    ZA_AUTO 3, u, w, t
    LDA bd_v : ASL A : STA u
    LDA bd_v+1 : ROL A : STA u+1
    LDA bd_v+2 : ROL A : STA u+2
    LDA u : CLC : ADC bd_v : STA u
    LDA u+1 : ADC bd_v+1 : STA u+1
    LDA u+2 : ADC bd_v+2 : STA u+2
    LDA bd_v+3 : ASL A : STA t
    LDA bd_v+4 : ROL A : STA t+1
    LDA bd_v+5 : ROL A : STA t+2
    LDA t : CLC : ADC bd_v+3 : STA t
    LDA t+1 : ADC bd_v+4 : STA t+1
    LDA t+2 : ADC bd_v+5 : STA t+2
    LDA bd_v+6 : ASL A : STA w
    LDA bd_v+7 : ROL A : STA w+1
    LDA bd_v+8 : ROL A : STA w+2
    CLC
    LDA w : ADC u : STA bd_f + 3 * BD_L
    LDA w+1 : ADC u+1 : STA bd_f + 3 * BD_L + 1
    LDA w+2 : ADC u+2 : EOR #&80 : STA bd_f + 3 * BD_L + 2
    SEC
    LDA w : SBC u : STA bd_f + 3 * BD_R
    LDA w+1 : SBC u+1 : STA bd_f + 3 * BD_R + 1
    LDA w+2 : SBC u+2 : EOR #&80 : STA bd_f + 3 * BD_R + 2
    SEC
    LDA bd_v+6 : SBC t : STA bd_f + 3 * BD_T
    LDA bd_v+7 : SBC t+1 : STA bd_f + 3 * BD_T + 1
    LDA bd_v+8 : SBC t+2 : EOR #&80 : STA bd_f + 3 * BD_T + 2
    RTS
}
ZA_AUTO 3 * BD_N, bd_f
ASSERT BD_L = 0 AND BD_R = 1 AND BD_T = 2 AND BD_N = 3

\ bd_put: object X's bounds = bd_f. X kept.
.bd_put
    FOR p = 0..BD_N - 1
        LDA bd_f + 3 * p : STA bd_k0 + p * N_OBJ,X
        LDA bd_f + 3 * p + 1 : STA bd_k1 + p * N_OBJ,X
        LDA bd_f + 3 * p + 2 : STA bd_k2 + p * N_OBJ,X
    NEXT
    RTS

\ bd_max: object X's bounds the greater of theirs and fill_acc's (a generic
\ object's later vertices), by the flipped top bytes' unsigned order. X
\ kept.
.bd_max
    JSR bd_eval
    FOR p = 0..BD_N - 1
        LDA bd_k0 + p * N_OBJ,X : CMP bd_f + 3 * p
        LDA bd_k1 + p * N_OBJ,X : SBC bd_f + 3 * p + 1
        LDA bd_k2 + p * N_OBJ,X : SBC bd_f + 3 * p + 2
        BCS kept
        LDA bd_f + 3 * p : STA bd_k0 + p * N_OBJ,X
        LDA bd_f + 3 * p + 1 : STA bd_k1 + p * N_OBJ,X
        LDA bd_f + 3 * p + 2 : STA bd_k2 + p * N_OBJ,X
    .kept
    NEXT
    RTS

\ BD_ADD p, s: bd_f's bound p plus s (24-bit, zero page)
MACRO BD_ADD p, s
    CLC
    LDA bd_f + 3 * p : ADC s : STA bd_f + 3 * p
    LDA bd_f + 3 * p + 1 : ADC s+1 : STA bd_f + 3 * p + 1
    LDA bd_f + 3 * p + 2 : ADC s+2 : STA bd_f + 3 * p + 2
ENDMACRO

\ bd_edge: fill_acc's vector, a box's edge along axis Y, added to each of
\ bd_f's bounds it raises (bd_sel's bit for the axis): L and R from u = 3x
\ and w = 2z, T from z and t = 3y, which under a level camera (mat_tilt 0)
\ is 0 along x or z (as transform_object's copies have it), and along y
\ raises none of them. X kept.
.bd_edge
{
    ZA_AUTO1 bit
    ZA_AUTO 3, u, w, s
    LDA bit8,Y : STA bit
    LDA bd_sel + BD_L : ORA bd_sel + BD_R : AND bit : BNE lr
    JMP no_lr
.lr
    LDA bd_v : ASL A : STA u
    LDA bd_v+1 : ROL A : STA u+1
    LDA bd_v+2 : ROL A : STA u+2
    LDA u : CLC : ADC bd_v : STA u
    LDA u+1 : ADC bd_v+1 : STA u+1
    LDA u+2 : ADC bd_v+2 : STA u+2
    LDA bd_v+6 : ASL A : STA w
    LDA bd_v+7 : ROL A : STA w+1
    LDA bd_v+8 : ROL A : STA w+2
    LDA bd_sel + BD_L : AND bit : BEQ no_l
    CLC
    LDA w : ADC u : STA s
    LDA w+1 : ADC u+1 : STA s+1
    LDA w+2 : ADC u+2 : STA s+2
    BD_ADD BD_L, s
.no_l
    LDA bd_sel + BD_R : AND bit : BEQ no_lr
    SEC
    LDA w : SBC u : STA s
    LDA w+1 : SBC u+1 : STA s+1
    LDA w+2 : SBC u+2 : STA s+2
    BD_ADD BD_R, s
.no_lr
    LDA bd_sel + BD_T : AND bit : BEQ done
    \ T: z less t = 3y (into u: w is done with), or z alone when t is 0
    LDA mat_tilt : BNE tilted
    BD_ADD BD_T, bd_v+6
.done
    RTS
.tilted
    LDA bd_v+3 : ASL A : STA u
    LDA bd_v+4 : ROL A : STA u+1
    LDA bd_v+5 : ROL A : STA u+2
    LDA u : CLC : ADC bd_v+3 : STA u
    LDA u+1 : ADC bd_v+4 : STA u+1
    LDA u+2 : ADC bd_v+5 : STA u+2
    SEC
    LDA bd_v+6 : SBC u : STA s
    LDA bd_v+7 : SBC u+1 : STA s+1
    LDA bd_v+8 : SBC u+2 : STA s+2
    BD_ADD BD_T, s
    RTS
}

\ BD_SAT p, v: bd_mc's bound p = v (32-bit), saturated to 24 bits, its top
\ byte's sign bit flipped
MACRO BD_SAT p, v
    LDA v+2 : ASL A : LDA #0 : ADC #&FF : EOR #&FF  ; (byte 2's sign, extended)
    CMP v+3 : BEQ fits
    LDA v+3 : BMI low
    LDA #&FF : STA bd_mc + 3 * p : STA bd_mc + 3 * p + 1
    STA bd_mc + 3 * p + 2                           ; (&7FFFFF)
    BRA done
.low
    STZ bd_mc + 3 * p : STZ bd_mc + 3 * p + 1
    STZ bd_mc + 3 * p + 2                           ; (&800000)
    BRA done
.fits
    LDA v : STA bd_mc + 3 * p
    LDA v+1 : STA bd_mc + 3 * p + 1
    LDA v+2 : EOR #&80 : STA bd_mc + 3 * p + 2
.done
ENDMACRO

\ bound_frame: bd_mc = the three bounds of M c (bd_eval's, in 32 bits: M c
\ isn't an object's), each saturated to 24 bits.
.bound_frame
{
    ZA_AUTO 4, u, w, t, f
    ZA_AUTO1 zs
    \ u = 3x and t = 3y, each x + 2x from its 24 bits sign-extended
    FOR q = 0..1
        V = WHERE(q = 0, u, t)
        LDA mc + 3 * q + 2 : ASL A : LDA #0 : ADC #&FF : EOR #&FF : STA V+3   ; (its sign, extended)
        LDA mc + 3 * q : STA V : ASL A : STA f
        LDA mc + 3 * q + 1 : STA V+1 : ROL A : STA f+1
        LDA mc + 3 * q + 2 : STA V+2 : ROL A : STA f+2
        LDA V+3 : ROL A : STA f+3
        CLC
        LDA V : ADC f : STA V
        LDA V+1 : ADC f+1 : STA V+1
        LDA V+2 : ADC f+2 : STA V+2
        LDA V+3 : ADC f+3 : STA V+3
    NEXT
    \ w = 2z, and zs z's sign, extended
    LDA mc+8 : ASL A : LDA #0 : ADC #&FF : EOR #&FF : STA zs
    LDA mc+6 : ASL A : STA w
    LDA mc+7 : ROL A : STA w+1
    LDA mc+8 : ROL A : STA w+2
    LDA zs : ROL A : STA w+3
    \ L = w + u
    CLC
    LDA w : ADC u : STA f
    LDA w+1 : ADC u+1 : STA f+1
    LDA w+2 : ADC u+2 : STA f+2
    LDA w+3 : ADC u+3 : STA f+3
    BD_SAT BD_L, f
    \ R = w - u
    SEC
    LDA w : SBC u : STA f
    LDA w+1 : SBC u+1 : STA f+1
    LDA w+2 : SBC u+2 : STA f+2
    LDA w+3 : SBC u+3 : STA f+3
    BD_SAT BD_R, f
    \ T = z - t
    SEC
    LDA mc+6 : SBC t : STA f
    LDA mc+7 : SBC t+1 : STA f+1
    LDA mc+8 : SBC t+2 : STA f+2
    LDA zs : SBC t+3 : STA f+3
    BD_SAT BD_T, f
    RTS
}

\ ---------------------------------------------------------------------------
\ transform_object: slot X's wanted vertices (mask A) in camera space.

\ V_SUB j: vertex j = cache slot X's vector - M c
MACRO V_SUB j
    LDA ca_x0,X : SEC : SBC mc+0 : STA vx0+j
    LDA ca_x1,X : SBC mc+1 : STA vx1+j
    LDA ca_x2,X : SBC mc+2 : STA vx2+j
    LDA ca_y0,X : SEC : SBC mc+3 : STA vy0+j
    LDA ca_y1,X : SBC mc+4 : STA vy1+j
    LDA ca_y2,X : SBC mc+5 : STA vy2+j
    LDA ca_z0,X : SEC : SBC mc+6 : STA vz0+j
    LDA ca_z1,X : SBC mc+7 : STA vz1+j
    LDA ca_z2,X : SBC mc+8 : STA vz2+j
ENDMACRO

\ V_ADD d, s, e: vertex d = vertex s + cache slot X + e's vector
MACRO V_ADD d, s, e
    LDA vx0+s : CLC : ADC ca_x0+e,X : STA vx0+d
    LDA vx1+s : ADC ca_x1+e,X : STA vx1+d
    LDA vx2+s : ADC ca_x2+e,X : STA vx2+d
    LDA vy0+s : CLC : ADC ca_y0+e,X : STA vy0+d
    LDA vy1+s : ADC ca_y1+e,X : STA vy1+d
    LDA vy2+s : ADC ca_y2+e,X : STA vy2+d
    LDA vz0+s : CLC : ADC ca_z0+e,X : STA vz0+d
    LDA vz1+s : ADC ca_z1+e,X : STA vz1+d
    LDA vz2+s : ADC ca_z2+e,X : STA vz2+d
ENDMACRO

\ A cuboid's vertex j is built from PARENT[j] and edge EDGE[j] (cache slot
\ X + EDGE[j]): its highest bit's axis added to the vertex without it.
CUBE_PARENT = {0, 0, 0, 1, 0, 1, 2, 3}
CUBE_EDGE   = {0, 1, 2, 2, 3, 3, 3, 3}

\ Under a level camera (mat_tilt 0) M's y row and column are (0, 64, 0), so
\ the cache's edges along x and z have y 0 and the one along y has x and z
\ 0, exactly: those coordinates are copies.
\ V_XZ d, s, e: vertex d = vertex s + cache slot X + e's vector, an edge along
\ x or z: x and z added, y copied
MACRO V_XZ d, s, e
    LDA vx0+s : CLC : ADC ca_x0+e,X : STA vx0+d
    LDA vx1+s : ADC ca_x1+e,X : STA vx1+d
    LDA vx2+s : ADC ca_x2+e,X : STA vx2+d
    LDA vz0+s : CLC : ADC ca_z0+e,X : STA vz0+d
    LDA vz1+s : ADC ca_z1+e,X : STA vz1+d
    LDA vz2+s : ADC ca_z2+e,X : STA vz2+d
    LDA vy0+s : STA vy0+d
    LDA vy1+s : STA vy1+d
    LDA vy2+s : STA vy2+d
ENDMACRO
\ V_UP d, s, e: the same along y: y added, x and z copied
MACRO V_UP d, s, e
    LDA vy0+s : CLC : ADC ca_y0+e,X : STA vy0+d
    LDA vy1+s : ADC ca_y1+e,X : STA vy1+d
    LDA vy2+s : ADC ca_y2+e,X : STA vy2+d
    LDA vx0+s : STA vx0+d
    LDA vx1+s : STA vx1+d
    LDA vx2+s : STA vx2+d
    LDA vz0+s : STA vz0+d
    LDA vz1+s : STA vz1+d
    LDA vz2+s : STA vz2+d
ENDMACRO
\ V_COPY d, s, u: vertex d's x and z vertex s's, its y vertex u's
MACRO V_COPY d, s, u
    LDA vx0+s : STA vx0+d
    LDA vx1+s : STA vx1+d
    LDA vx2+s : STA vx2+d
    LDA vz0+s : STA vz0+d
    LDA vz1+s : STA vz1+d
    LDA vz2+s : STA vz2+d
    LDA vy0+u : STA vy0+d
    LDA vy1+u : STA vy1+d
    LDA vy2+u : STA vy2+d
ENDMACRO
\ V_IF j: on past the next unless vertex j is wanted (transform_object's want)
MACRO V_IF j, past
    LDA #1 << j : BIT transform_object.want : BEQ past
ENDMACRO

.transform_object
{
    ZA_ENTRY
    ZA_AUTO1 want, slot
    STA want
    LDA ob_slot,X : STA slot
    LDA ob_flags,X : AND #K_MASK
    BNE not_cuboid
    JMP cuboid
.not_cuboid
    CMP #K_RECT : BNE not_rect
    JMP rect
.not_rect
    CMP #K_SENSOR : BNE generic
    JMP sensor
.generic
    \ a generic object: each wanted vertex from its own slot
    LDY #0
.gen_vertex
    LSR want : BCC gen_next
    TYA : CLC : ADC slot : TAX
    LDA ca_x0,X : SEC : SBC mc+0 : STA vx0,Y
    LDA ca_x1,X : SBC mc+1 : STA vx1,Y
    LDA ca_x2,X : SBC mc+2 : STA vx2,Y
    LDA ca_y0,X : SEC : SBC mc+3 : STA vy0,Y
    LDA ca_y1,X : SBC mc+4 : STA vy1,Y
    LDA ca_y2,X : SBC mc+5 : STA vy2,Y
    LDA ca_z0,X : SEC : SBC mc+6 : STA vz0,Y
    LDA ca_z1,X : SBC mc+7 : STA vz1,Y
    LDA ca_z2,X : SBC mc+8 : STA vz2,Y
.gen_next
    INY
    LDA want : BNE gen_vertex
    RTS
.sensor
    LDX slot
    V_SUB 0
    RTS
.rect
    LDX slot
    V_SUB 0
    V_ADD 1, 0, 1
    V_ADD 2, 1, 2
    V_ADD 3, 0, 2
    RTS
.cuboid
    LDA mat_tilt : BNE tilted
    JMP level
.tilted
    \ The vertices wanted and those they're built from: 7 from 3, 3 and 5
    \ from 1, 6 from 2, the rest from 0, which is always made.
    LDA want
    BIT #&80 : BEQ no7
    ORA #&08
.no7
    BIT #&28 : BEQ no35
    ORA #&02
.no35
    BIT #&40 : BEQ no6
    ORA #&04
.no6
    LSR A : STA want
    LDX slot
    V_SUB 0
    FOR j = 1..7
        LSR want : BCC skip
        V_ADD j, CUBE_PARENT[j], CUBE_EDGE[j]
    .skip
    NEXT
    RTS
.level
    \ A level camera's: 1, 4 and 5 (5 from 1) by x and z from 0, their y
    \ 0's; 2 by y from 0; 3, 6 and 7 copies, x and z from 1, 4 and 5, y from
    \ 2. So 7 wants 5, 5 and 3 want 1, 6 wants 4, and 3, 6 and 7 want 2.
    LDA want
    BIT #&80 : BEQ l_no7
    ORA #&20
.l_no7
    BIT #&28 : BEQ l_no35
    ORA #&02
.l_no35
    BIT #&40 : BEQ l_no6
    ORA #&10
.l_no6
    BIT #&C8 : BEQ l_no367
    ORA #&04
.l_no367
    STA want
    LDX slot
    V_SUB 0
    V_IF 1, l_1
    V_XZ 1, 0, 1
.l_1
    V_IF 4, l_4
    V_XZ 4, 0, 3
.l_4
    V_IF 5, l_5
    V_XZ 5, 1, 3
.l_5
    V_IF 2, l_2
    V_UP 2, 0, 2
.l_2
    V_IF 3, l_3
    V_COPY 3, 1, 2
.l_3
    V_IF 6, l_6
    V_COPY 6, 4, 2
.l_6
    V_IF 7, l_7
    V_COPY 7, 5, 2
.l_7
    RTS
}

ENDSECTION

SECTION ObjTables
\ f64(n - 64) = 64 ((n - 64)^2 DIV 4), n = 0..255, three bytes: read in the
\ frame, so never in sideways RAM nor &3000-&7FFF (the builds put it in
\ HAZEL, on a page boundary, so no read of it crosses a page).
FQ = 64 * (((0..255) - 64) * ((0..255) - 64) DIV 4)
.fq0
    EQUB FQ AND &FF
.fq1
    EQUB (FQ >> 8) AND &FF
.fq2
    EQUB (FQ >> 16) AND &FF
ENDSECTION

